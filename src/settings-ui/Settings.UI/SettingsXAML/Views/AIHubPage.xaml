                                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="18">
                            <controls:SettingsPageIntro x:Name="AiHubIntroduction"
                                                       ModuleDescription="{x:Bind ModuleDescription}"
                                                       ModuleImageSource="ms-appx:///Assets/Settings/Modules/AiHub.png" />
                    <Border x:Name="AiHubEnableCardSurface" Style="{StaticResource KitHeroSurfaceStyle}">
                        <controls:GPOInfoControl ShowWarning="{x:Bind ViewModel.IsEnabledGpoConfigured, Mode=OneWay}">
                            <tkcontrols:SettingsCard
                                x:Name="AiHubEnableSettingsCard"
                                x:Uid="AIHub_EnableSettingsCard"
                                Background="Transparent"
                                BorderThickness="0"
                                HeaderIcon="{ui:BitmapIcon Source=/Assets/Settings/Icons/AiHub.png}"
                                IsEnabled="{x:Bind ViewModel.IsEnabledGpoConfigured, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                                <ToggleSwitch x:Uid="AIHub_EnableToggleSwitch" AutomationProperties.AutomationId="Toggle_AIHub"
                                              IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}" />
                            </tkcontrols:SettingsCard>
                        </controls:GPOInfoControl>
                    </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel x:Name="AiHubHeaderTail" Spacing="12" SizeChanged="OnHeaderLayoutChanged">
                    <Border x:Name="AiHubMasterCardSurface" Background="Transparent">
                        <Grid x:Name="AiReadinessBar" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="9" RowSpacing="8">
                            <FontIcon x:Name="AiReadinessIcon" Glyph="{x:Bind ViewModel.AiReadinessGlyph, Mode=OneWay}" FontSize="13"
                                      Style="{x:Bind AiReadinessStyle(ViewModel.AiReadinessLevel), Mode=OneWay}" VerticalAlignment="Center" />
                            <tkcontrols:WrapPanel Grid.Column="1" HorizontalSpacing="6" VerticalSpacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.AiReadinessCompactText, Mode=OneWay}" FontSize="12" FontWeight="Medium"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                           ToolTipService.ToolTip="{x:Bind ViewModel.AiReadinessText, Mode=OneWay}" />
                                <TextBlock Text="·" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{x:Bind ViewModel.HasActiveModelInfo, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Text="{x:Bind ViewModel.CurrentEngineAndModelLabel, Mode=OneWay}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                           Visibility="{x:Bind ViewModel.HasActiveModelInfo, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </tkcontrols:WrapPanel>
                            <tkcontrols:WrapPanel x:Name="AiReadinessActions" Grid.Column="2" HorizontalSpacing="6" VerticalSpacing="4" VerticalAlignment="Center">
                                <HyperlinkButton Click="OnAiServiceSettingsClick" FontSize="12" Padding="6,2"
                                                 AutomationProperties.AutomationId="AIHub_OpenServiceSettingsButton"
                                                 AutomationProperties.Name="{x:Bind ViewModel.AiServiceSettingsLabel}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{x:Bind ViewModel.AiServiceSettingsLabel}" FontSize="12" />
                                        <FontIcon Glyph="&#xE76C;" FontSize="10" VerticalAlignment="Center" />
                                    </StackPanel>
                                </HyperlinkButton>
                                <Button Click="OnRecheckAiReadinessClick" IsEnabled="{x:Bind ViewModel.CanRecheckAiReadiness, Mode=OneWay}"
                                        Style="{StaticResource SubtleButtonStyle}" Padding="7,4" AutomationProperties.AutomationId="AIHub_RecheckAiButton"
                                        AutomationProperties.Name="{x:Bind ViewModel.RecheckAiLabel, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.RecheckAiLabel, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                </Button>
                            </tkcontrols:WrapPanel>
                        </Grid>
                    </Border>
                    <tkcontrols:Segmented x:Name="AiHubSections" SelectedIndex="{x:Bind ViewModel.ActiveTabIndex, Mode=TwoWay}" HorizontalAlignment="Left">
                        <tkcontrols:SegmentedItem Content="{x:Bind ViewModel.SecurityAuditTabLabel}" Icon="{ui:FontIcon Glyph=&#xE72E;}" />
                        <tkcontrols:SegmentedItem Content="{x:Bind ViewModel.OptimizationTabLabel}" Icon="{ui:FontIcon Glyph=&#xE9F5;}" />
                        <tkcontrols:SegmentedItem Content="{x:Bind ViewModel.TaskPoliciesTabLabel}" Icon="{ui:FontIcon Glyph=&#xE8A5;}" />
                    </tkcontrols:Segmented>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="AiHubContentScroll" Grid.Row="2" AutomationProperties.AutomationId="PageScrollViewer"
