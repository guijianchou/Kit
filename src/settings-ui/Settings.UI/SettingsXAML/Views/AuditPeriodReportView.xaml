<UserControl
    x:Class="Kit.Settings.UI.Views.AuditPeriodReportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Kit.Settings.UI.Services"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    Background="Transparent"
    AutomationProperties.AutomationId="AIHub_PeriodReportView">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ReportCanvasWashBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ReportChromeSurfaceBrush" Color="#E6172333" />
                    <SolidColorBrush x:Key="ReportChromeTextBrush" Color="#FFF2F6FC" />
                    <SolidColorBrush x:Key="ReportChromeSecondaryBrush" Color="#FFD0DCEB" />
                    <SolidColorBrush x:Key="ReportChromeChipBrush" Color="#223DA5F2" />
                    <SolidColorBrush x:Key="ReportChromeStrokeBrush" Color="#24FFFFFF" />
                    <SolidColorBrush x:Key="ReportFooterSurfaceBrush" Color="#99172333" />
                    <SolidColorBrush x:Key="ReportFooterStrokeBrush" Color="#18FFFFFF" />
                    <SolidColorBrush x:Key="ReportProgressSurfaceBrush" Color="#A6172333" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ReportCanvasWashBrush" Color="#35EDF3FA" />
                    <SolidColorBrush x:Key="ReportChromeSurfaceBrush" Color="#CCEDF3FA" />
                    <SolidColorBrush x:Key="ReportChromeTextBrush" Color="#FF172235" />
                    <SolidColorBrush x:Key="ReportChromeSecondaryBrush" Color="#FF52647E" />
                    <SolidColorBrush x:Key="ReportChromeChipBrush" Color="#142563B8" />
                    <SolidColorBrush x:Key="ReportChromeStrokeBrush" Color="#1F52647E" />
                    <SolidColorBrush x:Key="ReportFooterSurfaceBrush" Color="#B3EDF3FA" />
                    <SolidColorBrush x:Key="ReportFooterStrokeBrush" Color="#15172333" />
                    <SolidColorBrush x:Key="ReportProgressSurfaceBrush" Color="#B3F6F9FD" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="ReportCanvasWashBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ReportChromeSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ReportChromeTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ReportChromeSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ReportChromeChipBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ReportChromeStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ReportFooterSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ReportFooterStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ReportProgressSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="ReportCommandStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <!-- The export canvas must be loaded; it is covered only while the raster is being built. -->
        <Grid x:Name="RenderHost" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <Border x:Name="RenderCover" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Visibility="Collapsed" />
        <Grid x:Name="ReportRoot" Background="{ThemeResource ReportCanvasWashBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="ReportChrome" Grid.RowSpan="2" Background="{ThemeResource ReportChromeSurfaceBrush}" />
            <Grid x:Name="ReportTitleBar" Height="48" Background="Transparent"
                AutomationProperties.AutomationId="AIHub_PeriodReportTitleBar">
                <Grid x:Name="TitleBarContent" Margin="18,0,150,0" ColumnSpacing="10" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE9D9;" FontSize="16" Foreground="{ThemeResource ReportChromeSecondaryBrush}" />
                    <TextBlock x:Name="ReportTitle" Grid.Column="1" FontSize="13" services:TypographyResources.BaseFontSize="13"
                        FontWeight="SemiBold" Foreground="{ThemeResource ReportChromeTextBrush}" TextTrimming="CharacterEllipsis"
                        AutomationProperties.AutomationId="AIHub_PeriodReportTitle" />
                </Grid>
            </Grid>
            <Border x:Name="ReportToolbar" Grid.Row="1" Padding="16,0,16,10" BorderBrush="{ThemeResource ReportChromeStrokeBrush}" BorderThickness="0,0,0,1">
                <controls:WrapPanel HorizontalSpacing="7" VerticalSpacing="7">
                    <ComboBox x:Name="ModeSelector" MinWidth="100" SelectedIndex="0" SelectionChanged="OnModeSelectionChanged"
                        AutomationProperties.AutomationId="AIHub_WeeklyReportMode">
                        <ComboBoxItem x:Name="FastModeItem" Content="Fast" />
                        <ComboBoxItem x:Name="FullModeItem" Content="Full" />
                    </ComboBox>
                    <Border Background="{ThemeResource ReportChromeChipBrush}" BorderBrush="{ThemeResource ReportChromeStrokeBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="9,6" Margin="0,0,3,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PeriodChip" FontSize="12" services:TypographyResources.BaseFontSize="12"
                            Foreground="{ThemeResource ReportChromeSecondaryBrush}" AutomationProperties.AutomationId="AIHub_PeriodReportChip" />
                    </Border>
                    <Button x:Name="RefreshButton" Style="{StaticResource ReportCommandStyle}" Click="OnRefreshClick"
                        AutomationProperties.AutomationId="AIHub_RefreshPeriodReportButton">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72C;" FontSize="13" /><TextBlock x:Name="RefreshLabel" /></StackPanel>
                    </Button>
                    <Button x:Name="OpenImageButton" Style="{StaticResource ReportCommandStyle}" Click="OnOpenImageClick" IsEnabled="False"
                        AutomationProperties.AutomationId="AIHub_OpenReportImageButton">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8A7;" FontSize="13" /><TextBlock x:Name="OpenImageLabel" /></StackPanel>
                    </Button>
                    <Button x:Name="FitButton" Style="{StaticResource ReportCommandStyle}" Click="OnFitClick" IsEnabled="False"
                        AutomationProperties.AutomationId="AIHub_FitReportImageButton">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon x:Name="FitIcon" Glyph="&#xE740;" FontSize="13" /><TextBlock x:Name="FitLabel" /></StackPanel>
                    </Button>
                    <ProgressRing x:Name="LoadingRing" IsActive="False" Width="20" Height="20" Margin="4,0" Visibility="Collapsed"
                        Foreground="{ThemeResource ReportChromeSecondaryBrush}" />
                    <Button x:Name="CancelButton" Style="{StaticResource ReportCommandStyle}" Click="OnCancelClick" Visibility="Collapsed"
                        AutomationProperties.AutomationId="AIHub_CancelWeeklyReportButton">
                        <TextBlock x:Name="CancelLabel" />
                    </Button>
                </controls:WrapPanel>
            </Border>
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="ReportScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled" ZoomMode="Enabled" MinZoomFactor="0.4" MaxZoomFactor="3" SizeChanged="OnReportSizeChanged">
                    <Image x:Name="ReportImage" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top"
                        AutomationProperties.AutomationId="AIHub_StabilityReportPng" />
                </ScrollViewer>
                <Border x:Name="GenerationPanel" Grid.RowSpan="2" Margin="24" Padding="24" MaxWidth="660"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center" CornerRadius="12"
                    Background="{ThemeResource ReportProgressSurfaceBrush}" BackgroundSizing="OuterBorderEdge" BorderBrush="{ThemeResource ReportChromeStrokeBrush}" BorderThickness="1"
                    AutomationProperties.AutomationId="AIHub_WeeklyReportGenerationPanel">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon x:Name="GenerationStateGlyph" Glyph="&#xE9D9;" FontSize="22" VerticalAlignment="Top" Margin="0,3,0,0"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel Grid.Column="1" Spacing="7">
                                <TextBlock x:Name="GenerationTitle" FontSize="20" services:TypographyResources.BaseFontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                                    Foreground="{ThemeResource ReportChromeTextBrush}" AutomationProperties.AutomationId="AIHub_WeeklyReportGenerationTitle" />
                                <controls:WrapPanel HorizontalSpacing="16" VerticalSpacing="4">
                                    <TextBlock x:Name="GenerationStage" FontSize="13" services:TypographyResources.BaseFontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                        Foreground="{ThemeResource ReportChromeTextBrush}" AutomationProperties.LiveSetting="Polite"
                                        AutomationProperties.AutomationId="AIHub_WeeklyReportGenerationStage" />
                                    <TextBlock x:Name="GenerationElapsed" FontSize="12" services:TypographyResources.BaseFontSize="12"
                                        Foreground="{ThemeResource ReportChromeSecondaryBrush}" AutomationProperties.AutomationId="AIHub_WeeklyReportGenerationElapsed" />
                                </controls:WrapPanel>
                                <TextBlock x:Name="GenerationDetail" FontSize="13" services:TypographyResources.BaseFontSize="13" TextWrapping="Wrap"
                                    Foreground="{ThemeResource ReportChromeSecondaryBrush}" AutomationProperties.AutomationId="AIHub_WeeklyReportGenerationDetail" />
                                <TextBlock x:Name="RetainedPreviewNote" FontSize="12" services:TypographyResources.BaseFontSize="12" TextWrapping="Wrap"
                                    Foreground="{ThemeResource ReportChromeSecondaryBrush}" AutomationProperties.AutomationId="AIHub_WeeklyReportRetainedPreviewNote" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar x:Name="GenerationProgress" IsIndeterminate="False" Visibility="Collapsed" Height="3"
                            AutomationProperties.AutomationId="AIHub_WeeklyReportGenerationProgress" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border x:Name="ReportFooter" Grid.Row="3" Background="{ThemeResource ReportFooterSurfaceBrush}" BorderBrush="{ThemeResource ReportFooterStrokeBrush}"
                BorderThickness="0,1,0,0" Padding="16,9,16,10" AutomationProperties.AutomationId="AIHub_PeriodReportFooter">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="ReportStatus" FontSize="11" services:TypographyResources.BaseFontSize="11" TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" AutomationProperties.AutomationId="AIHub_PeriodReportStatus" />
                    <TextBlock x:Name="ModeDescription" FontSize="11" services:TypographyResources.BaseFontSize="11" TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="AIHub_WeeklyReportModeDescription" />
                    <controls:WrapPanel HorizontalSpacing="16" VerticalSpacing="3">
                        <TextBlock x:Name="ReportSources" FontSize="10" services:TypographyResources.BaseFontSize="10"
                            TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="ZoomHint" FontSize="10" services:TypographyResources.BaseFontSize="10"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </controls:WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
