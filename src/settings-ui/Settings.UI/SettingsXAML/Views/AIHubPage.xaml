                        HorizontalAlignment="Left"
                        Width="8"
                        Margin="-2,0,0,0"
                        Binding="{x:Bind AiHubDetailsHost.OpenPaneLength, Mode=TwoWay}"
                        IsDragInverted="True"
                        Minimum="340"
                        Maximum="620"
                        Visibility="Collapsed" />
