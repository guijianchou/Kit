<UserControl
    x:Class="Kit.Settings.UI.Views.FindingDetailsPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
    AutomationProperties.AutomationId="AIHub_FindingDetailsPane"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    IsTabStop="False">
    <UserControl.Resources>
        <Style x:Key="HighSeverityBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
        </Style>
        <Style x:Key="MediumSeverityBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
        </Style>
        <Style x:Key="LowSeverityBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SystemFillColorAttentionBackgroundBrush}" />
        </Style>
    </UserControl.Resources>

    <Border Background="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
        <Grid Padding="20" RowSpacing="16" RowDefinitions="Auto,*,Auto" TabFocusNavigation="Cycle">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="AI Hub" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="PaneTitleText" Style="{StaticResource BodyStrongTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2" TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="CloseDetailsButton" Grid.Column="1" VerticalAlignment="Center"
                        Style="{StaticResource KitIconButtonStyle}" Click="OnCloseClick"
                        AutomationProperties.AutomationId="AIHub_CloseFindingDetails">
                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                </Button>
            </Grid>

            <ScrollViewer x:Name="DetailsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="18" Padding="0,0,4,4">
                    <tkcontrols:WrapPanel HorizontalSpacing="8" VerticalSpacing="6">
                        <Border x:Name="SeverityBadge" CornerRadius="4" Padding="8,3">
                            <TextBlock x:Name="SeverityText" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       FontSize="12" FontWeight="SemiBold" />
                        </Border>
                        <Border CornerRadius="4" Padding="8,3" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock x:Name="CategoryText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <Border x:Name="OccurrencesBadge" CornerRadius="4" Padding="8,3" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock x:Name="OccurrencesText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </tkcontrols:WrapPanel>

                    <StackPanel Spacing="8">
                        <TextBlock x:Name="FindingTitleText" Style="{StaticResource SubtitleTextBlockStyle}"
                                   AutomationProperties.HeadingLevel="Level3" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Border CornerRadius="6" Padding="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid RowSpacing="8" ColumnSpacing="12" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                            <TextBlock x:Name="EventIdLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                            <TextBlock x:Name="EventIdText" Grid.Column="1" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock x:Name="SourceLabel" Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                            <TextBlock x:Name="SourceText" Grid.Row="1" Grid.Column="1" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock x:Uid="FindingDetails_Timestamp" Grid.Row="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                            <TextBlock x:Name="TimestampText" Grid.Row="2" Grid.Column="1" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock x:Name="RangeLabel" Grid.Row="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                            <TextBlock x:Name="RangeText" Grid.Row="3" Grid.Column="1" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </Grid>
                    </Border>

                    <StackPanel x:Name="ReasonSection" Spacing="6">
                        <TextBlock x:Name="ReasonLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="ReasonText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9D9;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Uid="FindingDetails_Recommendation" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock x:Name="RecommendationText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </StackPanel>

                    <Expander x:Name="EvidenceExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="EvidenceDescriptionText" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="EvidenceText" FontFamily="{StaticResource KitMonoFontFamily}" FontSize="12"
                                       TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Spacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock x:Name="PositionText" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button x:Name="PreviousButton" Style="{StaticResource KitIconButtonStyle}" Click="OnPreviousClick"
                                AutomationProperties.AutomationId="AIHub_PreviousFinding">
                            <FontIcon Glyph="&#xE76B;" FontSize="14" />
                        </Button>
                        <Button x:Name="NextButton" Style="{StaticResource KitIconButtonStyle}" Click="OnNextClick"
                                AutomationProperties.AutomationId="AIHub_NextFinding">
                            <FontIcon Glyph="&#xE76C;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
                <tkcontrols:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                    <Button x:Name="CopyButton" Click="OnCopyClick" Style="{StaticResource KitActionButtonStyle}"
                            AutomationProperties.AutomationId="AIHub_CopyFindingSummary">
                        <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE8C8;" FontSize="13" /><TextBlock x:Name="CopyLabel" /></StackPanel>
                    </Button>
                    <Button x:Name="AnalyzeButton" Click="OnAnalyzeClick" Style="{StaticResource KitPrimaryActionButtonStyle}"
                            AutomationProperties.AutomationId="AIHub_AnalyzeFindingRange">
                        <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE9D9;" FontSize="13" /><TextBlock x:Name="AnalyzeLabel" /></StackPanel>
                    </Button>
                </tkcontrols:WrapPanel>
                <TextBlock x:Name="ActionHintText" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="CopyFeedbackText" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
