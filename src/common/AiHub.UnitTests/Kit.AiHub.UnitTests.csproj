<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(RepoRoot)src\Common.Dotnet.CsWinRT.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <OutputPath>$(RepoRoot)$(Platform)\$(Configuration)\tests\AiHub\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <NoWarn>$(NoWarn);SA0001;SA1200;SA1201;SA1202;SA1309;SA1516;SA1600;SA1633;SA1649;SA1402;SA1116;SA1117;SA1118;SA1407;CA1861;CA1305</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest" />

    <!-- The audit reads the Windows event log, which needs this package's RID-specific
         runtime asset. A self-contained test output does not copy it by default, so the
         tests failed to load the assembly rather than exercising the reader. -->
    <PackageReference Include="System.Diagnostics.EventLog">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>none</PrivateAssets>
    </PackageReference>
    <ProjectReference Include="..\AiHub\Kit.AiHub.csproj" />
    <ProjectReference Include="..\..\modules\AIHub\AIHubLib\Kit.AIHubLib.csproj" />
  </ItemGroup>

  <!-- The event-log package ships its implementation under runtimes\win\lib, and a
       self-contained test output does not lay that down next to the test assembly. Copy it
       explicitly so the audit tests exercise the reader instead of failing to load it. -->
  <Target Name="CopyEventLogRuntimeAsset" AfterTargets="Build">
    <ItemGroup>
      <EventLogRuntimeAsset Include="$(NuGetPackageRoot)system.diagnostics.eventlog\10.0.8\runtimes\win\lib\net10.0\System.Diagnostics.EventLog.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(EventLogRuntimeAsset)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('%(EventLogRuntimeAsset.Identity)')" />
  </Target>
</Project>
