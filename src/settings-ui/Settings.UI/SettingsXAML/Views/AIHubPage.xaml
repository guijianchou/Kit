                                        SelectionChanged="OnAuditResultViewChanged" AutomationProperties.AutomationId="AIHub_ResultViews">
                                        <tkcontrols:SegmentedItem Content="{x:Bind ViewModel.AuditOverviewTabLabel}" Icon="{ui:FontIcon Glyph=&#xE80F;}" />
                                        <tkcontrols:SegmentedItem Content="{x:Bind ViewModel.AuditFindingsTabLabel, Mode=OneWay}" Icon="{ui:FontIcon Glyph=&#xEA37;}" />
                                    </tkcontrols:Segmented>
                                    <Border x:Name="AuditPeriodOverview" Padding="0"
                                        Visibility="{x:Bind ViewModel.ShowAuditOverview, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        AutomationProperties.AutomationId="AIHub_AuditSummary">
                                        <StackPanel Spacing="16">
                                            <tkcontrols:WrapPanel HorizontalSpacing="16" VerticalSpacing="8">
                                                <TextBlock x:Name="AuditPeriodHeading" Text="{x:Bind ViewModel.AuditSummaryHeading, Mode=OneWay}" Style="{StaticResource AiHubSectionTitleStyle}" VerticalAlignment="Center" />
                                                <HyperlinkButton x:Name="AuditViewAllButton" Content="{x:Bind ViewModel.AuditViewAllLabel, Mode=OneWay}"
                                                    Click="OnAuditViewAllClick" Padding="0" AutomationProperties.AutomationId="AIHub_ViewAllIssues" />
                                            </tkcontrols:WrapPanel>
                                            <TextBlock Text="{x:Bind ViewModel.AuditOverviewWindow, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="AIHub_AuditOverviewWindow" />
                                            <Grid x:Name="AuditRiskMetrics" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10" AutomationProperties.Name="{x:Bind ViewModel.AuditTotals, Mode=OneWay}">
                                                <Button x:Name="AuditRiskHighButton" Style="{StaticResource AiHubRiskMetricButtonStyle}"
                                                    BorderBrush="{ThemeResource AiHubRiskHighBorderBrush}"
                                                    Tag="High" Click="OnAuditRiskClick"
                                                    AutomationProperties.Name="{x:Bind FormatFilterCount(ViewModel.AuditOverviewHighLabel, ViewModel.AuditOverviewHighCount), Mode=OneWay}">
                                                    <Border Background="{ThemeResource AiHubRiskHighSurfaceBrush}" CornerRadius="8">
                                                        <Grid ColumnDefinitions="3,*">
                                                            <Border CornerRadius="8,0,0,8" Background="{ThemeResource AiHubRiskHighAccentBrush}" />
                                                            <Grid Grid.Column="1" Padding="14,12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="4">
                                                                <TextBlock Text="{x:Bind ViewModel.AuditOverviewHighCount, Mode=OneWay}" FontSize="28" FontWeight="SemiBold"
                                                                           FontFamily="{StaticResource KitMonoFontFamily}" Typography.NumeralAlignment="Tabular"
                                                                           Foreground="{ThemeResource AiHubRiskHighForegroundBrush}" />
                                                                <Border Grid.Column="1" Width="28" Height="28" CornerRadius="6" VerticalAlignment="Top"
                                                                        Background="{ThemeResource AiHubRiskHighIconBgBrush}">
                                                                    <FontIcon Glyph="&#xEA39;" FontSize="13" Foreground="{ThemeResource AiHubRiskHighForegroundBrush}"
                                                                              HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                                                </Border>
                                                                <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.AuditOverviewHighLabel}" FontSize="12" FontWeight="Medium"
                                                                           TextWrapping="Wrap" Foreground="{ThemeResource AiHubRiskHighForegroundBrush}" VerticalAlignment="Center" />
                                                                <FontIcon Grid.Row="1" Grid.Column="1" Glyph="&#xE76C;" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                          Foreground="{ThemeResource AiHubRiskHighForegroundBrush}" AutomationProperties.AccessibilityView="Raw" />
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                                <Button x:Name="AuditRiskMediumButton" Grid.Column="1" Style="{StaticResource AiHubRiskMetricButtonStyle}"
                                                    BorderBrush="{ThemeResource AiHubRiskMediumBorderBrush}"
                                                    Tag="Medium" Click="OnAuditRiskClick"
                                                    AutomationProperties.Name="{x:Bind FormatFilterCount(ViewModel.AuditOverviewMediumLabel, ViewModel.AuditOverviewMediumCount), Mode=OneWay}">
                                                    <Border Background="{ThemeResource AiHubRiskMediumSurfaceBrush}" CornerRadius="8">
                                                        <Grid ColumnDefinitions="3,*">
                                                            <Border CornerRadius="8,0,0,8" Background="{ThemeResource AiHubRiskMediumAccentBrush}" />
                                                            <Grid Grid.Column="1" Padding="14,12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="4">
                                                                <TextBlock Text="{x:Bind ViewModel.AuditOverviewMediumCount, Mode=OneWay}" FontSize="28" FontWeight="SemiBold"
                                                                           FontFamily="{StaticResource KitMonoFontFamily}" Typography.NumeralAlignment="Tabular"
                                                                           Foreground="{ThemeResource AiHubRiskMediumForegroundBrush}" />
                                                                <Border Grid.Column="1" Width="28" Height="28" CornerRadius="6" VerticalAlignment="Top"
                                                                        Background="{ThemeResource AiHubRiskMediumIconBgBrush}">
                                                                    <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{ThemeResource AiHubRiskMediumForegroundBrush}"
                                                                              HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                                                </Border>
                                                                <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.AuditOverviewMediumLabel}" FontSize="12" FontWeight="Medium"
                                                                           TextWrapping="Wrap" Foreground="{ThemeResource AiHubRiskMediumForegroundBrush}" VerticalAlignment="Center" />
                                                                <FontIcon Grid.Row="1" Grid.Column="1" Glyph="&#xE76C;" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                          Foreground="{ThemeResource AiHubRiskMediumForegroundBrush}" AutomationProperties.AccessibilityView="Raw" />
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                                <Button x:Name="AuditRiskLowButton" Grid.Column="2" Style="{StaticResource AiHubRiskMetricButtonStyle}"
                                                    BorderBrush="{ThemeResource AiHubRiskLowBorderBrush}"
                                                    Tag="Low" Click="OnAuditRiskClick"
                                                    AutomationProperties.Name="{x:Bind FormatFilterCount(ViewModel.AuditOverviewLowLabel, ViewModel.AuditOverviewLowCount), Mode=OneWay}">
                                                    <Border Background="{ThemeResource AiHubRiskLowSurfaceBrush}" CornerRadius="8">
                                                        <Grid ColumnDefinitions="3,*">
                                                            <Border CornerRadius="8,0,0,8" Background="{ThemeResource AiHubRiskLowAccentBrush}" />
                                                            <Grid Grid.Column="1" Padding="14,12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="4">
                                                                <TextBlock Text="{x:Bind ViewModel.AuditOverviewLowCount, Mode=OneWay}" FontSize="28" FontWeight="SemiBold"
                                                                           FontFamily="{StaticResource KitMonoFontFamily}" Typography.NumeralAlignment="Tabular"
                                                                           Foreground="{ThemeResource AiHubRiskLowForegroundBrush}" />
