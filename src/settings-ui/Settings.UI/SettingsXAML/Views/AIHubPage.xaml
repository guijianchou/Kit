                                                          ToolTipService.ToolTip="{x:Bind FormatFilterCount(ViewModel.MediumLabel, ViewModel.MediumCount), Mode=OneWay}"
                                                          Click="OnFilterClick" IsChecked="{x:Bind ViewModel.IsFilterMedium, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Ellipse Width="7" Height="7" Fill="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                                                    <TextBlock FontSize="12"><Run Text="{x:Bind ViewModel.MediumLabel, Mode=OneWay}" /><Run Text=" " /><Run Text="{x:Bind ViewModel.MediumCount, Mode=OneWay}" /></TextBlock>
                                                </StackPanel>
                                            </ToggleButton>
                                            <ToggleButton Tag="Low" Style="{StaticResource KitFilterPillToggleStyle}"
                                                          AutomationProperties.AutomationId="AIHub_FilterLowButton"
                                                          AutomationProperties.Name="{x:Bind FormatFilterCount(ViewModel.LowLabel, ViewModel.LowCount), Mode=OneWay}"
                                                          ToolTipService.ToolTip="{x:Bind FormatFilterCount(ViewModel.LowLabel, ViewModel.LowCount), Mode=OneWay}"
                                                          Click="OnFilterClick" IsChecked="{x:Bind ViewModel.IsFilterLow, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Ellipse Width="7" Height="7" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
