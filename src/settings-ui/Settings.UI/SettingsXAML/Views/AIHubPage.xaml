<?xml version="1.0" encoding="utf-8" ?>
<local:NavigablePage
    x:Class="Kit.Settings.UI.Views.AIHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kit.Settings.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Kit.Settings.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Kit.AIHubLib.Models"
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:viewModels="using:Kit.Settings.UI.ViewModels"
    xmlns:views="using:Kit.Settings.UI.Views"
    d:DataContext="{d:DesignInstance Type=viewModels:AIHubPageViewModel}"
    AutomationProperties.LandmarkType="Main"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <local:NavigablePage.Resources>

        <!-- Readiness / health styles per level: bound via AiReadinessStyle and HealthScore*Style, locked by AiHubSettingsTests + ModulePageSmoke contrast assertions -->
        <Style x:Key="ReadinessReadyStyle" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
        </Style>
        <Style x:Key="ReadinessDegradedStyle" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
        </Style>
        <Style x:Key="ReadinessUnverifiedStyle" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorAttentionBrush}" />
        </Style>
        <Style x:Key="ReadinessNotConfiguredStyle" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
        <Style x:Key="ReadinessDisabledStyle" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="HealthGoodStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{ThemeResource SystemFillColorSuccessBrush}" />
        </Style>
        <Style x:Key="HealthWarningStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{ThemeResource SystemFillColorCautionBrush}" />
        </Style>
        <Style x:Key="HealthCriticalStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
        <Style x:Key="HealthRingGoodStyle" TargetType="ProgressRing">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
        </Style>
        <Style x:Key="HealthRingWarningStyle" TargetType="ProgressRing">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
        </Style>
        <Style x:Key="HealthRingCriticalStyle" TargetType="ProgressRing">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>

        <Style x:Key="SafetyCardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SafetyCardDescStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="OptimizationItemContainerStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="OptimizationPresenterStyle" TargetType="ContentPresenter">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <DataTemplate x:Key="OptimizationInventoryScopeTemplate" x:DataType="viewModels:OptimizationInventoryScopeViewModel">
            <Border Margin="0,0,0,8" CornerRadius="{StaticResource OverlayCornerRadius}"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                          IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" HorizontalAlignment="Stretch" Padding="0,4">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" VerticalAlignment="Top" Margin="0,3,0,0"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}"
                                           FontFamily="{StaticResource KitMonoFontFamily}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <tkcontrols:WrapPanel HorizontalSpacing="10" VerticalSpacing="4">
                                    <TextBlock Text="{x:Bind SizeText}" FontWeight="SemiBold" FontFamily="{StaticResource KitMonoFontFamily}" />
                                    <TextBlock Text="{x:Bind FileSummary}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </tkcontrols:WrapPanel>
                                <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind SharePercent}" Height="4"
                                             AutomationProperties.Name="{x:Bind Name}" IsHitTestVisible="False"
                                             Visibility="{x:Bind HasMeasuredSize, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <tkcontrols:WrapPanel HorizontalSpacing="6" VerticalSpacing="4">
                                    <Border Style="{StaticResource KitStatusPillStyle}">
                                        <TextBlock Text="{x:Bind StateLabel}" FontSize="11" TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock Text="{x:Bind DispositionLabel}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </tkcontrols:WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel x:Name="InventoryScopeDetails" x:Load="{x:Bind HasBeenExpanded, Mode=OneWay}" Spacing="10" Padding="8,6">
                        <TextBlock Text="{x:Bind Reason}" TextWrapping="Wrap" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                        <TextBlock Text="{x:Bind Guidance}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind AgeSummary}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind HasMeasuredSize, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="{x:Bind ScanNotes}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind HasScanNotes, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <StackPanel Spacing="6" Visibility="{x:Bind HasTopFiles, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock x:Uid="AIHub_Inventory_LargestFilesTitle" FontWeight="SemiBold" FontSize="12" />
                            <ItemsControl ItemsSource="{x:Bind TopFiles}" HorizontalContentAlignment="Stretch">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:OptimizationInventoryFileViewModel">
                                        <Border Padding="10,8" Margin="0,0,0,4" CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Path}" FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                           FontFamily="{StaticResource KitMonoFontFamily}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <tkcontrols:WrapPanel HorizontalSpacing="12" VerticalSpacing="3">
                                                    <TextBlock Text="{x:Bind SizeText}" FontSize="12" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind ModifiedText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </tkcontrols:WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </Border>
        </DataTemplate>

        <!-- Leaf category item template inside groups -->
        <DataTemplate x:Key="OptimizationCategoryTemplate" x:DataType="viewModels:OptimizationCategoryViewModel">
            <Border Margin="0,0,0,6" CornerRadius="{StaticResource OverlayCornerRadius}" HorizontalAlignment="Stretch"
                    Visibility="{x:Bind HasVisibleItems, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                          Background="Transparent" BorderThickness="0">
                    <Expander.Header>
                        <Grid ColumnSpacing="12" RowSpacing="10" RowDefinitions="Auto,Auto" HorizontalAlignment="Stretch" MinHeight="48" Padding="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.ColumnSpan="2" Spacing="3" VerticalAlignment="Center">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13"
                                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                                    <Border Grid.Column="1" Style="{StaticResource KitStatusPillStyle}" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ReviewStatus}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{x:Bind LocationLabel}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind Destination}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Summary, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" FontFamily="{StaticResource KitMonoFontFamily}" />
                                <TextBlock Text="{x:Bind SelectionSummary, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Row="1" Grid.Column="1" Content="{x:Bind ActionLabel}" Command="{x:Bind ExecuteCommand}"
                                    IsEnabled="{x:Bind IsEnabled, Mode=OneWay}" VerticalAlignment="Center"
                                    Style="{StaticResource KitActionButtonStyle}" />
                        </Grid>
                    </Expander.Header>
                    <StackPanel x:Name="OptimizationLeafDetails" x:Load="{x:Bind HasBeenExpanded, Mode=OneWay}" Spacing="10" Padding="4,8">
                        <Border CornerRadius="4" Padding="8,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock Text="{x:Bind Destination}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="{StaticResource KitMonoFontFamily}" />
                        </Border>
                        <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind Progress, Mode=OneWay}"
                                     Visibility="{x:Bind HasProgress, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                     Style="{StaticResource KitProgressBarStyle}" />
                        <ListView ItemsSource="{x:Bind VisibleItems, Mode=OneWay}" SelectionMode="None" MaxHeight="320" HorizontalContentAlignment="Stretch"
                                  ItemContainerStyle="{StaticResource OptimizationItemContainerStyle}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:TempFileInfo">
                                    <Grid Padding="0,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                  IsEnabled="{x:Bind IsActionable, Mode=OneWay}"
                                                  AutomationProperties.Name="{x:Bind FileName}"
                                                  VerticalAlignment="Center" MinWidth="32" />
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind FilePath}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{x:Bind FilePath}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="{StaticResource KitMonoFontFamily}" />
                                            <TextBlock Text="{x:Bind DisplayReason}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind SizeFormatted}" FontWeight="Medium" FontSize="12" HorizontalAlignment="Right" FontFamily="{StaticResource KitMonoFontFamily}" />
                                            <Border Style="{StaticResource KitStatusPillStyle}" HorizontalAlignment="Right">
                                                <TextBlock Text="{x:Bind ReviewLabel}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Expander>
            </Border>
        </DataTemplate>

        <!-- Project item template -->
        <DataTemplate x:Key="OptimizationProjectTemplate" x:DataType="viewModels:OptimizationGroupViewModel">
            <Border Margin="0,0,0,6" CornerRadius="{StaticResource OverlayCornerRadius}" HorizontalAlignment="Stretch"
                    Visibility="{x:Bind HasVisibleItems, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                          Background="Transparent" BorderThickness="0">
                    <Expander.Header>
                        <Grid ColumnSpacing="12" RowSpacing="10" RowDefinitions="Auto,Auto" MinHeight="48" Padding="0,2" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.ColumnSpan="2" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Location}" />
                                <TextBlock Text="{x:Bind Summary}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="{x:Bind Size}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" FontFamily="{StaticResource KitMonoFontFamily}" />
                            <Button Grid.Row="1" Grid.Column="1" Content="{x:Bind CleanLabel}" Command="{x:Bind ExecuteCommand}"
                                    IsEnabled="{x:Bind IsEnabled, Mode=OneWay}" VerticalAlignment="Center"
                                    Style="{StaticResource KitActionButtonStyle}" />
                        </Grid>
                    </Expander.Header>
                    <StackPanel x:Name="OptimizationProjectDetails" x:Load="{x:Bind HasBeenExpanded, Mode=OneWay}" Spacing="8" Padding="4,8">
                        <Border CornerRadius="4" Padding="8,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock Text="{x:Bind Location}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="{StaticResource KitMonoFontFamily}" />
                        </Border>
                        <ListView ItemsSource="{x:Bind Categories}" ItemTemplate="{StaticResource OptimizationCategoryTemplate}"
                                  ItemContainerStyle="{StaticResource OptimizationItemContainerStyle}"
                                  SelectionMode="None" MaxHeight="360" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </StackPanel>
                </Expander>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FindingPreviewTemplate" x:DataType="models:AuditIssueEnhanced">
            <Button Tag="{x:Bind}" Click="OnFindingClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Style="{StaticResource SubtleButtonStyle}" Padding="0" AutomationProperties.Name="{x:Bind DisplayTitle}">
                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="4,14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Grid Width="32" Height="32" VerticalAlignment="Center">
                            <Border CornerRadius="8" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                    Visibility="{x:Bind IsHigh, Converter={StaticResource BoolToVisibilityConverter}}">
                                <FontIcon Glyph="&#xEA39;" FontSize="15" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border CornerRadius="8" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                    Visibility="{x:Bind IsMedium, Converter={StaticResource BoolToVisibilityConverter}}">
                                <FontIcon Glyph="&#xE7BA;" FontSize="15" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Visibility="{x:Bind IsLow, Converter={StaticResource BoolToVisibilityConverter}}">
                                <FontIcon Glyph="&#xE946;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind DisplayTitle}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"
                                       TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind DisplayTitle}" />
                            <TextBlock Text="{x:Bind CompactMetaText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border CornerRadius="4" Padding="8,2" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                    Visibility="{x:Bind IsHigh, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{x:Bind RiskBadgeText}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </Border>
                            <Border CornerRadius="4" Padding="8,2" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                    Visibility="{x:Bind IsMedium, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{x:Bind RiskBadgeText}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            </Border>
                            <Border CornerRadius="4" Padding="8,2" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Visibility="{x:Bind IsLow, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{x:Bind RiskBadgeText}" FontSize="11" FontWeight="Medium"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <FontIcon Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>
    </local:NavigablePage.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState><VisualState.StateTriggers><ui:ControlSizeTrigger TargetElement="{Binding ElementName=AuditResultsGrid}" MinWidth="700" /></VisualState.StateTriggers></VisualState>
                    <VisualState><VisualState.StateTriggers><ui:ControlSizeTrigger TargetElement="{Binding ElementName=AuditResultsGrid}" MaxWidth="700" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="AuditFindingsCard.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="AuditSummaryCard.(Grid.Row)" Value="1" />
                            <Setter Target="AuditSummaryCard.(Grid.Column)" Value="0" />
                            <Setter Target="AuditSummaryCard.(Grid.ColumnSpan)" Value="2" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup>
                    <VisualState><VisualState.StateTriggers><ui:ControlSizeTrigger TargetElement="{Binding ElementName=AuditOverviewGrid}" MinWidth="480" /></VisualState.StateTriggers></VisualState>
                    <VisualState><VisualState.StateTriggers><ui:ControlSizeTrigger TargetElement="{Binding ElementName=AuditOverviewGrid}" MaxWidth="480" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="AuditScoreCard.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="AuditScoreCard.HorizontalAlignment" Value="Left" />
                            <Setter Target="AuditScoreSummary.(Grid.Row)" Value="1" />
                            <Setter Target="AuditScoreSummary.(Grid.Column)" Value="0" />
                            <Setter Target="AuditScoreSummary.(Grid.ColumnSpan)" Value="2" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup>
                    <VisualState>
                        <VisualState.StateTriggers>
                            <ui:ControlSizeTrigger TargetElement="{Binding ElementName=AiReadinessBar}" MinWidth="640" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState>
                        <VisualState.StateTriggers>
                            <ui:ControlSizeTrigger TargetElement="{Binding ElementName=AiReadinessBar}" MaxWidth="640" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="AiReadinessActions.(Grid.Row)" Value="1" />
                            <Setter Target="AiReadinessActions.(Grid.Column)" Value="1" />
                            <Setter Target="AiReadinessActions.(Grid.ColumnSpan)" Value="2" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup>
                    <VisualState>
                        <VisualState.StateTriggers>
                            <ui:ControlSizeTrigger TargetElement="{Binding ElementName=AuditCommandHeader}" MinWidth="640" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="AuditHistoryDropDown.HorizontalAlignment" Value="Right" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState>
                        <VisualState.StateTriggers>
                            <ui:ControlSizeTrigger TargetElement="{Binding ElementName=AuditCommandHeader}" MaxWidth="640" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="AuditPrimaryCommands.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="AuditHistoryDropDown.(Grid.Row)" Value="1" />
                            <Setter Target="AuditHistoryDropDown.(Grid.Column)" Value="0" />
                            <Setter Target="AuditHistoryDropDown.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="AuditHistoryDropDown.HorizontalAlignment" Value="Left" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup>
                    <VisualState>
                        <VisualState.StateTriggers>
                            <ui:ControlSizeTrigger TargetElement="{Binding ElementName=OptimizationCommandHeader}" MinWidth="960" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="OptimizationCommandActions.HorizontalAlignment" Value="Right" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState>
                        <VisualState.StateTriggers>
                            <ui:ControlSizeTrigger TargetElement="{Binding ElementName=OptimizationCommandHeader}" MaxWidth="960" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="OptimizationCommandTitle.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="OptimizationCommandActions.(Grid.Row)" Value="1" />
                            <Setter Target="OptimizationCommandActions.(Grid.Column)" Value="0" />
                            <Setter Target="OptimizationCommandActions.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="OptimizationCommandActions.HorizontalAlignment" Value="Left" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup>
                    <VisualState>
                        <VisualState.StateTriggers>
                            <ui:ControlSizeTrigger TargetElement="{Binding ElementName=DownloadsCommandHeader}" MinWidth="720" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState>
                        <VisualState.StateTriggers>
                            <ui:ControlSizeTrigger TargetElement="{Binding ElementName=DownloadsCommandHeader}" MaxWidth="720" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="DownloadsCommandTitle.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="DownloadsCommandActions.(Grid.Row)" Value="1" />
                            <Setter Target="DownloadsCommandActions.(Grid.Column)" Value="0" />
                            <Setter Target="DownloadsCommandActions.(Grid.ColumnSpan)" Value="2" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup>
                    <VisualState>
                        <VisualState.StateTriggers>
                            <ui:ControlSizeTrigger TargetElement="{Binding ElementName=OptimizationReviewFilters}" MinWidth="560" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState>
                        <VisualState.StateTriggers>
                            <ui:ControlSizeTrigger TargetElement="{Binding ElementName=OptimizationReviewFilters}" MaxWidth="560" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="OptimizationSearchBox.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="OptimizationReviewFilter.(Grid.Row)" Value="1" />
                            <Setter Target="OptimizationReviewFilter.(Grid.Column)" Value="0" />
                            <Setter Target="OptimizationReviewFilter.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="OptimizationReviewFilter.HorizontalAlignment" Value="Stretch" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup>
                    <VisualState>
                        <VisualState.StateTriggers><ui:ControlSizeTrigger TargetElement="{Binding ElementName=InventoryHeader}" MinWidth="680" /></VisualState.StateTriggers>
                    </VisualState>
                    <VisualState>
                        <VisualState.StateTriggers><ui:ControlSizeTrigger TargetElement="{Binding ElementName=InventoryHeader}" MaxWidth="680" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="InventoryTitle.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="InventoryActions.(Grid.Row)" Value="1" />
                            <Setter Target="InventoryActions.(Grid.Column)" Value="0" />
                            <Setter Target="InventoryActions.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="InventoryActions.HorizontalAlignment" Value="Left" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup>
                    <VisualState>
                        <VisualState.StateTriggers><ui:ControlSizeTrigger TargetElement="{Binding ElementName=InventoryMetricsGrid}" MinWidth="600" /></VisualState.StateTriggers>
                    </VisualState>
                    <VisualState>
