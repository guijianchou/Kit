<UserControl
    x:Class="Kit.Settings.UI.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Kit.Settings.UI.Services"
    xmlns:animatedVisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:controls="using:Kit.Settings.UI.Controls"
    xmlns:converters="using:Kit.Settings.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Kit.Settings.UI.Helpers"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:ic="using:Microsoft.Xaml.Interactions.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Kit.Settings.UI.ViewModels"
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:views="using:Kit.Settings.UI.Views"
    mc:Ignorable="d"
    FontFamily="{ThemeResource KitUiFontFamily}"
    FontSize="{ThemeResource KitFontSize14}" services:TypographyResources.BaseFontSize="14">
    <UserControl.Resources>
        <converters:IconConverter x:Key="IconConverter" />
        <converters:SearchSuggestionTemplateSelector
            x:Key="SearchSuggestionTemplateSelector"
            DefaultSuggestionTemplate="{StaticResource DefaultSearchResultTemplate}"
            NoResultsSuggestionTemplate="{StaticResource NoResultSearchResultTemplate}"
            ShowAllSuggestionTemplate="{StaticResource ShowAllSearchResultTemplate}" />
        <DataTemplate x:Key="DefaultSearchResultTemplate" x:DataType="models:SuggestionItem">
            <Grid Padding="10,6" CornerRadius="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="28"
                    Height="28"
                    CornerRadius="6"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    VerticalAlignment="Center">
                    <Viewbox
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="Uniform">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{x:Bind Icon, Converter={StaticResource IconConverter}, ConverterParameter=&#xE713;}" />
                    </Viewbox>
                </Border>
                <StackPanel
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Header}" FontWeight="SemiBold" FontSize="{ThemeResource KitFontSize13_5}" services:TypographyResources.BaseFontSize="13.5" />
                    <TextBlock
                        FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Subtitle}"
                        Visibility="{x:Bind Subtitle, Converter={StaticResource StringVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="NoResultSearchResultTemplate" x:DataType="models:SuggestionItem">
            <Grid>
                <TextBlock
                    Margin="8"
                    HorizontalAlignment="Center"
                    Text="{x:Bind Header}"
                    TextAlignment="Center" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ShowAllSearchResultTemplate" x:DataType="models:SuggestionItem">
            <Grid Padding="8,6">
                <Rectangle
                    Height="1"
                    Margin="0,-6,0,6"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <TextBlock
                    x:Uid="Shell_Search_ShowAll" services:RuntimeLocalization.Uid="Shell_Search_ShowAll"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    TextAlignment="Center" />
            </Grid>
        </DataTemplate>
        <Style x:Key="AiUsageFlyoutPresenterStyle" TargetType="FlyoutPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="300" />
            <Setter Property="MaxWidth" Value="456" />
            <Setter Property="MaxHeight" Value="664" />
            <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style x:Key="AiUsageMetricLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource KitMetricTileLabelStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="AiUsageScopeButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontSize" Value="{ThemeResource KitFontSize12}" />
            <Setter Property="services:TypographyResources.BaseFontSize" Value="12" />
        </Style>
        <Style x:Key="AiUsageTabButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="6,5,6,3" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontSize" Value="{ThemeResource KitFontSize12}" />
            <Setter Property="services:TypographyResources.BaseFontSize" Value="12" />
        </Style>
    </UserControl.Resources>
    <Grid x:Name="RootGrid" Background="Transparent">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger TargetElement="{Binding ElementName=AppTitleBar}" MinWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SearchBoxContainer.Width" Value="516" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger TargetElement="{Binding ElementName=AppTitleBar}" MaxWidth="900" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            IsTabStop="False"
            Loaded="AppTitleBar_Loaded"
            PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <BitmapIconSource ShowAsMonochrome="False" UriSource="ms-appx:///Assets/Settings/icon.ico" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <Grid x:Name="SearchBoxContainer" MinWidth="160" MaxWidth="516">
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        x:Uid="Shell_SearchBox" services:RuntimeLocalization.Uid="Shell_SearchBox"
                        MinWidth="0"
                        MaxWidth="516"
                        MinHeight="32"
                        CornerRadius="16"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Loaded="SearchBox_Loaded"
                        SizeChanged="SearchBox_SizeChanged"
                        GotFocus="SearchBox_GotFocus"
                        ItemTemplateSelector="{StaticResource SearchSuggestionTemplateSelector}"
                        QueryIcon="Find"
                        QuerySubmitted="SearchBox_QuerySubmitted"
                        SuggestionChosen="SearchBox_SuggestionChosen"
                        TextChanged="SearchBox_TextChanged"
                        TextMemberPath="Header"
                        UpdateTextOnSelect="False" />
                </Grid>
            </TitleBar.Content>
        </TitleBar>
        <NavigationView
            x:Name="navigationView"
            Grid.Row="1"
            Canvas.ZIndex="0"
            DisplayModeChanged="NavigationView_DisplayModeChanged"
            IsBackButtonVisible="Collapsed"
            IsBackEnabled="{x:Bind ViewModel.IsBackEnabled, Mode=OneWay}"
            IsPaneOpen="{x:Bind _navigationPaneState.IsPaneOpen}"
            Loaded="NavigationView_Loaded"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            ItemInvoked="NavigationView_AiUsageInvoked"
            OpenPaneLength="280"
            CompactPaneLength="48"
            CompactModeThresholdWidth="640"
            ExpandedModeThresholdWidth="1008"
            PaneClosed="NavigationView_PaneClosed"
            PaneDisplayMode="Auto"
            PaneOpened="NavigationView_PaneOpened"
            SelectedItem="{x:Bind ViewModel.Selected, Mode=OneWay}">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="DashboardNavigationItem"
                    x:Uid="Shell_Dashboard" services:RuntimeLocalization.Uid="Shell_Dashboard"
                    AutomationProperties.AutomationId="DashboardNavItem"
                    Icon="{ui:FontIcon Glyph=&#xE80F;}" />

                <NavigationViewItemSeparator />

                <NavigationViewItem
                    x:Name="AIHubNavigationItem"
                    x:Uid="Shell_AIHub" services:RuntimeLocalization.Uid="Shell_AIHub"
                    AutomationProperties.AutomationId="AIHubNavItem">
                    <NavigationViewItem.Icon>
                        <ImageIcon Width="20" Height="20" Source="ms-appx:///Assets/Settings/Navigation/AiHub.png" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            Style="{StaticResource AttentionDotInfoBadgeStyle}"
                            Visibility="{x:Bind ViewModel.AuditProgress.IsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="AwakeNavigationItem"
                    x:Uid="Shell_Awake" services:RuntimeLocalization.Uid="Shell_Awake"
                    AutomationProperties.AutomationId="AwakeNavItem">
                    <NavigationViewItem.Icon>
                        <ImageIcon Width="20" Height="20" Source="ms-appx:///Assets/Settings/Navigation/Awake.png" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            Style="{StaticResource SuccessDotInfoBadgeStyle}"
                            Visibility="{x:Bind ViewModel.Badges.IsAwakeActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="LightSwitchNavigationItem"
                    x:Uid="Shell_LightSwitch" services:RuntimeLocalization.Uid="Shell_LightSwitch"
                    AutomationProperties.AutomationId="LightSwitchNavItem">
                    <NavigationViewItem.Icon>
                        <ImageIcon Width="20" Height="20" Source="ms-appx:///Assets/Settings/Navigation/LightSwitch.png" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="LocalserverNavigationItem"
                    x:Uid="Shell_Localserver" services:RuntimeLocalization.Uid="Shell_Localserver"
                    AutomationProperties.AutomationId="LocalserverNavItem">
                    <NavigationViewItem.Icon>
                        <ImageIcon Width="20" Height="20" Source="ms-appx:///Assets/Settings/Navigation/Localserver.png" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            Style="{StaticResource SuccessValueInfoBadgeStyle}"
                            Value="{x:Bind ViewModel.Badges.RunningLocalserverCount, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.Badges.HasRunningLocalservers, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="NetMapNavigationItem"
                    x:Uid="Shell_NetMap" services:RuntimeLocalization.Uid="Shell_NetMap"
                    AutomationProperties.AutomationId="NetMapNavItem">
                    <NavigationViewItem.Icon>
                        <ImageIcon Width="20" Height="20" Source="ms-appx:///Assets/Settings/Navigation/NetMap.png" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            Style="{StaticResource SuccessDotInfoBadgeStyle}"
                            Visibility="{x:Bind ViewModel.Badges.IsNetMapDetecting, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="UDPtestNavigationItem"
                    x:Uid="Shell_UDPtest" services:RuntimeLocalization.Uid="Shell_UDPtest"
                    AutomationProperties.AutomationId="UDPtestNavItem">
                    <NavigationViewItem.Icon>
                        <ImageIcon Width="20" Height="20" Source="ms-appx:///Assets/Settings/Navigation/UDPtest.png" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            Style="{StaticResource SuccessDotInfoBadgeStyle}"
                            Visibility="{x:Bind ViewModel.Badges.IsUdpMonitoring, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="WingetNavigationItem"
                    x:Uid="Shell_Winget" services:RuntimeLocalization.Uid="Shell_Winget"
                    AutomationProperties.AutomationId="WingetNavItem">
                    <NavigationViewItem.Icon>
                        <ImageIcon Width="20" Height="20" Source="ms-appx:///Assets/Settings/Navigation/Winget.png" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            Style="{StaticResource AttentionValueInfoBadgeStyle}"
                            Value="{x:Bind ViewModel.Badges.WingetUpdateCount, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.Badges.HasWingetUpdates, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>

            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="AiUsageNavigationItem"
                    x:Uid="Shell_AiUsage" services:RuntimeLocalization.Uid="Shell_AiUsage"
                    AutomationProperties.AutomationId="ShellAiUsage"
                    SelectsOnInvoked="False"
                    Icon="{ui:FontIcon Glyph=&#xE9D9;}">
                    <FlyoutBase.AttachedFlyout>
                        <Flyout
                            x:Name="AiUsageFlyout"
                            Placement="TopEdgeAlignedLeft"
                            ShouldConstrainToRootBounds="False"
                            FlyoutPresenterStyle="{StaticResource AiUsageFlyoutPresenterStyle}"
                            Opening="AiUsageFlyout_Opening"
                            Opened="AiUsageFlyout_Opened"
                            Closed="AiUsageFlyout_Closed">
                            <Grid x:Name="AiUsageContent" Width="456" Height="636" Background="Transparent" Loaded="AiUsageContent_Loaded">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Subtle translucent accent wash behind the pinned header -->
                                <Border
                                    Grid.RowSpan="2"
                                    Background="{ThemeResource KitHeroGradientBrush}"
                                    IsHitTestVisible="False" />

                                <!-- Row 0: Pinned Header + Scope + Live Banner -->
                                <StackPanel Padding="16,14,16,10" Spacing="10">
                                    <Grid x:Name="AiUsageHeaderGrid" ColumnSpacing="8" RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <tkcontrols:WrapPanel x:Name="AiUsageHeaderTitle" Orientation="Horizontal" HorizontalSpacing="8" VerticalSpacing="6" VerticalAlignment="Center">
                                            <Border
                                                Width="26"
                                                Height="26"
                                                CornerRadius="7"
                                                Background="{ThemeResource BadgeInfoBackgroundBrush}"
                                                VerticalAlignment="Center">
                                                <FontIcon
                                                    FontSize="13"
                                                    Glyph="&#xE9D9;"
                                                    Foreground="{ThemeResource BadgeInfoForegroundBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock
                                                x:Uid="Shell_AiUsageTitle"
                                                services:RuntimeLocalization.Uid="Shell_AiUsageTitle"
                                                FontWeight="SemiBold"
                                                FontSize="{ThemeResource KitFontSize18}"
                                                services:TypographyResources.BaseFontSize="18"
                                                VerticalAlignment="Center" />
                                            <Border
                                                Background="{ThemeResource BadgeInfoBackgroundBrush}"
                                                BorderBrush="{ThemeResource KitAccentTintBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="8,2"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    x:Uid="Shell_AiUsageCodexBadge"
                                                    services:RuntimeLocalization.Uid="Shell_AiUsageCodexBadge"
                                                    FontSize="{ThemeResource KitFontSize12}"
                                                    services:TypographyResources.BaseFontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource BadgeInfoForegroundBrush}" />
                                            </Border>
                                        </tkcontrols:WrapPanel>
                                        <StackPanel x:Name="AiUsageHeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Border
                                                x:Name="AiUsageLivePill"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="8,3"
                                                VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                    <Ellipse
                                                        x:Name="AiUsageLiveDot"
                                                        Width="6"
                                                        Height="6"
                                                        Fill="{ThemeResource TextFillColorTertiaryBrush}"
                                                        VerticalAlignment="Center" />
                                                    <TextBlock
                                                        x:Name="AiUsageLiveStatusText"
                                                        FontSize="{ThemeResource KitFontSize12}"
                                                        services:TypographyResources.BaseFontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <Button
                                                x:Name="AiUsageRefreshButton"
                                                Style="{StaticResource KitCompactIconButtonStyle}"
                                                Click="AiUsageRefreshButton_Click"
                                                AutomationProperties.AutomationId="AiUsageRefreshButton">
                                                <FontIcon FontSize="13" Glyph="&#xE72C;" />
                                            </Button>
                                            <Button
                                                x:Name="AiUsageClearButton"
                                                Style="{StaticResource KitCompactIconButtonStyle}"
                                                Click="AiUsageClearButton_Click"
                                                AutomationProperties.AutomationId="AiUsageClearButton">
                                                <FontIcon FontSize="13" Glyph="&#xE74D;" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Inline Clear Confirmation -->
                                    <Border
                                        x:Name="AiUsageClearConfirmBar"
                                        Visibility="Collapsed"
                                        Background="{ThemeResource BadgeCriticalBackgroundBrush}"
                                        BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource ControlCornerRadius}"
                                        Padding="10,8">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                x:Uid="Shell_AiUsageClearConfirmPrompt"
                                                services:RuntimeLocalization.Uid="Shell_AiUsageClearConfirmPrompt"
                                                FontSize="{ThemeResource KitFontSize12}"
                                                services:TypographyResources.BaseFontSize="12"
                                                Foreground="{ThemeResource BadgeCriticalForegroundBrush}"
                                                TextWrapping="Wrap"
                                                VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Button
                                                    x:Name="AiUsageClearConfirmButton"
                                                    x:Uid="Shell_AiUsageClearConfirmButton"
                                                    services:RuntimeLocalization.Uid="Shell_AiUsageClearConfirmButton"
                                                    Style="{StaticResource KitDangerActionButtonStyle}"
                                                    MinHeight="26"
                                                    Padding="10,2"
                                                    FontSize="{ThemeResource KitFontSize12}"
                                                    services:TypographyResources.BaseFontSize="12"
                                                    Click="AiUsageClearConfirmButton_Click" />
                                                <Button
                                                    x:Name="AiUsageClearCancelButton"
                                                    x:Uid="Shell_AiUsageClearCancelButton"
                                                    services:RuntimeLocalization.Uid="Shell_AiUsageClearCancelButton"
                                                    Style="{StaticResource KitCompactToolbarButtonStyle}"
                                                    Height="26"
                                                    MinHeight="26"
                                                    Click="AiUsageClearCancelButton_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Conditional Pi Notice (only shown when Pi kernel is active) -->
                                    <Border
                                        x:Name="AiUsagePiNoticeBar"
                                        Visibility="Collapsed"
                                        Background="{ThemeResource BadgeWarningBackgroundBrush}"
                                        BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource ControlCornerRadius}"
                                        Padding="10,7">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon FontSize="13" Glyph="&#xE946;" Foreground="{ThemeResource BadgeWarningForegroundBrush}" VerticalAlignment="Center" />
                                            <TextBlock
                                                Grid.Column="1"
                                                x:Uid="Shell_AiUsagePiNotice"
                                                services:RuntimeLocalization.Uid="Shell_AiUsagePiNotice"
                                                FontSize="{ThemeResource KitFontSize12}"
                                                services:TypographyResources.BaseFontSize="12"
                                                Foreground="{ThemeResource BadgeWarningForegroundBrush}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>

                                    <!-- Time Range Pills -->
                                    <tkcontrols:WrapPanel Orientation="Horizontal" HorizontalSpacing="5" VerticalSpacing="4">
                                        <Button
                                            x:Name="AiUsageRangeAllButton"
                                            x:Uid="Shell_AiUsageRangeAll"
                                            services:RuntimeLocalization.Uid="Shell_AiUsageRangeAll"
                                            Tag="AllTime"
                                            Style="{StaticResource AiUsageScopeButtonStyle}"
                                            Click="AiUsageRangeButton_Click" />
                                        <Button
                                            x:Name="AiUsageRangeSessionButton"
                                            x:Uid="Shell_AiUsageRangeSession"
                                            services:RuntimeLocalization.Uid="Shell_AiUsageRangeSession"
                                            Tag="Session"
                                            Style="{StaticResource AiUsageScopeButtonStyle}"
                                            Click="AiUsageRangeButton_Click" />
                                        <Button
                                            x:Name="AiUsageRangeTodayButton"
                                            x:Uid="Shell_AiUsageRangeToday"
                                            services:RuntimeLocalization.Uid="Shell_AiUsageRangeToday"
                                            Tag="Today"
                                            Style="{StaticResource AiUsageScopeButtonStyle}"
                                            Click="AiUsageRangeButton_Click" />
                                        <Button
                                            x:Name="AiUsageRange7dButton"
                                            x:Uid="Shell_AiUsageRange7d"
                                            services:RuntimeLocalization.Uid="Shell_AiUsageRange7d"
                                            Tag="Last7Days"
                                            Style="{StaticResource AiUsageScopeButtonStyle}"
                                            Click="AiUsageRangeButton_Click" />
                                        <Button
                                            x:Name="AiUsageRange30dButton"
                                            x:Uid="Shell_AiUsageRange30d"
                                            services:RuntimeLocalization.Uid="Shell_AiUsageRange30d"
                                            Tag="Last30Days"
                                            Style="{StaticResource AiUsageScopeButtonStyle}"
                                            Click="AiUsageRangeButton_Click" />
                                    </tkcontrols:WrapPanel>

                                    <!-- Live Running Banner (shown on Overview/Models while Codex is running) -->
                                    <Button
                                        x:Name="AiUsageLiveBannerButton"
                                        Visibility="Collapsed"
                                        Style="{StaticResource KitInteractiveCardButtonStyle}"
                                        BorderBrush="{ThemeResource KitUsageDiskBrush}"
                                        Padding="10,8"
                                        Click="AiUsageLiveBannerButton_Click">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" Fill="{ThemeResource KitUsageDiskBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock
                                                    x:Name="AiUsageLiveBannerTitleText"
                                                    FontSize="{ThemeResource KitFontSize13}"
                                                    services:TypographyResources.BaseFontSize="13"
                                                    FontWeight="SemiBold"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    x:Name="AiUsageLiveBannerDetailText"
                                                    FontSize="{ThemeResource KitFontSize12}"
                                                    services:TypographyResources.BaseFontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border
                                                Grid.Column="2"
                                                Background="{ThemeResource BadgeInfoBackgroundBrush}"
                                                CornerRadius="8"
                                                Padding="7,2"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    x:Name="AiUsageLiveBannerElapsedText"
                                                    FontFamily="{StaticResource KitMonoFontFamily}"
                                                    FontSize="{ThemeResource KitFontSize12}"
                                                    services:TypographyResources.BaseFontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource BadgeInfoForegroundBrush}" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </StackPanel>

                                <!-- Row 1: 3-Tab Segmented Switcher -->
                                <Border
                                    Grid.Row="1"
                                    Padding="16,0,16,10"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1">
                                    <Border
                                        x:Name="AiUsageTabTrackBorder"
                                        Background="Transparent"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="4">
                                        <Grid ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                x:Name="AiUsageTabOverviewButton"
                                                Tag="Overview"
                                                Style="{StaticResource AiUsageTabButtonStyle}"
                                                Click="AiUsageTabButton_Click">
                                                <Grid RowSpacing="3">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid ColumnSpacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <FontIcon x:Name="AiUsageTabOverviewIcon" FontSize="12" Glyph="&#xE9D9;" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="AiUsageTabOverviewText" Grid.Column="1" FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <Border x:Name="AiUsageTabOverviewIndicator" Grid.Row="1" Width="28" Height="2.5" CornerRadius="1.25" HorizontalAlignment="Center" Visibility="Collapsed" />
                                                </Grid>
                                            </Button>
                                            <Button
                                                x:Name="AiUsageTabModelsButton"
                                                Grid.Column="1"
                                                Tag="Models"
                                                Style="{StaticResource AiUsageTabButtonStyle}"
                                                Click="AiUsageTabButton_Click">
                                                <Grid RowSpacing="3">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid ColumnSpacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <FontIcon x:Name="AiUsageTabModelsIcon" FontSize="12" Glyph="&#xF158;" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="AiUsageTabModelsText" Grid.Column="1" FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <Border x:Name="AiUsageTabModelsIndicator" Grid.Row="1" Width="28" Height="2.5" CornerRadius="1.25" HorizontalAlignment="Center" Visibility="Collapsed" />
                                                </Grid>
                                            </Button>
                                            <Button
                                                x:Name="AiUsageTabActivityButton"
                                                Grid.Column="2"
                                                Tag="Activity"
                                                Style="{StaticResource AiUsageTabButtonStyle}"
                                                Click="AiUsageTabButton_Click">
                                                <Grid RowSpacing="3">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid ColumnSpacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <FontIcon x:Name="AiUsageTabActivityIcon" FontSize="12" Glyph="&#xE95E;" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="AiUsageTabActivityText" Grid.Column="1" FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <Border x:Name="AiUsageTabActivityIndicator" Grid.Row="1" Width="28" Height="2.5" CornerRadius="1.25" HorizontalAlignment="Center" Visibility="Collapsed" />
                                                </Grid>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Border>

                                <!-- Row 2: Scrollable Content Body -->
                                <ScrollViewer
                                    x:Name="AiUsageBodyScrollViewer"
                                    Grid.Row="2"
                                    HorizontalScrollMode="Disabled"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <Grid Padding="16,12,16,12">
                                        <!-- Overview Tab -->
                                        <StackPanel x:Name="AiUsageOverviewView" Spacing="10">
                                            <!-- 2x2 Hero KPI Tiles -->
                                            <Grid ColumnSpacing="8" RowSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Border x:Name="AiUsageKpiTokensTile" Style="{StaticResource KitMetricTileBorderStyle}">
                                                    <StackPanel Spacing="3">
                                                        <Grid ColumnSpacing="7" Margin="0,0,0,3">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                            <FontIcon x:Name="AiUsageTokensMetricIcon" FontSize="15" Glyph="&#xE8D4;" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" x:Uid="Shell_AiUsageTotalTokensLabel" services:RuntimeLocalization.Uid="Shell_AiUsageTotalTokensLabel" Style="{StaticResource AiUsageMetricLabelStyle}" />
                                                        </Grid>
                                                        <TextBlock
                                                            x:Name="AiUsageTotalTokensText"
                                                            Foreground="{ThemeResource KitUsageCpuBrush}"
                                                            Style="{StaticResource KitMetricTileValueStyle}" />
                                                        <TextBlock
                                                            x:Name="AiUsageTotalTokensSubText"
                                                            FontSize="{ThemeResource KitFontSize12}"
                                                            services:TypographyResources.BaseFontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>

                                                <Border x:Name="AiUsageKpiCacheTile" Grid.Column="1" Style="{StaticResource KitMetricTileBorderStyle}">
                                                    <StackPanel Spacing="3">
                                                        <Grid ColumnSpacing="7" Margin="0,0,0,3">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                            <FontIcon x:Name="AiUsageCacheMetricIcon" FontSize="15" Glyph="&#xE8AB;" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" x:Uid="Shell_AiUsageCacheHitLabel" services:RuntimeLocalization.Uid="Shell_AiUsageCacheHitLabel" Style="{StaticResource AiUsageMetricLabelStyle}" />
                                                        </Grid>
                                                        <TextBlock
                                                            x:Name="AiUsageCacheHitRateText"
                                                            Foreground="{ThemeResource KitUsageDiskBrush}"
                                                            Style="{StaticResource KitMetricTileValueStyle}" />
                                                        <TextBlock
                                                            x:Name="AiUsageCacheHitSubText"
                                                            FontSize="{ThemeResource KitFontSize12}"
                                                            services:TypographyResources.BaseFontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>

                                                <Border x:Name="AiUsageKpiTasksTile" Grid.Row="1" Style="{StaticResource KitMetricTileBorderStyle}">
                                                    <StackPanel Spacing="3">
                                                        <Grid ColumnSpacing="7" Margin="0,0,0,3">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                            <FontIcon x:Name="AiUsageTasksMetricIcon" FontSize="15" Glyph="&#xE9D9;" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" x:Uid="Shell_AiUsageTasksCallsLabel" services:RuntimeLocalization.Uid="Shell_AiUsageTasksCallsLabel" Style="{StaticResource AiUsageMetricLabelStyle}" />
                                                        </Grid>
                                                        <TextBlock
                                                            x:Name="AiUsageTasksCountValueText"
                                                            Foreground="{ThemeResource KitUsageMemoryBrush}"
                                                            Style="{StaticResource KitMetricTileValueStyle}" />
                                                        <TextBlock
                                                            x:Name="AiUsageCallsSplitText"
                                                            FontSize="{ThemeResource KitFontSize12}"
                                                            services:TypographyResources.BaseFontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>

                                                <Border x:Name="AiUsageKpiLatencyTile" Grid.Row="1" Grid.Column="1" Style="{StaticResource KitMetricTileBorderStyle}">
                                                    <StackPanel Spacing="3">
                                                        <Grid ColumnSpacing="7" Margin="0,0,0,3">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                            <FontIcon x:Name="AiUsageLatencyMetricIcon" FontSize="15" Glyph="&#xE823;" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" x:Uid="Shell_AiUsageAvgLatencyLabel" services:RuntimeLocalization.Uid="Shell_AiUsageAvgLatencyLabel" Style="{StaticResource AiUsageMetricLabelStyle}" />
                                                        </Grid>
                                                        <TextBlock
                                                            x:Name="AiUsageAvgLatencyText"
                                                            Foreground="{ThemeResource KitDataSeriesUdpBrush}"
                                                            Style="{StaticResource KitMetricTileValueStyle}" />
                                                        <TextBlock
                                                            x:Name="AiUsageDurationSubText"
                                                            FontSize="{ThemeResource KitFontSize12}"
                                                            services:TypographyResources.BaseFontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Codex Token Breakdown Card -->
                                            <Border x:Name="AiUsageBreakdownCard" Style="{StaticResource KitCardSurfaceStyle}" Padding="12,10">
                                                <StackPanel Spacing="8">
                                                    <TextBlock
                                                        x:Uid="Shell_AiUsageTokenBreakdownTitle"
                                                        services:RuntimeLocalization.Uid="Shell_AiUsageTokenBreakdownTitle"
                                                        FontSize="{ThemeResource KitFontSize13}"
                                                        services:TypographyResources.BaseFontSize="13"
                                                        FontWeight="SemiBold" />

                                                    <!-- Proportional 3-Segment Bar (Uncached Input / Cached Input / Output) -->
                                                    <StackPanel x:Name="AiUsageProportionSection" Spacing="6" Visibility="Collapsed">
                                                        <Border Height="8" CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                            <Grid x:Name="AiUsageProportionBarGrid" ColumnSpacing="2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition x:Name="AiUsageUncachedBarCol" Width="0*" />
                                                                    <ColumnDefinition x:Name="AiUsageCachedBarCol" Width="0*" />
                                                                    <ColumnDefinition x:Name="AiUsageOutputBarCol" Width="0*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Background="{ThemeResource KitUsageCpuBrush}" CornerRadius="4,0,0,4" />
                                                                <Border Grid.Column="1" Background="{ThemeResource KitUsageDiskBrush}" CornerRadius="2" />
                                                                <Border Grid.Column="2" Background="{ThemeResource KitUsageMemoryBrush}" CornerRadius="0,4,4,0" />
                                                            </Grid>
                                                        </Border>
                                                        <tkcontrols:WrapPanel Orientation="Horizontal" HorizontalSpacing="12" VerticalSpacing="4">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <Ellipse Width="7" Height="7" Fill="{ThemeResource KitUsageCpuBrush}" VerticalAlignment="Center" />
                                                                <TextBlock x:Name="AiUsageUncachedLegendText" x:Uid="Shell_AiUsageUncachedLegend" services:RuntimeLocalization.Uid="Shell_AiUsageUncachedLegend" FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <Ellipse Width="7" Height="7" Fill="{ThemeResource KitUsageDiskBrush}" VerticalAlignment="Center" />
                                                                <TextBlock x:Name="AiUsageCachedLegendText" x:Uid="Shell_AiUsageCachedLegend" services:RuntimeLocalization.Uid="Shell_AiUsageCachedLegend" FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <Ellipse Width="7" Height="7" Fill="{ThemeResource KitUsageMemoryBrush}" VerticalAlignment="Center" />
                                                                <TextBlock x:Name="AiUsageOutputLegendText" x:Uid="Shell_AiUsageOutputLegend" services:RuntimeLocalization.Uid="Shell_AiUsageOutputLegend" FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>
                                                        </tkcontrols:WrapPanel>
                                                    </StackPanel>

                                                    <!-- Input Tokens -->
                                                    <Grid ColumnSpacing="10" RowSpacing="2">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Ellipse Width="6" Height="6" Fill="{ThemeResource KitUsageCpuBrush}" VerticalAlignment="Center" />
                                                            <TextBlock x:Uid="Shell_AiUsageInput" services:RuntimeLocalization.Uid="Shell_AiUsageInput" FontSize="{ThemeResource KitFontSize14}" services:TypographyResources.BaseFontSize="14" />
                                                        </StackPanel>
                                                        <TextBlock x:Name="AiUsageInputText" Grid.Column="1" TextAlignment="Right" TextWrapping="Wrap" FontFamily="{StaticResource KitMonoFontFamily}" FontSize="{ThemeResource KitFontSize14}" services:TypographyResources.BaseFontSize="14" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                                                        <TextBlock x:Name="AiUsageInputCoverageText" Grid.Row="1" Grid.ColumnSpan="2" TextAlignment="Right" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12" />
                                                    </Grid>

                                                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                                    <!-- Cached Input Tokens -->
                                                    <Grid ColumnSpacing="10" RowSpacing="2">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Ellipse Width="6" Height="6" Fill="{ThemeResource KitUsageDiskBrush}" VerticalAlignment="Center" />
                                                            <TextBlock x:Uid="Shell_AiUsageCacheRead" services:RuntimeLocalization.Uid="Shell_AiUsageCacheRead" FontSize="{ThemeResource KitFontSize14}" services:TypographyResources.BaseFontSize="14" />
                                                        </StackPanel>
                                                        <TextBlock x:Name="AiUsageCacheReadText" Grid.Column="1" TextAlignment="Right" TextWrapping="Wrap" FontFamily="{StaticResource KitMonoFontFamily}" FontSize="{ThemeResource KitFontSize14}" services:TypographyResources.BaseFontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource KitUsageDiskBrush}" Typography.NumeralAlignment="Tabular" />
                                                        <TextBlock x:Name="AiUsageCacheReadCoverageText" Grid.Row="1" Grid.ColumnSpan="2" TextAlignment="Right" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12" />
                                                    </Grid>

                                                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                                    <!-- Output Tokens -->
                                                    <Grid ColumnSpacing="10" RowSpacing="2">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Ellipse Width="6" Height="6" Fill="{ThemeResource KitUsageMemoryBrush}" VerticalAlignment="Center" />
                                                            <TextBlock x:Uid="Shell_AiUsageOutput" services:RuntimeLocalization.Uid="Shell_AiUsageOutput" FontSize="{ThemeResource KitFontSize14}" services:TypographyResources.BaseFontSize="14" />
                                                        </StackPanel>
                                                        <TextBlock x:Name="AiUsageOutputText" Grid.Column="1" TextAlignment="Right" TextWrapping="Wrap" FontFamily="{StaticResource KitMonoFontFamily}" FontSize="{ThemeResource KitFontSize14}" services:TypographyResources.BaseFontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource KitUsageMemoryBrush}" Typography.NumeralAlignment="Tabular" />
                                                        <TextBlock x:Name="AiUsageOutputCoverageText" Grid.Row="1" Grid.ColumnSpan="2" TextAlignment="Right" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Task Outcome Summary Card -->
                                            <Border x:Name="AiUsageOutcomeCard" Style="{StaticResource KitCardSurfaceStyle}" Padding="12,10">
                                                <StackPanel Spacing="6">
                                                    <TextBlock
                                                        x:Name="AiUsageTasksText"
                                                        FontSize="{ThemeResource KitFontSize13}"
                                                        services:TypographyResources.BaseFontSize="13"
                                                        FontWeight="SemiBold"
                                                        TextWrapping="Wrap" />
                                                    <tkcontrols:WrapPanel
                                                        x:Name="AiUsageOutcomePillsPanel"
                                                        Orientation="Horizontal"
                                                        HorizontalSpacing="6"
                                                        VerticalSpacing="5"
                                                        Visibility="Collapsed" />
                                                    <TextBlock
                                                        x:Name="AiUsageOutcomesText"
                                                        FontSize="{ThemeResource KitFontSize12}"
                                                        services:TypographyResources.BaseFontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Top Models Preview Card -->
                                            <Border x:Name="AiUsageTopModelsCard" Style="{StaticResource KitCardSurfaceStyle}" Padding="12,10" Visibility="Collapsed">
                                                <StackPanel Spacing="8">
                                                    <Grid>
                                                        <TextBlock
                                                            x:Uid="Shell_AiUsageTopModelsTitle"
                                                            services:RuntimeLocalization.Uid="Shell_AiUsageTopModelsTitle"
                                                            FontSize="{ThemeResource KitFontSize13}"
                                                            services:TypographyResources.BaseFontSize="13"
                                                            FontWeight="SemiBold"
                                                            VerticalAlignment="Center" />
                                                        <HyperlinkButton
                                                            x:Uid="Shell_AiUsageViewAllModels"
                                                            services:RuntimeLocalization.Uid="Shell_AiUsageViewAllModels"
                                                            HorizontalAlignment="Right"
                                                            Padding="4,0"
                                                            MinHeight="0"
                                                            FontSize="{ThemeResource KitFontSize12}"
                                                            services:TypographyResources.BaseFontSize="12"
                                                            Click="AiUsageViewAllModels_Click" />
                                                    </Grid>
                                                    <StackPanel x:Name="AiUsageTopModelsPanel" Spacing="8" />
                                                </StackPanel>
                                            </Border>

                                            <!-- By Task Breakdown Card -->
                                            <Border x:Name="AiUsageByTaskCard" Style="{StaticResource KitCardSurfaceStyle}" Padding="12,10" Visibility="Collapsed">
                                                <StackPanel Spacing="8">
                                                    <TextBlock
                                                        x:Uid="Shell_AiUsageByTaskTitle"
                                                        services:RuntimeLocalization.Uid="Shell_AiUsageByTaskTitle"
                                                        FontSize="{ThemeResource KitFontSize13}"
                                                        services:TypographyResources.BaseFontSize="13"
                                                        FontWeight="SemiBold" />
                                                    <StackPanel x:Name="AiUsageByTaskPanel" Spacing="7" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Models Tab -->
                                        <StackPanel x:Name="AiUsageModelsView" Visibility="Collapsed" Spacing="10">
                                            <TextBlock
                                                x:Uid="Shell_AiUsageModelsHeader"
                                                services:RuntimeLocalization.Uid="Shell_AiUsageModelsHeader"
                                                FontSize="{ThemeResource KitFontSize12}"
                                                services:TypographyResources.BaseFontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap" />
                                            <StackPanel x:Name="AiUsageModelsListPanel" Spacing="9" />
                                            <Border
                                                x:Name="AiUsageModelsEmptyState"
                                                Visibility="Collapsed"
                                                Style="{StaticResource KitSubtleSurfaceStyle}">
                                                <TextBlock
                                                    x:Name="AiUsageModelsEmptyText"
                                                    FontSize="{ThemeResource KitFontSize13}"
                                                    services:TypographyResources.BaseFontSize="13"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    TextWrapping="Wrap" />
                                            </Border>
                                            <!-- Separated pre-SQLite legacy unattributed history card -->
                                            <Border
                                                x:Name="AiUsageLegacyModelsCard"
                                                Visibility="Collapsed"
                                                CornerRadius="8"
                                                BorderThickness="1"
                                                Padding="12,10">
                                                <StackPanel Spacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon FontSize="12" Glyph="&#xE81C;" Foreground="{ThemeResource BadgeWarningForegroundBrush}" VerticalAlignment="Center" />
                                                        <TextBlock
                                                            x:Name="AiUsageLegacyModelsTitleText"
                                                            FontSize="{ThemeResource KitFontSize12}"
                                                            services:TypographyResources.BaseFontSize="12"
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource BadgeWarningForegroundBrush}"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        x:Name="AiUsageLegacyModelsStatsText"
                                                        FontFamily="{StaticResource KitMonoFontFamily}"
                                                        FontSize="{ThemeResource KitFontSize12}"
                                                        services:TypographyResources.BaseFontSize="12"
                                                        Typography.NumeralAlignment="Tabular"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        x:Name="AiUsageLegacyModelsHintText"
                                                        FontSize="{ThemeResource KitFontSize12}"
                                                        services:TypographyResources.BaseFontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Activity Tab -->
                                        <StackPanel x:Name="AiUsageActivityView" Visibility="Collapsed" Spacing="12">
                                            <!-- Active Now -->
                                            <StackPanel Spacing="6">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Ellipse Width="7" Height="7" Fill="{ThemeResource KitUsageDiskBrush}" VerticalAlignment="Center" />
                                                    <TextBlock
                                                        x:Uid="Shell_AiUsageActiveSectionTitle"
                                                        services:RuntimeLocalization.Uid="Shell_AiUsageActiveSectionTitle"
                                                        FontSize="{ThemeResource KitFontSize13}"
                                                        services:TypographyResources.BaseFontSize="13"
                                                        FontWeight="SemiBold" />
                                                </StackPanel>
                                                <StackPanel x:Name="AiUsageActiveListPanel" Spacing="7" />
                                                <Border
                                                    x:Name="AiUsageNoActiveCard"
                                                    Style="{StaticResource KitSubtleSurfaceStyle}">
                                                    <TextBlock
                                                        x:Uid="Shell_AiUsageNoActiveSessions"
                                                        services:RuntimeLocalization.Uid="Shell_AiUsageNoActiveSessions"
                                                        FontSize="{ThemeResource KitFontSize12}"
                                                        services:TypographyResources.BaseFontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        TextWrapping="Wrap" />
                                                </Border>
                                            </StackPanel>

                                            <!-- Current Session Timeline -->
                                            <StackPanel Spacing="6">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Ellipse Width="7" Height="7" Fill="{ThemeResource KitUsageCpuBrush}" VerticalAlignment="Center" />
                                                    <TextBlock
                                                        x:Uid="Shell_AiUsageTimelineSectionTitle"
                                                        services:RuntimeLocalization.Uid="Shell_AiUsageTimelineSectionTitle"
                                                        FontSize="{ThemeResource KitFontSize13}"
                                                        services:TypographyResources.BaseFontSize="13"
                                                        FontWeight="SemiBold" />
                                                </StackPanel>
                                                <StackPanel x:Name="AiUsageSessionEventsPanel" Spacing="5" />
                                                <Border
                                                    x:Name="AiUsageNoSessionEventsCard"
                                                    Style="{StaticResource KitSubtleSurfaceStyle}">
                                                    <TextBlock
                                                        x:Uid="Shell_AiUsageNoSessionEvents"
                                                        services:RuntimeLocalization.Uid="Shell_AiUsageNoSessionEvents"
                                                        FontSize="{ThemeResource KitFontSize12}"
                                                        services:TypographyResources.BaseFontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        TextWrapping="Wrap" />
                                                </Border>
                                            </StackPanel>

                                            <!-- Persisted Recent Calls -->
                                            <StackPanel Spacing="6">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Ellipse Width="7" Height="7" Fill="{ThemeResource KitUsageMemoryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock
                                                        x:Uid="Shell_AiUsageRecentCallsSectionTitle"
                                                        services:RuntimeLocalization.Uid="Shell_AiUsageRecentCallsSectionTitle"
                                                        FontSize="{ThemeResource KitFontSize13}"
                                                        services:TypographyResources.BaseFontSize="13"
                                                        FontWeight="SemiBold" />
                                                </StackPanel>
                                                <StackPanel x:Name="AiUsageRecentCallsPanel" Spacing="7" />
                                                <Border
                                                    x:Name="AiUsageNoRecentCallsCard"
                                                    Style="{StaticResource KitSubtleSurfaceStyle}">
                                                    <TextBlock
                                                        x:Uid="Shell_AiUsageNoRecentCalls"
                                                        services:RuntimeLocalization.Uid="Shell_AiUsageNoRecentCalls"
                                                        FontSize="{ThemeResource KitFontSize12}"
                                                        services:TypographyResources.BaseFontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        TextWrapping="Wrap" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>

                                <!-- Row 3: Pinned Subtle Footer -->
                                <Border
                                    Grid.Row="3"
                                    Padding="16,8,16,10"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,1,0,0">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Name="AiUsageFooterText"
                                            FontSize="{ThemeResource KitFontSize12}"
                                            services:TypographyResources.BaseFontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="1"
                                            x:Uid="Shell_AiUsageCodexOnlyFooter"
                                            services:RuntimeLocalization.Uid="Shell_AiUsageCodexOnlyFooter"
                                            FontSize="{ThemeResource KitFontSize12}"
                                            services:TypographyResources.BaseFontSize="12"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="GeneralNavigationItem"
                    x:Uid="Shell_Settings" services:RuntimeLocalization.Uid="Shell_Settings"
                    AutomationProperties.AutomationId="GeneralNavItem">
                    <NavigationViewItem.Icon>
                        <AnimatedIcon>
                            <AnimatedIcon.Source>
                                <animatedVisuals:AnimatedSettingsVisualSource />
                            </AnimatedIcon.Source>
                            <AnimatedIcon.FallbackIconSource>
                                <SymbolIconSource Symbol="Setting" />
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            Style="{StaticResource UpdateInfoBadgeStyle}"
                            Visibility="{x:Bind ViewModel.Badges.IsKitUpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <i:Interaction.Behaviors>
                <ic:EventTriggerBehavior EventName="ItemInvoked">
                    <ic:InvokeCommandAction Command="{x:Bind ViewModel.ItemInvokedCommand}" />
                </ic:EventTriggerBehavior>
            </i:Interaction.Behaviors>
            <Grid x:Name="ShellContentHost" Padding="0,20,0,0">
                <Frame x:Name="shellFrame">
                    <Frame.ContentTransitions>
                        <TransitionCollection>
                            <NavigationThemeTransition>
                                <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                    <SuppressNavigationTransitionInfo />
                                </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                            </NavigationThemeTransition>
                        </TransitionCollection>
                    </Frame.ContentTransitions>
                </Frame>
            </Grid>
        </NavigationView>
    </Grid>
</UserControl>
