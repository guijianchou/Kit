<local:NavigablePage
    x:Class="Kit.Settings.UI.Views.AwakePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Kit.Settings.UI.Services"
    xmlns:controls="using:Kit.Settings.UI.Controls"
    xmlns:converters="using:Kit.Settings.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Kit.Settings.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:viewModels="using:Kit.Settings.UI.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:AwakeViewModel}"
    AutomationProperties.LandmarkType="Main"
    NavigationCacheMode="Required"
    mc:Ignorable="d"
    FontFamily="{ThemeResource KitUiFontFamily}"
    FontSize="{ThemeResource KitFontSize14}" services:TypographyResources.BaseFontSize="14">

    <local:NavigablePage.Resources>
        <converters:AwakeModeToIntConverter x:Key="AwakeModeToIntConverter" />
    </local:NavigablePage.Resources>

    <controls:SettingsPageControl
        x:Uid="Awake" services:RuntimeLocalization.Uid="Awake"
        CompactHeader="True"
        IsTabStop="False"
        ModuleImageSource="ms-appx:///Assets/Settings/Modules/Awake.png">
        <controls:SettingsPageControl.ModuleContent>
            <StackPanel ChildrenTransitions="{StaticResource SettingsCardsAnimations}" Orientation="Vertical">
                <controls:GPOInfoControl ShowWarning="{x:Bind ViewModel.IsEnabledGpoConfigured, Mode=OneWay}">
                    <tkcontrols:SettingsCard
                        x:Name="AwakeEnableSettingsCard"
                        x:Uid="Awake_EnableSettingsCard" services:RuntimeLocalization.Uid="Awake_EnableSettingsCard"
                        HeaderIcon="{ui:BitmapIcon Source=/Assets/Settings/Icons/Awake.png}"
                        IsEnabled="{x:Bind ViewModel.IsEnabledGpoConfigured, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                        <ToggleSwitch
                            x:Name="AwakeEnableToggleSwitch"
                            AutomationProperties.AutomationId="Toggle_Awake"
                            IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}" />
                    </tkcontrols:SettingsCard>
                </controls:GPOInfoControl>

                <controls:SettingsGroup x:Uid="Awake_BehaviorSettingsGroup" services:RuntimeLocalization.Uid="Awake_BehaviorSettingsGroup" IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}">
                    <tkcontrols:SettingsCard
                        x:Name="AwakeModeSettingsCard"
                        x:Uid="Awake_ModeSettingsCard" services:RuntimeLocalization.Uid="Awake_ModeSettingsCard"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE945;}">
                        <ComboBox x:Uid="Awake_ModeSelector" services:RuntimeLocalization.Uid="Awake_ModeSelector" AutomationProperties.AutomationId="ModeSelection_Awake" MinWidth="{StaticResource SettingActionControlMinWidth}" SelectedIndex="{x:Bind Path=ViewModel.Mode, Mode=TwoWay, Converter={StaticResource AwakeModeToIntConverter}}">
                            <ComboBoxItem x:Uid="Awake_NoKeepAwakeSelector" services:RuntimeLocalization.Uid="Awake_NoKeepAwakeSelector" />
                            <ComboBoxItem x:Uid="Awake_IndefiniteKeepAwakeSelector" services:RuntimeLocalization.Uid="Awake_IndefiniteKeepAwakeSelector" />
                            <ComboBoxItem x:Uid="Awake_TemporaryKeepAwakeSelector" services:RuntimeLocalization.Uid="Awake_TemporaryKeepAwakeSelector" />
                            <ComboBoxItem x:Uid="Awake_ExpirableKeepAwakeSelector" services:RuntimeLocalization.Uid="Awake_ExpirableKeepAwakeSelector" />
                        </ComboBox>
                    </tkcontrols:SettingsCard>

                    <tkcontrols:SettingsExpander
                        x:Name="AwakeExpirationSettingsExpander"
                        x:Uid="Awake_ExpirationSettingsExpander" services:RuntimeLocalization.Uid="Awake_ExpirationSettingsExpander"
                        HeaderIcon="{ui:FontIcon Glyph=&#xEC92;}"
                        IsExpanded="True"
                        Visibility="{x:Bind ViewModel.IsExpirationConfigurationEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <tkcontrols:SettingsExpander.Items>
                            <tkcontrols:SettingsCard x:Name="AwakeExpirationSettingsExpanderDate" x:Uid="Awake_ExpirationSettingsExpander_Date" services:RuntimeLocalization.Uid="Awake_ExpirationSettingsExpander_Date">
                                <CalendarDatePicker
                                    x:Uid="Awake_ExpirationDatePicker" services:RuntimeLocalization.Uid="Awake_ExpirationDatePicker"
                                    MinWidth="{StaticResource SettingActionControlMinWidth}"
                                    AutomationProperties.AutomationId="ExpirationDate_Awake"
                                    Date="{x:Bind ViewModel.ExpirationDateTimeNullable, Mode=TwoWay}" />
                            </tkcontrols:SettingsCard>
                            <tkcontrols:SettingsCard x:Name="AwakeExpirationSettingsExpanderTime" x:Uid="Awake_ExpirationSettingsExpander_Time" services:RuntimeLocalization.Uid="Awake_ExpirationSettingsExpander_Time">
                                <TimePicker
                                    x:Uid="Awake_ExpirationTimePicker" services:RuntimeLocalization.Uid="Awake_ExpirationTimePicker"
                                    MinWidth="{StaticResource SettingActionControlMinWidth}"
                                    AutomationProperties.AutomationId="ExpirationTime_Awake"
                                    Time="{x:Bind ViewModel.ExpirationTime, Mode=TwoWay}" />
                            </tkcontrols:SettingsCard>
                        </tkcontrols:SettingsExpander.Items>
                    </tkcontrols:SettingsExpander>

                    <tkcontrols:SettingsCard
                        x:Name="AwakeIntervalSettingsCard"
                        x:Uid="Awake_IntervalSettingsCard" services:RuntimeLocalization.Uid="Awake_IntervalSettingsCard"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE916;}"
                        Visibility="{x:Bind ViewModel.IsTimeConfigurationEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

                        <tkcontrols:WrapPanel MinWidth="{StaticResource SettingActionControlMinWidth}" HorizontalSpacing="8" VerticalSpacing="8">
                            <NumberBox
                                AutomationProperties.AutomationId="IntervalHours_Awake" x:Uid="Awake_IntervalHoursInput" services:RuntimeLocalization.Uid="Awake_IntervalHoursInput"
                                Width="116"
                                HorizontalAlignment="Left"
                                LargeChange="5"
                                Maximum="999"
                                Minimum="0"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.IntervalHours, Mode=TwoWay}" />
                            <NumberBox
                                AutomationProperties.AutomationId="IntervalMinutes_Awake" x:Uid="Awake_IntervalMinutesInput" services:RuntimeLocalization.Uid="Awake_IntervalMinutesInput"
                                Width="116"
                                HorizontalAlignment="Left"
                                LargeChange="5"
                                Maximum="59"
                                Minimum="0"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.IntervalMinutes, Mode=TwoWay}" />
                        </tkcontrols:WrapPanel>
                    </tkcontrols:SettingsCard>

                    <tkcontrols:SettingsCard
                        x:Uid="Awake_DisplaySettingsCard" services:RuntimeLocalization.Uid="Awake_DisplaySettingsCard"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE7F4;}"
                        IsEnabled="{x:Bind ViewModel.IsScreenConfigurationPossibleEnabled, Mode=OneWay}">
                        <ToggleSwitch AutomationProperties.AutomationId="KeepDisplayOn_Awake" IsOn="{x:Bind ViewModel.KeepDisplayOn, Mode=TwoWay}" />
                    </tkcontrols:SettingsCard>
                </controls:SettingsGroup>
            </StackPanel>
        </controls:SettingsPageControl.ModuleContent>

        <controls:SettingsPageControl.PrimaryLinks>
            <controls:PageLink x:Uid="LearnMore_Awake" services:RuntimeLocalization.Uid="LearnMore_Awake" Link="https://github.com/guijianchou/Kit" />
        </controls:SettingsPageControl.PrimaryLinks>
        <controls:SettingsPageControl.SecondaryLinks>
            <controls:PageLink x:Uid="SecondaryLink_Awake" services:RuntimeLocalization.Uid="SecondaryLink_Awake" Link="https://awake.den.dev" />
        </controls:SettingsPageControl.SecondaryLinks>
    </controls:SettingsPageControl>
</local:NavigablePage>
