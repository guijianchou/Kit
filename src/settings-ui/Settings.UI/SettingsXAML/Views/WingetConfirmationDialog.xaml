<ContentDialog
    x:Class="Kit.Settings.UI.Views.WingetConfirmationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Kit.Settings.UI.Services"
    xmlns:views="using:Kit.Settings.UI.Views"
    CornerRadius="{ThemeResource OverlayCornerRadius}"
    FontFamily="{ThemeResource KitUiFontFamily}"
    FontSize="{ThemeResource KitFontSize14}" services:TypographyResources.BaseFontSize="14"
    AutomationProperties.AutomationId="Winget_ConfirmationDialog"
    DefaultButton="Close">

    <ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <AcrylicBrush x:Key="WingetConfirmationSurfaceBrush" TintColor="#202A38" TintOpacity="0.14"
                        TintLuminosityOpacity="0.62" FallbackColor="#FF202733" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <AcrylicBrush x:Key="WingetConfirmationSurfaceBrush" TintColor="#F9FAFD" TintOpacity="0.08"
                        TintLuminosityOpacity="0.72" FallbackColor="#FFF3F5F9" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="WingetConfirmationSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- One continuous in-app acrylic surface; the native content overlay would obscure it. -->
            <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="Transparent" />
        </ResourceDictionary>
    </ContentDialog.Resources>

    <ContentDialog.Style>
        <Style TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
            <Setter Property="Background" Value="{ThemeResource WingetConfirmationSurfaceBrush}" />
        </Style>
    </ContentDialog.Style>

    <ScrollViewer
        x:Name="ConfirmationScroll"
        MaxHeight="500"
        MaxWidth="640"
        Background="Transparent"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Auto"
        AutomationProperties.AutomationId="Winget_ConfirmationScroll">
        <StackPanel Spacing="12">
            <TextBlock x:Name="ExplanationText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <Border
                Background="{ThemeResource KitAccentTintBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnDefinitions="3,*">
                    <Border CornerRadius="8,0,0,8" Background="{ThemeResource AccentFillColorDefaultBrush}" />
                    <StackPanel Grid.Column="1" Padding="12,9" Spacing="4">
                        <TextBlock x:Name="ElevationText" FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12" FontWeight="Medium" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="OptionsSummaryText" FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </StackPanel>
                </Grid>
            </Border>
            <ItemsControl x:Name="PackagesRepeater" HorizontalContentAlignment="Stretch">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="views:WingetConfirmationItem">
                        <Border
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="0,8,0,12">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <TextBlock Text="{x:Bind Identity}" FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12" FontFamily="{StaticResource KitMonoFontFamily}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <Border
                                    HorizontalAlignment="Left"
                                    Padding="7,2"
                                    Background="{ThemeResource KitAccentTintBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                    <TextBlock Text="{x:Bind VersionTransition}" FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12" FontWeight="SemiBold" FontFamily="{StaticResource KitMonoFontFamily}" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </Border>
                                <TextBlock Text="{x:Bind LicenseSummary}" FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind LicenseVisibility}" />
                                <TextBlock Text="{x:Bind AgreementsSummary}" FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind AgreementsVisibility}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
