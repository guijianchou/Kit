<?xml version="1.0" encoding="utf-8" ?>
<local:NavigablePage
    x:Class="Kit.Settings.UI.Views.LocalserverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kit.Settings.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Kit.Settings.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:viewModels="using:Kit.Settings.UI.ViewModels"
    xmlns:views="using:Kit.Settings.UI.Views"
    d:DataContext="{d:DesignInstance Type=viewModels:LocalserverViewModel}"
    AutomationProperties.LandmarkType="Main"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <local:NavigablePage.Resources>
        <FontFamily x:Key="MonoFontFamily">Consolas, Segoe UI Mono, Cascadia Mono</FontFamily>

        <Style x:Key="MetricPrimaryStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="MetricCompactStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="MetricStrongStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="MetaLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="60" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </local:NavigablePage.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger TargetElement="{Binding ElementName=StatusCardsGrid}" MinWidth="820" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="EnvironmentCard.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="SystemSessionColumn.(Grid.Row)" Value="0" />
                        <Setter Target="SystemSessionColumn.(Grid.Column)" Value="1" />
                        <Setter Target="SystemSessionColumn.(Grid.ColumnSpan)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger TargetElement="{Binding ElementName=StatusCardsGrid}" MaxWidth="820" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <controls:SettingsPageControl
            x:Uid="Localserver"
            IsTabStop="False">
            <controls:SettingsPageControl.ModuleContent>
                <StackPanel Spacing="16">
                    <controls:GPOInfoControl ShowWarning="{x:Bind ViewModel.IsEnabledGpoConfigured, Mode=OneWay}">
                        <tkcontrols:SettingsCard
                            x:Uid="Localserver_EnableSettingsCard"
                            HeaderIcon="{ui:BitmapIcon Source=/Assets/Settings/Icons/Localserver.png}"
                            IsEnabled="{x:Bind ViewModel.IsEnabledGpoConfigured, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                            <ToggleSwitch
                                AutomationProperties.AutomationId="Toggle_Localserver"
                                IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}" />
                        </tkcontrols:SettingsCard>
                    </controls:GPOInfoControl>

                    <InfoBar
                        IsClosable="True"
                        IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}"
                        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Severity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}" />

                    <!-- All module settings disabled when master switch is OFF -->
                    <ContentControl IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}"
                                    Opacity="{x:Bind ViewModel.IsEnabled, Mode=OneWay, Converter={StaticResource BoolToDisabledOpacityConverter}}"
                                    IsTabStop="False"
                                    HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="16">
                            <!-- Top Overview Cards Grid -->
                        <Grid x:Name="StatusCardsGrid" ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Left: ENVIRONMENT Card -->
                        <Border
                            x:Name="EnvironmentCard"
                            Grid.ColumnSpan="2"
                            Padding="16,14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource OverlayCornerRadius}">
                            <Grid ColumnDefinitions="112,*" ColumnSpacing="18">
                                <!-- Health Ring -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                    <Grid Width="88" Height="88">
                                        <Ellipse Width="84" Height="84" Stroke="{ThemeResource CardStrokeColorDefaultBrush}" StrokeThickness="6" />
                                        <Ellipse Width="84" Height="84" Stroke="{x:Bind ViewModel.HealthRingBrush, Mode=OneWay}" StrokeThickness="6" />
                                        <TextBlock Width="76" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind ViewModel.HealthStateText, Mode=OneWay}" />
                                    </Grid>
                                </StackPanel>

                                <Border Width="1" Margin="0,4" HorizontalAlignment="Right" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                                <!-- Diagnostics details -->
                                <StackPanel Grid.Column="1" Spacing="10">
                                    <!-- Header and Service Selector -->
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Uid="Localserver_SectionEnvironment" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        </StackPanel>
                                        <ComboBox
                                            x:Uid="Localserver_SelectedLineComboBox"
                                            Grid.Column="2"
                                            MinWidth="0"
                                            Width="180"
                                            Height="32"
                                            Padding="10,0"
                                            DisplayMemberPath="Name"
                                            FontSize="12"
                                            ItemsSource="{x:Bind ViewModel.Lines, Mode=OneWay}"
                                            SelectedItem="{x:Bind ViewModel.SelectedLine, Mode=TwoWay}" />
                                    </Grid>

                                    <!-- Verdict Summary -->
                                    <TextBlock Foreground="{x:Bind ViewModel.EnvSummaryBrush, Mode=OneWay}" Text="{x:Bind ViewModel.EnvSummaryText, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />

                                    <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                                    <!-- 4 Baseline Metrics: PORT, PID, STATE, RUNTIMES -->
                                    <Grid ColumnDefinitions="76,76,110,*" ColumnSpacing="12">
                                        <StackPanel Spacing="2">
                                            <TextBlock x:Uid="Localserver_ColPort" Style="{StaticResource MetaLabelStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.EnvPortText, Mode=OneWay}" Style="{StaticResource MetricPrimaryStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock x:Uid="Localserver_ColPid" Style="{StaticResource MetaLabelStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.EnvPidText, Mode=OneWay}" Style="{StaticResource MetricPrimaryStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock x:Uid="Localserver_ColState" Style="{StaticResource MetaLabelStyle}" />
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,4,0,0">
                                                <Ellipse Width="7" Height="7" Fill="{x:Bind ViewModel.EnvStateBrush, Mode=OneWay}" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind ViewModel.EnvStateText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{x:Bind ViewModel.EnvStateBrush, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Spacing="2">
                                            <TextBlock x:Uid="Localserver_RuntimesLabel" Style="{StaticResource MetaLabelStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.EnvRuntimesText, Mode=OneWay}" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                                    <!-- CHECKS Chips -->
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Uid="Localserver_ChecksLabel" Style="{StaticResource MetaLabelStyle}" />
                                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.EnvironmentCheckChips, Mode=OneWay}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:EnvironmentCheckChipModel">
                                                        <Border Padding="8,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{x:Bind Brush}" BorderThickness="1" CornerRadius="4" ToolTipService.ToolTip="{x:Bind Tooltip}">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <Ellipse Width="6" Height="6" Fill="{x:Bind Brush}" VerticalAlignment="Center" />
                                                                <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Label}" />
                                                                <Button MinWidth="20" MinHeight="20" Padding="2" Style="{ThemeResource SubtleButtonStyle}" Visibility="{x:Bind FixVisibility}">
                                                                    <FontIcon FontSize="10" Glyph="&#xE712;" />
                                                                    <Button.Flyout>
                                                                        <MenuFlyout>
                                                                            <MenuFlyoutItem x:Uid="Localserver_CopyFixCommandMenu" Click="CopyFixCommand_Click" DataContext="{x:Bind}" Visibility="{x:Bind FixCommandVisibility}" />
                                                                            <MenuFlyoutItem x:Uid="Localserver_ReleasePortMenu" Click="ReleasePort_Click" DataContext="{x:Bind}" Visibility="{x:Bind ReleasePortVisibility}" />
                                                                        </MenuFlyout>
                                                                    </Button.Flyout>
                                                                </Button>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>

                                    <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                                    <!-- Secondary details: COMMAND & ARGS and WORKING DIR -->
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                        <StackPanel Spacing="2">
                                            <TextBlock x:Uid="Localserver_CommandAndArgsLabel" Style="{StaticResource MetaLabelStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.EnvCommandText, Mode=OneWay}" FontFamily="Consolas, Segoe UI Mono" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{x:Bind ViewModel.EnvCommandText, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock x:Uid="Localserver_WorkingDirLabel" Style="{StaticResource MetaLabelStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.EnvCwdText, Mode=OneWay}" FontFamily="Consolas, Segoe UI Mono" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{x:Bind ViewModel.EnvCwdText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>

                                    <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                                    <!-- CPU Trend Canvas -->
                                    <Grid RowDefinitions="Auto,*" RowSpacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock x:Uid="Localserver_CpuTrendLabel" Style="{StaticResource MetaLabelStyle}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusChartRangeText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </Grid>
                                        <Border Grid.Row="1" Height="50" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" SizeChanged="OnStatusChartSizeChanged">
                                            <Grid>
                                                <Path Data="{x:Bind ViewModel.StatusCurveFillGeometry, Mode=OneWay}"
                                                      Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                      Opacity="0.14" />
                                                <Path Data="{x:Bind ViewModel.StatusCurveGeometry, Mode=OneWay}"
                                                      Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                                      StrokeThickness="1.75"
                                                      StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" />
                                                <TextBlock x:Uid="Localserver_NoActivityText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Visibility="{x:Bind ViewModel.StatusChartEmptyVisibility, Mode=OneWay}" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Right: SYSTEM and SESSION Column -->
                        <StackPanel x:Name="SystemSessionColumn" Grid.Row="1" Grid.ColumnSpan="2" Spacing="12">
                            <!-- SYSTEM Card -->
                            <Border
                                Padding="16,14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource OverlayCornerRadius}">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Uid="Localserver_SectionSystem" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                    <!-- GPU info -->
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="2">
                                        <TextBlock Text="{x:Bind ViewModel.GpuNameText, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="{x:Bind ViewModel.GpuStatusDotBrush, Mode=OneWay}" VerticalAlignment="Center" />
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.GpuStatusText, Mode=OneWay}" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.GpuDriverText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    </Grid>

                                    <!-- GPU 3-meter row -->
                                    <Grid ColumnDefinitions="1*,1.3*,1*" ColumnSpacing="12">
                                        <StackPanel Spacing="3">
                                            <TextBlock x:Uid="Localserver_GpuLoadLabel" Style="{StaticResource MetaLabelStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.GpuUtilizationText, Mode=OneWay}" Style="{StaticResource MetricStrongStyle}" />
                                            <ProgressBar Maximum="100" Value="{x:Bind ViewModel.GpuUtilizationValue, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock x:Uid="Localserver_GpuVramLabel" Style="{StaticResource MetaLabelStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.GpuMemoryText, Mode=OneWay}" Style="{StaticResource MetricStrongStyle}" />
                                            <ProgressBar Maximum="100" Value="{x:Bind ViewModel.GpuMemoryValue, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="3">
                                            <TextBlock x:Uid="Localserver_GpuTempLabel" Style="{StaticResource MetaLabelStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.GpuTemperatureText, Mode=OneWay}" Style="{StaticResource MetricStrongStyle}" />
                                            <ProgressBar Maximum="100" Value="{x:Bind ViewModel.GpuTemperatureValue, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>

                                    <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                                    <!-- Host CPU & RAM -->
                                    <Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                                        <TextBlock Grid.ColumnSpan="3" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.SystemProcessorText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" x:Uid="Localserver_HostCpuLabel" Style="{StaticResource MetaLabelStyle}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SystemCpuText, Mode=OneWay}" FontWeight="SemiBold" MinWidth="48" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Row="1" Grid.Column="2" Maximum="100" Value="{x:Bind ViewModel.SystemCpuValue, Mode=OneWay}" VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="2" x:Uid="Localserver_HostRamLabel" Style="{StaticResource MetaLabelStyle}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SystemRamText, Mode=OneWay}" FontWeight="SemiBold" MinWidth="48" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Row="2" Grid.Column="2" Maximum="100" Value="{x:Bind ViewModel.SystemRamValue, Mode=OneWay}" VerticalAlignment="Center" />
                                    </Grid>

                                    <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                                    <!-- Host Edition & Build -->
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <TextBlock x:Uid="Localserver_HostLabel" Style="{StaticResource MetaLabelStyle}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.SystemEditionText, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.SystemBuildText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SESSION Card -->
                            <Border
                                Padding="16,14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource OverlayCornerRadius}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock x:Uid="Localserver_SectionSession" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SessionUptimeText, Mode=OneWay}" FontFamily="Consolas, Segoe UI Mono" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                        <StackPanel Spacing="2">
                                            <TextBlock x:Uid="Localserver_RegisteredLabel" Style="{StaticResource MetaLabelStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.SessionRegisteredText, Mode=OneWay}" Style="{StaticResource MetricCompactStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock x:Uid="Localserver_RunningLabel" Style="{StaticResource MetaLabelStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.SessionRunningText, Mode=OneWay}" Style="{StaticResource MetricCompactStyle}" Foreground="{x:Bind ViewModel.SessionRunningBrush, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock x:Uid="Localserver_FaultedLabel" Style="{StaticResource MetaLabelStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.SessionFaultedText, Mode=OneWay}" Style="{StaticResource MetricCompactStyle}" Foreground="{x:Bind ViewModel.SessionFaultedBrush, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Toolbar -->
                    <StackPanel Margin="0,8,0,0" Spacing="12">
                        <TextBlock x:Uid="Localserver_LinesHeader" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <tkcontrols:WrapPanel HorizontalSpacing="8" Orientation="Horizontal" VerticalSpacing="8">
                            <Button x:Uid="Localserver_AddLineButton" Click="AddLine_Click" IsEnabled="{x:Bind ViewModel.CanAddLine, Mode=OneWay}" Style="{ThemeResource AccentButtonStyle}" />
                            <Button x:Uid="Localserver_StartAllButton" Click="StartAll_Click" IsEnabled="{x:Bind ViewModel.CanStartAll, Mode=OneWay}" />
                            <Button x:Uid="Localserver_StopAllButton" Click="StopAll_Click" IsEnabled="{x:Bind ViewModel.CanStopAll, Mode=OneWay}" />
                            <Button x:Uid="Localserver_RefreshButton" Click="RefreshTelemetry_Click" IsEnabled="{x:Bind ViewModel.CanRefreshTelemetry, Mode=OneWay}">
                                <FontIcon FontSize="16" Glyph="&#xE72C;" />
                            </Button>
                        </tkcontrols:WrapPanel>
                    </StackPanel>

                    <!-- Empty State Card -->
                    <Border
                        Padding="24"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource OverlayCornerRadius}"
                        Visibility="{x:Bind views:LocalserverPage.GetEmptyVisibility(ViewModel.Lines.Count), Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="Localserver_EmptyLinesTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Uid="Localserver_EmptyLinesDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Table Header -->
                    <Grid Padding="17,8,17,8" Margin="0,4,0,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.8*" MinWidth="140" />
                            <ColumnDefinition Width="0.7*" MinWidth="56" />
                            <ColumnDefinition Width="1.1*" MinWidth="90" />
                            <ColumnDefinition Width="0.9*" MinWidth="75" />
                            <ColumnDefinition Width="0.6*" MinWidth="50" />
                            <ColumnDefinition Width="0.8*" MinWidth="65" />
                            <ColumnDefinition Width="0.7*" MinWidth="55" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="Localserver_ColName" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" x:Uid="Localserver_ColPort" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" x:Uid="Localserver_ColState" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" x:Uid="Localserver_ColUptime" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="4" x:Uid="Localserver_ColCpu" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="5" x:Uid="Localserver_ColMem" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="6" x:Uid="Localserver_ColPid" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <!-- Service Rows ItemsControl -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Lines, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:LineRowViewModel">
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="16,10"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource OverlayCornerRadius}">
                                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.8*" MinWidth="140" />
                                            <ColumnDefinition Width="0.7*" MinWidth="56" />
                                            <ColumnDefinition Width="1.1*" MinWidth="90" />
                                            <ColumnDefinition Width="0.9*" MinWidth="75" />
                                            <ColumnDefinition Width="0.6*" MinWidth="50" />
                                            <ColumnDefinition Width="0.8*" MinWidth="65" />
                                            <ColumnDefinition Width="0.7*" MinWidth="55" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Row 0: NAME + Tag + Lock -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Center" />
                                            <Border Padding="4,1" CornerRadius="3" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Visibility="{x:Bind TagVisibility, Mode=OneWay}" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind TagLabel, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="{x:Bind TagBrush, Mode=OneWay}" />
                                            </Border>
                                            <Border Padding="4,1" CornerRadius="3" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Visibility="{x:Bind AdoptedVisibility, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind AdoptedTooltip, Mode=OneWay}" VerticalAlignment="Center">
                                                <TextBlock Text="ADOPTED" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                            </Border>
                                            <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind LockVisibility, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind LockTooltip, Mode=OneWay}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Row 0: PORT -->
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind PortText, Mode=OneWay}" VerticalAlignment="Center" FontFamily="Consolas, Segoe UI Mono" />

                                        <!-- Row 0: STATE -->
                                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="{x:Bind StateBrush, Mode=OneWay}" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind StateLabel, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Row 0: UPTIME -->
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{x:Bind UptimeText, Mode=OneWay}" Foreground="{x:Bind UptimeBrush, Mode=OneWay}" FontFamily="Consolas, Segoe UI Mono" VerticalAlignment="Center" />

                                        <!-- Row 0: CPU -->
                                        <TextBlock Grid.Row="0" Grid.Column="4" Text="{x:Bind CpuText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                                        <!-- Row 0: MEM -->
                                        <TextBlock Grid.Row="0" Grid.Column="5" Text="{x:Bind MemoryText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                                        <!-- Row 0: PID -->
                                        <TextBlock Grid.Row="0" Grid.Column="6" Text="{x:Bind PidText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                                        <!-- Row 0: Actions Column -->
                                        <StackPanel Grid.Row="0" Grid.Column="7" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <ToggleSwitch
                                                MinWidth="0"
                                                Width="40"
                                                Height="36"
                                                VerticalAlignment="Center"
                                                OnContent=""
                                                OffContent=""
                                                IsOn="{x:Bind IsOn, Mode=TwoWay}"
                                                IsEnabled="{x:Bind CanToggle, Mode=OneWay}"
                                                AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" />
                                            <Button
                                                Width="30"
                                                Height="30"
                                                Padding="0"
                                                Style="{ThemeResource SubtleButtonStyle}"
                                                Click="ToggleConfigExpanded_Click"
                                                DataContext="{x:Bind}"
                                                ToolTipService.ToolTip="{x:Bind LockTooltip, Mode=OneWay}">
                                                <FontIcon FontSize="12" Glyph="{x:Bind ExpandGlyph, Mode=OneWay}" />
                                            </Button>
                                            <Button
                                                Width="30"
                                                Height="30"
                                                Padding="0"
                                                Style="{ThemeResource SubtleButtonStyle}">
                                                <FontIcon FontSize="14" Glyph="&#xE712;" />
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem x:Uid="Localserver_RestartLineMenu" Click="RestartLine_Click" DataContext="{x:Bind}" IsEnabled="{x:Bind CanRestart, Mode=OneWay}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE72C;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem x:Uid="Localserver_ForceKillLineMenu" Click="ForceKillLine_Click" DataContext="{x:Bind}" IsEnabled="{x:Bind CanForceKill, Mode=OneWay}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE711;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>

                                        <!-- Row 1: Status Sub-Row (Status in Col 0 under NAME, RecentBars in Col 1..6 starting under PORT, Open in Col 7) -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Visibility="{x:Bind StatusVisibility, Mode=OneWay}">
                                            <TextBlock x:Uid="Localserver_StatusLabel" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <Ellipse Width="6" Height="6" Fill="{x:Bind StateBrush, Mode=OneWay}" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind StateLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- RecentBars status bar (starts directly under PORT, spans across to PID) -->
                                        <ScrollViewer
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="6"
                                            Margin="0,8,0,0"
                                            Height="24"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            HorizontalScrollMode="Disabled"
                                            HorizontalScrollBarVisibility="Hidden"
                                            VerticalScrollMode="Disabled"
                                            VerticalScrollBarVisibility="Hidden"
                                            Visibility="{x:Bind StatusVisibility, Mode=OneWay}">
                                            <ItemsControl ItemsSource="{x:Bind RecentBars, Mode=OneWay}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="2" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:RecentBarViewModel">
                                                        <Border Width="5" Height="{x:Bind BarHeight}" Background="{x:Bind Brush}" CornerRadius="2" ToolTipService.ToolTip="{x:Bind Description}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <!-- Open hyperlink button directly under Actions -->
                                        <HyperlinkButton
                                            Grid.Row="1"
                                            Grid.Column="7"
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Right"
                                            Padding="6,2"
                                            Click="OpenServiceUrl_Click"
                                            DataContext="{x:Bind}"
                                            Visibility="{x:Bind OpenUrlVisibility, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind OpenUrl, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE774;" FontSize="11" />
                                                <TextBlock x:Uid="Localserver_OpenUrlText" FontSize="12" />
                                            </StackPanel>
                                        </HyperlinkButton>

                                        <!-- Row 2: Expanded Targets-style Configuration Panel -->
                                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="8" Margin="0,12,0,0" Spacing="12" Visibility="{x:Bind ConfigVisibility, Mode=OneWay}">
                                            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                                            <Grid ColumnDefinitions="110,*" ColumnSpacing="12" RowSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                                                <!-- NAME -->
                                                <TextBlock x:Uid="Localserver_ConfigName" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Text="{x:Bind Name, Mode=TwoWay}" IsEnabled="{x:Bind IsEditable, Mode=OneWay}" />

                                                <!-- COMMAND -->
                                                <TextBlock Grid.Row="1" x:Uid="Localserver_ConfigCommand" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <TextBox Text="{x:Bind Executable, Mode=TwoWay}" FontFamily="Consolas, Segoe UI Mono" IsEnabled="{x:Bind IsEditable, Mode=OneWay}" />
                                                    <Button Grid.Column="1" x:Uid="Localserver_BrowseFileButton" Click="BrowseExecutable_Click" DataContext="{x:Bind}" IsEnabled="{x:Bind IsEditable, Mode=OneWay}" />
                                                </Grid>

                                                <!-- ARGUMENTS -->
                                                <TextBlock Grid.Row="2" x:Uid="Localserver_ConfigArguments" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBox Grid.Row="2" Grid.Column="1" Text="{x:Bind BaseArgsText, Mode=TwoWay}" FontFamily="Consolas, Segoe UI Mono" IsEnabled="{x:Bind IsEditable, Mode=OneWay}" />

                                                <!-- WORKING DIR -->
                                                <TextBlock Grid.Row="3" x:Uid="Localserver_ConfigWorkingDir" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <TextBox Text="{x:Bind Cwd, Mode=TwoWay}" FontFamily="Consolas, Segoe UI Mono" IsEnabled="{x:Bind IsEditable, Mode=OneWay}" />
                                                    <Button Grid.Column="1" x:Uid="Localserver_BrowseFolderButton" Click="BrowseCwd_Click" DataContext="{x:Bind}" IsEnabled="{x:Bind IsEditable, Mode=OneWay}" />
                                                </Grid>

                                                <!-- PORT -->
                                                <TextBlock Grid.Row="4" x:Uid="Localserver_ConfigPort" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                                    <NumberBox Value="{x:Bind PortValue, Mode=TwoWay}" Width="130" Minimum="0" Maximum="65535" SpinButtonPlacementMode="Compact" IsEnabled="{x:Bind IsEditable, Mode=OneWay}" />
                                                    <TextBlock Text="{x:Bind PortHintText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- RESOLVED COMMAND -->
                                                <TextBlock Grid.Row="5" x:Uid="Localserver_ConfigResolvedCommand" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBox Grid.Row="5" Grid.Column="1" Text="{x:Bind ResolvedCommandText, Mode=OneWay}" FontFamily="Consolas, Segoe UI Mono" IsReadOnly="True" TextWrapping="Wrap" />
                                            </Grid>

                                            <!-- Bottom of Expanded Panel: Action buttons (Delete on left, Save on right) -->
                                            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,4" />

                                            <Grid Margin="0,4,0,0">
                                                <Button
                                                    HorizontalAlignment="Left"
                                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                    IsEnabled="{x:Bind IsEditable, Mode=OneWay}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                                        <TextBlock x:Uid="Localserver_DeleteLineButtonText" />
                                                    </StackPanel>
                                                    <Button.Flyout>
                                                        <Flyout>
                                                            <StackPanel MaxWidth="300" Spacing="10">
                                                                <TextBlock x:Uid="Localserver_ConfirmDeleteTitle" FontWeight="SemiBold" />
                                                                <TextBlock x:Uid="Localserver_ConfirmDeleteDescription" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                                <Button x:Uid="Localserver_ConfirmDeleteConfirmButton" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Click="DeleteLine_Click" DataContext="{x:Bind}" />
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>

                                                <Button
                                                    HorizontalAlignment="Right"
                                                    Style="{ThemeResource AccentButtonStyle}"
                                                    Click="SaveCatalog_Click"
                                                    IsEnabled="{x:Bind IsEditable, Mode=OneWay}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE74E;" FontSize="13" />
                                                        <TextBlock x:Uid="Localserver_SaveLineButtonText" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Bottom Output Drawer -->
                    <Border
                        Margin="0,12,0,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource OverlayCornerRadius}">
                        <Grid RowDefinitions="Auto,Auto">
                            <!-- Header -->
                            <Grid Height="40" Padding="12,0" ColumnDefinitions="Auto,Auto,*,Auto">
                                <Button
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    Click="ToggleLogPanel_Click">
                                    <FontIcon Glyph="{x:Bind ViewModel.LogToggleGlyph, Mode=OneWay}" FontSize="12" />
                                </Button>
                                <TextBlock Grid.Column="1" x:Uid="Localserver_OutputHeader" Margin="8,0,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.LogSubtitleText, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.LogActionsVisibility, Mode=OneWay}">
                                    <ToggleButton
                                        Height="26"
                                        Padding="8,0"
                                        FontSize="12"
                                        x:Uid="Localserver_LogFollowToggle"
                                        IsChecked="{x:Bind ViewModel.IsLogFollowEnabled, Mode=TwoWay}" />
                                    <Button
                                        Height="26"
                                        Width="28"
                                        Padding="0"
                                        Click="OpenLogFolder_Click">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                                    </Button>
                                    <Button
                                        Height="26"
                                        Width="28"
                                        Padding="0"
                                        Click="ClearLogs_Click">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Body -->
                            <Border
                                Grid.Row="1"
                                Height="200"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                Visibility="{x:Bind ViewModel.LogPanelVisibility, Mode=OneWay}">
                                <Grid>
                                    <ScrollViewer
                                        x:Name="LogScroller"
                                        Padding="12,8"
                                        HorizontalScrollMode="Auto"
                                        HorizontalScrollBarVisibility="Auto"
                                        VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.LogLines, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewModels:LogLineViewModel">
                                                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                                                        <TextBlock Text="{x:Bind Timestamp}" FontFamily="Consolas, Segoe UI Mono" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                        <TextBlock Grid.Column="1" Width="24" Text="{x:Bind StreamLabel}" FontFamily="Consolas, Segoe UI Mono" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                        <TextBlock Grid.Column="2" Text="{x:Bind Text}" FontFamily="Consolas, Segoe UI Mono" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{x:Bind Brush}" FontWeight="{x:Bind FontWeight}" TextWrapping="NoWrap" IsTextSelectionEnabled="True" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock
                                        x:Uid="Localserver_LogEmptyText"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Visibility="{x:Bind ViewModel.LogEmptyVisibility, Mode=OneWay}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    </StackPanel>
                    </ContentControl>

                </StackPanel>
            </controls:SettingsPageControl.ModuleContent>
        </controls:SettingsPageControl>
    </Grid>
</local:NavigablePage>
