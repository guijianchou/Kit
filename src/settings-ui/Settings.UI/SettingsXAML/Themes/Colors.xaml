<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Kit 兼容令牌（批次 0：alias-first 迁移）
        - 键名全部保留以兼容既有页面引用；值已指向 WinUI 系统主题资源。
        - 各页面批次将改为直接引用系统刷；批次 7 删除本文件的空壳令牌。
        - 原 Mica 玻璃半透明值（#0EFFFFFF 等）与 InfoBar 硬编码 override 已退役。
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- 内容层（原 LayerFillColorDefault @35% 透明 hack 已移除） -->
            <SolidColorBrush x:Key="KitContentLayerBrush" Color="{StaticResource LayerFillColorDefault}" />
            <SolidColorBrush x:Key="KitSurfaceBrush" Color="{StaticResource CardBackgroundFillColorDefault}" />
            <SolidColorBrush x:Key="SolidBackgroundBrush" Color="{StaticResource SolidBackgroundFillColorBase}" />

            <!-- 卡片 / 胶囊（玻璃半透明值退役，指向系统表面色） -->
            <SolidColorBrush x:Key="MetricCardBackgroundBrush" Color="{StaticResource CardBackgroundFillColorDefault}" />
            <SolidColorBrush x:Key="MetricCardStrokeBrush" Color="{StaticResource CardStrokeColorDefault}" />
            <SolidColorBrush x:Key="MetricCardHoverBackgroundBrush" Color="{StaticResource ControlFillColorSecondary}" />
            <SolidColorBrush x:Key="PillBadgeBackgroundBrush" Color="{StaticResource SubtleFillColorSecondary}" />
            <SolidColorBrush x:Key="PillBadgeBorderBrush" Color="{StaticResource CardStrokeColorDefault}" />

            <!-- 状态徽章（指向系统语义色对） -->
            <SolidColorBrush x:Key="BadgeSuccessBackgroundBrush" Color="{StaticResource SystemFillColorSuccessBackground}" />
            <SolidColorBrush x:Key="BadgeSuccessForegroundBrush" Color="{StaticResource SystemFillColorSuccess}" />
            <SolidColorBrush x:Key="BadgeWarningBackgroundBrush" Color="{StaticResource SystemFillColorCautionBackground}" />
            <SolidColorBrush x:Key="BadgeWarningForegroundBrush" Color="{StaticResource SystemFillColorCaution}" />
            <SolidColorBrush x:Key="BadgeInfoBackgroundBrush" Color="{StaticResource SystemFillColorAttentionBackground}" />
            <SolidColorBrush x:Key="BadgeInfoForegroundBrush" Color="{StaticResource SystemFillColorAttention}" />

            <!-- 数据序列语义色（TCP/UDP 曲线；全项目唯一允许保留 hex 的定义处） -->
            <SolidColorBrush x:Key="KitDataSeriesTcpBrush" Color="#FFFF745A" />
            <SolidColorBrush x:Key="KitDataSeriesUdpBrush" Color="#FF20C9A6" />

            <!-- 设置导航标签色彩体系（外观/启动/AI/诊断/备份/更新） -->
            <SolidColorBrush x:Key="SectionAppearanceForegroundBrush" Color="#FFCE93D8" />
            <SolidColorBrush x:Key="SectionAppearanceTintBrush" Color="#25CE93D8" />
            <SolidColorBrush x:Key="SectionStartupForegroundBrush" Color="#FF60CDFF" />
            <SolidColorBrush x:Key="SectionStartupTintBrush" Color="#2560CDFF" />
            <SolidColorBrush x:Key="SectionAiForegroundBrush" Color="#FFFFA154" />
            <SolidColorBrush x:Key="SectionAiTintBrush" Color="#25FFA154" />
            <SolidColorBrush x:Key="SectionDiagnosticsForegroundBrush" Color="#FF6CCB5F" />
            <SolidColorBrush x:Key="SectionDiagnosticsTintBrush" Color="#256CCB5F" />
            <SolidColorBrush x:Key="SectionBackupForegroundBrush" Color="#FF4DD0E1" />
            <SolidColorBrush x:Key="SectionBackupTintBrush" Color="#254DD0E1" />
            <SolidColorBrush x:Key="SectionUpdatesForegroundBrush" Color="#FFFF77A9" />
            <SolidColorBrush x:Key="SectionUpdatesTintBrush" Color="#25FF77A9" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="KitContentLayerBrush" Color="{StaticResource LayerFillColorDefault}" />
            <SolidColorBrush x:Key="KitSurfaceBrush" Color="{StaticResource CardBackgroundFillColorDefault}" />
            <SolidColorBrush x:Key="SolidBackgroundBrush" Color="{StaticResource SolidBackgroundFillColorBase}" />

            <SolidColorBrush x:Key="MetricCardBackgroundBrush" Color="{StaticResource CardBackgroundFillColorDefault}" />
            <SolidColorBrush x:Key="MetricCardStrokeBrush" Color="{StaticResource CardStrokeColorDefault}" />
            <SolidColorBrush x:Key="MetricCardHoverBackgroundBrush" Color="{StaticResource ControlFillColorSecondary}" />
            <SolidColorBrush x:Key="PillBadgeBackgroundBrush" Color="{StaticResource SubtleFillColorSecondary}" />
            <SolidColorBrush x:Key="PillBadgeBorderBrush" Color="{StaticResource CardStrokeColorDefault}" />

            <SolidColorBrush x:Key="BadgeSuccessBackgroundBrush" Color="{StaticResource SystemFillColorSuccessBackground}" />
            <SolidColorBrush x:Key="BadgeSuccessForegroundBrush" Color="{StaticResource SystemFillColorSuccess}" />
            <SolidColorBrush x:Key="BadgeWarningBackgroundBrush" Color="{StaticResource SystemFillColorCautionBackground}" />
            <SolidColorBrush x:Key="BadgeWarningForegroundBrush" Color="{StaticResource SystemFillColorCaution}" />
            <SolidColorBrush x:Key="BadgeInfoBackgroundBrush" Color="{StaticResource SystemFillColorAttentionBackground}" />
            <SolidColorBrush x:Key="BadgeInfoForegroundBrush" Color="{StaticResource SystemFillColorAttention}" />

            <SolidColorBrush x:Key="KitDataSeriesTcpBrush" Color="#FFFF745A" />
            <SolidColorBrush x:Key="KitDataSeriesUdpBrush" Color="#FF20C9A6" />

            <!-- 设置导航标签色彩体系（外观/启动/AI/诊断/备份/更新） -->
            <SolidColorBrush x:Key="SectionAppearanceForegroundBrush" Color="#FF6A1B9A" />
            <SolidColorBrush x:Key="SectionAppearanceTintBrush" Color="#156A1B9A" />
            <SolidColorBrush x:Key="SectionStartupForegroundBrush" Color="#FF0066B4" />
            <SolidColorBrush x:Key="SectionStartupTintBrush" Color="#150066B4" />
            <SolidColorBrush x:Key="SectionAiForegroundBrush" Color="#FFC43E00" />
            <SolidColorBrush x:Key="SectionAiTintBrush" Color="#15C43E00" />
            <SolidColorBrush x:Key="SectionDiagnosticsForegroundBrush" Color="#FF0E703C" />
            <SolidColorBrush x:Key="SectionDiagnosticsTintBrush" Color="#150E703C" />
            <SolidColorBrush x:Key="SectionBackupForegroundBrush" Color="#FF006E7A" />
            <SolidColorBrush x:Key="SectionBackupTintBrush" Color="#15006E7A" />
            <SolidColorBrush x:Key="SectionUpdatesForegroundBrush" Color="#FFA8226A" />
            <SolidColorBrush x:Key="SectionUpdatesTintBrush" Color="#15A8226A" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="KitContentLayerBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="KitSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SolidBackgroundBrush" Color="{StaticResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="MetricCardBackgroundBrush" Color="{StaticResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MetricCardStrokeBrush" Color="{StaticResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MetricCardHoverBackgroundBrush" Color="{StaticResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="PillBadgeBackgroundBrush" Color="{StaticResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PillBadgeBorderBrush" Color="{StaticResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="BadgeSuccessBackgroundBrush" Color="{StaticResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BadgeSuccessForegroundBrush" Color="{StaticResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BadgeWarningBackgroundBrush" Color="{StaticResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BadgeWarningForegroundBrush" Color="{StaticResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BadgeInfoBackgroundBrush" Color="{StaticResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BadgeInfoForegroundBrush" Color="{StaticResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="KitDataSeriesTcpBrush" Color="{StaticResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="KitDataSeriesUdpBrush" Color="{StaticResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="SectionAppearanceForegroundBrush" Color="{StaticResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SectionAppearanceTintBrush" Color="{StaticResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SectionStartupForegroundBrush" Color="{StaticResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SectionStartupTintBrush" Color="{StaticResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SectionAiForegroundBrush" Color="{StaticResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SectionAiTintBrush" Color="{StaticResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SectionDiagnosticsForegroundBrush" Color="{StaticResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SectionDiagnosticsTintBrush" Color="{StaticResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SectionBackupForegroundBrush" Color="{StaticResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SectionBackupTintBrush" Color="{StaticResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SectionUpdatesForegroundBrush" Color="{StaticResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SectionUpdatesTintBrush" Color="{StaticResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
