                <Grid Padding="0,0,24,32">
                    <StackPanel x:Name="AiHubTabContent" MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="16">
                        <InfoBar IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}" IsClosable="True" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.IsStatusOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                 Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" AutomationProperties.LiveSetting="Assertive" />

                        <!-- TAB 0: SECURITY AUDIT -->
                        <StackPanel Spacing="16" Visibility="{x:Bind IsAuditTab(ViewModel.ActiveTabIndex), Mode=OneWay}">
                            <Border x:Name="AuditWorkflowCard"
                                    Style="{StaticResource KitCardSurfaceStyle}"
                                    Visibility="{x:Bind ViewModel.SidebarWorkflowVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind ViewModel.SidebarWorkflowGlyph, Mode=OneWay}" FontSize="16"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SidebarWorkflowTitle, Mode=OneWay}"
                                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.SidebarWorkflowPercentText, Mode=OneWay}"
                                               FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource KitMonoFontFamily}" VerticalAlignment="Center" />
                                    <Button Grid.Column="3" Content="{x:Bind ViewModel.CancelTaskLabel}" Command="{x:Bind ViewModel.CancelAuditCommand}"
