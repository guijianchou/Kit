<?xml version="1.0" encoding="utf-8"?>
<local:NavigablePage
    x:Class="Kit.Settings.UI.Views.NetMapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kit.Settings.UI.Helpers"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Kit.Settings.UI.ViewModels"
    NavigationCacheMode="Required"
    AutomationProperties.LandmarkType="Main">
    <local:NavigablePage.Resources>
        <ResourceDictionary>
        <ResourceDictionary x:Key="NetMapHealthStyles">
            <Style x:Key="UnknownText" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" /></Style>
            <Style x:Key="UnknownDot" TargetType="Ellipse"><Setter Property="Fill" Value="{ThemeResource TextFillColorTertiaryBrush}" /></Style>
            <Style x:Key="UnknownBox" TargetType="Rectangle"><Setter Property="Fill" Value="{ThemeResource TextFillColorTertiaryBrush}" /></Style>
            <Style x:Key="GoodText" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" /></Style>
            <Style x:Key="GoodDot" TargetType="Ellipse"><Setter Property="Fill" Value="{ThemeResource SystemFillColorSuccessBrush}" /></Style>
            <Style x:Key="GoodBox" TargetType="Rectangle"><Setter Property="Fill" Value="{ThemeResource SystemFillColorSuccessBrush}" /></Style>
            <Style x:Key="WarningText" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" /></Style>
            <Style x:Key="WarningDot" TargetType="Ellipse"><Setter Property="Fill" Value="{ThemeResource SystemFillColorCautionBrush}" /></Style>
            <Style x:Key="WarningBox" TargetType="Rectangle"><Setter Property="Fill" Value="{ThemeResource SystemFillColorCautionBrush}" /></Style>
            <Style x:Key="ErrorText" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" /></Style>
            <Style x:Key="ErrorDot" TargetType="Ellipse"><Setter Property="Fill" Value="{ThemeResource SystemFillColorCriticalBrush}" /></Style>
            <Style x:Key="ErrorBox" TargetType="Rectangle"><Setter Property="Fill" Value="{ThemeResource SystemFillColorCriticalBrush}" /></Style>
        </ResourceDictionary>
        <vm:NetMapHealthStyleConverter x:Key="NetMapHealthStyleConverter" Styles="{StaticResource NetMapHealthStyles}" />
        <Style x:Key="NetMapCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="NetMapSecondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="NetMapDirectMarkerStyle" TargetType="Rectangle">
            <Setter Property="Fill" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="NetMapProxyMarkerStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="NetMapRouteLineStyle" TargetType="Polyline">
            <Setter Property="Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
        </Style>
        <Style x:Key="NetMapHopNumberStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="NetMapMapLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="NetMapMapLabelBackgroundStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <DataTemplate x:Key="NetMapEgressTemplate" x:DataType="vm:NetMapCard">
            <Border Style="{StaticResource NetMapCardStyle}">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Style="{x:Bind Health, Converter={StaticResource NetMapHealthStyleConverter}, ConverterParameter=Dot}" />
                            <TextBlock Text="{x:Bind Status}" FontSize="12" Style="{x:Bind Health, Converter={StaticResource NetMapHealthStyleConverter}, ConverterParameter=Text}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{x:Bind Ip}" FontFamily="Consolas" FontSize="22" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{x:Bind Health, Converter={StaticResource NetMapHealthStyleConverter}, ConverterParameter=Text}" />
                    <TextBlock Text="{x:Bind Location}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Location}" />
                    <TextBlock Text="{x:Bind Asn}" Style="{StaticResource NetMapSecondary}" MaxLines="1" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Asn}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{x:Bind Timestamp}" Style="{StaticResource NetMapSecondary}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" x:Uid="NetMap_CardDetails" Content="Details" Style="{StaticResource TextButtonStyle}" MinWidth="0" MinHeight="28" Padding="8,4">
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel MaxWidth="320" Spacing="8">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Source}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind Route}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Asn}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind GeographySource}" Style="{StaticResource NetMapSecondary}" />
                                        <TextBlock Text="{x:Bind Freshness}" Style="{StaticResource NetMapSecondary}" Visibility="{x:Bind IsStale, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
        </ResourceDictionary>
    </local:NavigablePage.Resources>
    <ScrollViewer x:Name="PageScroller" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="PageScrollViewer">
        <StackPanel MaxWidth="1000" Margin="24,0,24,48" Spacing="12">
            <tk:SettingsCard x:Uid="NetMap_EnableCard" Header="NetMap" Description="Observe your current egress" AutomationProperties.AutomationId="NetMapEnableCard">
                <tk:SettingsCard.HeaderIcon>
                    <ImageIcon Source="/Assets/Settings/NetMapLogo.png" Width="36" Height="40" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="EnableSwitch" x:Uid="NetMap_Enable" IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}" AutomationProperties.AutomationId="Toggle_NetMap" />
            </tk:SettingsCard>
            <ContentControl IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}" Opacity="{x:Bind ViewModel.IsEnabled, Mode=OneWay, Converter={StaticResource BoolToDisabledOpacityConverter}}" HorizontalContentAlignment="Stretch" IsTabStop="False">
                <StackPanel Spacing="12">
                    <Border x:Name="DetectionCard" Style="{StaticResource NetMapCardStyle}" Padding="16,10">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Grid Width="10" Height="10" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                                <Ellipse Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                                <Ellipse Fill="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind ViewModel.IsDetectionOn, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.RunStatus, Mode=OneWay}" Style="{StaticResource NetMapSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="2" ToolTipService.ToolTip="{x:Bind ViewModel.RunStatus, Mode=OneWay}" AutomationProperties.LiveSetting="Polite" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="StartButton" x:Uid="NetMap_Start" Content="Start" Click="Start_Click" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="NetMapStart" />
                                <Button x:Name="StopButton" x:Uid="NetMap_Stop" Content="Stop" Click="Stop_Click" IsEnabled="{x:Bind ViewModel.IsDetectionOn, Mode=OneWay}" AutomationProperties.AutomationId="NetMapStop" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid x:Name="EgressGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12" SizeChanged="EgressGrid_SizeChanged">
                        <ContentControl x:Name="DirectCard" Content="{x:Bind ViewModel.Direct, Mode=OneWay}" ContentTemplate="{StaticResource NetMapEgressTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" />
                        <ContentControl x:Name="ProxyCard" Grid.Column="1" Content="{x:Bind ViewModel.Proxy, Mode=OneWay}" ContentTemplate="{StaticResource NetMapEgressTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" />
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.EvidenceNote, Mode=OneWay}" Style="{StaticResource NetMapSecondary}" />
                    <Border x:Name="MapCard" Style="{StaticResource NetMapCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="NetMap_MapTitle" Text="Egress map" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.RouteTarget, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Ellipse x:Name="TargetStatusLight" Width="11" Height="11" Style="{x:Bind ViewModel.TargetHealth, Mode=OneWay, Converter={StaticResource NetMapHealthStyleConverter}, ConverterParameter=Dot}" />
                                <TextBlock x:Name="TargetLatencyText" Grid.Column="1" Text="{x:Bind ViewModel.TargetLatency, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" Style="{x:Bind ViewModel.TargetHealth, Mode=OneWay, Converter={StaticResource NetMapHealthStyleConverter}, ConverterParameter=Text}" />
                            </Grid>
                            <Grid x:Name="MapBody" ColumnDefinitions="*,440" RowDefinitions="Auto,Auto" ColumnSpacing="12" SizeChanged="MapBody_SizeChanged">
                                <Viewbox x:Name="MapView" Stretch="Uniform" MaxHeight="260" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                                    <Canvas Width="960" Height="480">
                                        <Canvas.Clip><RectangleGeometry Rect="0,0,960,480" /></Canvas.Clip>
                                        <Path x:Name="WorldOutline" Fill="{ThemeResource ControlFillColorSecondaryBrush}" Stroke="{ThemeResource TextFillColorTertiaryBrush}" StrokeThickness="0.7" />
                                        <Canvas x:Name="MapLines" Width="960" Height="480" />
                                        <Canvas x:Name="MapPoints" Width="960" Height="480" />
                                    </Canvas>
                                </Viewbox>
                                <StackPanel x:Name="RoutePanel" Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{x:Bind ViewModel.RouteStatus, Mode=OneWay}" Style="{StaticResource NetMapSecondary}" />
                                    <Grid ColumnDefinitions="24,120,*,48,48,48" Padding="8,4" ColumnSpacing="6">
                                        <TextBlock x:Uid="NetMap_HopHeader" Text="#" />
                                        <TextBlock Grid.Column="1" x:Uid="NetMap_RouterHeader" Text="Router" />
                                        <TextBlock Grid.Column="2" x:Uid="NetMap_LocHeader" Text="Loc" />
                                        <TextBlock Grid.Column="3" x:Uid="NetMap_LossHeader" Text="Loss" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="4" x:Uid="NetMap_LastRttHeader" Text="Last ms" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="5" x:Uid="NetMap_RttHeader" Text="Avg ms" HorizontalAlignment="Right" />
                                    </Grid>
                                    <ListView x:Name="HopList" ItemsSource="{x:Bind ViewModel.Hops, Mode=OneWay}" SelectionChanged="HopList_SelectionChanged" HorizontalContentAlignment="Stretch" MaxHeight="224" AutomationProperties.AutomationId="NetMapHopList">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="MinHeight" Value="32" />
                                                <Setter Property="Padding" Value="8,2" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:NetMapHopRow">
                                                <Grid ColumnDefinitions="24,120,*,48,48,48" ColumnSpacing="6" MinHeight="28" ToolTipService.ToolTip="{x:Bind Detail, Mode=OneWay}" AutomationProperties.Name="{x:Bind Detail, Mode=OneWay}">
                                                    <Border Width="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" HorizontalAlignment="Center" />
                                                    <Grid Width="24" Height="24" VerticalAlignment="Center">
                                                        <Ellipse Style="{x:Bind Health, Mode=OneWay, Converter={StaticResource NetMapHealthStyleConverter}, ConverterParameter=Dot}" />
                                                        <TextBlock Text="{x:Bind Ttl}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                    </Grid>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Ip, Mode=OneWay}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind Location, Mode=OneWay}" Style="{StaticResource NetMapSecondary}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Location, Mode=OneWay}" />
                                                    <TextBlock Grid.Column="3" Text="{x:Bind Loss, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="4" Text="{x:Bind Last, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{x:Bind Health, Mode=OneWay, Converter={StaticResource NetMapHealthStyleConverter}, ConverterParameter=Text}" />
                                                    <TextBlock Grid.Column="5" Text="{x:Bind Rtt, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="MapDescription" TextWrapping="Wrap" MinHeight="32" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Uid="NetMap_MapNotice" Style="{StaticResource NetMapSecondary}" Text="Natural Earth · country points are regional illustrations, not precise device locations." />
                            <TextBlock x:Uid="NetMap_RouteNotice" Style="{StaticResource NetMapSecondary}" Text="System ICMP route; missing replies are not application packet loss." />
                        </StackPanel>
                    </Border>
                    <Border x:Name="ServicesCard" Style="{StaticResource NetMapCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="NetMap_ServicesTitle" Text="Service endpoints" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Uid="NetMap_HealthLegend" Style="{StaticResource NetMapSecondary}" />
                            <Grid ColumnDefinitions="2*,3*" ColumnSpacing="12">
                                <TextBlock x:Uid="NetMap_Endpoint" Text="Endpoint" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" x:Uid="NetMap_ProxyHeader" Text="Proxy" FontWeight="SemiBold" />
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Services, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NetMapServiceRow">
                                        <Grid ColumnDefinitions="2*,3*" ColumnSpacing="12" Padding="0,10">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{x:Bind Name}" />
                                                <TextBlock Text="{x:Bind Endpoint}" Style="{StaticResource NetMapSecondary}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                    <Ellipse Width="11" Height="11" Style="{x:Bind Health, Mode=OneWay, Converter={StaticResource NetMapHealthStyleConverter}, ConverterParameter=Dot}" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Status, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" Style="{x:Bind Health, Mode=OneWay, Converter={StaticResource NetMapHealthStyleConverter}, ConverterParameter=Text}" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind Latency, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Style="{x:Bind Health, Mode=OneWay, Converter={StaticResource NetMapHealthStyleConverter}, ConverterParameter=Text}" />
                                                </Grid>
                                                <TextBlock Text="{x:Bind Proxy, Mode=OneWay}" Style="{StaticResource NetMapSecondary}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{x:Bind ViewModel.ServiceTimestamp, Mode=OneWay}" Style="{StaticResource NetMapSecondary}" />
                            <TextBlock x:Uid="NetMap_ServiceNotice" Text="Responses do not verify accounts or models. Domain routing may differ." Style="{StaticResource NetMapSecondary}" />
                        </StackPanel>
                    </Border>
                    <Expander x:Name="SettingsExpander" x:Uid="NetMap_Settings" Header="Connection and map settings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="16">
                            <ComboBox x:Uid="NetMap_ProxyMode" Header="Proxy connection" SelectedIndex="{x:Bind ViewModel.ProxyModeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                <ComboBoxItem x:Uid="NetMap_SystemMode" Content="System proxy" />
                                <ComboBoxItem x:Uid="NetMap_ExplicitMode" Content="HTTP / HTTPS / SOCKS5" />
                                <ComboBoxItem x:Uid="NetMap_TunMode" Content="System route / TUN" />
                            </ComboBox>
                            <TextBox x:Uid="NetMap_ProxyAddress" Header="Explicit proxy address" PlaceholderText="socks5://127.0.0.1:1080" Text="{x:Bind ViewModel.ProxyAddress, Mode=TwoWay}" />
                            <TextBlock x:Uid="NetMap_ProxyNotice" Style="{StaticResource NetMapSecondary}" Text="No username/password. Direct bypasses application proxy settings, but cannot bypass TUN." />
                            <ToggleSwitch x:Uid="NetMap_OnlineLookup" Header="Look up missing ASN and locations online" IsOn="{x:Bind ViewModel.OnlineLookup, Mode=TwoWay}" />
                            <TextBox x:Uid="NetMap_AsnPath" Header="GeoLite2-ASN database (optional)" Text="{x:Bind ViewModel.AsnDatabase, Mode=TwoWay}" />
                            <Button x:Uid="NetMap_BrowseAsn" Content="Choose ASN database" Click="BrowseDatabase_Click" Tag="ASN" />
                            <TextBox x:Uid="NetMap_CityPath" Header="GeoLite2-City database (optional)" Text="{x:Bind ViewModel.CityDatabase, Mode=TwoWay}" />
                            <Button x:Uid="NetMap_BrowseCity" Content="Choose City database" Click="BrowseDatabase_Click" Tag="City" />
                            <TextBlock Text="{x:Bind ViewModel.DatabaseStatus, Mode=OneWay}" Style="{StaticResource NetMapSecondary}" />
                            <TextBlock x:Uid="NetMap_DatabaseNotice" Style="{StaticResource NetMapSecondary}" Text="Databases stay local and are loaded only when detection starts. Leave paths empty to use country-only observations." />
                            <Expander x:Name="DataUpdateExpander" x:Uid="NetMap_DataUpdates" Header="ASN database update" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="12">
                                    <TextBlock x:Uid="NetMap_UpdateNotice" Style="{StaticResource NetMapSecondary}" />
                                    <HyperlinkButton Content="GeoLite2 · P3TERX/GeoLite.mmdb" NavigateUri="https://github.com/P3TERX/GeoLite.mmdb" />
                                    <Button x:Name="UpdateAsnButton" x:Uid="NetMap_UpdateAsn" Content="Download / update ASN" Click="UpdateAsn_Click" IsEnabled="{x:Bind ViewModel.CanUpdate, Mode=OneWay}" />
                                    <ProgressBar Value="{x:Bind ViewModel.UpdateProgress, Mode=OneWay}" Maximum="100" Visibility="{x:Bind ViewModel.IsUpdating, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <Button x:Uid="NetMap_CancelUpdate" Content="Cancel download" Click="CancelUpdate_Click" IsEnabled="{x:Bind ViewModel.IsUpdating, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Expander>
                            <Button x:Uid="NetMap_Apply" Content="Apply settings" Style="{StaticResource AccentButtonStyle}" Click="Apply_Click" IsEnabled="{x:Bind ViewModel.CanUpdate, Mode=OneWay}" />
                        </StackPanel>
                    </Expander>
                    <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</local:NavigablePage>
