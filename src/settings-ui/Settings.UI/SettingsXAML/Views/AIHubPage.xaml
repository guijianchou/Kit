                                                <Button Content="{x:Bind ViewModel.LatestAuditLabel}" Command="{x:Bind ViewModel.SelectLatestCommand}" AutomationProperties.AutomationId="AIHub_SelectLatestButton" />
                                            </StackPanel>
                                        </Flyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </Grid>

                            <Grid x:Name="AuditResultsGrid" ColumnDefinitions="3*,2*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                                <Border x:Name="AuditFindingsCard" Style="{StaticResource KitCardSurfaceStyle}" Padding="20,18" VerticalAlignment="Top">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock Text="{x:Bind ViewModel.FindingsCardHeading, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <ToggleButton x:Name="FindingSearchToggle" Grid.Column="1" Style="{StaticResource KitFilterPillToggleStyle}"
                                                          Click="OnFindingSearchToggleClick" AutomationProperties.Name="{x:Bind ViewModel.SearchPlaceholder}"
                                                          ToolTipService.ToolTip="{x:Bind ViewModel.SearchPlaceholder}">
                                                <FontIcon Glyph="&#xE71C;" FontSize="14" />
                                            </ToggleButton>
                                        </Grid>
                                        <tkcontrols:WrapPanel HorizontalSpacing="6" VerticalSpacing="6">
                                            <ToggleButton Tag="All" Style="{StaticResource KitFilterPillToggleStyle}"
                                                          AutomationProperties.AutomationId="AIHub_FilterAllButton"
                                                          AutomationProperties.Name="{x:Bind FormatFilterCount(ViewModel.FilterAllLabel, ViewModel.TotalFindings), Mode=OneWay}"
                                                          ToolTipService.ToolTip="{x:Bind FormatFilterCount(ViewModel.FilterAllLabel, ViewModel.TotalFindings), Mode=OneWay}"
                                                          Click="OnFilterClick" IsChecked="{x:Bind ViewModel.IsFilterAll, Mode=OneWay}">
                                                <TextBlock FontSize="12"><Run Text="{x:Bind ViewModel.FilterAllLabel, Mode=OneWay}" /><Run Text=" " /><Run Text="{x:Bind ViewModel.TotalFindings, Mode=OneWay}" /></TextBlock>
                                            </ToggleButton>
                                            <ToggleButton Tag="High" Style="{StaticResource KitFilterPillToggleStyle}"
