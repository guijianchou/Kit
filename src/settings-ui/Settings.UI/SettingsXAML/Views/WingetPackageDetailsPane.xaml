<UserControl
    x:Class="Kit.Settings.UI.Views.WingetPackageDetailsPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    AutomationProperties.AutomationId="Winget_PackageDetailsPane"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    IsTabStop="False">

    <Border
        Background="Transparent"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1,0,0,0">
        <Grid Padding="20" RowSpacing="16" RowDefinitions="Auto,*,Auto" TabFocusNavigation="Cycle">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:Name="PaneEyebrowText" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        x:Name="PackageTitleText"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        FontSize="16"
                        AutomationProperties.HeadingLevel="Level2"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True" />
                </StackPanel>
                <Button
                    x:Name="CloseDetailsButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource KitIconButtonStyle}"
                    Click="OnCloseClick"
                    AutomationProperties.AutomationId="Winget_ClosePackageDetails">
                    <FontIcon Glyph="&#xE711;" FontSize="14" AutomationProperties.AccessibilityView="Raw" />
                </Button>
            </Grid>

            <ScrollViewer
                x:Name="DetailsScroll"
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="14" Padding="0,0,4,4">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Border Style="{StaticResource KitIconBadgeStyle}">
                            <FontIcon Glyph="&#xE7B8;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                        </Border>
                        <TextBlock
                            x:Name="IdentityText"
                            Grid.Column="1"
                            FontSize="12"
                            FontFamily="{StaticResource KitMonoFontFamily}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                        <Button
                            x:Name="CopyIdButton"
                            Grid.Column="2"
                            Style="{StaticResource KitIconButtonStyle}"
                            Click="OnCopyIdClick"
                            VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8C8;" FontSize="13" AutomationProperties.AccessibilityView="Raw" />
                        </Button>
                    </Grid>

                    <StackPanel x:Name="DetailsLoadingPanel" Spacing="10" Visibility="Collapsed" Padding="0,12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ProgressRing x:Name="DetailsProgressRing" Width="22" Height="22" IsActive="False" />
                            <TextBlock x:Name="LoadingLabelText" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            x:Name="DetailsCancelButton"
                            Click="OnCancelClick"
                            Style="{StaticResource KitActionButtonStyle}"
                            HorizontalAlignment="Left" />
                    </StackPanel>

                    <Border
                        x:Name="DetailsErrorContainer"
                        Background="{ThemeResource BadgeWarningBackgroundBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12"
                        Visibility="Collapsed">
                        <StackPanel x:Name="DetailsErrorPanel" Spacing="10" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7BA;" FontSize="15" Foreground="{ThemeResource BadgeWarningForegroundBrush}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock x:Name="DetailsErrorText" TextWrapping="Wrap" IsTextSelectionEnabled="True" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button
                                x:Name="DetailsRetryButton"
                                Click="OnRetryClick"
                                Style="{StaticResource KitActionButtonStyle}"
                                HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="DetailsContentPanel" Spacing="14" Visibility="Collapsed">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnDefinitions="3,*">
                                <Border CornerRadius="8,0,0,8" Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                <StackPanel Grid.Column="1" Padding="14,12" Spacing="8">
                                    <TextBlock
                                        x:Name="VersionsText"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        FontFamily="{StaticResource KitMonoFontFamily}"
                                        Typography.NumeralAlignment="Tabular"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap"
                                        IsTextSelectionEnabled="True" />
                                    <TextBlock
                                        x:Name="PublisherText"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        IsTextSelectionEnabled="True" />
                                    <TextBlock
                                        x:Name="DescriptionText"
                                        FontSize="13"
                                        TextWrapping="Wrap"
                                        IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel x:Name="VersionOptionsPanel" Spacing="8" Visibility="Collapsed">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <ComboBox
                                    x:Name="VersionChoiceBox"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="Winget_VersionChoice" />
                                <Button
                                    x:Name="ApplyVersionButton"
                                    Grid.Column="1"
                                    VerticalAlignment="Bottom"
                                    Click="OnApplyVersionClick"
                                    Style="{StaticResource KitActionButtonStyle}"
                                    AutomationProperties.AutomationId="Winget_ApplyVersion" />
                            </Grid>
                            <TextBlock
                                x:Name="VersionExplanationText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Border
                            Background="{ThemeResource KitAccentTintBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock
                                    x:Name="InstallExplanationText"
                                    Grid.Column="1"
                                    FontSize="12"
                                    TextWrapping="Wrap"
                                    IsTextSelectionEnabled="True" />
                            </Grid>
                        </Border>

                        <StackPanel x:Name="MetadataLinksPanel" Spacing="6">
                            <HyperlinkButton x:Name="HomepageLink" Padding="0" Visibility="Collapsed" />
                            <TextBlock x:Name="LicenseText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="Collapsed" />
                            <HyperlinkButton x:Name="LicenseLink" Padding="0" Visibility="Collapsed" />
                        </StackPanel>

                        <Border Style="{StaticResource KitRecessedSurfaceStyle}" Padding="14,12">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock x:Name="ReleaseNotesHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                                <tk:MarkdownTextBlock
                                    x:Name="ReleaseNotesMarkdown"
                                    DisableHtml="True"
                                    IsTextSelectionEnabled="True"
                                    UsePipeTables="True"
                                    UseTaskLists="True" />
                                <HyperlinkButton x:Name="ReleaseNotesLink" Padding="0" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Spacing="8">
                <tk:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                    <Button
                        x:Name="CopyCommandButton"
                        Click="OnCopyCommandClick"
                        Style="{StaticResource KitActionButtonStyle}"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE756;" FontSize="13" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock x:Name="CopyCommandLabel" />
                        </StackPanel>
                    </Button>
                </tk:WrapPanel>
                <TextBlock
                    x:Name="FeedbackText"
                    Visibility="Collapsed"
                    FontSize="12"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
