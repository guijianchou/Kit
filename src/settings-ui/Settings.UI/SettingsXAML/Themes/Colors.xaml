<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Kit 主题色彩定义（全项目唯一色彩定义处）
        - 批次 0 的 alias-first 空壳令牌（KitContentLayer / KitSurface / MetricCard* / PillBadge* /
          SolidBackground）已在清理轮删除；页面一律直接引用 WinUI 系统主题刷。
        - 此处仅保留：状态徽章语义色、数据序列色、品牌装饰色与设置导航标签色彩体系。
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- 状态徽章（指向系统语义色对） -->
            <SolidColorBrush x:Key="BadgeSuccessBackgroundBrush" Color="{StaticResource SystemFillColorSuccessBackground}" />
            <SolidColorBrush x:Key="BadgeSuccessForegroundBrush" Color="{StaticResource SystemFillColorSuccess}" />
            <SolidColorBrush x:Key="BadgeWarningBackgroundBrush" Color="{StaticResource SystemFillColorCautionBackground}" />
            <SolidColorBrush x:Key="BadgeWarningForegroundBrush" Color="{StaticResource SystemFillColorCaution}" />
            <SolidColorBrush x:Key="BadgeInfoBackgroundBrush" Color="{StaticResource SystemFillColorAttentionBackground}" />
            <SolidColorBrush x:Key="BadgeInfoForegroundBrush" Color="{ThemeResource SystemAccentColorLight2}" />
            <SolidColorBrush x:Key="BadgeCriticalBackgroundBrush" Color="{StaticResource SystemFillColorCriticalBackground}" />
            <SolidColorBrush x:Key="BadgeCriticalForegroundBrush" Color="{StaticResource SystemFillColorCritical}" />

            <!-- 数据序列语义色（TCP/UDP 曲线） -->
            <SolidColorBrush x:Key="KitDataSeriesTcpBrush" Color="#FFFF745A" />
            <SolidColorBrush x:Key="KitDataSeriesUdpBrush" Color="#FF20C9A6" />

            <!-- Windows 徽标渐变（快捷方式冲突窗口，原 WindowsLogoGradient） -->
            <LinearGradientBrush x:Key="KitWindowsLogoGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0.0" Color="#FF80F9FF" />
                <GradientStop Offset="1" Color="#FF0B9CFF" />
            </LinearGradientBrush>

            <!-- 更新可用徽章点（原 InfoBadge UpdateInfoBadgeStyle） -->
            <SolidColorBrush x:Key="KitUpdateBadgeBrush" Color="#F09A2A" />

            <!-- 使用率进度条调色（UsageProgressBar 类别令牌；数值与旧内联 ARGB 逐位一致） -->
            <SolidColorBrush x:Key="KitUsageCpuBrush" Color="#FF38B6FF" />
            <SolidColorBrush x:Key="KitUsageMemoryBrush" Color="#FFB146C2" />
            <SolidColorBrush x:Key="KitUsageDiskBrush" Color="#FF38AD62" />
            <SolidColorBrush x:Key="KitUsageGpuBrush" Color="#FFFF8C00" />
            <SolidColorBrush x:Key="KitUsageTempNormalBrush" Color="#FFFBB03B" />
            <SolidColorBrush x:Key="KitUsageTempWarmBrush" Color="#FFFF8C00" />
            <SolidColorBrush x:Key="KitUsageTempHotBrush" Color="#FFFF5252" />
            <SolidColorBrush x:Key="KitUsageDefaultBrush" Color="#FF38B6FF" />

            <!-- Mica 强调色微染：图标徽章底色 / 顶栏轻量微染（跟随系统强调色，保持 Mica 通透层次） -->
            <SolidColorBrush x:Key="KitAccentTintBrush" Opacity="0.14" Color="{ThemeResource SystemAccentColorLight2}" />
            <LinearGradientBrush x:Key="KitHeroGradientBrush" Opacity="0.10" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="{ThemeResource SystemAccentColorLight2}" />
                <GradientStop Offset="0.6" Color="Transparent" />
            </LinearGradientBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="BadgeSuccessBackgroundBrush" Color="{StaticResource SystemFillColorSuccessBackground}" />
            <SolidColorBrush x:Key="BadgeSuccessForegroundBrush" Color="{StaticResource SystemFillColorSuccess}" />
            <SolidColorBrush x:Key="BadgeWarningBackgroundBrush" Color="{StaticResource SystemFillColorCautionBackground}" />
            <SolidColorBrush x:Key="BadgeWarningForegroundBrush" Color="{StaticResource SystemFillColorCaution}" />
            <SolidColorBrush x:Key="BadgeInfoBackgroundBrush" Color="{StaticResource SystemFillColorAttentionBackground}" />
            <SolidColorBrush x:Key="BadgeInfoForegroundBrush" Color="{ThemeResource SystemAccentColorDark1}" />
            <SolidColorBrush x:Key="BadgeCriticalBackgroundBrush" Color="{StaticResource SystemFillColorCriticalBackground}" />
            <SolidColorBrush x:Key="BadgeCriticalForegroundBrush" Color="{StaticResource SystemFillColorCritical}" />

            <SolidColorBrush x:Key="KitDataSeriesTcpBrush" Color="#FFFF745A" />
            <SolidColorBrush x:Key="KitDataSeriesUdpBrush" Color="#FF20C9A6" />

            <LinearGradientBrush x:Key="KitWindowsLogoGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0.0" Color="#FF4DD2FF" />
                <GradientStop Offset="0.75" Color="#FF0078D4" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="KitUpdateBadgeBrush" Color="#F09A2A" />

            <!-- 使用率进度条调色（UsageProgressBar 类别令牌；数值与旧内联 ARGB 逐位一致） -->
            <SolidColorBrush x:Key="KitUsageCpuBrush" Color="#FF0078D4" />
            <SolidColorBrush x:Key="KitUsageMemoryBrush" Color="#FF744DA9" />
            <SolidColorBrush x:Key="KitUsageDiskBrush" Color="#FF0E7A0D" />
            <SolidColorBrush x:Key="KitUsageGpuBrush" Color="#FFD83B01" />
            <SolidColorBrush x:Key="KitUsageTempNormalBrush" Color="#FFCA5010" />
            <SolidColorBrush x:Key="KitUsageTempWarmBrush" Color="#FFD83B01" />
            <SolidColorBrush x:Key="KitUsageTempHotBrush" Color="#FFC42B1C" />
            <SolidColorBrush x:Key="KitUsageDefaultBrush" Color="#FF0078D4" />

            <SolidColorBrush x:Key="KitAccentTintBrush" Opacity="0.10" Color="{ThemeResource SystemAccentColorDark1}" />
            <LinearGradientBrush x:Key="KitHeroGradientBrush" Opacity="0.12" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="{ThemeResource SystemAccentColorLight2}" />
                <GradientStop Offset="0.6" Color="Transparent" />
            </LinearGradientBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="BadgeSuccessBackgroundBrush" Color="{StaticResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BadgeSuccessForegroundBrush" Color="{StaticResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BadgeWarningBackgroundBrush" Color="{StaticResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BadgeWarningForegroundBrush" Color="{StaticResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BadgeInfoBackgroundBrush" Color="{StaticResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BadgeInfoForegroundBrush" Color="{StaticResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BadgeCriticalBackgroundBrush" Color="{StaticResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BadgeCriticalForegroundBrush" Color="{StaticResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="KitDataSeriesTcpBrush" Color="{StaticResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="KitDataSeriesUdpBrush" Color="{StaticResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="KitWindowsLogoGradientBrush" Color="{StaticResource SystemColorHighlightTextColor}" />

            <SolidColorBrush x:Key="KitUpdateBadgeBrush" Color="{StaticResource SystemColorWindowTextColor}" />

            <!-- 使用率进度条调色（高对比：全部随窗口文本色，保证可达性） -->
            <SolidColorBrush x:Key="KitUsageCpuBrush" Color="{StaticResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="KitUsageMemoryBrush" Color="{StaticResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="KitUsageDiskBrush" Color="{StaticResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="KitUsageGpuBrush" Color="{StaticResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="KitUsageTempNormalBrush" Color="{StaticResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="KitUsageTempWarmBrush" Color="{StaticResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="KitUsageTempHotBrush" Color="{StaticResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="KitUsageDefaultBrush" Color="{StaticResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="KitAccentTintBrush" Color="{StaticResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="KitHeroGradientBrush" Color="{StaticResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
