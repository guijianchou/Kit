<?xml version="1.0" encoding="utf-8" ?>
<local:NavigablePage
    x:Class="Kit.Settings.UI.Views.AIHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kit.Settings.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Kit.Settings.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Kit.AIHubLib.Models"
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:viewModels="using:Kit.Settings.UI.ViewModels"
    xmlns:views="using:Kit.Settings.UI.Views"
    d:DataContext="{d:DesignInstance Type=viewModels:AIHubPageViewModel}"
    AutomationProperties.LandmarkType="Main"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <local:NavigablePage.Resources>

        <!-- Readiness / health styles per level: bound via AiReadinessStyle and HealthScore*Style, locked by AiHubSettingsTests + ModulePageSmoke contrast assertions -->
        <Style x:Key="ReadinessReadyStyle" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
        </Style>
        <Style x:Key="ReadinessDegradedStyle" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
        </Style>
        <Style x:Key="ReadinessUnverifiedStyle" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorAttentionBrush}" />
        </Style>
        <Style x:Key="ReadinessNotConfiguredStyle" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
        <Style x:Key="ReadinessDisabledStyle" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="HealthGoodStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{ThemeResource SystemFillColorSuccessBrush}" />
        </Style>
        <Style x:Key="HealthWarningStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{ThemeResource SystemFillColorCautionBrush}" />
        </Style>
        <Style x:Key="HealthCriticalStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
        <Style x:Key="HealthRingGoodStyle" TargetType="ProgressRing">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
        </Style>
        <Style x:Key="HealthRingWarningStyle" TargetType="ProgressRing">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
        </Style>
        <Style x:Key="HealthRingCriticalStyle" TargetType="ProgressRing">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>



        <Style x:Key="SafetyCardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SafetyCardDescStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="OptimizationItemContainerStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="OptimizationPresenterStyle" TargetType="ContentPresenter">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <DataTemplate x:Key="OptimizationInventoryScopeTemplate" x:DataType="viewModels:OptimizationInventoryScopeViewModel">
            <Border Margin="0,0,0,8" CornerRadius="{StaticResource OverlayCornerRadius}"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                          IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" HorizontalAlignment="Stretch" Padding="0,4">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" VerticalAlignment="Top" Margin="0,3,0,0"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}"
                                           FontFamily="{StaticResource KitMonoFontFamily}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <tkcontrols:WrapPanel HorizontalSpacing="10" VerticalSpacing="4">
                                    <TextBlock Text="{x:Bind SizeText}" FontWeight="SemiBold" FontFamily="{StaticResource KitMonoFontFamily}" />
                                    <TextBlock Text="{x:Bind FileSummary}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </tkcontrols:WrapPanel>
                                <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind SharePercent}" Height="4"
                                             AutomationProperties.Name="{x:Bind Name}" IsHitTestVisible="False"
                                             Visibility="{x:Bind HasMeasuredSize, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <tkcontrols:WrapPanel HorizontalSpacing="6" VerticalSpacing="4">
                                    <Border Style="{StaticResource KitStatusPillStyle}">
                                        <TextBlock Text="{x:Bind StateLabel}" FontSize="11" TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock Text="{x:Bind DispositionLabel}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </tkcontrols:WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel x:Name="InventoryScopeDetails" x:Load="{x:Bind HasBeenExpanded, Mode=OneWay}" Spacing="10" Padding="8,6">
                        <TextBlock Text="{x:Bind Reason}" TextWrapping="Wrap" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                        <TextBlock Text="{x:Bind Guidance}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind AgeSummary}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind HasMeasuredSize, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="{x:Bind ScanNotes}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind HasScanNotes, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <StackPanel Spacing="6" Visibility="{x:Bind HasTopFiles, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock x:Uid="AIHub_Inventory_LargestFilesTitle" FontWeight="SemiBold" FontSize="12" />
                            <ItemsControl ItemsSource="{x:Bind TopFiles}" HorizontalContentAlignment="Stretch">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:OptimizationInventoryFileViewModel">
                                        <Border Padding="10,8" Margin="0,0,0,4" CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Path}" FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                           FontFamily="{StaticResource KitMonoFontFamily}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <tkcontrols:WrapPanel HorizontalSpacing="12" VerticalSpacing="3">
                                                    <TextBlock Text="{x:Bind SizeText}" FontSize="12" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind ModifiedText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </tkcontrols:WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </Border>
        </DataTemplate>

        <!-- Leaf category item template inside groups -->
        <DataTemplate x:Key="OptimizationCategoryTemplate" x:DataType="viewModels:OptimizationCategoryViewModel">
            <Border Margin="0,0,0,6" CornerRadius="{StaticResource OverlayCornerRadius}" HorizontalAlignment="Stretch"
                    Visibility="{x:Bind HasVisibleItems, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                          Background="Transparent" BorderThickness="0">
                    <Expander.Header>
                        <Grid ColumnSpacing="12" RowSpacing="10" RowDefinitions="Auto,Auto" HorizontalAlignment="Stretch" MinHeight="48" Padding="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.ColumnSpan="2" Spacing="3" VerticalAlignment="Center">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13"
                                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                                    <Border Grid.Column="1" Style="{StaticResource KitStatusPillStyle}" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ReviewStatus}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{x:Bind LocationLabel}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind Destination}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Summary, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" FontFamily="{StaticResource KitMonoFontFamily}" />
                                <TextBlock Text="{x:Bind SelectionSummary, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Row="1" Grid.Column="1" Content="{x:Bind ActionLabel}" Command="{x:Bind ExecuteCommand}"
                                    IsEnabled="{x:Bind IsEnabled, Mode=OneWay}" VerticalAlignment="Center"
                                    Style="{StaticResource KitActionButtonStyle}" />
                        </Grid>
                    </Expander.Header>
                    <StackPanel x:Name="OptimizationLeafDetails" x:Load="{x:Bind HasBeenExpanded, Mode=OneWay}" Spacing="10" Padding="4,8">
                        <Border CornerRadius="4" Padding="8,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock Text="{x:Bind Destination}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="{StaticResource KitMonoFontFamily}" />
                        </Border>
                        <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind Progress, Mode=OneWay}"
                                     Visibility="{x:Bind HasProgress, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                     Style="{StaticResource KitProgressBarStyle}" />
                        <ListView ItemsSource="{x:Bind VisibleItems, Mode=OneWay}" SelectionMode="None" MaxHeight="320" HorizontalContentAlignment="Stretch"
                                  ItemContainerStyle="{StaticResource OptimizationItemContainerStyle}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:TempFileInfo">
                                    <Grid Padding="0,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                  IsEnabled="{x:Bind IsActionable, Mode=OneWay}"
                                                  AutomationProperties.Name="{x:Bind FileName}"
                                                  VerticalAlignment="Center" MinWidth="32" />
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind FilePath}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{x:Bind FilePath}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="{StaticResource KitMonoFontFamily}" />
                                            <TextBlock Text="{x:Bind DisplayReason}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind SizeFormatted}" FontWeight="Medium" FontSize="12" HorizontalAlignment="Right" FontFamily="{StaticResource KitMonoFontFamily}" />
                                            <Border Style="{StaticResource KitStatusPillStyle}" HorizontalAlignment="Right">
                                                <TextBlock Text="{x:Bind ReviewLabel}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Expander>
            </Border>
        </DataTemplate>

        <!-- Project item template -->
        <DataTemplate x:Key="OptimizationProjectTemplate" x:DataType="viewModels:OptimizationGroupViewModel">
            <Border Margin="0,0,0,6" CornerRadius="{StaticResource OverlayCornerRadius}" HorizontalAlignment="Stretch"
                    Visibility="{x:Bind HasVisibleItems, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                          Background="Transparent" BorderThickness="0">
                    <Expander.Header>
                        <Grid ColumnSpacing="12" RowSpacing="10" RowDefinitions="Auto,Auto" MinHeight="48" Padding="0,2" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.ColumnSpan="2" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Location}" />
                                <TextBlock Text="{x:Bind Summary}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="{x:Bind Size}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" FontFamily="{StaticResource KitMonoFontFamily}" />
                            <Button Grid.Row="1" Grid.Column="1" Content="{x:Bind CleanLabel}" Command="{x:Bind ExecuteCommand}"
                                    IsEnabled="{x:Bind IsEnabled, Mode=OneWay}" VerticalAlignment="Center"
                                    Style="{StaticResource KitActionButtonStyle}" />
                        </Grid>
                    </Expander.Header>
                    <StackPanel x:Name="OptimizationProjectDetails" x:Load="{x:Bind HasBeenExpanded, Mode=OneWay}" Spacing="8" Padding="4,8">
                        <Border CornerRadius="4" Padding="8,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock Text="{x:Bind Location}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="{StaticResource KitMonoFontFamily}" />
                        </Border>
                        <ListView ItemsSource="{x:Bind Categories}" ItemTemplate="{StaticResource OptimizationCategoryTemplate}"
                                  ItemContainerStyle="{StaticResource OptimizationItemContainerStyle}"
                                  SelectionMode="None" MaxHeight="360" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </StackPanel>
                </Expander>
            </Border>
        </DataTemplate>

        <!-- Modern Finding Item Preview Template with Mica Glass styling -->
        <DataTemplate x:Key="FindingPreviewTemplate" x:DataType="models:AuditIssueEnhanced">
            <Button Tag="{x:Bind}" Click="OnFindingClick" Margin="0,0,0,8"
                    Style="{StaticResource KitInteractiveCardButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind DisplayTitle}"
                    AutomationProperties.Name="{x:Bind DisplayTitle}">
                <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="14">
                    <!-- Left Severity Indicator Accent Bar -->
                    <Border Background="{ThemeResource SystemFillColorCriticalBrush}" CornerRadius="2" Visibility="{x:Bind IsHigh, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Border Background="{ThemeResource SystemFillColorCautionBrush}" CornerRadius="2" Visibility="{x:Bind IsMedium, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Border Background="{ThemeResource SystemFillColorAttentionBrush}" CornerRadius="2" Visibility="{x:Bind IsLow, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!-- Main Finding Details -->
                    <StackPanel Grid.Column="1" Spacing="6">
                        <!-- Top Metadata Row: Severity Pill, Category Pill, Model Pill -->
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                            <!-- High Severity Pill -->
                            <Border CornerRadius="4" Padding="6,2" Background="{ThemeResource BadgeWarningBackgroundBrush}"
                                    Visibility="{x:Bind IsHigh, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{x:Bind SeverityText}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </Border>
                            <!-- Medium Severity Pill -->
                            <Border CornerRadius="4" Padding="6,2" Background="{ThemeResource BadgeWarningBackgroundBrush}"
                                    Visibility="{x:Bind IsMedium, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{x:Bind SeverityText}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            </Border>
                            <!-- Low Severity Pill -->
                            <Border CornerRadius="4" Padding="6,2" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Visibility="{x:Bind IsLow, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{x:Bind SeverityText}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource KitStatusPillStyle}">
                                <TextBlock Text="{x:Bind CategoryLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>

                            <TextBlock Grid.Column="3" Text="{x:Bind ModelLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Title -->
                        <TextBlock Text="{x:Bind DisplayTitle}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13"
                                   TextWrapping="Wrap" MaxLines="2" ToolTipService.ToolTip="{x:Bind DisplayTitle}" />

                        <!-- Suggested Action Row -->
                        <Border CornerRadius="6" Padding="10,6" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Border CornerRadius="4" Padding="6,1" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ActionBadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{x:Bind PriorityActionText}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" MaxLines="2" TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind PriorityActionText}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Footer: Evidence Summary, Occurrences, Timestamp -->
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="0,2,0,0">
                            <TextBlock Text="{x:Bind EvidenceSummaryText}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       ToolTipService.ToolTip="{x:Bind EvidenceSummaryText}" TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="1" Style="{StaticResource KitStatusPillStyle}"
                                    Visibility="{x:Bind HasOccurrences, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{x:Bind OccurrencesLabel}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <TextBlock Grid.Column="2" Text="{x:Bind EventTimestampText}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="{StaticResource KitMonoFontFamily}" />
                        </Grid>
                    </StackPanel>

                    <!-- Right Chevron -->
                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </DataTemplate>
    </local:NavigablePage.Resources>

    <Grid x:Name="AIHubRoot" RowDefinitions="Auto,Auto,*" RowSpacing="12" Padding="24,0,0,0">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger TargetElement="{Binding ElementName=AiReadinessBar}" MinWidth="640" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger TargetElement="{Binding ElementName=AiReadinessBar}" MaxWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AiReadinessActions.(Grid.Row)" Value="1" />
                        <Setter Target="AiReadinessActions.(Grid.Column)" Value="1" />
                        <Setter Target="AiReadinessActions.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger TargetElement="{Binding ElementName=AuditOverviewGrid}" MinWidth="760" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger TargetElement="{Binding ElementName=AuditOverviewGrid}" MaxWidth="760" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AuditScoreCard.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="AuditFindingsSummary.(Grid.Row)" Value="1" />
                        <Setter Target="AuditFindingsSummary.(Grid.Column)" Value="0" />
                        <Setter Target="AuditFindingsSummary.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger TargetElement="{Binding ElementName=AuditCommandHeader}" MinWidth="960" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger TargetElement="{Binding ElementName=AuditCommandHeader}" MaxWidth="960" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AuditCommandTitle.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="AuditCommandActions.(Grid.Row)" Value="1" />
                        <Setter Target="AuditCommandActions.(Grid.Column)" Value="0" />
                        <Setter Target="AuditCommandActions.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="AuditCommandActions.HorizontalAlignment" Value="Left" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger TargetElement="{Binding ElementName=OptimizationCommandHeader}" MinWidth="960" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="OptimizationCommandActions.HorizontalAlignment" Value="Right" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger TargetElement="{Binding ElementName=OptimizationCommandHeader}" MaxWidth="960" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="OptimizationCommandTitle.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="OptimizationCommandActions.(Grid.Row)" Value="1" />
                        <Setter Target="OptimizationCommandActions.(Grid.Column)" Value="0" />
                        <Setter Target="OptimizationCommandActions.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="OptimizationCommandActions.HorizontalAlignment" Value="Left" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger TargetElement="{Binding ElementName=DownloadsCommandHeader}" MinWidth="720" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger TargetElement="{Binding ElementName=DownloadsCommandHeader}" MaxWidth="720" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DownloadsCommandTitle.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="DownloadsCommandActions.(Grid.Row)" Value="1" />
                        <Setter Target="DownloadsCommandActions.(Grid.Column)" Value="0" />
                        <Setter Target="DownloadsCommandActions.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger TargetElement="{Binding ElementName=OptimizationReviewFilters}" MinWidth="560" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger TargetElement="{Binding ElementName=OptimizationReviewFilters}" MaxWidth="560" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="OptimizationSearchBox.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="OptimizationReviewFilter.(Grid.Row)" Value="1" />
                        <Setter Target="OptimizationReviewFilter.(Grid.Column)" Value="0" />
                        <Setter Target="OptimizationReviewFilter.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="OptimizationReviewFilter.HorizontalAlignment" Value="Stretch" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers><ui:ControlSizeTrigger TargetElement="{Binding ElementName=InventoryHeader}" MinWidth="680" /></VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers><ui:ControlSizeTrigger TargetElement="{Binding ElementName=InventoryHeader}" MaxWidth="680" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="InventoryTitle.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="InventoryActions.(Grid.Row)" Value="1" />
                        <Setter Target="InventoryActions.(Grid.Column)" Value="0" />
                        <Setter Target="InventoryActions.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="InventoryActions.HorizontalAlignment" Value="Left" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers><ui:ControlSizeTrigger TargetElement="{Binding ElementName=InventoryMetricsGrid}" MinWidth="600" /></VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers><ui:ControlSizeTrigger TargetElement="{Binding ElementName=InventoryMetricsGrid}" MaxWidth="600" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="InventoryObservedTile.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="InventoryRecentTile.(Grid.Row)" Value="1" />
                        <Setter Target="InventoryRecentTile.(Grid.Column)" Value="0" />
                        <Setter Target="InventoryRecentTile.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="InventoryOldTile.(Grid.Row)" Value="2" />
                        <Setter Target="InventoryOldTile.(Grid.Column)" Value="0" />
                        <Setter Target="InventoryOldTile.(Grid.ColumnSpan)" Value="3" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers><ui:ControlSizeTrigger TargetElement="{Binding ElementName=InventoryFilters}" MinWidth="560" /></VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers><ui:ControlSizeTrigger TargetElement="{Binding ElementName=InventoryFilters}" MaxWidth="560" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="InventorySearchBox.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="InventoryFilterComboBox.(Grid.Row)" Value="1" />
                        <Setter Target="InventoryFilterComboBox.(Grid.Column)" Value="0" />
                        <Setter Target="InventoryFilterComboBox.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="InventoryFilterComboBox.HorizontalAlignment" Value="Stretch" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <TextBlock x:Name="AiHubPageTitle" x:Uid="AIHub_PageTitle" MaxWidth="1000" Margin="0,0,24,0"
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                   Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
        <!-- Match SettingsPageControl's right padding and max-width order. Keep the module
             switch above navigation while each tab owns only its scrollable content. -->
        <Grid x:Name="AiHubFixedHeader" Grid.Row="1" Padding="0,0,24,0">
            <StackPanel MaxWidth="1000" Spacing="12" HorizontalAlignment="Stretch">
                <Border x:Name="AiHubMasterCardSurface" Style="{StaticResource KitHeroSurfaceStyle}" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="0">
                        <!-- Master Enable Toggle with GPO -->
                        <controls:GPOInfoControl ShowWarning="{x:Bind ViewModel.IsEnabledGpoConfigured, Mode=OneWay}">
                            <tkcontrols:SettingsCard
                                x:Uid="AIHub_EnableSettingsCard"
                                Header="Enable AI Hub"
                                Description="Analyze Windows event logs for security health and optimize disk hygiene with strict safety policies"
                                HeaderIcon="{ui:BitmapIcon Source=/Assets/Settings/Icons/AiHub.png}"
                                IsEnabled="{x:Bind ViewModel.IsEnabledGpoConfigured, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                BorderThickness="0" Background="Transparent">
                                <ToggleSwitch
                                    x:Uid="AIHub_EnableToggleSwitch"
                                    AutomationProperties.AutomationId="Toggle_AIHub"
                                    IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}" />
                            </tkcontrols:SettingsCard>
                        </controls:GPOInfoControl>

                        <!-- AI Service Status & Readiness Glass Sub-Bar -->
                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                Padding="16,10" CornerRadius="0,0,8,8">
                            <Grid x:Name="AiReadinessBar" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource KitIconBadgeSmallStyle}">
                                    <FontIcon x:Name="AiReadinessIcon" Glyph="{x:Bind ViewModel.AiReadinessGlyph, Mode=OneWay}"
                                              Style="{x:Bind AiReadinessStyle(ViewModel.AiReadinessLevel), Mode=OneWay}"
                                              FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <tkcontrols:WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalSpacing="8" VerticalSpacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.AiReadinessText, Mode=OneWay}"
                                               FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Border Visibility="{x:Bind ViewModel.HasActiveModelInfo, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            CornerRadius="4" Padding="6,1" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentEngineAndModelLabel, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="Medium" />
                                    </Border>
                                </tkcontrols:WrapPanel>
                                <tkcontrols:WrapPanel x:Name="AiReadinessActions" Grid.Column="2" HorizontalSpacing="10" VerticalSpacing="6" VerticalAlignment="Center">
                                    <HyperlinkButton Content="{x:Bind ViewModel.AiServiceSettingsLabel}"
                                                     ToolTipService.ToolTip="{x:Bind ViewModel.AiServiceSettingsLabel}"
                                                     AutomationProperties.AutomationId="AIHub_OpenServiceSettingsButton"
                                                     Click="OnAiServiceSettingsClick" FontSize="12" />
                                    <Button IsEnabled="{x:Bind ViewModel.CanRecheckAiReadiness, Mode=OneWay}"
                                            AutomationProperties.AutomationId="AIHub_RecheckAiButton"
                                            AutomationProperties.Name="{x:Bind ViewModel.RecheckAiLabel, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.RecheckAiLabel, Mode=OneWay}"
                                            Click="OnRecheckAiReadinessClick"
                                            Style="{StaticResource KitActionButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE72C;" FontSize="11" />
                                            <TextBlock Text="{x:Bind ViewModel.RecheckAiLabel, Mode=OneWay}" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </tkcontrols:WrapPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
                <tkcontrols:Segmented x:Name="AiHubSections"
                    SelectedIndex="{x:Bind ViewModel.ActiveTabIndex, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <tkcontrols:SegmentedItem Content="{x:Bind ViewModel.SecurityAuditTabLabel, Mode=OneWay}" Icon="{ui:FontIcon Glyph=&#xE72E;}" />
                    <tkcontrols:SegmentedItem Content="{x:Bind ViewModel.OptimizationTabLabel, Mode=OneWay}" Icon="{ui:FontIcon Glyph=&#xE9F5;}" />
                    <tkcontrols:SegmentedItem Content="{x:Bind ViewModel.TaskPoliciesTabLabel, Mode=OneWay}" Icon="{ui:FontIcon Glyph=&#xE8A5;}" />
                </tkcontrols:Segmented>
            </StackPanel>
        </Grid>
        <ScrollViewer x:Name="AiHubContentScroll" Grid.Row="2" AutomationProperties.AutomationId="PageScrollViewer"
                      HorizontalContentAlignment="Stretch"
                      HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <Grid Padding="0,0,24,32">
                <StackPanel x:Name="AiHubTabContent" MaxWidth="1000" Spacing="16" HorizontalAlignment="Stretch">
                    <!-- System Status InfoBar -->
                    <InfoBar
                        AutomationProperties.LiveSetting="Assertive"
                        IsClosable="True"
                        IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.IsStatusOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                        Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" />

                    <!-- ============================================================== -->
                    <!-- 2. MASTER OPACITY & ISENABLED WRAPPER                          -->
                    <!-- ============================================================== -->
                    <ContentControl
                        IsTabStop="False"
                        HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="16">

                            <!-- ============================================================== -->
                            <!-- TAB 1: SECURITY AUDIT                                          -->
                            <!-- ============================================================== -->
                            <StackPanel Spacing="16" Visibility="{x:Bind IsAuditTab(ViewModel.ActiveTabIndex), Mode=OneWay}">
                                <!-- Live Workflow Progress Card (when auditing/analyzing) -->
                                <Border x:Name="AuditWorkflowCard"
                                        Style="{StaticResource KitWorkflowCardStyle}"
                                        Visibility="{x:Bind ViewModel.SidebarWorkflowVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{x:Bind ViewModel.SidebarWorkflowGlyph, Mode=OneWay}" FontSize="16"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SidebarWorkflowTitle, Mode=OneWay}"
                                                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.SidebarWorkflowPercentText, Mode=OneWay}"
                                                       FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource KitMonoFontFamily}" VerticalAlignment="Center" />
                                        </Grid>
                                        <ProgressBar x:Name="AuditWorkflowProgress" Value="{x:Bind ViewModel.SidebarWorkflowPercent, Mode=OneWay}" Minimum="0" Maximum="100"
                                                     IsIndeterminate="{x:Bind ViewModel.IsAuditProgressIndeterminate, Mode=OneWay}"
                                                     Style="{StaticResource KitProgressBarStyle}"
                                                     AutomationProperties.Name="{x:Bind ViewModel.SidebarWorkflowTooltip, Mode=OneWay}" />
                                        <!-- Both messages can contain a complete native failure.
                                             An Auto column would take the available width away
                                             from the wrapping status and create a very tall card. -->
                                        <ScrollViewer x:Name="AuditWorkflowDetailsScroll" MaxHeight="144"
                                                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                                                      HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{x:Bind ViewModel.CurrentStageText, Mode=OneWay}" FontSize="12"
                                                           FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="AuditWorkflowStatus" Text="{x:Bind ViewModel.AuditStatusText, Mode=OneWay}"
                                                           FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock x:Name="AuditWorkflowAiResult" Text="{x:Bind ViewModel.AiAnalysisRanText, Mode=OneWay}"
                                                           Visibility="{x:Bind ViewModel.AiAnalysisRanText, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}"
                                                           FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>

                                <!-- Hero Command Header: Scope info & command controls aligned on Mica canvas -->
                                <Grid x:Name="AuditCommandHeader" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="12" ColumnSpacing="12" Margin="0,4,0,0">
                                    <Grid x:Name="AuditCommandTitle" ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                                        <Border Style="{StaticResource KitIconBadgeStyle}">
                                            <FontIcon Glyph="&#xE72E;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.SecurityAuditTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" AutomationProperties.HeadingLevel="Level2" />
                                            <Border CornerRadius="6" Padding="8,2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE72E;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind ViewModel.ScopeHint, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <tkcontrols:WrapPanel x:Name="AuditCommandActions" Grid.Column="1" HorizontalAlignment="Right" HorizontalSpacing="8" VerticalSpacing="8" VerticalAlignment="Center">
                                        <Button Style="{StaticResource KitActionButtonStyle}" Command="{x:Bind ViewModel.FastScanCommand}"
                                                AutomationProperties.AutomationId="AIHub_FastScanButton"
                                                AutomationProperties.Name="{x:Bind ViewModel.FastScanLabel, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <FontIcon Glyph="&#xE8FE;" FontSize="12" />
                                                <TextBlock Text="{x:Bind ViewModel.FastScanLabel, Mode=OneWay}" FontSize="13" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource KitPrimaryActionButtonStyle}" Command="{x:Bind ViewModel.FullScanCommand}"
                                                AutomationProperties.AutomationId="AIHub_FullScanButton"
                                                AutomationProperties.Name="{x:Bind ViewModel.FullScanLabel, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <FontIcon Glyph="&#xE721;" FontSize="12" />
                                                <TextBlock Text="{x:Bind ViewModel.FullScanLabel, Mode=OneWay}" FontSize="13" />
                                            </StackPanel>
                                        </Button>
                                        <ComboBox Width="76" MinHeight="32" CornerRadius="{StaticResource ControlCornerRadius}" SelectedIndex="{x:Bind ViewModel.FullScanRangeIndex, Mode=TwoWay}"
                                                  AutomationProperties.Name="{x:Bind ViewModel.FullScanRangeHint, Mode=OneWay}"
                                                  ToolTipService.ToolTip="{x:Bind ViewModel.FullScanRangeHint, Mode=OneWay}">
                                            <ComboBoxItem Content="{x:Bind ViewModel.RangeOption1DayLabel, Mode=OneWay}" />
                                            <ComboBoxItem Content="{x:Bind ViewModel.RangeOption2DaysLabel, Mode=OneWay}" />
                                            <ComboBoxItem Content="{x:Bind ViewModel.RangeOption1WeekLabel, Mode=OneWay}" />
                                        </ComboBox>
                                        <Button Style="{StaticResource KitActionButtonStyle}" Command="{x:Bind ViewModel.DeepAnalyzeCommand}"
                                                AutomationProperties.AutomationId="AIHub_DeepAnalyzeButton"
                                                ToolTipService.ToolTip="{x:Bind ViewModel.DeepAnalyzeHint, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <FontIcon Glyph="&#xE9D9;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.DeepAnalyzeLabel, Mode=OneWay}" FontSize="13" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource KitActionButtonStyle}" Command="{x:Bind ViewModel.CancelAuditCommand}"
                                                AutomationProperties.AutomationId="AIHub_CancelAuditButton"
                                                AutomationProperties.Name="{x:Bind ViewModel.CancelTaskLabel, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind ViewModel.CancelTaskLabel, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE711;" FontSize="11" />
                                                <TextBlock Text="{x:Bind ViewModel.CancelTaskLabel, Mode=OneWay}" FontSize="13" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource KitIconButtonStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.ScanOptionsLabel, Mode=OneWay}"
                                                AutomationProperties.AutomationId="AIHub_ScanOptionsButton"
                                                AutomationProperties.Name="{x:Bind ViewModel.ScanOptionsLabel, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE712;" FontSize="14" />
                                        </Button>
                                    </tkcontrols:WrapPanel>
                                </Grid>

                                <!-- Health Overview Hero Glass Surface -->
                                <Border Style="{StaticResource KitCardSurfaceStyle}" Padding="20,18">
                                    <StackPanel Spacing="16">
                                        <!-- Top row: Health overview label with Heartbeat icon & DatePicker -->
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                            <Border Style="{StaticResource KitIconBadgeStyle}">
                                                <FontIcon Glyph="&#xEC02;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ViewModel.HealthOverviewLabel, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="15" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedAuditLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource SubtleButtonStyle}"
                                                    Visibility="{x:Bind ViewModel.HasAiReport, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Click="OnJumpToAiReportClick"
                                                    Padding="8,4" CornerRadius="{StaticResource ControlCornerRadius}"
                                                    AutomationProperties.AutomationId="AIHub_ViewAiReportButton"
                                                    AutomationProperties.Name="{x:Bind ViewModel.ViewAiReportLabel}"
                                                    ToolTipService.ToolTip="{x:Bind ViewModel.JumpToAiReportHint}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE9D9;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{x:Bind ViewModel.ViewAiReportLabel}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                </StackPanel>
                                            </Button>
                                            <CalendarDatePicker x:Uid="AIHub_AuditDatePicker" Grid.Column="3" Width="150" MinHeight="32" CornerRadius="{StaticResource ControlCornerRadius}"
                                                                Date="{x:Bind ViewModel.SelectedAuditDate, Mode=OneWay}"
                                                                MaxDate="{x:Bind ViewModel.LatestSelectableAuditDate}"
                                                                DateChanged="OnAuditDateChanged" />
                                            <Button Grid.Column="4"
                                                    Style="{StaticResource KitCompactToolbarButtonStyle}"
                                                    Command="{x:Bind ViewModel.SelectLatestCommand}"
                                                    AutomationProperties.AutomationId="AIHub_SelectLatestButton"
                                                    AutomationProperties.Name="{x:Bind ViewModel.LatestAuditLabel, Mode=OneWay}"
                                                    ToolTipService.ToolTip="{x:Bind ViewModel.SelectedAuditLabel, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE823;" FontSize="11" />
                                                    <TextBlock Text="{x:Bind ViewModel.LatestAuditLabel, Mode=OneWay}" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- 2-Column Split: Score Hero on left, Summary and Priority callout on right -->
                                        <Grid x:Name="AuditOverviewGrid" ColumnDefinitions="2*,3*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="16">
                                            <!-- Left: Score Hero with Frosted Glass Badge & Visual Radial Ring Gauge Graphic (绘图) -->
                                            <Border x:Name="AuditScoreCard" CornerRadius="{StaticResource OverlayCornerRadius}" Padding="16,14"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                <StackPanel x:Name="AuditScoreSummary" Spacing="10" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind ViewModel.HealthScoreLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18" VerticalAlignment="Center">
                                                        <!-- Visual Circular Progress Ring Gauge (绘图) -->
                                                        <Grid Width="88" Height="88" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Ellipse Width="88" Height="88"
                                                                     Stroke="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                                     StrokeThickness="6" />
                                                            <ProgressRing IsIndeterminate="False"
                                                                          Value="{x:Bind HealthScoreToDouble(ViewModel.HealthScore), Mode=OneWay}"
                                                                          Maximum="100"
                                                                          Width="88" Height="88"
                                                                          Style="{x:Bind HealthScoreRingStyle(ViewModel.HealthScore), Mode=OneWay}"
                                                                          Visibility="{x:Bind ViewModel.HasAuditData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="0">
                                                                <TextBlock x:Name="AuditScoreText"
                                                                           Text="{x:Bind ViewModel.HealthScoreText, Mode=OneWay}"
                                                                           FontSize="26" FontWeight="Bold" FontFamily="{StaticResource KitMonoFontFamily}"
                                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                           HorizontalAlignment="Center" TextAlignment="Center" />
                                                                <TextBlock Text="/100" FontSize="10"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                           HorizontalAlignment="Center" TextAlignment="Center"
                                                                           Visibility="{x:Bind ViewModel.HasAuditData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Verdict & Summary on right of gauge -->
                                                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                                                                <Ellipse x:Name="AuditHealthIndicator" Width="10" Height="10" VerticalAlignment="Center"
                                                                         Visibility="{x:Bind ViewModel.HasAuditData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                         Style="{x:Bind HealthScoreStyle(ViewModel.HealthScore), Mode=OneWay}" />
                                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.HealthVerdict, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                           FontSize="14" TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center" />
                                                            </Grid>
                                                            <TextBlock Text="{x:Bind ViewModel.HealthSummaryText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                                            <Button Visibility="{x:Bind ViewModel.IsCriticalScore, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                    Command="{x:Bind ViewModel.FilterHighSeverityCommand}"
                                                                    Style="{StaticResource SubtleButtonStyle}" Padding="6,2" CornerRadius="4"
                                                                    HorizontalAlignment="Left"
                                                                    AutomationProperties.AutomationId="AIHub_FilterHighQuickActionButton"
                                                                    AutomationProperties.Name="{x:Bind ViewModel.FilterHighQuickActionLabel}"
                                                                    ToolTipService.ToolTip="{x:Bind ViewModel.FilterHighQuickActionHint}">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <FontIcon Glyph="&#xE7BA;" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                                                    <TextBlock Text="{x:Bind ViewModel.FilterHighQuickActionLabel}" FontSize="11" FontWeight="SemiBold"
                                                                               Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Right: Findings counters & Priority callout -->
                                            <StackPanel x:Name="AuditFindingsSummary" Grid.Column="1" Spacing="10">
                                                <TextBlock Text="{x:Bind ViewModel.FindingsInAuditLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                                <!-- 3 Distinct Metric Tiles for High, Medium, Low -->
                                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                                    <!-- High Card -->
                                                    <Border Style="{StaticResource KitMetricTileBorderStyle}">
                                                        <StackPanel Spacing="3">
                                                            <TextBlock Text="{x:Bind ViewModel.HighCount, Mode=OneWay}" Style="{StaticResource KitMetricTileValueStyle}" />
                                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                <Ellipse Width="6" Height="6" Fill="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{x:Bind ViewModel.HighLabel, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- Medium Card -->
                                                    <Border Grid.Column="1" Style="{StaticResource KitMetricTileBorderStyle}">
                                                        <StackPanel Spacing="3">
                                                            <TextBlock Text="{x:Bind ViewModel.MediumCount, Mode=OneWay}" Style="{StaticResource KitMetricTileValueStyle}" />
                                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                <Ellipse Width="6" Height="6" Fill="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{x:Bind ViewModel.MediumLabel, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- Low Card -->
                                                    <Border Grid.Column="2" Style="{StaticResource KitMetricTileBorderStyle}">
                                                        <StackPanel Spacing="3">
                                                            <TextBlock Text="{x:Bind ViewModel.LowCount, Mode=OneWay}" Style="{StaticResource KitMetricTileValueStyle}" />
                                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                <Ellipse Width="6" Height="6" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{x:Bind ViewModel.LowLabel, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <!-- Priority Callout Card ("优先处理") with Accent Border -->
                                                <Button Tag="{x:Bind ViewModel.AuditPriorityFinding, Mode=OneWay}" Click="OnPriorityFindingClick"
                                                        Style="{StaticResource KitInteractiveCardButtonStyle}"
                                                        Padding="14,10" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                        AutomationProperties.AutomationId="AIHub_PriorityFindingButton"
                                                        AutomationProperties.Name="{x:Bind ViewModel.AuditPriorityTitle, Mode=OneWay}"
                                                        ToolTipService.ToolTip="{x:Bind ViewModel.AuditPriorityTitle, Mode=OneWay}"
                                                        Visibility="{x:Bind ViewModel.HasAuditPriority, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="5" ColumnSpacing="8">
                                                        <Border CornerRadius="4" Padding="6,2" Background="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Left">
                                                            <TextBlock Text="{x:Bind ViewModel.PriorityCalloutBadgeText, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                        </Border>
                                                        <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.AuditPriorityTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                   FontSize="13" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.AuditPriorityAction, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Button>

                                                <!-- Empty State Callout when no priority finding -->
                                                <Border Padding="14,10" CornerRadius="{StaticResource OverlayCornerRadius}"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                        Visibility="{x:Bind ViewModel.HasAuditPriority, Converter={StaticResource ReverseBoolToVisibilityConverter}, Mode=OneWay}">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{x:Bind ViewModel.AuditSummaryEmptyTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13" TextWrapping="Wrap" />
                                                        <TextBlock Text="{x:Bind ViewModel.AuditSummaryEmptyText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Collapsible Audit Activity & Metadata in Expander -->
                                        <Border CornerRadius="{StaticResource OverlayCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <Expander Header="{x:Bind ViewModel.AuditActivityLabel, Mode=OneWay}"
                                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                      Background="Transparent" BorderThickness="0">
                                                <StackPanel Spacing="14" Padding="4,8">
                                                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
                                                        <StackPanel Spacing="3">
                                                            <TextBlock Text="{x:Bind ViewModel.AuditsLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Text="{x:Bind ViewModel.ActivityScansText, Mode=OneWay}" Style="{StaticResource KitMetricTileValueStyle}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="3">
                                                            <TextBlock Text="{x:Bind ViewModel.RecordedFindingsLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Text="{x:Bind ViewModel.ActivityFindingsText, Mode=OneWay}" Style="{StaticResource KitMetricTileValueStyle}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Spacing="3">
                                                            <TextBlock Text="{x:Bind ViewModel.ActiveDaysLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Text="{x:Bind ViewModel.ActiveDaysText, Mode=OneWay}" Style="{StaticResource KitMetricTileValueStyle}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" Spacing="3">
                                                            <TextBlock Text="{x:Bind ViewModel.HealthAverageLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Text="{x:Bind ViewModel.HealthAverageText, Mode=OneWay}" Style="{StaticResource KitMetricTileValueStyle}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Scan Details metadata row -->
                                                    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                                        <Grid ColumnDefinitions="*,*,2*,*" ColumnSpacing="16">
                                                            <StackPanel Spacing="3">
                                                                <TextBlock Text="{x:Bind ViewModel.ScanLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{x:Bind ViewModel.ScanTypeText, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Spacing="3">
                                                                <TextBlock Text="{x:Bind ViewModel.FinishedLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{x:Bind ViewModel.FinishedText, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Spacing="3">
                                                                <TextBlock Text="{x:Bind ViewModel.WindowLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{x:Bind ViewModel.WindowText, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="3" Spacing="3">
                                                                <TextBlock Text="{x:Bind ViewModel.EventsReadLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{x:Bind ViewModel.EventCountText, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Expander>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Findings by category surface with Glass Controls -->
                                <Border Style="{StaticResource KitCardSurfaceStyle}" Padding="20,18">
                                    <StackPanel Spacing="16">
                                        <!-- Heading & Count with Diagnostic Icon -->
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                            <Border Style="{StaticResource KitIconBadgeStyle}">
                                                <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="{ThemeResource SystemFillColorCautionBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ViewModel.FindingsHeading, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="15" />
                                                <TextBlock Text="{x:Bind ViewModel.FindingsSummaryText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Streamlined Filter & Search Toolbar in Frosted Container -->
                                        <Border CornerRadius="{StaticResource OverlayCornerRadius}" Padding="12"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <StackPanel Spacing="10">
                                                <!-- Row 1: Search Box + View Switcher + Reset Action -->
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"
                                                      Visibility="{x:Bind ViewModel.HasAuditData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBox Text="{x:Bind ViewModel.FindingSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}"
                                                             PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}"
                                                             Height="32" CornerRadius="{StaticResource ControlCornerRadius}" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                        <ToggleButton Tag="Priority" Style="{StaticResource KitFilterPillToggleStyle}"
                                                                      AutomationProperties.Name="{x:Bind ViewModel.PriorityViewLabel, Mode=OneWay}"
                                                                      IsChecked="{x:Bind ViewModel.IsPriorityView, Mode=OneWay}" Click="OnFindingsViewClick">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <FontIcon Glyph="&#xE735;" FontSize="11" />
                                                                <TextBlock Text="{x:Bind ViewModel.PriorityViewLabel, Mode=OneWay}" FontSize="12" />
                                                            </StackPanel>
                                                        </ToggleButton>
                                                        <ToggleButton Tag="All" Style="{StaticResource KitFilterPillToggleStyle}"
                                                                      AutomationProperties.Name="{x:Bind ViewModel.AllFindingsLabel, Mode=OneWay}"
                                                                      IsChecked="{x:Bind ViewModel.ShowAllFindings, Mode=OneWay}" Click="OnFindingsViewClick">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <FontIcon Glyph="&#xE8A1;" FontSize="11" />
                                                                <TextBlock Text="{x:Bind ViewModel.AllFindingsLabel, Mode=OneWay}" FontSize="12" />
                                                            </StackPanel>
                                                        </ToggleButton>
                                                        <Button Style="{StaticResource KitActionButtonStyle}"
                                                                Command="{x:Bind ViewModel.ResetFindingFiltersCommand}"
                                                                AutomationProperties.AutomationId="AIHub_ResetFindingFiltersButton"
                                                                Visibility="{x:Bind ViewModel.HasFindingFilters, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <FontIcon Glyph="&#xE711;" FontSize="11" />
                                                                <TextBlock Text="{x:Bind ViewModel.ResetFindingFiltersLabel}" FontSize="12" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Row 2: Severity Filter Pills -->
                                                <tkcontrols:WrapPanel HorizontalSpacing="6" VerticalSpacing="6">
                                                    <ToggleButton Tag="All" Style="{StaticResource KitFilterPillToggleStyle}"
                                                                  AutomationProperties.AutomationId="AIHub_FilterAllButton"
                                                                  AutomationProperties.Name="{x:Bind FormatFilterCount(ViewModel.FilterAllLabel, ViewModel.TotalFindings), Mode=OneWay}"
                                                                  ToolTipService.ToolTip="{x:Bind FormatFilterCount(ViewModel.FilterAllLabel, ViewModel.TotalFindings), Mode=OneWay}"
                                                                  Click="OnFilterClick" IsChecked="{x:Bind ViewModel.IsFilterAll, Mode=OneWay}">
                                                        <TextBlock FontSize="12"><Run Text="{x:Bind ViewModel.FilterAllLabel, Mode=OneWay}" /><Run Text=" " /><Run Text="{x:Bind ViewModel.TotalFindings, Mode=OneWay}" /></TextBlock>
                                                    </ToggleButton>
                                                    <ToggleButton Tag="High" Style="{StaticResource KitFilterPillToggleStyle}"
                                                                  AutomationProperties.AutomationId="AIHub_FilterHighButton"
                                                                  AutomationProperties.Name="{x:Bind FormatFilterCount(ViewModel.HighLabel, ViewModel.HighCount), Mode=OneWay}"
                                                                  ToolTipService.ToolTip="{x:Bind FormatFilterCount(ViewModel.HighLabel, ViewModel.HighCount), Mode=OneWay}"
                                                                  Click="OnFilterClick" IsChecked="{x:Bind ViewModel.IsFilterHigh, Mode=OneWay}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Ellipse Width="7" Height="7" Fill="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" />
                                                            <TextBlock FontSize="12"><Run Text="{x:Bind ViewModel.HighLabel, Mode=OneWay}" /><Run Text=" " /><Run Text="{x:Bind ViewModel.HighCount, Mode=OneWay}" /></TextBlock>
                                                        </StackPanel>
                                                    </ToggleButton>
                                                    <ToggleButton Tag="Medium" Style="{StaticResource KitFilterPillToggleStyle}"
                                                                  AutomationProperties.AutomationId="AIHub_FilterMediumButton"
                                                                  AutomationProperties.Name="{x:Bind FormatFilterCount(ViewModel.MediumLabel, ViewModel.MediumCount), Mode=OneWay}"
                                                                  ToolTipService.ToolTip="{x:Bind FormatFilterCount(ViewModel.MediumLabel, ViewModel.MediumCount), Mode=OneWay}"
                                                                  Click="OnFilterClick" IsChecked="{x:Bind ViewModel.IsFilterMedium, Mode=OneWay}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Ellipse Width="7" Height="7" Fill="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                                                            <TextBlock FontSize="12"><Run Text="{x:Bind ViewModel.MediumLabel, Mode=OneWay}" /><Run Text=" " /><Run Text="{x:Bind ViewModel.MediumCount, Mode=OneWay}" /></TextBlock>
                                                        </StackPanel>
                                                    </ToggleButton>
                                                    <ToggleButton Tag="Low" Style="{StaticResource KitFilterPillToggleStyle}"
                                                                  AutomationProperties.AutomationId="AIHub_FilterLowButton"
                                                                  AutomationProperties.Name="{x:Bind FormatFilterCount(ViewModel.LowLabel, ViewModel.LowCount), Mode=OneWay}"
                                                                  ToolTipService.ToolTip="{x:Bind FormatFilterCount(ViewModel.LowLabel, ViewModel.LowCount), Mode=OneWay}"
                                                                  Click="OnFilterClick" IsChecked="{x:Bind ViewModel.IsFilterLow, Mode=OneWay}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Ellipse Width="7" Height="7" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                            <TextBlock FontSize="12"><Run Text="{x:Bind ViewModel.LowLabel, Mode=OneWay}" /><Run Text=" " /><Run Text="{x:Bind ViewModel.LowCount, Mode=OneWay}" /></TextBlock>
                                                        </StackPanel>
                                                    </ToggleButton>
                                                </tkcontrols:WrapPanel>

                                                <!-- Row 3: Channel / Source Filter Pills -->
                                                <tkcontrols:WrapPanel HorizontalSpacing="6" VerticalSpacing="6">
                                                    <ToggleButton Tag="All" Style="{StaticResource KitFilterPillToggleStyle}"
                                                                  AutomationProperties.Name="{x:Bind ViewModel.OverviewLabel, Mode=OneWay}"
                                                                  Content="{x:Bind ViewModel.OverviewLabel, Mode=OneWay}"
                                                                  IsChecked="{x:Bind ViewModel.IsSourceAll, Mode=OneWay}" Click="OnSourceFilterClick" />
                                                    <ToggleButton Tag="Application" Style="{StaticResource KitFilterPillToggleStyle}"
                                                                  AutomationProperties.Name="{x:Bind ViewModel.ApplicationLabel, Mode=OneWay}"
                                                                  Content="{x:Bind ViewModel.ApplicationLabel, Mode=OneWay}"
                                                                  IsChecked="{x:Bind ViewModel.IsSourceApplication, Mode=OneWay}" Click="OnSourceFilterClick" />
                                                    <ToggleButton Tag="Security" Style="{StaticResource KitFilterPillToggleStyle}"
                                                                  AutomationProperties.Name="{x:Bind ViewModel.SecurityLabel, Mode=OneWay}"
                                                                  Content="{x:Bind ViewModel.SecurityLabel, Mode=OneWay}"
                                                                  IsChecked="{x:Bind ViewModel.IsSourceSecurity, Mode=OneWay}" Click="OnSourceFilterClick" />
                                                    <ToggleButton Tag="System" Style="{StaticResource KitFilterPillToggleStyle}"
                                                                  AutomationProperties.Name="{x:Bind ViewModel.SystemLabel, Mode=OneWay}"
                                                                  Content="{x:Bind ViewModel.SystemLabel, Mode=OneWay}"
                                                                  IsChecked="{x:Bind ViewModel.IsSourceSystem, Mode=OneWay}" Click="OnSourceFilterClick" />
                                                    <ToggleButton Tag="Setup" Style="{StaticResource KitFilterPillToggleStyle}"
                                                                  AutomationProperties.Name="{x:Bind ViewModel.SetupLabel, Mode=OneWay}"
                                                                  Content="{x:Bind ViewModel.SetupLabel, Mode=OneWay}"
                                                                  IsChecked="{x:Bind ViewModel.IsSourceSetup, Mode=OneWay}" Click="OnSourceFilterClick" />
                                                    <ToggleButton Tag="ForwardedEvents" Style="{StaticResource KitFilterPillToggleStyle}"
                                                                  AutomationProperties.Name="{x:Bind ViewModel.ForwardedLabel, Mode=OneWay}"
                                                                  Content="{x:Bind ViewModel.ForwardedLabel, Mode=OneWay}"
                                                                  IsChecked="{x:Bind ViewModel.IsSourceForwarded, Mode=OneWay}" Click="OnSourceFilterClick" />
                                                </tkcontrols:WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Priority View (Flat Top-5) -->
                                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.ShowPriorityFindings, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{x:Bind ViewModel.PriorityPreviewLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.PriorityFindings, Mode=OneWay}" ItemTemplate="{StaticResource FindingPreviewTemplate}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Spacing="0" ChildrenTransitions="{StaticResource SettingsCardsAnimations}" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Category Grouped Expanders View -->
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.FindingSections, Mode=OneWay}"
                                                      Visibility="{x:Bind ViewModel.ShowAllFindings, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="0" ChildrenTransitions="{StaticResource SettingsCardsAnimations}" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewModels:FindingSection">
                                                    <Border Margin="0,0,0,8" CornerRadius="{StaticResource OverlayCornerRadius}"
                                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                  IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                                                  Background="Transparent" BorderThickness="0">
                                                            <Expander.Header>
                                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14" Padding="0,4" HorizontalAlignment="Stretch">
                                                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                                        <TextBlock Text="{x:Bind SeveritySummary}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                                        <Border Width="{x:Bind HighBarWidth}" Height="6" CornerRadius="3" Background="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind HasHigh, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                        <Border Width="{x:Bind MediumBarWidth}" Height="6" CornerRadius="3" Background="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind HasMedium, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                        <Border Width="{x:Bind LowBarWidth}" Height="6" CornerRadius="3" Background="{ThemeResource SystemFillColorAttentionBrush}" Visibility="{x:Bind HasLow, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="2" Text="{x:Bind CountLabel}" Style="{StaticResource CaptionTextBlockStyle}" MinWidth="76" TextAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                </Grid>
                                                            </Expander.Header>
                                                            <ItemsControl ItemsSource="{x:Bind Issues}" ItemTemplate="{StaticResource FindingPreviewTemplate}" Margin="0,4,0,0">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Spacing="0" ChildrenTransitions="{StaticResource SettingsCardsAnimations}" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </Expander>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Empty States with Rich Visual Illustration (绘图) -->
                                        <StackPanel Padding="0,32" Spacing="8" HorizontalAlignment="Center" Visibility="{x:Bind ViewModel.ShowNoAudit, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border Width="48" Height="48" CornerRadius="24" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE9D9;" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{x:Bind ViewModel.HealthVerdict, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="15" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind ViewModel.HealthSummaryText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" />
                                        </StackPanel>
                                        <StackPanel Padding="0,32" Spacing="8" HorizontalAlignment="Center" Visibility="{x:Bind ViewModel.ShowEmptyIssues, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border Width="48" Height="48" CornerRadius="24" Background="{ThemeResource BadgeSuccessBackgroundBrush}" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE73E;" FontSize="22" Foreground="{ThemeResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{x:Bind ViewModel.EmptyFindingsTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="15" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind ViewModel.EmptyFindingsDescription, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" MaxWidth="420" />
                                        </StackPanel>
                                        <StackPanel Padding="0,32" Spacing="10" HorizontalAlignment="Center" Visibility="{x:Bind ViewModel.ShowNoFilterMatches, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <!-- Visual Empty State Drawing (绘图) -->
                                            <Border Width="52" Height="52" CornerRadius="26"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                    HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE721;" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{x:Bind ViewModel.NoMatchingFindingsTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="15" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind ViewModel.NoMatchingFindingsDescription, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" MaxWidth="380" />
                                            <Button Style="{StaticResource KitActionButtonStyle}"
                                                    Command="{x:Bind ViewModel.ResetFindingFiltersCommand}"
                                                    HorizontalAlignment="Center" Margin="0,4,0,0">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE711;" FontSize="11" />
                                                    <TextBlock Text="{x:Bind ViewModel.ResetFindingFiltersLabel}" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- AI deep-analysis report (produced by the configured Codex/Pi kernel) -->
                                <Border x:Name="AuditAiReport" Style="{StaticResource KitCardSurfaceStyle}" Padding="18,16"
                                        Visibility="{x:Bind ViewModel.HasAiReport, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Spacing="14">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                            <Border Style="{StaticResource KitIconBadgeSmallStyle}">
                                                <FontIcon Glyph="&#xE9D9;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AiReportSummaryText, Mode=OneWay}"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Style="{StaticResource SubtleButtonStyle}" Padding="8,4" CornerRadius="4"
                                                    Click="OnCopyAiReportClick"
                                                    AutomationProperties.AutomationId="AIHub_CopyAiReportButton"
                                                    AutomationProperties.Name="{x:Bind ViewModel.CopyReportLabel}"
                                                    ToolTipService.ToolTip="{x:Bind ViewModel.CopyAiReportHint}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                                    <TextBlock Text="{x:Bind ViewModel.CopyReportLabel}" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                            <Border Grid.Column="3" CornerRadius="4" Padding="6,2" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ViewModel.AiReportMetaText, Mode=OneWay}"
                                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </Grid>
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.AiReportFindings, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="0" ChildrenTransitions="{StaticResource SettingsCardsAnimations}" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewModels:AiReportFinding">
                                                    <Border Margin="0,0,0,8" Padding="14,10" CornerRadius="{StaticResource OverlayCornerRadius}"
                                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                        <StackPanel Spacing="6">
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                                                <Border Grid.Column="1" CornerRadius="4" Padding="6,1" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                                    <TextBlock Text="{x:Bind SeverityLabel}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                            <Border CornerRadius="6" Padding="10,6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                                <TextBlock Text="{x:Bind Recommendation}" Style="{StaticResource CaptionTextBlockStyle}"
                                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ============================================================== -->
                            <!-- TAB 2: OPTIMIZATION                                            -->
                            <!-- ============================================================== -->
                            <StackPanel x:Name="OptimizationPanel" Spacing="16" HorizontalAlignment="Stretch" Visibility="{x:Bind IsOptTab(ViewModel.ActiveTabIndex), Mode=OneWay}">
                                <Border x:Name="OptimizationWorkflowCard"
                                        Style="{StaticResource KitWorkflowCardStyle}"
                                        Visibility="{x:Bind ViewModel.IsWorkflowVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE9F5;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ScanPhaseText, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.OptimizationWorkflowPercentText, Mode=OneWay}"
                                                       FontSize="14" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" FontFamily="{StaticResource KitMonoFontFamily}" VerticalAlignment="Center" />
                                        </Grid>
                                        <ProgressBar x:Name="OptimizationWorkflowProgress"
                                                     Style="{StaticResource KitProgressBarStyle}"
                                                     Minimum="0" Maximum="100"
                                                     Value="{x:Bind ViewModel.OptimizationWorkflowPercent, Mode=OneWay}"
                                                     IsIndeterminate="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                                                     AutomationProperties.Name="{x:Bind ViewModel.OptimizationWorkflowTitle}"
                                                     AutomationProperties.HelpText="{x:Bind ViewModel.OptimizationWorkflowStatus, Mode=OneWay}" />
                                        <TextBlock x:Name="OptimizationWorkflowStatus" Text="{x:Bind ViewModel.OptimizationWorkflowStatus, Mode=OneWay}"
                                                   FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <!-- Optimization Header directly on Mica Canvas with Clean Icon Badge -->
                                <Grid x:Name="OptimizationCommandHeader" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="12" ColumnSpacing="12" Margin="0,4,0,0">
                                    <Grid x:Name="OptimizationCommandTitle" ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                                        <Border Style="{StaticResource KitIconBadgeStyle}">
                                            <FontIcon Glyph="&#xE9F5;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.OptimizationTabLabel, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" AutomationProperties.HeadingLevel="Level2" />
                                            <Border CornerRadius="6" Padding="8,2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" HorizontalAlignment="Left"
                                                    Visibility="{x:Bind ViewModel.OptimizationWorkflowStatus, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}">
                                                <TextBlock Text="{x:Bind ViewModel.OptimizationWorkflowStatus, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <tkcontrols:WrapPanel x:Name="OptimizationCommandActions" Grid.Column="1" HorizontalSpacing="8" VerticalSpacing="8" VerticalAlignment="Center">
                                        <ProgressRing IsActive="{x:Bind ViewModel.IsOptimizing, Mode=OneWay}" Width="18" Height="18"
                                                      Visibility="{x:Bind ViewModel.IsOptimizing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <Button Command="{x:Bind ViewModel.ScanAllCommand}"
                                                Style="{StaticResource KitActionButtonStyle}"
                                                AutomationProperties.AutomationId="AIHub_RescanOptimization">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE72C;" FontSize="11" />
                                                <TextBlock Text="{x:Bind ViewModel.ScanAllLabel, Mode=OneWay}" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{x:Bind ViewModel.CleanAllCommand}" IsEnabled="{x:Bind ViewModel.CanCleanAll, Mode=OneWay}"
                                                Style="{StaticResource KitPrimaryActionButtonStyle}"
                                                AutomationProperties.AutomationId="AIHub_CleanAll">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE9F5;" FontSize="12" />
                                                <TextBlock Text="{x:Bind ViewModel.CleanAllLabel, Mode=OneWay}" FontSize="13" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{x:Bind ViewModel.CancelOptimizationCommand}"
                                                Style="{StaticResource KitActionButtonStyle}"
                                                AutomationProperties.AutomationId="AIHub_CancelOptimizationButton"
                                                AutomationProperties.Name="{x:Bind ViewModel.CancelTaskLabel, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind ViewModel.CancelTaskLabel, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE711;" FontSize="11" />
                                                <TextBlock Text="{x:Bind ViewModel.CancelTaskLabel, Mode=OneWay}" FontSize="13" />
                                            </StackPanel>
                                        </Button>
                                    </tkcontrols:WrapPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                    <Border Grid.Column="0" Style="{StaticResource KitMetricTileBorderStyle}">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{x:Bind ViewModel.ScannedCandidatesLabel}" Style="{StaticResource KitMetricTileLabelStyle}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:Name="OptimizationScannedCandidatesText" Text="{x:Bind ViewModel.ScannedCandidatesText, Mode=OneWay}"
                                                       Style="{StaticResource KitMetricTileValueStyle}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource KitMetricTileBorderStyle}">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{x:Bind ViewModel.ApprovedCandidatesLabel}" Style="{StaticResource KitMetricTileLabelStyle}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:Name="OptimizationApprovedCandidatesText" Text="{x:Bind ViewModel.ApprovedCandidatesText, Mode=OneWay}"
                                                       Style="{StaticResource KitMetricTileValueStyle}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource KitMetricTileBorderStyle}">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{x:Bind ViewModel.CleanableCapacityLabel}" Style="{StaticResource KitMetricTileLabelStyle}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:Name="OptimizationCleanableCapacityText" Text="{x:Bind ViewModel.CleanableCapacityText, Mode=OneWay}"
                                                       Style="{StaticResource KitMetricTileValueStyle}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border x:Name="InventoryPanel" AutomationProperties.AutomationId="InventoryPanel"
                                        Style="{StaticResource KitCardSurfaceStyle}" Padding="20,18">
                                    <StackPanel Spacing="14">
                                        <Grid x:Name="InventoryHeader" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                                            <StackPanel x:Name="InventoryTitle" Spacing="5">
                                                <TextBlock x:Uid="AIHub_Inventory_Title" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18"
                                                           AutomationProperties.HeadingLevel="Level2" />
                                                <TextBlock x:Uid="AIHub_Inventory_Description" FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <tkcontrols:WrapPanel x:Name="InventoryActions" Grid.Column="1" HorizontalAlignment="Right" HorizontalSpacing="8" VerticalSpacing="6">
                                                <Button x:Uid="AIHub_Inventory_AnalyzeButton" Command="{x:Bind ViewModel.AnalyzeStorageCommand}"
                                                        IsEnabled="{x:Bind ViewModel.CanAnalyzeStorage, Mode=OneWay}"
                                                        AutomationProperties.AutomationId="AIHub_AnalyzeStorage" Style="{StaticResource KitActionButtonStyle}" />
                                                <Button x:Uid="AIHub_Inventory_StopButton" Command="{x:Bind ViewModel.CancelInventoryCommand}"
                                                        IsEnabled="{x:Bind ViewModel.CanCancelInventory, Mode=OneWay}"
                                                        Visibility="{x:Bind ViewModel.IsInventoryScanning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        AutomationProperties.AutomationId="AIHub_CancelInventory" Style="{StaticResource KitActionButtonStyle}" />
                                            </tkcontrols:WrapPanel>
                                        </Grid>
                                        <ProgressBar IsIndeterminate="True" Style="{StaticResource KitProgressBarStyle}"
                                                     Visibility="{x:Bind ViewModel.IsInventoryScanning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                     AutomationProperties.Name="{x:Bind ViewModel.InventoryStatusText, Mode=OneWay}" />
                                        <TextBlock x:Name="InventoryStatusText" Text="{x:Bind ViewModel.InventoryStatusText, Mode=OneWay}" TextWrapping="Wrap"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasInventory, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid x:Name="InventoryMetricsGrid" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                                                <Border x:Name="InventoryObservedTile" Style="{StaticResource KitMetricTileBorderStyle}">
                                                    <StackPanel Spacing="5">
                                                        <TextBlock x:Uid="AIHub_Inventory_ObservedLabel" Style="{StaticResource KitMetricTileLabelStyle}" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="InventoryObservedSizeText" Text="{x:Bind ViewModel.Inventory.ObservedSizeText, Mode=OneWay}"
                                                                   Style="{StaticResource KitMetricTileValueStyle}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="InventoryRecentTile" Grid.Column="1" Style="{StaticResource KitMetricTileBorderStyle}">
                                                    <StackPanel Spacing="5">
                                                        <TextBlock x:Uid="AIHub_Inventory_RecentLabel" Style="{StaticResource KitMetricTileLabelStyle}" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="InventoryRecentSizeText" Text="{x:Bind ViewModel.Inventory.RecentSizeText, Mode=OneWay}"
                                                                   Style="{StaticResource KitMetricTileValueStyle}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="InventoryOldTile" Grid.Column="2" Style="{StaticResource KitMetricTileBorderStyle}">
                                                    <StackPanel Spacing="5">
                                                        <TextBlock x:Uid="AIHub_Inventory_OldLabel" Style="{StaticResource KitMetricTileLabelStyle}" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="InventoryOldSizeText" Text="{x:Bind ViewModel.Inventory.OldSizeText, Mode=OneWay}"
                                                                   Style="{StaticResource KitMetricTileValueStyle}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Uid="AIHub_Inventory_SizeCaveat" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="InventoryCoverageText" Text="{x:Bind ViewModel.Inventory.CoverageSummary, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" />
                                            <TextBlock x:Uid="AIHub_Inventory_PartialHint" TextWrapping="Wrap" FontSize="12"
                                                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                       Visibility="{x:Bind ViewModel.Inventory.IsPartial, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBlock Text="{x:Bind ViewModel.Inventory.SnapshotText, Mode=OneWay}" TextWrapping="Wrap" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Grid x:Name="InventoryFilters" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                                <TextBox x:Name="InventorySearchBox" x:Uid="AIHub_Inventory_SearchBox" AutomationProperties.AutomationId="InventorySearchBox"
                                                         Text="{x:Bind ViewModel.Inventory.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <ComboBox x:Name="InventoryFilterComboBox" x:Uid="AIHub_Inventory_FilterComboBox" Grid.Column="1" MinWidth="160"
                                                          AutomationProperties.AutomationId="InventoryFilterComboBox" HorizontalAlignment="Right"
                                                          ItemsSource="{x:Bind ViewModel.Inventory.FilterOptions}"
                                                          SelectedIndex="{x:Bind ViewModel.Inventory.FilterIndex, Mode=TwoWay}" />
                                            </Grid>
                                            <TextBlock Text="{x:Bind ViewModel.Inventory.FilterSummary, Mode=OneWay}" TextWrapping="Wrap" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <ListView x:Name="InventoryScopeList" AutomationProperties.AutomationId="InventoryScopeList"
                                                      ItemsSource="{x:Bind ViewModel.Inventory.FilteredRows, Mode=OneWay}"
                                                      ItemTemplate="{StaticResource OptimizationInventoryScopeTemplate}"
                                                      ItemContainerStyle="{StaticResource OptimizationItemContainerStyle}"
                                                      SelectionMode="None" HorizontalContentAlignment="Stretch" MaxHeight="600"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                            <TextBlock x:Name="InventoryNoMatches" x:Uid="AIHub_Inventory_NoMatches" TextWrapping="Wrap" FontSize="12"
                                                       Visibility="{x:Bind ViewModel.Inventory.HasFilteredRows, Mode=OneWay, Converter={StaticResource ReverseBoolToVisibilityConverter}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource KitCardSurfaceStyle}" Padding="16"
                                        Visibility="{x:Bind ViewModel.HasOptimizationResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Spacing="12">
                                        <Grid x:Name="OptimizationReviewFilters" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="12">
                                            <TextBox x:Name="OptimizationSearchBox" x:Uid="AIHub_OptimizationSearchBox"
                                                     Text="{x:Bind ViewModel.OptimizationSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <ComboBox x:Name="OptimizationReviewFilter" x:Uid="AIHub_OptimizationReviewFilter" Grid.Column="1"
                                                      ItemsSource="{x:Bind ViewModel.OptimizationFilterOptions}"
                                                      SelectedIndex="{x:Bind ViewModel.OptimizationFilterIndex, Mode=TwoWay}" MinWidth="150" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind ViewModel.FilteredCandidatesSummary, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        <tkcontrols:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                            <Button x:Uid="AIHub_SelectVisibleButton" Command="{x:Bind ViewModel.SelectAllCandidatesCommand}" Style="{StaticResource KitActionButtonStyle}" />
                                            <Button x:Uid="AIHub_DeselectVisibleButton" Command="{x:Bind ViewModel.DeselectAllCandidatesCommand}" Style="{StaticResource KitActionButtonStyle}" />
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0">
                                                <TextBlock x:Uid="AIHub_SelectedCandidatesLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock x:Name="OptimizationSelectionSummary" Text="{x:Bind ViewModel.SelectedCandidatesSummary, Mode=OneWay}" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <Button x:Uid="AIHub_ExecuteSelectedButton" Command="{x:Bind ViewModel.ExecuteOptimizationCommand}"
                                                    AutomationProperties.AutomationId="AIHub_ExecuteSelected" Style="{StaticResource KitPrimaryActionButtonStyle}" />
                                        </tkcontrols:WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="OptimizationNoResults" Style="{StaticResource KitCardSurfaceStyle}" Padding="20"
                                        Visibility="{x:Bind ViewModel.HasOptimizationResults, Mode=OneWay, Converter={StaticResource ReverseBoolToVisibilityConverter}}">
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Uid="AIHub_OptimizationNoResultsTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Uid="AIHub_OptimizationNoResultsDescription" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="OptimizationNoFilterMatches" Style="{StaticResource KitCardSurfaceStyle}" Padding="20"
                                        Visibility="{x:Bind ShowOptimizationNoMatches(ViewModel.HasOptimizationResults, ViewModel.HasFilteredOptimizationResults), Mode=OneWay}">
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Uid="AIHub_OptimizationNoFilterMatchesTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Uid="AIHub_OptimizationNoFilterMatchesDescription" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <!-- Downloads Management Section Card -->
                                <Border Style="{StaticResource KitCardSurfaceStyle}" Padding="20,18">
                                    <StackPanel Spacing="14">
                                        <Grid x:Name="DownloadsCommandHeader" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel x:Name="DownloadsCommandTitle" Spacing="4">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                    <Border Style="{StaticResource KitIconBadgeStyle}">
                                                        <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind ViewModel.DownloadsLabel, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Grid>
                                                <Border CornerRadius="4" Padding="6,2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" HorizontalAlignment="Left" Margin="0,4,0,0">
                                                    <TextBlock Text="{x:Bind ViewModel.DownloadsPath}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="{StaticResource KitMonoFontFamily}" />
                                                </Border>
                                                <TextBlock Text="{x:Bind ViewModel.DownloadsResultSummary, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" FontWeight="Medium" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <tkcontrols:WrapPanel x:Name="DownloadsCommandActions" Grid.Column="1" HorizontalSpacing="8" VerticalSpacing="8" VerticalAlignment="Center">
                                                <Button Command="{x:Bind ViewModel.ScanDownloadsCommand}"
                                                        Style="{StaticResource KitActionButtonStyle}"
                                                        AutomationProperties.AutomationId="AIHub_ScanDownloads">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE721;" FontSize="11" />
                                                        <TextBlock Text="{x:Bind ViewModel.ScanButtonLabel}" FontSize="12" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Command="{x:Bind ViewModel.OrganizeDownloadsCommand}"
                                                        Style="{StaticResource KitActionButtonStyle}"
                                                        AutomationProperties.AutomationId="AIHub_OrganizeDownloads">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE8B7;" FontSize="11" />
                                                        <TextBlock Text="{x:Bind ViewModel.OrganizeDownloadsLabel}" FontSize="12" />
                                                    </StackPanel>
                                                </Button>
                                            </tkcontrols:WrapPanel>
                                        </Grid>
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.DownloadCategories}" ItemTemplate="{StaticResource OptimizationCategoryTemplate}" HorizontalContentAlignment="Stretch"
                                                      ItemContainerStyle="{StaticResource OptimizationPresenterStyle}"
                                                      IsEnabled="{x:Bind ViewModel.CanSelectOptimizationItems, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="0" ChildrenTransitions="{StaticResource SettingsCardsAnimations}" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Caches & Temporary Files Section Card -->
                                <Border Style="{StaticResource KitCardSurfaceStyle}" Padding="20,18">
                                    <StackPanel Spacing="14">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                    <Border Style="{StaticResource KitIconBadgeStyle}">
                                                        <FontIcon Glyph="&#xEDA2;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind ViewModel.TemporaryFilesLabel, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" />
                                                        <TextBlock Text="{x:Bind ViewModel.CacheResultSummary, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                            <Button Grid.Column="1" Command="{x:Bind ViewModel.ScanTemporaryFilesCommand}"
                                                    Style="{StaticResource KitActionButtonStyle}"
                                                    VerticalAlignment="Center" AutomationProperties.AutomationId="AIHub_ScanCaches">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE721;" FontSize="11" />
                                                    <TextBlock Text="{x:Bind ViewModel.ScanButtonLabel}" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- User Directory Space Analysis Expander in Translucent Container -->
                                        <Border CornerRadius="{StaticResource OverlayCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                Visibility="{x:Bind ViewModel.HasUserDirectorySummaries, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Expander Header="{x:Bind ViewModel.UserDirectoryLabel}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                      Background="Transparent" BorderThickness="0">
                                                <ItemsControl ItemsSource="{x:Bind ViewModel.UserDirectorySummaries}" HorizontalContentAlignment="Stretch" Padding="6,8">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Spacing="0" ChildrenTransitions="{StaticResource SettingsCardsAnimations}" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Text="{x:Bind}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="{StaticResource KitMonoFontFamily}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </Border>

                                        <!-- Broad Cache Groups with Modern Frosted Card Expanders -->
                                        <ItemsControl x:Name="OptimizationCacheGroups" ItemsSource="{x:Bind ViewModel.CacheGroups}" HorizontalContentAlignment="Stretch"
                                                      ItemContainerStyle="{StaticResource OptimizationPresenterStyle}"
                                                      IsEnabled="{x:Bind ViewModel.CanSelectOptimizationItems, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewModels:OptimizationGroupViewModel">
                                                    <Border Margin="0,0,0,8" CornerRadius="{StaticResource OverlayCornerRadius}" HorizontalAlignment="Stretch"
                                                            Visibility="{x:Bind HasVisibleItems, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                  IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                                                  Background="Transparent" BorderThickness="0">
                                                             <Expander.Header>
                                                                <Grid x:Name="OptimizationFamilyHeader" ColumnSpacing="14" MinHeight="52" Padding="0,2" HorizontalAlignment="Stretch">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Style="{StaticResource KitIconBadgeStyle}">
                                                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                        <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                                                                        <TextBlock Text="{x:Bind Summary}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Summary}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="2" Text="{x:Bind Size}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="12,0" FontFamily="{StaticResource KitMonoFontFamily}" />
                                                                    <Button Grid.Column="3" Content="{x:Bind CleanLabel}" Command="{x:Bind ExecuteCommand}"
                                                                            Style="{StaticResource KitActionButtonStyle}"
                                                                            IsEnabled="{x:Bind IsEnabled, Mode=OneWay}" VerticalAlignment="Center">
                                                                    </Button>
                                                                </Grid>
                                                            </Expander.Header>
                                                            <Border x:Name="OptimizationGroupDetails" x:Load="{x:Bind HasBeenExpanded, Mode=OneWay}"
                                                                    Padding="8,10,0,8">
                                                                <Grid>
                                                                    <ListView x:Name="OptimizationProjectList" x:Load="{x:Bind HasProjects}" ItemsSource="{x:Bind Projects}"
                                                                              ItemContainerStyle="{StaticResource OptimizationItemContainerStyle}"
                                                                              ItemTemplate="{StaticResource OptimizationProjectTemplate}" SelectionMode="None" MaxHeight="520" HorizontalContentAlignment="Stretch" />
                                                                    <ListView x:Name="OptimizationDirectCategoryList" x:Load="{x:Bind HasDirectCategories}" ItemsSource="{x:Bind Categories}"
                                                                              ItemContainerStyle="{StaticResource OptimizationItemContainerStyle}"
                                                                              ItemTemplate="{StaticResource OptimizationCategoryTemplate}" SelectionMode="None" MaxHeight="440" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                                                </Grid>
                                                            </Border>
                                                        </Expander>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource KitCardSurfaceStyle}" Padding="20,18">
                                    <StackPanel Spacing="12">
                                        <tkcontrols:WrapPanel HorizontalSpacing="12" VerticalSpacing="8">
                                            <TextBlock x:Uid="AIHub_OptimizationHistoryTitle" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="16"
                                                       VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                                            <Button x:Uid="AIHub_RefreshHistoryButton" Command="{x:Bind ViewModel.RefreshOptimizationHistoryCommand}" Style="{StaticResource KitActionButtonStyle}" />
                                        </tkcontrols:WrapPanel>
                                        <TextBlock x:Uid="AIHub_OptimizationHistoryEmpty" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Visibility="{x:Bind ViewModel.HasOptimizationHistory, Mode=OneWay, Converter={StaticResource ReverseBoolToVisibilityConverter}}" />
                                        <ListView x:Name="OptimizationHistoryList" ItemsSource="{x:Bind ViewModel.OptimizationHistory}"
                                                  SelectedItem="{x:Bind ViewModel.SelectedOptimizationRun, Mode=TwoWay}"
                                                  SelectionMode="Single" MaxHeight="240" HorizontalContentAlignment="Stretch"
                                                  Visibility="{x:Bind ViewModel.HasOptimizationHistory, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="viewModels:OptimizationRunViewModel">
                                                    <StackPanel Spacing="4" Padding="4,8">
                                                        <TextBlock Text="{x:Bind CompletedText}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <StackPanel Spacing="12" Visibility="{x:Bind HasSelectedRun(ViewModel.SelectedOptimizationRun), Mode=OneWay}">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedOptimizationRun.DetailsSummary, Mode=OneWay}"
                                                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <ListView ItemsSource="{x:Bind ViewModel.SelectedOptimizationRun.Details, Mode=OneWay}" MaxHeight="300"
                                                      SelectionMode="None" HorizontalContentAlignment="Stretch">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="models:OptimizationExecutionItemRecord">
                                                        <StackPanel Spacing="4" Padding="4,8">
                                                            <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            <TextBlock Text="{x:Bind views:AIHubPage.ExecutionItemSummary(Action, State)}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Text="{x:Bind SourcePath}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind SourcePath}" FontSize="11" />
                                                            <TextBlock Text="{x:Bind DestinationPath}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind DestinationPath}" FontSize="11"
                                                                       Visibility="{x:Bind DestinationPath, Converter={StaticResource StringVisibilityConverter}}" />
                                                            <TextBlock Text="{x:Bind Reason}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                       Visibility="{x:Bind Reason, Converter={StaticResource StringVisibilityConverter}}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                            <Button x:Uid="AIHub_CopyOptimizationReportButton" Click="OnCopyOptimizationReportClick"
                                                    Style="{StaticResource KitActionButtonStyle}" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ============================================================== -->
                            <!-- TAB 3: TASK POLICIES (per-chain AGENTS.md)                     -->
                            <!-- ============================================================== -->
                            <StackPanel x:Name="TaskPolicyPanel" x:Load="False" Spacing="16" Visibility="Collapsed">
                                <InfoBar x:Name="AiTaskPolicyStatus"
                                         AutomationProperties.LiveSetting="Assertive"
                                         IsClosable="True"
                                         IsOpen="{x:Bind ViewModel.AiHub.IsStatusOpen, Mode=TwoWay}"
                                         Visibility="{x:Bind ViewModel.AiHub.IsStatusOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                         Message="{x:Bind ViewModel.AiHub.StatusMessage, Mode=OneWay}"
                                         Severity="{x:Bind ViewModel.AiHub.StatusSeverity, Mode=OneWay}" />

                                <Border Style="{StaticResource KitCardSurfaceStyle}" Padding="20,18">
                                    <StackPanel Spacing="16">
                                        <!-- Header row with Policy Icon Badge -->
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <Border Style="{StaticResource KitIconBadgeStyle}">
                                                <FontIcon Glyph="&#xE8A5;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ViewModel.TaskPolicyTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="16" AutomationProperties.HeadingLevel="Level2" />
                                                <TextBlock Text="{x:Bind ViewModel.TaskPolicyDescription, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Each chain keeps its own draft until explicitly saved. -->
                                        <tkcontrols:Segmented
                                            x:Name="AiTaskPolicySegmented"
                                            SelectedIndex="{x:Bind ViewModel.AiHub.TaskPolicyIndex, Mode=TwoWay}"
                                            HorizontalAlignment="Left">
                                            <tkcontrols:SegmentedItem x:Uid="AIHub_Segment_SecurityAudit" Content="Security audit" Icon="{ui:FontIcon Glyph=&#xE72E;}" />
                                            <tkcontrols:SegmentedItem x:Uid="AIHub_Segment_Optimization" Content="Optimization" Icon="{ui:FontIcon Glyph=&#xE9F5;}" />
                                        </tkcontrols:Segmented>

                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind ViewModel.AiHub.CurrentPolicyStatusText, Mode=OneWay}"
                                                       FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                                            <TextBlock x:Uid="AIHub_TaskPolicyDraftHint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Visibility="{x:Bind ViewModel.AiHub.IsCurrentPolicyDirty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>

                                        <!-- Code Editor Frosted Container -->
                                        <Border CornerRadius="{StaticResource OverlayCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="14">
                                            <StackPanel Spacing="12">
                                                <TextBox
                                                    x:Name="AiTaskPolicyContentBox"
                                                    x:Uid="AIHub_TaskPolicyContentBox"
                                                    Loaded="OnTaskPolicyContentLoaded"
                                                    Text="{x:Bind ViewModel.AiHub.CurrentPolicyContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    IsReadOnly="{x:Bind ViewModel.AiHub.CanEditPolicies, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                                    AcceptsReturn="True"
                                                    TextWrapping="Wrap"
                                                    MinHeight="220"
                                                    MaxHeight="400"
                                                    MaxLength="64000"
                                                    FontFamily="{StaticResource KitMonoFontFamily}"
                                                    FontSize="12"
                                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                                    ScrollViewer.VerticalScrollBarVisibility="Auto" />

                                                <StackPanel Spacing="12">
                                                    <Border CornerRadius="{StaticResource ControlCornerRadius}" Padding="8,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                                        <TextBlock Text="{x:Bind ViewModel.AiHub.CurrentPolicyFilePath, Mode=OneWay}"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   FontFamily="{StaticResource KitMonoFontFamily}"
                                                                   ToolTipService.ToolTip="{x:Bind ViewModel.AiHub.CurrentPolicyFilePath, Mode=OneWay}"
                                                                   VerticalAlignment="Center" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                    </Border>
                                                    <tkcontrols:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" HorizontalAlignment="Right">
                                                    <Button x:Uid="AIHub_DiscardTaskPolicyButton"
                                                            Command="{x:Bind ViewModel.AiHub.DiscardActivePolicyCommand}"
                                                            Style="{StaticResource KitActionButtonStyle}" />
                                                    <Button x:Uid="AiHub_ResetPolicyButton"
                                                            AutomationProperties.AutomationId="AIHub_ResetTaskPolicyButton"
                                                            Command="{x:Bind ViewModel.AiHub.ResetActivePolicyCommand}"
                                                            Style="{StaticResource KitActionButtonStyle}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE777;" FontSize="12" />
                                                            <TextBlock x:Uid="AiHub_ResetPolicyButtonText" Text="Reset to default" FontSize="12" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button x:Uid="AiHub_SavePolicyButton"
                                                            AutomationProperties.AutomationId="AIHub_SaveTaskPolicyButton"
                                                            Style="{StaticResource KitPrimaryActionButtonStyle}"
                                                            Command="{x:Bind ViewModel.AiHub.SaveActivePolicyCommand}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE74E;" FontSize="12" />
                                                            <TextBlock x:Uid="AiHub_SavePolicyButtonText" Text="Save" FontSize="12" />
                                                        </StackPanel>
                                                    </Button>
                                                    </tkcontrols:WrapPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </ContentControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</local:NavigablePage>
