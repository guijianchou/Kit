                                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{x:Bind ViewModel.AuditsLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.ActivityScansText, Mode=OneWay}" Style="{StaticResource KitMetricTileValueStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{x:Bind ViewModel.RecordedFindingsLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.ActivityFindingsText, Mode=OneWay}" Style="{StaticResource KitMetricTileValueStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="3">
                                            <TextBlock Text="{x:Bind ViewModel.ActiveDaysLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.ActiveDaysText, Mode=OneWay}" Style="{StaticResource KitMetricTileValueStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Spacing="3">
                                            <TextBlock Text="{x:Bind ViewModel.HealthAverageLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.HealthAverageText, Mode=OneWay}" Style="{StaticResource KitMetricTileValueStyle}" />
                                        </StackPanel>
                                    </Grid>
                                    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                        <Grid ColumnDefinitions="*,*,2*,*" ColumnSpacing="16">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{x:Bind ViewModel.ScanLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.ScanTypeText, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock Text="{x:Bind ViewModel.FinishedLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.FinishedText, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="3">
                                                <TextBlock Text="{x:Bind ViewModel.WindowLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.WindowText, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Spacing="3">
                                                <TextBlock Text="{x:Bind ViewModel.EventsReadLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.EventCountText, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Expander>

                            <StackPanel Orientation="Horizontal" Spacing="6" Padding="2,0">
                                <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Uid="AIHub_Fluent_AuditBoundaryFooter" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <!-- TAB 1: SPACE OPTIMIZATION -->
                        <StackPanel x:Name="OptimizationPanel" Spacing="16" HorizontalAlignment="Stretch" Visibility="{x:Bind IsOptTab(ViewModel.ActiveTabIndex), Mode=OneWay}">
                            <Border x:Name="OptimizationWorkflowCard"
                                    Style="{StaticResource KitCardSurfaceStyle}"
                                    Visibility="{x:Bind ViewModel.IsWorkflowVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE9F5;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ScanPhaseText, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.OptimizationWorkflowPercentText, Mode=OneWay}"
                                                   FontSize="14" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" FontFamily="{StaticResource KitMonoFontFamily}" VerticalAlignment="Center" />
                                        <Button Grid.Column="3" Content="{x:Bind ViewModel.CancelTaskLabel}" Command="{x:Bind ViewModel.CancelOptimizationCommand}"
                                                Visibility="{x:Bind ViewModel.IsOptimizing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Style="{StaticResource KitActionButtonStyle}" />
                                    </Grid>
                                    <ProgressBar x:Name="OptimizationWorkflowProgress"
                                                 Style="{StaticResource KitProgressBarStyle}"
                                                 Minimum="0" Maximum="100"
                                                 Value="{x:Bind ViewModel.OptimizationWorkflowPercent, Mode=OneWay}"
