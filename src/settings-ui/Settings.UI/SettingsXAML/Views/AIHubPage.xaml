                                    <SplitButton x:Name="AuditScanButton" Click="OnSelectedScanClick" IsEnabledChanged="OnScanButtonIsEnabledChanged" IsEnabled="{x:Bind ViewModel.CanConfigureAudit, Mode=OneWay}"
