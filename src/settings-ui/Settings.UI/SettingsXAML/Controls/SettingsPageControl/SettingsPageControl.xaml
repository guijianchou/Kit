<UserControl
    x:Class="Kit.Settings.UI.Controls.SettingsPageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Kit.Settings.UI.Services"
    xmlns:controls="using:Kit.Settings.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">
    <Grid Padding="24,0,0,0" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid
            x:Name="PageHeaderGrid"
            MaxWidth="{StaticResource PageMaxWidth}"
            Margin="0,0,24,0"
            HorizontalAlignment="Stretch"
            ColumnDefinitions="*,Auto"
            RowDefinitions="Auto,Auto"
            ColumnSpacing="16">
            <TextBlock
                x:Name="Header"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                AutomationProperties.HeadingLevel="1"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind ModuleTitle, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind ModuleDescription, Mode=OneWay}" />
            <ContentPresenter
                x:Name="HeaderActionPresenter"
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Content="{x:Bind HeaderAction, Mode=OneWay}" />
            <StackPanel
                x:Name="CompactHeaderSubtitlePanel"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="0,6,0,0"
                Orientation="Vertical"
                Spacing="4"
                Visibility="{x:Bind GetCompactSubtitleVisibility(CompactHeader, ModuleDescription, PrimaryLinks.Count), Mode=OneWay}">
                <TextBlock
                    x:Name="CompactDescriptionText"
                    FontSize="{ThemeResource KitFontSize13}" services:TypographyResources.BaseFontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    MaxLines="2"
                    Text="{x:Bind ModuleDescription, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    ToolTipService.ToolTip="{x:Bind ModuleDescription, Mode=OneWay}"
                    Visibility="{x:Bind ModuleDescription, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}" />
                <ItemsControl
                    x:Name="CompactPrimaryLinksControl"
                    IsTabStop="False"
                    ItemsSource="{x:Bind PrimaryLinks, Mode=OneWay}"
                    Visibility="{x:Bind PrimaryLinks.Count, Mode=OneWay, Converter={StaticResource DoubleToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="controls:PageLink">
                            <HyperlinkButton
                                Padding="0"
                                FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12"
                                NavigateUri="{x:Bind Link}"
                                Style="{StaticResource TextButtonStyle}">
                                <TextBlock Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap" />
                            </HyperlinkButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <tkcontrols:WrapPanel HorizontalSpacing="16" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" AutomationProperties.AutomationId="PageScrollViewer">
            <Grid
                Padding="0,0,24,32"
                RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Top panel (shown only when not using compact Fluent header)  -->
                <controls:SettingsPageIntro
                    x:Name="PageIntro"
                    MaxWidth="{StaticResource PageMaxWidth}"
                    Margin="0,0,0,18"
                    ModuleDescription="{x:Bind ModuleDescription, Mode=OneWay}"
                    ModuleImageSource="{x:Bind ModuleImageSource, Mode=OneWay}"
                    PrimaryLinks="{x:Bind PrimaryLinks, Mode=OneWay}"
                    Visibility="{x:Bind GetLegacyIntroVisibility(CompactHeader, ModuleImageSource, ModuleDescription), Mode=OneWay}" />

                <!--  Content panel  -->
                <ContentPresenter
                    x:Name="ModuleContentPresenter"
                    Grid.Row="1"
                    MaxWidth="{StaticResource PageMaxWidth}"
                    Content="{x:Bind ModuleContent, Mode=OneWay}" />

                <!--  Bottom panel  -->
                <StackPanel
                    x:Name="SecondaryLinksPanel"
                    Grid.Row="2"
                    MaxWidth="{StaticResource PageMaxWidth}"
                    Margin="0,24,0,0"
                    AutomationProperties.Name="{x:Bind SecondaryLinksHeader, Mode=OneWay}"
                    Orientation="Vertical"
                    Spacing="8"
                    Visibility="{x:Bind SecondaryLinks.Count, Mode=OneWay, Converter={StaticResource DoubleToVisibilityConverter}}">
                    <Rectangle
                        Height="1"
                        HorizontalAlignment="Stretch"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind SecondaryLinksHeader, Mode=OneWay}" />
                    <ItemsControl
                        x:Name="SecondaryLinksItemControl"
                        IsTabStop="False"
                        ItemsSource="{x:Bind SecondaryLinks, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="controls:PageLink">
                                <HyperlinkButton NavigateUri="{x:Bind Link}" Style="{StaticResource TextButtonStyle}">
                                    <TextBlock Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap" />
                                </HyperlinkButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <tkcontrols:WrapPanel HorizontalSpacing="24" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
