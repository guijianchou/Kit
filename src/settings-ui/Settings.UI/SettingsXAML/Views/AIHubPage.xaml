                                                    <ItemsPanelTemplate>
                                                        <StackPanel Spacing="0" ChildrenTransitions="{StaticResource SettingsCardsAnimations}" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:AiReportFinding">
                                                        <Border Margin="0,0,0,8" Padding="14,10" CornerRadius="{StaticResource OverlayCornerRadius}"
