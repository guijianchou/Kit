<local:NavigablePage
    x:Class="Kit.Settings.UI.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Kit.Settings.UI.Services"
    xmlns:controlConverters="using:Kit.Settings.UI.Controls.Converters"
    xmlns:controls="using:Kit.Settings.UI.Controls"
    xmlns:converters="using:Kit.Settings.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Kit.Settings.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ptcontrols="using:Kit.Common.UI.Controls"
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:viewmodels="using:Kit.Settings.UI.ViewModels"
    AutomationProperties.LandmarkType="Main"
    NavigationCacheMode="Required"
    mc:Ignorable="d"
    FontFamily="{ThemeResource KitUiFontFamily}"
    FontSize="{ThemeResource KitFontSize14}" services:TypographyResources.BaseFontSize="14">
    <local:NavigablePage.Resources>
        <controlConverters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <converters:EnumToModuleListSortOptionConverter x:Key="EnumToModuleListSortOptionConverter" />
        <Style x:Key="DashboardDetailTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource KitFontSize14}" />
        <Setter Property="services:TypographyResources.BaseFontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="LineHeight" Value="{ThemeResource KitFontSize20}" />
        <Setter Property="services:TypographyResources.BaseLineHeight" Value="20" />
            <Setter Property="LineStackingStrategy" Value="MaxHeight" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="DashboardDetailValueStyle" TargetType="TextBlock" BasedOn="{StaticResource DashboardDetailTextStyle}">
            <Setter Property="FontFamily" Value="{ThemeResource KitUiFontFamily}" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <Style x:Key="DashboardSectionHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource DashboardDetailTextStyle}">
            <Setter Property="FontFamily" Value="{ThemeResource KitUiFontFamily}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="{ThemeResource KitFontSize24}" />
        <Setter Property="services:TypographyResources.BaseLineHeight" Value="24" />
        </Style>
        <Style x:Key="DashboardCardHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource KitUiFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource KitFontSize16}" />
        <Setter Property="services:TypographyResources.BaseFontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DashboardCardDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource KitUiFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource KitFontSize13}" />
        <Setter Property="services:TypographyResources.BaseFontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <DataTemplate x:Key="DashboardDetailTemplate" x:DataType="viewmodels:DashboardDetail">
            <Grid x:Name="DetailRow" Loaded="DetailRow_Loaded" Padding="0,5" ColumnSpacing="16" MinHeight="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{ThemeResource DashboardDetailLabelWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DetailLabel" Text="{x:Bind Label, Mode=OneWay}" Style="{StaticResource DashboardDetailTextStyle}" />
                <TextBlock x:Name="DetailValue" Grid.Column="1" Text="{x:Bind Value, Mode=OneWay}" Style="{StaticResource DashboardDetailValueStyle}"
                    Visibility="{x:Bind HasUsage, Converter={StaticResource ReverseBoolToVisibilityConverter}, Mode=OneWay}" />
                <Grid x:Name="UsageRow" Grid.Column="1" ColumnSpacing="12" VerticalAlignment="Top"
                    Visibility="{x:Bind HasUsage, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{ThemeResource DashboardUsageValueWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DetailUsageValue" Text="{x:Bind Value, Mode=OneWay}" Style="{StaticResource DashboardDetailValueStyle}" />
                    <Grid Grid.Column="1" Height="20" VerticalAlignment="Top">
                        <local:UsageProgressBar Height="4" MinHeight="4" CornerRadius="2"
                            Background="{ThemeResource ControlStrongStrokeColorDisabledBrush}"
                            VerticalAlignment="Center" Maximum="100" TargetValue="{x:Bind UsageValue, Mode=OneWay}"
                            local:UsageProgressBar.UsageCategory="{x:Bind UsageCategory, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind Label, Mode=OneWay}" AutomationProperties.HelpText="{x:Bind Value, Mode=OneWay}"
                            Visibility="{x:Bind HasUsage, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>
    </local:NavigablePage.Resources>

    <Grid Padding="24,8,0,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="DashboardHeader"
            MaxWidth="{StaticResource PageMaxWidth}"
            Margin="0,0,24,0"
            HorizontalAlignment="Stretch"
            ColumnSpacing="24" RowSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Name="DashboardHeading"
                x:Uid="DashboardTitle" services:RuntimeLocalization.Uid="DashboardTitle"
                AutomationProperties.HeadingLevel="1"
                VerticalAlignment="Center" TextWrapping="Wrap"
                Style="{StaticResource TitleTextBlockStyle}" />
            <StackPanel x:Name="DashboardVersionPanel" Grid.Column="1" HorizontalAlignment="Right"
                        VerticalAlignment="Center" MaxWidth="280" Spacing="2">
                <TextBlock x:Name="DashboardVersionText" Text="{x:Bind ViewModel.KitVersionLabel, Mode=OneWay}"
                           HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"
                           Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <HyperlinkButton x:Name="DashboardUpdateNoticeButton" Click="UpdateNotice_Click"
                                 Padding="0" MinHeight="0" HorizontalAlignment="Right" HorizontalContentAlignment="Right"
                                 AutomationProperties.Name="{x:Bind ViewModel.KitUpdateNotice, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.HasKitUpdateNotice, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock x:Name="DashboardUpdateNoticeText" Text="{x:Bind ViewModel.KitUpdateNotice, Mode=OneWay}"
                               TextAlignment="Right" TextWrapping="Wrap" />
                </HyperlinkButton>
            </StackPanel>
            <TextBlock
                x:Name="DashboardIntroduction" Grid.Row="1" Grid.ColumnSpan="2"
                x:Uid="DashboardIntro" services:RuntimeLocalization.Uid="DashboardIntro"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="WrapWholeWords"
                Style="{StaticResource BodyTextBlockStyle}" />
        </Grid>

        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1">
            <Grid Padding="0,0,24,32">
                <Grid
                    x:Name="DashboardGrid"
                    MaxWidth="{StaticResource PageMaxWidth}"
                    ColumnSpacing="8"
                    RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="DashboardSecondaryWidth" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="PrimaryColumn" Spacing="8">
                        <controls:Card
                            x:Name="QuickAccessCard"
                            x:Uid="QuickAccessTitle" services:RuntimeLocalization.Uid="QuickAccessTitle"
                            TitleFontSize="{ThemeResource KitFontSize16}" services:TypographyResources.BaseTitleFontSize="16"
                            DescriptionFontSize="{ThemeResource KitFontSize13}" services:TypographyResources.BaseDescriptionFontSize="13"
                            Padding="0"
                            VerticalAlignment="Top"
                            DividerVisibility="Collapsed">
                            <Grid>
                                <controls:QuickAccessList
                                    x:Name="QuickAccessItemsControl"
                                    Margin="16,0,16,14"
                                    IsCompact="True"
                                    ItemsSource="{x:Bind ViewModel.QuickAccessItems, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.VisibleQuickAccessItemsCount, Mode=OneWay, Converter={StaticResource DoubleToVisibilityConverter}}" />
                                <StackPanel
                                    Padding="16,12"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.VisibleQuickAccessItemsCount, Mode=OneWay, Converter={StaticResource DoubleToInvertedVisibilityConverter}}">
                                    <FontIcon
                                        AutomationProperties.AccessibilityView="Raw"
                                        FontSize="16"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xE74C;" />
                                    <TextBlock
                                        x:Uid="NoActionsToShow" services:RuntimeLocalization.Uid="NoActionsToShow"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource BodyTextBlockStyle}" />
                                </StackPanel>
                            </Grid>
                        </controls:Card>

                        <Border x:Name="SystemOverviewCard" Style="{StaticResource KitCardSurfaceStyle}" Padding="0">
                            <Grid RowDefinitions="Auto,Auto,*">
                                <StackPanel Padding="16,14" Spacing="4">
                                    <TextBlock x:Uid="Dashboard_SystemCard" services:RuntimeLocalization.Uid="Dashboard_SystemCard" Style="{StaticResource DashboardCardHeadingStyle}" AutomationProperties.HeadingLevel="Level2" />
                                    <TextBlock x:Uid="Dashboard_SystemDescription" services:RuntimeLocalization.Uid="Dashboard_SystemDescription" Style="{StaticResource DashboardCardDescriptionStyle}" />
                                </StackPanel>
                                <Rectangle Grid.Row="1" Height="1" HorizontalAlignment="Stretch" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <StackPanel Grid.Row="2" Spacing="0">
                                    <ItemsControl x:Name="SystemDetailsList" Margin="16,12" ItemsSource="{x:Bind ViewModel.SystemDetails, Mode=OneWay}"
                                        ItemTemplate="{StaticResource DashboardDetailTemplate}" />

                                    <!-- Storage Section -->
                                    <Border Padding="16,14,16,12"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnDefinitions="20,*" ColumnSpacing="16" MinHeight="24">
                                                <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xEDA2;" FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" x:Uid="Dashboard_StorageHeading" services:RuntimeLocalization.Uid="Dashboard_StorageHeading" Style="{StaticResource DashboardSectionHeadingStyle}" />
                                            </Grid>
                                            <ItemsControl x:Name="StorageDetailsList" ItemsSource="{x:Bind ViewModel.StorageDetails, Mode=OneWay}"
                                                ItemTemplate="{StaticResource DashboardDetailTemplate}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Graphics Cards Section -->
                                    <ItemsControl x:Name="GraphicsCardsList" ItemsSource="{x:Bind ViewModel.GraphicsCards, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="0" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="viewmodels:DashboardGpuCard">
                                                <Border Padding="16,14,16,12"
                                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                                    <StackPanel Spacing="12">
                                                        <Grid ColumnDefinitions="20,*" ColumnSpacing="16" MinHeight="24">
                                                            <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xE7F8;" FontSize="20" Height="24" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                                            <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource DashboardSectionHeadingStyle}" />
                                                        </Grid>
                                                        <ItemsControl ItemsSource="{x:Bind Details, Mode=OneWay}" ItemTemplate="{StaticResource DashboardDetailTemplate}" />
                                                        <TextBlock Margin="0,2,0,0" Text="{x:Bind Status, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                                            Visibility="{x:Bind Status, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="SecondaryColumn" Grid.Column="1" Spacing="8">
                        <controls:Card
                            x:Name="UtilitiesCard"
                            x:Uid="UtilitiesHeader" services:RuntimeLocalization.Uid="UtilitiesHeader"
                            TitleFontSize="{ThemeResource KitFontSize16}" services:TypographyResources.BaseTitleFontSize="16"
                            DescriptionFontSize="{ThemeResource KitFontSize13}" services:TypographyResources.BaseDescriptionFontSize="13"
                            Padding="0"
                            VerticalAlignment="Top"
                            DividerVisibility="Collapsed">
                            <controls:Card.TitleContent>
                                <Button
                                    x:Uid="Dashboard_SortBy" services:RuntimeLocalization.Uid="Dashboard_SortBy"
                                    AutomationProperties.AutomationId="DashboardSortByButton"
                                    VerticalAlignment="Top"
                                    MinWidth="32"
                                    MinHeight="32"
                                    Style="{StaticResource KitSubtleIconButtonStyle}">
                                    <ToolTipService.ToolTip>
                                        <TextBlock x:Uid="Dashboard_SortBy_ToolTip" services:RuntimeLocalization.Uid="Dashboard_SortBy_ToolTip" />
                                    </ToolTipService.ToolTip>
                                    <Button.Content>
                                        <FontIcon FontSize="16" Glyph="&#xE8CB;" />
                                    </Button.Content>
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <RadioMenuFlyoutItem
                                                x:Uid="Dashboard_SortAlphabetical" services:RuntimeLocalization.Uid="Dashboard_SortAlphabetical"
                                                Click="SortAlphabetical_Click"
                                                GroupName="DashboardSortGroup"
                                                IsChecked="{x:Bind ViewModel.DashboardSortOrder, Mode=OneWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Alphabetical}" />
                                            <RadioMenuFlyoutItem
                                                x:Uid="Dashboard_SortByStatus" services:RuntimeLocalization.Uid="Dashboard_SortByStatus"
                                                Click="SortByStatus_Click"
                                                GroupName="DashboardSortGroup"
                                                IsChecked="{x:Bind ViewModel.DashboardSortOrder, Mode=OneWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=ByStatus}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </controls:Card.TitleContent>
                            <controls:ModuleList
                                x:Name="ModulesCard"
                                ItemsSource="{x:Bind ViewModel.AllModules, Mode=OneWay}"
                                SortOption="{x:Bind ViewModel.DashboardSortOrder, Mode=TwoWay, Converter={StaticResource EnumToModuleListSortOptionConverter}}" />
                        </controls:Card>

                        <Border x:Name="NetworkOverviewCard" VerticalAlignment="Top" Style="{StaticResource KitCardSurfaceStyle}" Padding="0">
                            <Grid RowDefinitions="Auto,Auto,*">
                                <StackPanel Padding="16,14" Spacing="4">
                                    <TextBlock x:Uid="Dashboard_NetworkCard" services:RuntimeLocalization.Uid="Dashboard_NetworkCard" Style="{StaticResource DashboardCardHeadingStyle}" AutomationProperties.HeadingLevel="Level2" />
                                    <TextBlock x:Uid="Dashboard_NetworkDescription" services:RuntimeLocalization.Uid="Dashboard_NetworkDescription" Style="{StaticResource DashboardCardDescriptionStyle}" />
                                </StackPanel>
                                <Rectangle Grid.Row="1" Height="1" HorizontalAlignment="Stretch" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <StackPanel Grid.Row="2" Padding="16,14" Spacing="12">
                                    <Grid x:Name="EgressComparisonGrid" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="DirectRouteTitle" Margin="0,0,0,4" x:Uid="Dashboard_DirectRouteTitle" services:RuntimeLocalization.Uid="Dashboard_DirectRouteTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Name="DirectIpLabel" Margin="0,0,0,2" x:Uid="Dashboard_PublicIpLabel" services:RuntimeLocalization.Uid="Dashboard_PublicIpLabel" Grid.Row="1" Style="{StaticResource KitMicroLabelTextStyle}" />
                                        <TextBlock x:Name="DirectIpText" Margin="0,0,0,6" Grid.Row="2"
                                            Text="{x:Bind viewmodels:DashboardViewModel.EgressIp(ViewModel.DirectEgress), Mode=OneWay}"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                            FontFamily="{StaticResource KitMonoFontFamily}" FontSize="{ThemeResource KitFontSize14}" services:TypographyResources.BaseFontSize="14" FontWeight="Normal" Typography.NumeralAlignment="Tabular" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                        <TextBlock x:Name="DirectLocationText" Margin="0,0,0,4" Grid.Row="3" TextWrapping="Wrap" FontSize="{ThemeResource KitFontSize13}" services:TypographyResources.BaseFontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Run x:Uid="Dashboard_LocationLabel" services:RuntimeLocalization.Uid="Dashboard_LocationLabel" /><Run Text="{x:Bind ViewModel.DirectEgress.Location, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </TextBlock>
                                        <TextBlock x:Name="DirectEgressStatusText" Margin="0,2,0,0" Grid.Row="4" Text="{x:Bind viewmodels:DashboardViewModel.EgressStatus(ViewModel.DirectEgress), Mode=OneWay}"
                                            Visibility="{x:Bind EgressStatusVisibility(ViewModel.DirectEgress), Mode=OneWay}"
                                            Style="{x:Bind EgressTextStyle(ViewModel.DirectEgress.Health), Mode=OneWay}"
                                            TextWrapping="Wrap" FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12" />
                                        <Rectangle x:Name="EgressDivider" Grid.Column="1" Grid.RowSpan="5" Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                        <TextBlock x:Name="ProxyRouteTitle" Margin="0,0,0,4" x:Uid="Dashboard_ProxyRouteTitle" services:RuntimeLocalization.Uid="Dashboard_ProxyRouteTitle" Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Name="ProxyIpLabel" Margin="0,0,0,2" x:Uid="Dashboard_PublicIpLabel" services:RuntimeLocalization.Uid="Dashboard_PublicIpLabel" Grid.Row="1" Grid.Column="2" Style="{StaticResource KitMicroLabelTextStyle}" />
                                        <TextBlock x:Name="ProxyIpText" Margin="0,0,0,6" Grid.Row="2" Grid.Column="2"
                                            Text="{x:Bind viewmodels:DashboardViewModel.EgressIp(ViewModel.ProxyEgress), Mode=OneWay}"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                            FontFamily="{StaticResource KitMonoFontFamily}" FontSize="{ThemeResource KitFontSize14}" services:TypographyResources.BaseFontSize="14" FontWeight="Normal" Typography.NumeralAlignment="Tabular" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                        <TextBlock x:Name="ProxyLocationText" Margin="0,0,0,4" Grid.Row="3" Grid.Column="2" TextWrapping="Wrap" FontSize="{ThemeResource KitFontSize13}" services:TypographyResources.BaseFontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Run x:Uid="Dashboard_LocationLabel" services:RuntimeLocalization.Uid="Dashboard_LocationLabel" /><Run Text="{x:Bind ViewModel.ProxyEgress.Location, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </TextBlock>
                                        <TextBlock x:Name="ProxyEgressStatusText" Margin="0,2,0,0" Grid.Row="4" Grid.Column="2" Text="{x:Bind viewmodels:DashboardViewModel.EgressStatus(ViewModel.ProxyEgress), Mode=OneWay}"
                                            Visibility="{x:Bind EgressStatusVisibility(ViewModel.ProxyEgress), Mode=OneWay}"
                                            Style="{x:Bind EgressTextStyle(ViewModel.ProxyEgress.Health), Mode=OneWay}"
                                            TextWrapping="Wrap" FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="DashboardHeaderStates">
                <VisualState x:Name="DashboardHeaderWide">
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger x:Name="DashboardHeaderWideTrigger" TargetElement="{Binding ElementName=DashboardHeader}" MinWidth="480" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="DashboardHeaderNarrow">
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger x:Name="DashboardHeaderNarrowTrigger" TargetElement="{Binding ElementName=DashboardHeader}" MaxWidth="480" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DashboardHeading.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="DashboardVersionPanel.(Grid.Row)" Value="1" />
                        <Setter Target="DashboardVersionPanel.(Grid.Column)" Value="0" />
                        <Setter Target="DashboardVersionPanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="DashboardIntroduction.(Grid.Row)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="EgressLayoutStates">
                <VisualState x:Name="EgressSideBySide">
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger TargetElement="{Binding ElementName=EgressComparisonGrid}" MinWidth="400" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="EgressStacked">
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger TargetElement="{Binding ElementName=EgressComparisonGrid}" MaxWidth="400" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DirectRouteTitle.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="DirectIpLabel.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="DirectIpText.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="DirectLocationText.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="DirectEgressStatusText.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="EgressDivider.(Grid.Column)" Value="0" />
                        <Setter Target="EgressDivider.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="EgressDivider.(Grid.Row)" Value="5" />
                        <Setter Target="EgressDivider.(Grid.RowSpan)" Value="1" />
                        <Setter Target="EgressDivider.Width" Value="Auto" />
                        <Setter Target="EgressDivider.Height" Value="1" />
                        <Setter Target="EgressDivider.Margin" Value="0,8,0,12" />
                        <Setter Target="ProxyRouteTitle.(Grid.Column)" Value="0" />
                        <Setter Target="ProxyRouteTitle.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="ProxyRouteTitle.(Grid.Row)" Value="6" />
                        <Setter Target="ProxyIpLabel.(Grid.Column)" Value="0" />
                        <Setter Target="ProxyIpLabel.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="ProxyIpLabel.(Grid.Row)" Value="7" />
                        <Setter Target="ProxyIpText.(Grid.Column)" Value="0" />
                        <Setter Target="ProxyIpText.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="ProxyIpText.(Grid.Row)" Value="8" />
                        <Setter Target="ProxyLocationText.(Grid.Column)" Value="0" />
                        <Setter Target="ProxyLocationText.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="ProxyLocationText.(Grid.Row)" Value="9" />
                        <Setter Target="ProxyEgressStatusText.(Grid.Column)" Value="0" />
                        <Setter Target="ProxyEgressStatusText.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="ProxyEgressStatusText.(Grid.Row)" Value="10" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="DashboardLayoutStates">
                <VisualState x:Name="DashboardTwoColumns">
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger x:Name="DashboardTwoColumnsTrigger" TargetElement="{Binding ElementName=DashboardGrid}" MinWidth="{ThemeResource DashboardTwoColumnThreshold}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="DashboardSingleColumn">
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger x:Name="DashboardSingleColumnTrigger" TargetElement="{Binding ElementName=DashboardGrid}" MaxWidth="{ThemeResource DashboardTwoColumnThreshold}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DashboardGrid.ColumnSpacing" Value="0" />
                        <Setter Target="DashboardSecondaryWidth.Width" Value="0" />
                        <Setter Target="SecondaryColumn.(Grid.Column)" Value="0" />
                        <Setter Target="SecondaryColumn.(Grid.Row)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</local:NavigablePage>
