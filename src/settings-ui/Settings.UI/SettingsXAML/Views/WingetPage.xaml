<local:NavigablePage
    x:Class="Kit.Settings.UI.Views.WingetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kit.Settings.UI.Helpers"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:views="using:Kit.Settings.UI.Views"
    xmlns:vm="using:Kit.Settings.UI.ViewModels"
    AutomationProperties.LandmarkType="Main"
    NavigationCacheMode="Required">

    <local:NavigablePage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <!-- Semantic badge & operation card borders/stripes -->
                    <SolidColorBrush x:Key="WingetNeutralBorderBrush" Color="#24FFFFFF" />
                    <SolidColorBrush x:Key="WingetAccentBorderBrush" Color="#4860CDFF" />
                    <SolidColorBrush x:Key="WingetSuccessBorderBrush" Color="#486CCB5F" />
                    <SolidColorBrush x:Key="WingetWarningBorderBrush" Color="#48FCE100" />
                    <SolidColorBrush x:Key="WingetErrorBorderBrush" Color="#48FF99A4" />

                    <SolidColorBrush x:Key="WingetNeutralStripeBrush" Color="#55FFFFFF" />
                    <SolidColorBrush x:Key="WingetAccentStripeBrush" Color="#FF60CDFF" />
                    <SolidColorBrush x:Key="WingetSuccessStripeBrush" Color="#FF6CCB5F" />
                    <SolidColorBrush x:Key="WingetWarningStripeBrush" Color="#FFFCE100" />
                    <SolidColorBrush x:Key="WingetErrorStripeBrush" Color="#FFFF7A85" />

                    <!-- Version upgrade pill & source tag -->
                    <SolidColorBrush x:Key="WingetVersionPillBgBrush" Color="#2460CDFF" />
                    <SolidColorBrush x:Key="WingetVersionPillBorderBrush" Color="#4A60CDFF" />
                    <SolidColorBrush x:Key="WingetVersionPillForegroundBrush" Color="#FF7CCBFF" />
                    <SolidColorBrush x:Key="WingetSourcePillBgBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="WingetSourcePillBorderBrush" Color="#22FFFFFF" />

                    <!-- Discover workspace accent & soft Mica hero wash -->
                    <SolidColorBrush x:Key="WingetDiscoverBadgeBgBrush" Color="#269E8CFF" />
                    <SolidColorBrush x:Key="WingetDiscoverBadgeBorderBrush" Color="#4A9E8CFF" />
                    <SolidColorBrush x:Key="WingetDiscoverGlyphBrush" Color="#FFB8ACFF" />
                    <LinearGradientBrush x:Key="WingetDiscoverHeroWashBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#2460CDFF" />
                        <GradientStop Offset="0.55" Color="#1A9E8CFF" />
                        <GradientStop Offset="1" Color="Transparent" />
                    </LinearGradientBrush>

                    <!-- Primary action button palettes (Accent & Destructive) -->
                    <SolidColorBrush x:Key="WingetPrimaryAccentTintBrush" Color="#2860CDFF" />
                    <SolidColorBrush x:Key="WingetPrimaryAccentForegroundBrush" Color="#FF8AD8FF" />
                    <SolidColorBrush x:Key="WingetDestructiveTintBrush" Color="#28FF6B7A" />
                    <SolidColorBrush x:Key="WingetDestructiveForegroundBrush" Color="#FFFF99A4" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WingetNeutralBorderBrush" Color="#1E000000" />
                    <SolidColorBrush x:Key="WingetAccentBorderBrush" Color="#3C0067C0" />
                    <SolidColorBrush x:Key="WingetSuccessBorderBrush" Color="#3A0F7B0F" />
                    <SolidColorBrush x:Key="WingetWarningBorderBrush" Color="#449D5D00" />
                    <SolidColorBrush x:Key="WingetErrorBorderBrush" Color="#3CC42B1C" />

                    <SolidColorBrush x:Key="WingetNeutralStripeBrush" Color="#44000000" />
                    <SolidColorBrush x:Key="WingetAccentStripeBrush" Color="#FF0067C0" />
                    <SolidColorBrush x:Key="WingetSuccessStripeBrush" Color="#FF0F7B0F" />
                    <SolidColorBrush x:Key="WingetWarningStripeBrush" Color="#FFC17A00" />
                    <SolidColorBrush x:Key="WingetErrorStripeBrush" Color="#FFC42B1C" />

                    <SolidColorBrush x:Key="WingetVersionPillBgBrush" Color="#180067C0" />
                    <SolidColorBrush x:Key="WingetVersionPillBorderBrush" Color="#3A0067C0" />
                    <SolidColorBrush x:Key="WingetVersionPillForegroundBrush" Color="#FF005A9E" />
                    <SolidColorBrush x:Key="WingetSourcePillBgBrush" Color="#0A000000" />
                    <SolidColorBrush x:Key="WingetSourcePillBorderBrush" Color="#18000000" />

                    <SolidColorBrush x:Key="WingetDiscoverBadgeBgBrush" Color="#186246C8" />
                    <SolidColorBrush x:Key="WingetDiscoverBadgeBorderBrush" Color="#386246C8" />
                    <SolidColorBrush x:Key="WingetDiscoverGlyphBrush" Color="#FF5A3EC2" />
                    <LinearGradientBrush x:Key="WingetDiscoverHeroWashBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#200078D4" />
                        <GradientStop Offset="0.55" Color="#166246C8" />
                        <GradientStop Offset="1" Color="Transparent" />
                    </LinearGradientBrush>

                    <SolidColorBrush x:Key="WingetPrimaryAccentTintBrush" Color="#1A0067C0" />
                    <SolidColorBrush x:Key="WingetPrimaryAccentForegroundBrush" Color="#FF005A9E" />
                    <SolidColorBrush x:Key="WingetDestructiveTintBrush" Color="#18C42B1C" />
                    <SolidColorBrush x:Key="WingetDestructiveForegroundBrush" Color="#FFB3261E" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="WingetNeutralBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="WingetAccentBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="WingetSuccessBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="WingetWarningBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="WingetErrorBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />

                    <SolidColorBrush x:Key="WingetNeutralStripeBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="WingetAccentStripeBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="WingetSuccessStripeBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="WingetWarningStripeBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="WingetErrorStripeBrush" Color="{ThemeResource SystemColorHighlightColor}" />

                    <SolidColorBrush x:Key="WingetVersionPillBgBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="WingetVersionPillBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="WingetVersionPillForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="WingetSourcePillBgBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="WingetSourcePillBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />

                    <SolidColorBrush x:Key="WingetDiscoverBadgeBgBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="WingetDiscoverBadgeBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="WingetDiscoverGlyphBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="WingetDiscoverHeroWashBrush" Color="{ThemeResource SystemColorWindowColor}" />

                    <SolidColorBrush x:Key="WingetPrimaryAccentTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="WingetPrimaryAccentForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="WingetDestructiveTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="WingetDestructiveForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Semantic colors use WinUI theme resources, including high contrast.
                 The page itself stays transparent so the shell's Mica remains visible. -->
            <Style x:Key="WingetNeutralBadgeStyle" TargetType="Border" BasedOn="{StaticResource KitIconBadgeStyle}">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource WingetNeutralBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="WingetAccentBadgeStyle" TargetType="Border" BasedOn="{StaticResource KitIconBadgeStyle}">
                <Setter Property="BorderBrush" Value="{ThemeResource WingetAccentBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="WingetDiscoverBadgeStyle" TargetType="Border" BasedOn="{StaticResource KitIconBadgeStyle}">
                <Setter Property="Background" Value="{ThemeResource WingetDiscoverBadgeBgBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource WingetDiscoverBadgeBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="WingetSuccessBadgeStyle" TargetType="Border" BasedOn="{StaticResource KitIconBadgeStyle}">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorSuccessBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource WingetSuccessBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="WingetWarningBadgeStyle" TargetType="Border" BasedOn="{StaticResource KitIconBadgeStyle}">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource WingetWarningBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="WingetErrorBadgeStyle" TargetType="Border" BasedOn="{StaticResource KitIconBadgeStyle}">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource WingetErrorBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="WingetNeutralGlyphStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="WingetAccentGlyphStyle" TargetType="FontIcon" BasedOn="{StaticResource WingetNeutralGlyphStyle}">
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="WingetDiscoverGlyphStyle" TargetType="FontIcon" BasedOn="{StaticResource WingetNeutralGlyphStyle}">
                <Setter Property="Foreground" Value="{ThemeResource WingetDiscoverGlyphBrush}" />
            </Style>
            <Style x:Key="WingetSuccessGlyphStyle" TargetType="FontIcon" BasedOn="{StaticResource WingetNeutralGlyphStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
            </Style>
            <Style x:Key="WingetWarningGlyphStyle" TargetType="FontIcon" BasedOn="{StaticResource WingetNeutralGlyphStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <Style x:Key="WingetErrorGlyphStyle" TargetType="FontIcon" BasedOn="{StaticResource WingetNeutralGlyphStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
            <Style x:Key="WingetNeutralStripeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource WingetNeutralStripeBrush}" />
                <Setter Property="CornerRadius" Value="8,0,0,8" />
            </Style>
            <Style x:Key="WingetAccentStripeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource WingetAccentStripeBrush}" />
                <Setter Property="CornerRadius" Value="8,0,0,8" />
            </Style>
            <Style x:Key="WingetSuccessStripeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource WingetSuccessStripeBrush}" />
                <Setter Property="CornerRadius" Value="8,0,0,8" />
            </Style>
            <Style x:Key="WingetWarningStripeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource WingetWarningStripeBrush}" />
                <Setter Property="CornerRadius" Value="8,0,0,8" />
            </Style>
            <Style x:Key="WingetErrorStripeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource WingetErrorStripeBrush}" />
                <Setter Property="CornerRadius" Value="8,0,0,8" />
            </Style>
            <Style x:Key="WingetVersionPillStyle" TargetType="Border" BasedOn="{StaticResource KitStatusPillStyle}">
                <Setter Property="Background" Value="{ThemeResource WingetVersionPillBgBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource WingetVersionPillBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Padding" Value="7,2" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="WingetSourcePillStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource WingetSourcePillBgBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource WingetSourcePillBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="WingetSortHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Padding" Value="4,4" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="MinHeight" Value="28" />
            </Style>
            <Style x:Key="PackageItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>

            <DataTemplate x:Key="DetailedPackageTemplate" x:DataType="vm:WingetPackageRow">
                <Grid x:Name="PackageRowBounds" Tag="{x:Bind}" RightTapped="PackageRow_RightTapped" MinWidth="0" Padding="0,8" ColumnDefinitions="36,2*,2*,1.1*,1.1*,1*" ColumnSpacing="10">
                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" />
                    <StackPanel Grid.Column="1" MinWidth="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind StateLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind Id, Mode=OneWay}" FontSize="12" FontFamily="{StaticResource KitMonoFontFamily}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Id, Mode=OneWay}" />
                    <TextBlock Grid.Column="3" Text="{x:Bind InstalledVersion, Mode=OneWay}" FontSize="12" FontFamily="{StaticResource KitMonoFontFamily}" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind InstalledVersion, Mode=OneWay}" />
                    <Grid Grid.Column="4" VerticalAlignment="Center">
                        <Border Style="{StaticResource WingetVersionPillStyle}" Visibility="{x:Bind AvailableVersion, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}">
                            <TextBlock Text="{x:Bind AvailableVersion, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" FontFamily="{StaticResource KitMonoFontFamily}" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource WingetVersionPillForegroundBrush}" ToolTipService.ToolTip="{x:Bind AvailableVersion, Mode=OneWay}" />
                        </Border>
                    </Grid>
                    <Border Grid.Column="5" Style="{StaticResource WingetSourcePillStyle}" Visibility="{x:Bind SourceLabel, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}">
                        <TextBlock Text="{x:Bind SourceLabel, Mode=OneWay}" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind SourceLabel, Mode=OneWay}" />
                    </Border>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="NarrowDetailedPackageTemplate" x:DataType="vm:WingetPackageRow">
                <Grid x:Name="PackageRowBounds" Tag="{x:Bind}" RightTapped="PackageRow_RightTapped" MinWidth="0" Padding="0,8" ColumnDefinitions="36,2*,1.1*,1.1*" ColumnSpacing="10">
                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" />
                    <StackPanel Grid.Column="1" MinWidth="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind StateLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind InstalledVersion, Mode=OneWay}" FontSize="12" FontFamily="{StaticResource KitMonoFontFamily}" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind InstalledVersion, Mode=OneWay}" />
                    <Grid Grid.Column="3" VerticalAlignment="Center">
                        <Border Style="{StaticResource WingetVersionPillStyle}" Visibility="{x:Bind AvailableVersion, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}">
                            <TextBlock Text="{x:Bind AvailableVersion, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" FontFamily="{StaticResource KitMonoFontFamily}" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource WingetVersionPillForegroundBrush}" ToolTipService.ToolTip="{x:Bind AvailableVersion, Mode=OneWay}" />
                        </Border>
                    </Grid>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="CompactPackageTemplate" x:DataType="vm:WingetPackageRow">
                <Grid x:Name="PackageRowBounds" Tag="{x:Bind}" RightTapped="PackageRow_RightTapped" MinWidth="0" Padding="0,2" ColumnDefinitions="36,2*,2*,1.1*,1.1*,1*" ColumnSpacing="10">
                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Id, Mode=OneWay}" FontSize="12" FontFamily="{StaticResource KitMonoFontFamily}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Id, Mode=OneWay}" />
                    <TextBlock Grid.Column="3" Text="{x:Bind InstalledVersion, Mode=OneWay}" FontSize="12" FontFamily="{StaticResource KitMonoFontFamily}" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind InstalledVersion, Mode=OneWay}" />
                    <TextBlock Grid.Column="4" Text="{x:Bind AvailableVersion, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" FontFamily="{StaticResource KitMonoFontFamily}" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource WingetVersionPillForegroundBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind AvailableVersion, Mode=OneWay}" />
                    <TextBlock Grid.Column="5" Text="{x:Bind SourceLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="NarrowCompactPackageTemplate" x:DataType="vm:WingetPackageRow">
                <Grid x:Name="PackageRowBounds" Tag="{x:Bind}" RightTapped="PackageRow_RightTapped" MinWidth="0" Padding="0,2" ColumnDefinitions="36,2*,1.1*,1.1*" ColumnSpacing="10">
                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}" />
                    <TextBlock Grid.Column="2" Text="{x:Bind InstalledVersion, Mode=OneWay}" FontSize="12" FontFamily="{StaticResource KitMonoFontFamily}" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind InstalledVersion, Mode=OneWay}" />
                    <TextBlock Grid.Column="3" Text="{x:Bind AvailableVersion, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" FontFamily="{StaticResource KitMonoFontFamily}" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource WingetVersionPillForegroundBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind AvailableVersion, Mode=OneWay}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="TilePackageTemplate" x:DataType="vm:WingetPackageRow">
                <Grid x:Name="PackageRowBounds" Tag="{x:Bind}" RightTapped="PackageRow_RightTapped" Width="220" RowDefinitions="Auto,*" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <Border Margin="12,8,12,0" Height="3" CornerRadius="1.5" Background="{ThemeResource WingetAccentStripeBrush}" Opacity="0.82" />
                    <Grid Grid.Row="1" Padding="12,8,12,12" RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="32,*" RowSpacing="8">
                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind Id, Mode=OneWay}" FontSize="11" FontFamily="{StaticResource KitMonoFontFamily}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Id, Mode=OneWay}" />
                        <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource WingetVersionPillStyle}" HorizontalAlignment="Stretch" Visibility="{x:Bind Versions, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}">
                            <TextBlock Text="{x:Bind Versions, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" FontFamily="{StaticResource KitMonoFontFamily}" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource WingetVersionPillForegroundBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Versions, Mode=OneWay}" />
                        </Border>
                        <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBlock Text="{x:Bind StateLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Style="{StaticResource WingetSourcePillStyle}" Visibility="{x:Bind SourceLabel, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}">
                                <TextBlock Text="{x:Bind SourceLabel, Mode=OneWay}" FontSize="10" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="SourceFilterTemplate" x:DataType="vm:WingetSourceFilter">
                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,2">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Style="{StaticResource WingetSourcePillStyle}">
                            <TextBlock Text="{x:Bind Count, Mode=OneWay}" FontSize="11" FontFamily="{StaticResource KitMonoFontFamily}" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </Grid>
                </CheckBox>
            </DataTemplate>

            <DataTemplate x:Key="QueueTemplate" x:DataType="vm:WingetQueueRow">
                <Expander x:Name="QueueRowExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,4">
                    <Expander.Header>
                        <Grid Padding="4,2" ColumnDefinitions="2*,*,*" ColumnSpacing="12">
                            <StackPanel MinWidth="0">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Identity, Mode=OneWay}" FontSize="11" FontFamily="{StaticResource KitMonoFontFamily}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource WingetSourcePillStyle}">
                                <TextBlock Text="{x:Bind KindText, Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="2" Text="{x:Bind StateText, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind WhenText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind HasTimestamp, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="{x:Bind Message, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <Border Style="{StaticResource KitRecessedSurfaceStyle}">
                            <ScrollViewer MaxHeight="140" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                                <TextBlock Text="{x:Bind Output, Mode=OneWay}" FontFamily="{StaticResource KitMonoFontFamily}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Expander>
            </DataTemplate>
        </ResourceDictionary>
    </local:NavigablePage.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="HeaderResponsiveStates">
                <VisualState>
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger TargetElement="{Binding ElementName=WingetViewport}" MinWidth="680" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger TargetElement="{Binding ElementName=WingetViewport}" MaxWidth="680" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="WingetDescription.Visibility" Value="Collapsed" />
                        <Setter Target="AutomaticSettingsLabel.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="NavFilterResponsiveStates">
                <VisualState>
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger TargetElement="{Binding ElementName=WingetViewport}" MinWidth="760" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger TargetElement="{Binding ElementName=WingetViewport}" MaxWidth="760" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="InlineLocalFilterBox.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="FooterResponsiveStates">
                <VisualState>
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger TargetElement="{Binding ElementName=WorkspaceFooter}" MinWidth="600" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger TargetElement="{Binding ElementName=WorkspaceFooter}" MaxWidth="600" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="FooterSelectionText.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="FooterControls.(Grid.Row)" Value="1" />
                        <Setter Target="FooterControls.(Grid.Column)" Value="0" />
                        <Setter Target="FooterControls.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="FooterControls.HorizontalAlignment" Value="Left" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="DetailsPaneDisplayStates">
                <VisualState x:Name="DetailsPaneOverlay">
                    <VisualState.Setters>
                        <Setter Target="WingetDetailsHost.PaneBackground" Value="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" />
                        <Setter Target="DetailsPaneSizer.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="DetailsPaneInline">
                    <VisualState.Setters>
                        <Setter Target="WingetDetailsHost.PaneBackground" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                        <Setter Target="DetailsPaneSizer.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <SplitView
            x:Name="WingetDetailsHost"
            DisplayMode="Overlay"
            PanePlacement="Right"
            IsPaneOpen="False"
            LightDismissOverlayMode="On"
            OpenPaneLength="420"
            PaneBackground="{ThemeResource LayerFillColorDefaultBrush}">
            <SplitView.Pane>
                <Grid>
                    <views:WingetPackageDetailsPane x:Name="WingetDetailsPane" />
                    <tk:PropertySizer
                        x:Name="DetailsPaneSizer"
                        x:Uid="Winget_DetailsResizeHandle"
                        HorizontalAlignment="Left"
                        Width="8"
                        Margin="-2,0,0,0"
                        Binding="{x:Bind WingetDetailsHost.OpenPaneLength, Mode=TwoWay}"
                        IsDragInverted="True"
                        Minimum="340"
                        Maximum="620"
                        Visibility="Collapsed" />
                </Grid>
            </SplitView.Pane>

            <!-- Match the shared settings page's 1000-DIP centered content width, plus
                 24-DIP minimum gutters. One finite slot still owns every workspace edge. -->
            <Grid
                x:Name="WingetViewport"
                MaxWidth="1048"
                HorizontalAlignment="Stretch"
                Padding="24,0,24,16"
                RowDefinitions="Auto,Auto,Auto,Auto,*"
                RowSpacing="12"
                SizeChanged="Viewport_SizeChanged">

                <!-- Row 0: Unified compact Fluent header (title + concise description) -->
                <Grid
                    x:Name="WingetPageHeader"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="6">
                    <TextBlock
                        x:Name="WingetPageTitle"
                        VerticalAlignment="Center"
                        Text="{x:Bind ModuleTitle}"
                        Style="{StaticResource TitleTextBlockStyle}"
                        AutomationProperties.HeadingLevel="Level1"
                        ToolTipService.ToolTip="{x:Bind ModuleDescription}" />
                    <TextBlock
                        x:Name="WingetDescription"
                        Grid.Row="1"
                        Text="{x:Bind ModuleDescription}"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind ModuleDescription}" />
                </Grid>

                <!-- Row 1: Module Enable SettingsCard -->
                <tk:SettingsCard
                    x:Name="WingetEnableCard"
                    Grid.Row="1"
                    x:Uid="Winget_EnableCard"
                    HorizontalAlignment="Stretch"
                    HeaderIcon="{ui:BitmapIcon Source=/Assets/Settings/Icons/Winget.png}">
                    <ToggleSwitch
                        x:Name="WingetEnableToggle"
                        x:Uid="Winget_EnableToggle"
                        AutomationProperties.AutomationId="Toggle_Winget"
                        IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}" />
                </tk:SettingsCard>

                <!-- Row 2: Native Win11 SettingsExpander for status, version, automatic checks, and documentation -->
                <tk:SettingsExpander
                    x:Name="WingetSettingsExpander"
                    Grid.Row="2"
                    HorizontalAlignment="Stretch"
                    IsExpanded="False">
                    <tk:SettingsExpander.Header>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border x:Name="ReadinessBadge" Style="{x:Bind BadgeStyle(ViewModel.ReadinessTone), Mode=OneWay}">
                                <FontIcon x:Name="ReadinessGlyph" Glyph="{x:Bind ViewModel.ReadinessGlyph, Mode=OneWay}" Style="{x:Bind GlyphStyle(ViewModel.ReadinessTone), Mode=OneWay}" AutomationProperties.AccessibilityView="Raw" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="AutomaticSettingsLabel"
                                    x:Uid="Winget_AutomaticSettings"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </tk:SettingsExpander.Header>
                    <Border VerticalAlignment="Center" Style="{StaticResource KitStatusPillStyle}">
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{x:Bind ViewModel.VersionText, Mode=OneWay}"
                            FontSize="11"
                            LineHeight="16"
                            FontFamily="{StaticResource KitMonoFontFamily}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard x:Name="DailySettingsCard" x:Uid="Winget_DailyCard" Padding="16,12" MinHeight="58">
                            <tk:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE787;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                            </tk:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                x:Name="DailyCheckToggle"
                                x:Uid="Winget_DailyToggle"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource RightAlignedCompactToggleSwitchStyle}"
                                IsOn="{x:Bind ViewModel.DailyCheckEnabled, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}" />
                        </tk:SettingsCard>
                        <tk:SettingsCard x:Name="NotifySettingsCard" x:Uid="Winget_NotifyCard" Padding="16,12" MinHeight="58">
                            <tk:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xEA8F;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                            </tk:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                x:Name="NotifyUpdatesToggle"
                                x:Uid="Winget_NotifyToggle"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource RightAlignedCompactToggleSwitchStyle}"
                                IsOn="{x:Bind ViewModel.NotifyUpdates, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}" />
                        </tk:SettingsCard>
                        <tk:SettingsCard x:Name="ScheduleSettingsCard" x:Uid="Winget_ScheduleCard" Padding="16,12" MinHeight="58">
                            <tk:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE823;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                            </tk:SettingsCard.HeaderIcon>
                            <tk:SettingsCard.Description>
                                <StackPanel x:Name="ScheduleSummary" Spacing="2">
                                    <TextBlock x:Name="LastCheckText" Text="{x:Bind ViewModel.LastCheckText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="NextCheckText" Text="{x:Bind ViewModel.NextCheckText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </tk:SettingsCard.Description>
                            <HyperlinkButton
                                x:Name="WingetHelpLink"
                                x:Uid="Winget_Help"
                                NavigateUri="https://learn.microsoft.com/en-us/windows/package-manager/winget/"
                                Padding="0"
                                VerticalAlignment="Center" />
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>

                <!-- Row 3: Workspace tabs with Updates InfoBadge + inline local AutoSuggestBox -->
                <Grid x:Name="WingetNavBar" Grid.Row="3" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <tk:Segmented x:Name="WingetSections" SelectedIndex="{x:Bind ViewModel.ActiveTabIndex, Mode=TwoWay}" HorizontalAlignment="Left">
                        <tk:SegmentedItem Icon="{ui:FontIcon Glyph=&#xE895;}">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Text('UpdatesTab/Content')}" VerticalAlignment="Center" />
                                <InfoBadge
                                    x:Name="UpdatesTabBadge"
                                    Style="{StaticResource AttentionValueInfoBadgeStyle}"
                                    Value="{x:Bind ViewModel.UpdatesCount, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.HasUpdatesBadge, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </tk:SegmentedItem>
                        <tk:SegmentedItem x:Uid="Winget_InstalledTab" Icon="{ui:FontIcon Glyph=&#xE770;}" />
                        <tk:SegmentedItem x:Uid="Winget_DiscoverTab" Icon="{ui:FontIcon Glyph=&#xE774;}" />
                    </tk:Segmented>
                    <AutoSuggestBox
                        x:Name="InlineLocalFilterBox"
                        Grid.Column="1"
                        x:Uid="Winget_LocalFilter"
                        QueryIcon="Find"
                        MinWidth="180"
                        MaxWidth="260"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.FilterText, Mode=TwoWay}" />
                </Grid>

                <!-- Row 4: Package Workspace -->
                <Grid x:Name="PackageWorkspaceGrid" Grid.Row="4" MinWidth="0" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                    <Grid x:Name="WorkspaceHeaderGrid" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,4,0,8">
                        <Border x:Name="WorkspaceBadge" Style="{x:Bind WorkspaceBadgeStyle(ViewModel.ActiveTabIndex), Mode=OneWay}" Width="32" Height="32" CornerRadius="8">
                            <FontIcon Glyph="{x:Bind WorkspaceGlyph(ViewModel.ActiveTabIndex), Mode=OneWay}" Style="{x:Bind WorkspaceGlyphStyle(ViewModel.ActiveTabIndex), Mode=OneWay}" FontSize="16" AutomationProperties.AccessibilityView="Raw" />
                        </Border>
                        <StackPanel Grid.Column="1" MinWidth="0" Spacing="0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.WorkspaceTitle, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind ViewModel.WorkspaceSubtitle, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.WorkspaceSubtitle, Mode=OneWay}" />
                        </StackPanel>
                        <Button x:Name="CompactFiltersButton" Grid.Column="2" x:Uid="Winget_FiltersButton" Visibility="Collapsed" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE71C;" FontSize="13" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Text="{x:Bind Text('FiltersButton/Content')}" />
                                <InfoBadge
                                    Style="{StaticResource AttentionValueInfoBadgeStyle}"
                                    Value="{x:Bind ViewModel.ActiveFilterCount, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.HasActiveFilters, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout x:Name="FiltersFlyout" Placement="BottomEdgeAlignedRight" />
                            </Button.Flyout>
                        </Button>
                        <ToggleButton
                            x:Name="FiltersToggleButton"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Checked="FiltersToggle_Changed"
                            Unchecked="FiltersToggle_Changed"
                            AutomationProperties.AutomationId="Winget_ToggleFilters">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE71C;" FontSize="14" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock x:Name="FiltersToggleLabel" Text="{x:Bind Text('ShowFilters')}" />
                                <InfoBadge
                                    Style="{StaticResource AttentionValueInfoBadgeStyle}"
                                    Value="{x:Bind ViewModel.ActiveFilterCount, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.HasActiveFilters, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </Grid>

                    <CommandBar
                        x:Name="WorkspaceCommands"
                        Grid.Row="1"
                        Margin="0,0,0,6"
                        Background="Transparent"
                        DefaultLabelPosition="Right"
                        IsDynamicOverflowEnabled="True"
                        HorizontalAlignment="Left"
                        HorizontalContentAlignment="Stretch">
                        <AppBarButton
                            x:Name="PrimaryActionButton"
                            Label="{x:Bind ViewModel.PrimaryActionLabel, Mode=OneWay}"
                            Icon="Sync"
                            Background="{ThemeResource WingetPrimaryAccentTintBrush}"
                            Foreground="{ThemeResource WingetPrimaryAccentForegroundBrush}"
                            CornerRadius="6"
                            IsEnabled="{x:Bind ViewModel.CanPrepareSelection, Mode=OneWay}"
                            Click="PrimaryAction_Click"
                            AutomationProperties.AutomationId="Winget_PrimaryAction" />
                        <AppBarButton x:Uid="Winget_ReloadAction" Icon="Refresh" IsEnabled="{x:Bind ViewModel.CanReload, Mode=OneWay}" Click="Reload_Click" AutomationProperties.AutomationId="Winget_Check" />
                        <AppBarSeparator />
                        <AppBarButton x:Name="DetailsButton" x:Uid="Winget_DetailsAction" Icon="Document" IsEnabled="{x:Bind ViewModel.CanOpenDetails, Mode=OneWay}" Click="Details_Click" AutomationProperties.AutomationId="Winget_Details" />
                        <AppBarButton x:Uid="Winget_IgnoreAction" Icon="Pin" Visibility="{x:Bind IsUpdatesTab(ViewModel.ActiveTabIndex), Mode=OneWay}" IsEnabled="{x:Bind HasSelectionCount(ViewModel.SelectedCount), Mode=OneWay}" Click="Ignore_Click" />
                        <AppBarButton x:Name="ActivityToolbarButton" x:Uid="Winget_ActivityToolbarButton" Icon="{ui:FontIcon Glyph=&#xE81C;}" Click="Activity_Click" AutomationProperties.AutomationId="Winget_ActivityButton" />
                        <CommandBar.SecondaryCommands>
                            <AppBarButton x:Uid="Winget_OptionsAction" Icon="Setting" Click="Options_Click" />
                            <AppBarButton x:Uid="Winget_ManualAction" Icon="{ui:FontIcon Glyph=&#xE756;}" IsEnabled="{x:Bind CanShowManualCommand(ViewModel.HasSelection, ViewModel.ManualCommand), Mode=OneWay}" Click="Manual_Click" />
                            <AppBarButton x:Uid="Winget_ManageIgnoredAction" Icon="Manage" Visibility="{x:Bind IsUpdatesTab(ViewModel.ActiveTabIndex), Mode=OneWay}" Click="ManageIgnored_Click" />
                            <AppBarSeparator />
                            <AppBarButton x:Uid="Winget_CsvAction" Icon="Save" IsEnabled="{x:Bind ViewModel.HasRows, Mode=OneWay}" Click="ExportCsv_Click" />
                            <AppBarButton x:Uid="Winget_BundleAction" Icon="SaveLocal" IsEnabled="{x:Bind HasSelectionCount(ViewModel.SelectedCount), Mode=OneWay}" Click="ExportBundle_Click" />
                        </CommandBar.SecondaryCommands>
                    </CommandBar>

                    <StackPanel Grid.Row="2" Spacing="6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Visibility="{x:Bind ViewModel.HasActiveFilters, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{x:Bind ViewModel.ActiveFilterSummary, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" AutomationProperties.AutomationId="Winget_ActiveFilters" />
                            <HyperlinkButton Grid.Column="1" Content="{x:Bind Text('ResetFilters')}" Click="ResetFilters_Click" AutomationProperties.AutomationId="Winget_ResetFilters" />
                        </Grid>
                        <InfoBar IsOpen="{x:Bind ViewModel.RecoveryRequired, Mode=OneWay}" Visibility="{x:Bind ViewModel.RecoveryRequired, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Message="{x:Bind Text('RecoveryHint')}" Severity="Warning" IsClosable="False" />
                        <InfoBar IsOpen="{x:Bind ExceedsBatchLimit(ViewModel.SelectedCount), Mode=OneWay}" Visibility="{x:Bind ShowBatchLimit(ViewModel.SelectedCount), Mode=OneWay}" Message="{x:Bind Text('BatchLimitHint')}" Severity="Informational" IsClosable="False" />
                        <InfoBar x:Uid="Winget_Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}" Severity="Error" IsClosable="False" />
                        <InfoBar x:Uid="Winget_NotificationError" IsOpen="{x:Bind ViewModel.HasNotificationError, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasNotificationError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Message="{x:Bind ViewModel.NotificationErrorText, Mode=OneWay}" Severity="Informational" IsClosable="False" />
                        <InfoBar x:Uid="Winget_RestartRequired" IsOpen="{x:Bind ViewModel.RestartRequired, Mode=OneWay}" Visibility="{x:Bind ViewModel.RestartRequired, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Severity="Informational" IsClosable="False" />
                    </StackPanel>

                    <!-- Active operation / durable queue card (auto-collapsed when idle) -->
                    <Border
                        x:Name="WingetOperationCard"
                        Grid.Row="3"
                        Margin="0,4,0,10"
                        Style="{StaticResource KitCardSurfaceStyle}"
                        Padding="0"
                        Visibility="{x:Bind ViewModel.ShowOperationCard, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid ColumnDefinitions="3,*">
                            <Border x:Name="OperationAccentStripe" Style="{x:Bind StripeStyle(ViewModel.OperationTone), Mode=OneWay}" />
                            <Grid Grid.Column="1">
                                <Border
                                    CornerRadius="0,8,8,0"
                                    Background="{ThemeResource KitHeroGradientBrush}"
                                    IsHitTestVisible="False"
                                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Grid x:Name="WingetOperationCardGrid" Padding="14,12" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Grid Width="32" Height="32" VerticalAlignment="Center">
                                            <Ellipse x:Name="OperationPulseRing" Width="32" Height="32" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0" IsHitTestVisible="False" />
                                            <Border x:Name="OperationBadge" Style="{x:Bind BadgeStyle(ViewModel.OperationTone), Mode=OneWay}">
                                                <FontIcon x:Name="OperationGlyph" Glyph="{x:Bind ViewModel.OperationGlyph, Mode=OneWay}" Style="{x:Bind GlyphStyle(ViewModel.OperationTone), Mode=OneWay}" AutomationProperties.AccessibilityView="Raw" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="1" MinWidth="0" Spacing="3">
                                            <TextBlock x:Name="OperationSummaryText" Text="{x:Bind ViewModel.OperationSummary, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.OperationSummary, Mode=OneWay}" AutomationProperties.LiveSetting="Polite" />
                                            <TextBlock x:Name="OperationDescriptionText" Text="{x:Bind ViewModel.OperationDescription, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.OperationDescription, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="OperationHistoryButton" x:Uid="Winget_OperationHistory" Click="Activity_Click" VerticalAlignment="Center" />
                                            <Button x:Name="OperationCancelButton" x:Uid="Winget_Cancel" Click="Cancel_Click" VerticalAlignment="Center" IsEnabled="{x:Bind ViewModel.CanCancelOperation, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Grid>
                                    <ProgressBar
                                        Grid.Row="1"
                                        Style="{StaticResource KitProgressBarStyle}"
                                        Value="{x:Bind ViewModel.Progress, Mode=OneWay}"
                                        IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <Expander x:Name="OperationDetailsExpander" Grid.Row="2" x:Uid="Winget_OperationDetails" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                                        <ScrollViewer MaxHeight="180" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="{x:Bind ViewModel.OperationDescription, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasOperationOutput, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{x:Bind Text('InstallerOutput')}" FontWeight="SemiBold" />
                                                    <Border Style="{StaticResource KitRecessedSurfaceStyle}">
                                                        <ScrollViewer x:Name="OperationOutputScroll" MaxHeight="140" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                                                            <TextBlock x:Name="OperationOutputText" Text="{x:Bind ViewModel.OperationOutput, Mode=OneWay}" FontFamily="{StaticResource KitMonoFontFamily}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                        </ScrollViewer>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Text('QueueTitle')}" FontWeight="SemiBold" />
                                                <ItemsControl x:Name="OperationQueueList" ItemsSource="{x:Bind ViewModel.QueueItems}" ItemTemplate="{StaticResource QueueTemplate}" />
                                                <TextBlock x:Uid="Winget_QueueEmpty" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind ShowNoItems(ViewModel.QueueItems.Count), Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind Text('HistoryTitle')}" FontWeight="SemiBold" />
                                                <ItemsControl x:Name="OperationHistoryList" ItemsSource="{x:Bind ViewModel.HistoryItems}" ItemTemplate="{StaticResource QueueTemplate}" />
                                                <TextBlock x:Uid="Winget_HistoryEmpty" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind ShowNoItems(ViewModel.HistoryItems.Count), Mode=OneWay}" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Expander>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Main package workspace body -->
                    <Grid x:Name="WorkspaceBody" Grid.Row="4" Margin="0,6,0,0" MinWidth="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="FilterColumn" Width="0" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            x:Name="FiltersHost"
                            Visibility="Collapsed"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">
                            <ScrollViewer x:Name="FiltersPanel" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE71C;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock x:Uid="Winget_FiltersHeading" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox x:Name="LocalFilterBox" x:Uid="Winget_LocalFilter" Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Expander x:Uid="Winget_SourcesExpander" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.SourceFilters}" ItemTemplate="{StaticResource SourceFilterTemplate}" />
                                    </Expander>
                                    <Expander x:Uid="Winget_SearchOptionsExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <StackPanel Spacing="4">
                                            <CheckBox IsChecked="{x:Bind ViewModel.ExactMatch, Mode=TwoWay}" MinWidth="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                <TextBlock Text="{x:Bind Text('ExactMatch/Content')}" TextWrapping="Wrap" />
                                            </CheckBox>
                                            <CheckBox IsChecked="{x:Bind ViewModel.IncludeUnknown, Mode=TwoWay}" MinWidth="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="{x:Bind IsUpdatesTab(ViewModel.ActiveTabIndex), Mode=OneWay}">
                                                <TextBlock Text="{x:Bind Text('IncludeUnknown/Content')}" TextWrapping="Wrap" />
                                            </CheckBox>
                                            <CheckBox IsChecked="{x:Bind ViewModel.ShowIgnored, Mode=TwoWay}" MinWidth="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="{x:Bind IsUpdatesTab(ViewModel.ActiveTabIndex), Mode=OneWay}">
                                                <TextBlock Text="{x:Bind Text('ShowIgnored/Content')}" TextWrapping="Wrap" />
                                            </CheckBox>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <Grid x:Name="PackageTableViewport" Grid.Column="1" MinWidth="0" RowDefinitions="Auto,Auto,*">
                            <Grid x:Name="DiscoverSearchToolbar" Margin="0,0,0,8" ColumnDefinitions="*,Auto" ColumnSpacing="8" Visibility="{x:Bind ShowSearchToolbar(ViewModel.ActiveTabIndex, ViewModel.HasSearchResults), Mode=OneWay}">
                                <TextBox x:Name="PackageSearchBox" x:Uid="Winget_SearchBox" Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" KeyDown="SearchBox_KeyDown" />
                                <Button Grid.Column="1" x:Uid="Winget_SearchButton" IsEnabled="{x:Bind ViewModel.CanSearch, Mode=OneWay}" Click="Search_Click" Style="{StaticResource AccentButtonStyle}" />
                            </Grid>
                            <StackPanel x:Name="DiscoverSearchFeedback" Grid.Row="1" Margin="0,0,0,8" Spacing="3" Visibility="{x:Bind IsDiscoverTab(ViewModel.ActiveTabIndex), Mode=OneWay}">
                                <TextBlock x:Name="SearchStatusText" Text="{x:Bind ViewModel.SearchStatusText, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock x:Name="SearchScopeText" Text="{x:Bind Text('SearchSourceScope')}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind Text('SearchRefine')}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind ViewModel.SearchResultsLimited, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>

                            <Border x:Name="WingetPackageListCard" Grid.Row="2" Style="{StaticResource KitCardSurfaceStyle}" Padding="0" MinWidth="0">
                                <Grid MinWidth="0" RowDefinitions="Auto,*">
                                    <Grid
                                        x:Name="PackageTableHeader"
                                        Padding="10,3"
                                        ColumnSpacing="10"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="8,8,0,0"
                                        Visibility="{x:Bind ShowTable(ViewModel.ActiveTabIndex, ViewModel.HasSearchResults, ViewModel.ViewModeIndex), Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition x:Name="HeaderIdColumn" Width="2*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition x:Name="HeaderSourceColumn" Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="SelectAllPackagesCheckBox" x:Uid="Winget_SelectAllVisible" IsThreeState="True" IsChecked="{x:Bind ViewModel.IsAllVisibleSelected, Mode=OneWay}" Click="SelectAllPackages_Click" MinWidth="0" />
                                        <Button Grid.Column="1" Tag="0" Click="SortColumn_Click" Style="{StaticResource WingetSortHeaderButtonStyle}">
                                            <TextBlock x:Uid="Winget_ColumnPackage" TextTrimming="CharacterEllipsis" />
                                        </Button>
                                        <Button x:Name="HeaderIdButton" Grid.Column="2" Tag="1" Click="SortColumn_Click" Style="{StaticResource WingetSortHeaderButtonStyle}">
                                            <TextBlock x:Uid="Winget_ColumnId" TextTrimming="CharacterEllipsis" />
                                        </Button>
                                        <Button Grid.Column="3" Tag="2" Click="SortColumn_Click" Style="{StaticResource WingetSortHeaderButtonStyle}">
                                            <TextBlock x:Uid="Winget_ColumnInstalled" TextTrimming="CharacterEllipsis" />
                                        </Button>
                                        <Button Grid.Column="4" Tag="3" Click="SortColumn_Click" Style="{StaticResource WingetSortHeaderButtonStyle}">
                                            <TextBlock x:Uid="Winget_ColumnAvailable" TextTrimming="CharacterEllipsis" />
                                        </Button>
                                        <Button x:Name="HeaderSourceButton" Grid.Column="5" Tag="4" Click="SortColumn_Click" Style="{StaticResource WingetSortHeaderButtonStyle}">
                                            <TextBlock x:Uid="Winget_ColumnSource" TextTrimming="CharacterEllipsis" />
                                        </Button>
                                    </Grid>

                                    <ListView
                                        x:Name="PackagesList"
                                        Grid.Row="1"
                                        ItemsSource="{x:Bind ViewModel.DisplayPackages}"
                                        SelectedItem="{x:Bind ViewModel.ActiveSelection, Mode=TwoWay}"
                                        ItemTemplate="{StaticResource DetailedPackageTemplate}"
                                        ItemContainerStyle="{StaticResource PackageItemStyle}"
                                        SelectionMode="Single"
                                        IsItemClickEnabled="True"
                                        ItemClick="Package_ItemClick"
                                        DoubleTapped="Package_DoubleTapped"
                                        HorizontalContentAlignment="Stretch"
                                        ScrollViewer.HorizontalScrollMode="Disabled"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        Visibility="{x:Bind ShowList(ViewModel.ViewModeIndex), Mode=OneWay}"
                                        AutomationProperties.AutomationId="Winget_Packages">
                                        <ListView.ItemContainerTransitions>
                                            <TransitionCollection />
                                        </ListView.ItemContainerTransitions>
                                    </ListView>

                                    <GridView
                                        x:Name="PackageTiles"
                                        Grid.Row="1"
                                        Padding="10"
                                        ItemsSource="{x:Bind ViewModel.DisplayPackages}"
                                        SelectedItem="{x:Bind ViewModel.ActiveSelection, Mode=TwoWay}"
                                        ItemTemplate="{StaticResource TilePackageTemplate}"
                                        SelectionMode="Single"
                                        IsItemClickEnabled="True"
                                        ItemClick="Package_ItemClick"
                                        DoubleTapped="Package_DoubleTapped"
                                        ScrollViewer.HorizontalScrollMode="Disabled"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        Visibility="{x:Bind ShowTiles(ViewModel.ViewModeIndex), Mode=OneWay}" />

                                    <!-- Centered loading / empty state -->
                                    <StackPanel
                                        x:Name="PackageEmptyPanel"
                                        Grid.Row="1"
                                        Spacing="10"
                                        Margin="24"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind ShowEmpty(ViewModel.ActiveTabIndex, ViewModel.HasRows, ViewModel.HasSearchResults), Mode=OneWay}">
                                        <ProgressRing
                                            Width="28"
                                            Height="28"
                                            HorizontalAlignment="Center"
                                            IsActive="{x:Bind ViewModel.IsLoadingList, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.IsLoadingList, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <Border
                                            Width="48"
                                            Height="48"
                                            CornerRadius="24"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            HorizontalAlignment="Center"
                                            Visibility="{x:Bind ViewModel.IsLoadingList, Mode=OneWay, Converter={StaticResource ReverseBoolToVisibilityConverter}}">
                                            <FontIcon Glyph="&#xE7B8;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                        </Border>
                                        <TextBlock
                                            x:Name="PackageEmptyText"
                                            Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                                            TextWrapping="Wrap"
                                            TextAlignment="Center"
                                            MaxWidth="420"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <Grid x:Name="DiscoverStartPanel" Grid.RowSpan="2" Visibility="{x:Bind ShowDiscoveryStart(ViewModel.ActiveTabIndex, ViewModel.HasSearchResults), Mode=OneWay}">
                                        <Border CornerRadius="8" Background="{ThemeResource WingetDiscoverHeroWashBrush}" IsHitTestVisible="False" />
                                        <Grid x:Name="DiscoverHeroContent" Margin="28" MaxWidth="640" RowDefinitions="Auto,Auto,Auto" RowSpacing="14" VerticalAlignment="Center">
                                            <Border
                                                Style="{StaticResource WingetDiscoverBadgeStyle}"
                                                Width="68"
                                                Height="68"
                                                CornerRadius="20"
                                                HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE774;" FontSize="30" Foreground="{ThemeResource WingetDiscoverGlyphBrush}" AutomationProperties.AccessibilityView="Raw" />
                                            </Border>
                                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBox x:Name="DiscoverSearchBox" x:Uid="Winget_SearchBox" FontSize="18" MinHeight="46" CornerRadius="6" Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" KeyDown="SearchBox_KeyDown" />
                                                <Button Grid.Column="1" x:Uid="Winget_SearchButton" MinHeight="46" Padding="18,0" CornerRadius="6" IsEnabled="{x:Bind ViewModel.CanSearch, Mode=OneWay}" Click="Search_Click" Style="{StaticResource AccentButtonStyle}" />
                                            </Grid>
                                            <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Responsive Footer -->
                    <Grid x:Name="WorkspaceFooter" Grid.Row="5" Margin="0,6,0,0" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                        <TextBlock x:Name="FooterSelectionText" Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <StackPanel x:Name="FooterControls" Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                            <ComboBox x:Uid="Winget_SortBy" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}" MinWidth="110">
                                <ComboBoxItem x:Uid="Winget_SortName" />
                                <ComboBoxItem x:Uid="Winget_SortId" />
                                <ComboBoxItem x:Uid="Winget_SortInstalled" />
                                <ComboBoxItem x:Uid="Winget_SortAvailable" />
                                <ComboBoxItem x:Uid="Winget_SortSource" />
                            </ComboBox>
                            <ToggleButton
                                x:Name="SortDirectionToggle"
                                x:Uid="Winget_SortDescending"
                                IsChecked="{x:Bind ViewModel.SortDescending, Mode=TwoWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.SortDirectionToolTip, Mode=OneWay}"
                                Padding="8">
                                <FontIcon Glyph="{x:Bind ViewModel.SortDirectionGlyph, Mode=OneWay}" FontSize="14" AutomationProperties.AccessibilityView="Raw" />
                            </ToggleButton>
                            <ComboBox x:Uid="Winget_ViewMode" SelectedIndex="{x:Bind ViewModel.ViewModeIndex, Mode=TwoWay}" MinWidth="110">
                                <ComboBoxItem x:Uid="Winget_DetailedView" />
                                <ComboBoxItem x:Uid="Winget_CompactView" />
                                <ComboBoxItem x:Uid="Winget_GridView" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </SplitView>
    </Grid>
</local:NavigablePage>
