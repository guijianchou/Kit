                                    <Border Style="{StaticResource KitCardSurfaceStyle}" Padding="18,16">
                                        <StackPanel Spacing="14">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <Border Style="{StaticResource KitIconBadgeSmallStyle}">
                                                    <FontIcon Glyph="&#xE9D9;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AiReportSummaryText, Mode=OneWay}"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
