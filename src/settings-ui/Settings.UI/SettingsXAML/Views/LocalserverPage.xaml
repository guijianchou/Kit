<?xml version="1.0" encoding="utf-8" ?>
<local:NavigablePage
    x:Class="Kit.Settings.UI.Views.LocalserverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kit.Settings.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Kit.Settings.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:viewModels="using:Kit.Settings.UI.ViewModels"
    xmlns:views="using:Kit.Settings.UI.Views"
    d:DataContext="{d:DesignInstance Type=viewModels:LocalserverViewModel}"
    AutomationProperties.LandmarkType="Main"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger TargetElement="{Binding ElementName=LocalserverHeroBar}" MinWidth="640" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger TargetElement="{Binding ElementName=LocalserverHeroBar}" MaxWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LocalserverHeroGrid.RowSpacing" Value="10" />
                        <Setter Target="HeroStatusGroup.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="HeroUptimeStack.(Grid.Row)" Value="1" />
                        <Setter Target="HeroUptimeStack.(Grid.Column)" Value="0" />
                        <Setter Target="HeroUptimeStack.HorizontalAlignment" Value="Left" />
                        <Setter Target="HeroRefreshButton.(Grid.Row)" Value="1" />
                        <Setter Target="HeroRefreshButton.(Grid.Column)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger TargetElement="{Binding ElementName=EnvironmentCard}" MinWidth="760" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger TargetElement="{Binding ElementName=EnvironmentCard}" MaxWidth="760" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="EnvDetailsStack.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="EnvTrendDivider.Visibility" Value="Collapsed" />
                        <Setter Target="EnvTrendPanel.(Grid.Row)" Value="1" />
                        <Setter Target="EnvTrendPanel.(Grid.Column)" Value="2" />
                        <Setter Target="EnvTrendPanel.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="EnvTrendPanel.Margin" Value="0,12,0,0" />
                        <Setter Target="EnvTileState.(Grid.Row)" Value="1" />
                        <Setter Target="EnvTileState.(Grid.Column)" Value="0" />
                        <Setter Target="EnvTileState.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="EnvTileRuntimes.(Grid.Row)" Value="1" />
                        <Setter Target="EnvTileRuntimes.(Grid.Column)" Value="2" />
                        <Setter Target="EnvTileRuntimes.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="EnvTilePort.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="EnvTilePid.(Grid.Column)" Value="2" />
                        <Setter Target="EnvTilePid.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="EnvCommandPanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="EnvCwdPanel.(Grid.Row)" Value="1" />
                        <Setter Target="EnvCwdPanel.(Grid.Column)" Value="0" />
                        <Setter Target="EnvCwdPanel.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <controls:SettingsPageControl
            x:Uid="Localserver"
            CompactHeader="True"
            IsTabStop="False"
            ModuleImageSource="ms-appx:///Assets/Settings/Modules/Localserver.png"
            ModuleTitle="Local Server">
            <controls:SettingsPageControl.ModuleContent>
                <StackPanel Spacing="16">
                    <controls:GPOInfoControl ShowWarning="{x:Bind ViewModel.IsEnabledGpoConfigured, Mode=OneWay}">
                        <tkcontrols:SettingsCard
                            x:Name="LocalserverEnableSettingsCard"
                            x:Uid="Localserver_EnableSettingsCard"
                            HeaderIcon="{ui:BitmapIcon Source=/Assets/Settings/Icons/Localserver.png}"
                            IsEnabled="{x:Bind ViewModel.IsEnabledGpoConfigured, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                            <ToggleSwitch
                                x:Name="LocalserverEnableToggleSwitch"
                                AutomationProperties.AutomationId="Toggle_Localserver"
                                IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}" />
                        </tkcontrols:SettingsCard>
                    </controls:GPOInfoControl>

                    <!-- ============================================================== -->
                    <!-- 1. LIVE SESSION TELEMETRY BAR (Unified Mica Hero Panel)        -->
                    <!-- ============================================================== -->
                    <ContentControl x:Name="LocalserverHeroBar" Style="{StaticResource KitHeroPanelStyle}">
                        <Grid
                            x:Name="LocalserverHeroGrid"
                            Padding="16,14"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="14"
                            RowDefinitions="Auto,Auto"
                            RowSpacing="0">
                            <!-- Live Status Dot & Quick Session Summary -->
                            <StackPanel x:Name="HeroStatusGroup" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border
                                    Width="26"
                                    Height="26"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="13">
                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Fill="{x:Bind ViewModel.EnvStateBrush, Mode=OneWay}" />
                                </Border>
                                <tkcontrols:WrapPanel HorizontalSpacing="8" VerticalSpacing="6" VerticalAlignment="Center">
                                    <Border Height="28" Padding="10,0" VerticalAlignment="Center" Background="{ThemeResource BadgeSuccessBackgroundBrush}" CornerRadius="14">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource BadgeSuccessForegroundBrush}" Glyph="&#xE768;" />
                                            <TextBlock VerticalAlignment="Center" FontSize="12" LineHeight="16" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" Foreground="{ThemeResource BadgeSuccessForegroundBrush}" Text="{x:Bind ViewModel.SessionRunningText, Mode=OneWay}" Typography.NumeralAlignment="Tabular" />
                                            <TextBlock x:Uid="Localserver_RunningBadge" VerticalAlignment="Center" FontSize="12" LineHeight="16" LineStackingStrategy="BlockLineHeight" Foreground="{ThemeResource BadgeSuccessForegroundBrush}" Text="Running" />
                                        </StackPanel>
                                    </Border>
                                    <Border Height="28" Padding="10,0" VerticalAlignment="Center" Background="{ThemeResource BadgeCriticalBackgroundBrush}" CornerRadius="14">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource BadgeCriticalForegroundBrush}" Glyph="&#xE783;" />
                                            <TextBlock VerticalAlignment="Center" FontSize="12" LineHeight="16" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" Foreground="{ThemeResource BadgeCriticalForegroundBrush}" Text="{x:Bind ViewModel.SessionFaultedText, Mode=OneWay}" Typography.NumeralAlignment="Tabular" />
                                            <TextBlock x:Uid="Localserver_FaultedBadge" VerticalAlignment="Center" FontSize="12" LineHeight="16" LineStackingStrategy="BlockLineHeight" Foreground="{ThemeResource BadgeCriticalForegroundBrush}" Text="Faulted" />
                                        </StackPanel>
                                    </Border>
                                    <Border Height="28" Padding="10,0" VerticalAlignment="Center" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="14">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock VerticalAlignment="Center" FontSize="12" LineHeight="16" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" Text="{x:Bind ViewModel.SessionRegisteredText, Mode=OneWay}" Typography.NumeralAlignment="Tabular" />
                                            <TextBlock x:Uid="Localserver_TotalBadge" VerticalAlignment="Center" FontSize="12" LineHeight="16" LineStackingStrategy="BlockLineHeight" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Total" />
                                        </StackPanel>
                                    </Border>
                                </tkcontrols:WrapPanel>
                            </StackPanel>

                            <!-- Session Uptime -->
                            <StackPanel
                                x:Name="HeroUptimeStack"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6">
                                <FontIcon VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE823;" />
                                <TextBlock x:Uid="Localserver_TelemetryUptimeLabel" VerticalAlignment="Center" FontSize="12" LineHeight="16" LineStackingStrategy="BlockLineHeight" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Uptime:" />
                                <TextBlock VerticalAlignment="Center" FontSize="12" LineHeight="16" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" Text="{x:Bind ViewModel.SessionUptimeText, Mode=OneWay}" Typography.NumeralAlignment="Tabular" />
                            </StackPanel>

                            <!-- Quick Refresh Action -->
                            <Button
                                x:Name="HeroRefreshButton"
                                x:Uid="Localserver_RefreshButton"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="RefreshTelemetry_Click"
                                IsEnabled="{x:Bind ViewModel.CanRefreshTelemetry, Mode=OneWay}"
                                Style="{StaticResource KitCompactToolbarButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon VerticalAlignment="Center" FontSize="11" Glyph="&#xE72C;" />
                                    <TextBlock x:Uid="Localserver_RefreshButtonText" VerticalAlignment="Center" FontSize="12" LineHeight="16" LineStackingStrategy="BlockLineHeight" Text="Refresh" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </ContentControl>

                    <!-- System Status InfoBar -->
                    <InfoBar
                        IsClosable="True"
                        IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}"
                        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Severity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsErrorOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!-- All module settings disabled when master switch is OFF -->
                    <ContentControl
                        HorizontalContentAlignment="Stretch"
                        IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}"
                        IsTabStop="False"
                        Opacity="{x:Bind ViewModel.IsEnabled, Mode=OneWay, Converter={StaticResource BoolToDisabledOpacityConverter}}">
                        <StackPanel ChildrenTransitions="{StaticResource SettingsCardsAnimations}" Spacing="16">

                            <!-- ============================================================== -->
                            <!-- 2. SERVICES MANAGEMENT SECTION (Main Action Workspace)         -->
                            <!-- ============================================================== -->
                            <Grid Margin="0,4,0,0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock
                                        x:Uid="Localserver_LinesHeader"
                                        VerticalAlignment="Center"
                                        AutomationProperties.HeadingLevel="Level2"
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="Services" />
                                    <Border Height="24" Padding="10,0" VerticalAlignment="Center" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <TextBlock VerticalAlignment="Center" FontSize="11" LineHeight="16" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" Text="{x:Bind ViewModel.Lines.Count, Mode=OneWay}" Typography.NumeralAlignment="Tabular" />
                                            <TextBlock x:Uid="Localserver_ConfiguredBadge" VerticalAlignment="Center" FontSize="11" LineHeight="16" LineStackingStrategy="BlockLineHeight" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="configured" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <tkcontrols:WrapPanel Grid.Column="1" HorizontalAlignment="Right" HorizontalSpacing="8" VerticalSpacing="6" VerticalAlignment="Center">
                                    <Button x:Uid="Localserver_AddServiceButton" Click="AddLine_Click" IsEnabled="{x:Bind ViewModel.CanAddLine, Mode=OneWay}" Style="{StaticResource KitPrimaryActionButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon VerticalAlignment="Center" FontSize="12" Glyph="&#xE710;" />
                                            <TextBlock x:Uid="Localserver_AddLineButtonText" VerticalAlignment="Center" FontSize="13" Text="Add service" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Uid="Localserver_StartAllServicesButton" Click="StartAll_Click" IsEnabled="{x:Bind ViewModel.CanStartAll, Mode=OneWay}" Style="{StaticResource KitActionButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE768;" />
                                            <TextBlock x:Uid="Localserver_StartAllButtonText" VerticalAlignment="Center" FontSize="13" Text="Start all" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Uid="Localserver_StopAllServicesButton" Click="StopAll_Click" IsEnabled="{x:Bind ViewModel.CanStopAll, Mode=OneWay}" Style="{StaticResource KitActionButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xE71A;" />
                                            <TextBlock x:Uid="Localserver_StopAllButtonText" VerticalAlignment="Center" FontSize="13" Text="Stop all" />
                                        </StackPanel>
                                    </Button>
                                </tkcontrols:WrapPanel>
                            </Grid>

                            <!-- Empty State Card -->
                            <Border
                                Padding="28"
                                Style="{StaticResource KitCardSurfaceStyle}"
                                Visibility="{x:Bind views:LocalserverPage.GetEmptyVisibility(ViewModel.Lines.Count), Mode=OneWay}">
                                <StackPanel HorizontalAlignment="Center" Spacing="8">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        AutomationProperties.AccessibilityView="Raw"
                                        FontSize="28"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xE968;" />
                                    <TextBlock x:Uid="Localserver_EmptyLinesTitle" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Uid="Localserver_EmptyLinesDescription" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Services Table Container (hidden when empty so no orphan header renders) -->
                            <Border
                                Style="{StaticResource KitCardSurfaceStyle}" Padding="0"
                                Visibility="{x:Bind views:LocalserverPage.GetNonEmptyVisibility(ViewModel.Lines.Count), Mode=OneWay}">
                                <ScrollViewer
                                    HorizontalScrollBarVisibility="Auto"
                                    HorizontalScrollMode="Auto"
                                    VerticalScrollBarVisibility="Disabled"
                                    VerticalScrollMode="Disabled">
                                    <StackPanel MinWidth="680" Spacing="0">
                                        <!-- Table Header -->
                                        <Grid Padding="16,11,16,7" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.1*" MinWidth="96" />
                                                <ColumnDefinition Width="0.5*" MinWidth="48" />
                                                <ColumnDefinition Width="0.8*" MinWidth="80" />
                                                <ColumnDefinition Width="0.7*" MinWidth="70" />
                                                <ColumnDefinition Width="0.5*" MinWidth="48" />
                                                <ColumnDefinition Width="0.6*" MinWidth="56" />
                                                <ColumnDefinition Width="0.7*" MinWidth="60" />
                                                <ColumnDefinition Width="128" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="Localserver_ColName" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock x:Uid="Localserver_ColPort" Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock x:Uid="Localserver_ColState" Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock x:Uid="Localserver_ColUptime" Grid.Column="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock x:Uid="Localserver_ColCpu" Grid.Column="4" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock x:Uid="Localserver_ColMem" Grid.Column="5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock x:Uid="Localserver_ColPid" Grid.Column="6" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Grid>

                                        <!-- Service Rows ItemsControl -->
                                        <ItemsControl x:Name="ServiceRows" ItemsSource="{x:Bind ViewModel.Lines, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="0" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewModels:LineRowViewModel">
                                                    <Border
                                                        Padding="16,10"
                                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                        BorderThickness="0,0,0,1">
                                                        <Grid ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="1.1*" MinWidth="96" />
                                                                <ColumnDefinition Width="0.5*" MinWidth="48" />
                                                                <ColumnDefinition Width="0.8*" MinWidth="80" />
                                                                <ColumnDefinition Width="0.7*" MinWidth="70" />
                                                                <ColumnDefinition Width="0.5*" MinWidth="48" />
                                                                <ColumnDefinition Width="0.6*" MinWidth="56" />
                                                                <ColumnDefinition Width="0.7*" MinWidth="60" />
                                                                <ColumnDefinition Width="128" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Row 0: NAME + Tag + Lock -->
                                                            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}" />
                                                                <Border Padding="6,2" VerticalAlignment="Center" Background="{x:Bind TagBackgroundBrush, Mode=OneWay}" CornerRadius="4" Visibility="{x:Bind TagVisibility, Mode=OneWay}">
                                                                    <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{x:Bind TagBrush, Mode=OneWay}" Text="{x:Bind TagLabel, Mode=OneWay}" />
                                                                </Border>
                                                                <Border Padding="6,2" VerticalAlignment="Center" Background="{ThemeResource BadgeWarningBackgroundBrush}" CornerRadius="4" ToolTipService.ToolTip="{x:Bind AdoptedTooltip, Mode=OneWay}" Visibility="{x:Bind AdoptedVisibility, Mode=OneWay}">
                                                                    <TextBlock x:Uid="Localserver_AdoptedBadge" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource BadgeWarningForegroundBrush}" Text="ADOPTED" />
                                                                </Border>
                                                                <FontIcon VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE72E;" ToolTipService.ToolTip="{x:Bind LockTooltip, Mode=OneWay}" Visibility="{x:Bind LockVisibility, Mode=OneWay}" />
                                                            </StackPanel>

                                                            <!-- Row 0: PORT -->
                                                            <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" FontFamily="{StaticResource KitMonoFontFamily}" Text="{x:Bind PortText, Mode=OneWay}" Typography.NumeralAlignment="Tabular" />

                                                            <!-- Row 0: STATE -->
                                                            <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{x:Bind StateBrush, Mode=OneWay}" />
                                                                <TextBlock VerticalAlignment="Center" Text="{x:Bind StateLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>

                                                            <!-- Row 0: UPTIME -->
                                                            <TextBlock Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" FontFamily="{StaticResource KitMonoFontFamily}" Foreground="{x:Bind UptimeBrush, Mode=OneWay}" Text="{x:Bind UptimeText, Mode=OneWay}" Typography.NumeralAlignment="Tabular" />

                                                            <!-- Row 0: CPU -->
                                                            <TextBlock Grid.Row="0" Grid.Column="4" VerticalAlignment="Center" FontFamily="{StaticResource KitMonoFontFamily}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind CpuText, Mode=OneWay}" Typography.NumeralAlignment="Tabular" />

                                                            <!-- Row 0: MEM -->
                                                            <TextBlock Grid.Row="0" Grid.Column="5" VerticalAlignment="Center" FontFamily="{StaticResource KitMonoFontFamily}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind MemoryText, Mode=OneWay}" Typography.NumeralAlignment="Tabular" />

                                                            <!-- Row 0: PID -->
                                                            <TextBlock Grid.Row="0" Grid.Column="6" VerticalAlignment="Center" FontFamily="{StaticResource KitMonoFontFamily}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind PidText, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind PidTooltip, Mode=OneWay}" Typography.NumeralAlignment="Tabular" />

                                                            <!-- Row 0: Actions Column -->
                                                            <StackPanel Grid.Row="0" Grid.Column="7" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                                                                <ToggleSwitch
                                                                    Width="40"
                                                                    Margin="0,0,4,0"
                                                                    VerticalAlignment="Center"
                                                                    AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                                                                    IsEnabled="{x:Bind CanToggle, Mode=OneWay}"
                                                                    IsOn="{x:Bind IsOn, Mode=TwoWay}"
                                                                    OffContent=""
                                                                    OnContent=""
                                                                    Style="{StaticResource RightAlignedCompactToggleSwitchStyle}" />
                                                                <Button
                                                                    x:Uid="Localserver_ConfigureButton"
                                                                    Click="ToggleConfigExpanded_Click"
                                                                    DataContext="{x:Bind}"
                                                                    Style="{StaticResource KitSubtleIconButtonStyle}">
                                                                    <FontIcon FontSize="12" Glyph="{x:Bind ExpandGlyph, Mode=OneWay}" />
                                                                </Button>
                                                                <Button
                                                                    x:Uid="Localserver_MoreOptionsButton"
                                                                    Style="{StaticResource KitSubtleIconButtonStyle}">
                                                                    <FontIcon FontSize="14" Glyph="&#xE712;" />
                                                                    <Button.Flyout>
                                                                        <MenuFlyout>
                                                                            <MenuFlyoutItem x:Uid="Localserver_RestartLineMenu" Click="RestartLine_Click" DataContext="{x:Bind}" IsEnabled="{x:Bind CanRestart, Mode=OneWay}">
                                                                                <MenuFlyoutItem.Icon>
                                                                                    <FontIcon Glyph="&#xE72C;" />
                                                                                </MenuFlyoutItem.Icon>
                                                                            </MenuFlyoutItem>
                                                                            <MenuFlyoutItem x:Uid="Localserver_ForceKillLineMenu" Click="ForceKillLine_Click" DataContext="{x:Bind}" IsEnabled="{x:Bind CanForceKill, Mode=OneWay}">
                                                                                <MenuFlyoutItem.Icon>
                                                                                    <FontIcon Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xE711;" />
                                                                                </MenuFlyoutItem.Icon>
                                                                            </MenuFlyoutItem>
                                                                        </MenuFlyout>
                                                                    </Button.Flyout>
                                                                </Button>
                                                            </StackPanel>

                                                            <!-- Row 1: Concise Activity Label + Pooled ProbeHistoryStrip -->
                                                            <TextBlock
                                                                x:Uid="Localserver_StatusLabel"
                                                                Grid.Row="1"
                                                                Grid.Column="0"
                                                                Margin="0,8,0,0"
                                                                VerticalAlignment="Center"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                Visibility="{x:Bind StatusVisibility, Mode=OneWay}" />

                                                            <controls:ProbeHistoryStrip
                                                                Grid.Row="1"
                                                                Grid.Column="1"
                                                                Grid.ColumnSpan="6"
                                                                Height="20"
                                                                Margin="0,8,16,0"
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Center"
                                                                AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                                                                IncludeNeutralPath="True"
                                                                ItemsSource="{x:Bind RecentBars, Mode=OneWay}"
                                                                Visibility="{x:Bind StatusVisibility, Mode=OneWay}" />

                                                            <!-- Open hyperlink button directly under Actions -->
                                                            <HyperlinkButton
                                                                Grid.Row="1"
                                                                Grid.Column="7"
                                                                Margin="0,8,0,0"
                                                                Padding="8,3"
                                                                HorizontalAlignment="Right"
                                                                AutomationProperties.AutomationId="Localserver_OpenServiceUrlButton"
                                                                Click="OpenServiceUrl_Click"
                                                                CornerRadius="4"
                                                                DataContext="{x:Bind}"
                                                                ToolTipService.ToolTip="{x:Bind OpenUrl, Mode=OneWay}"
                                                                Visibility="{x:Bind OpenUrlVisibility, Mode=OneWay}">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <FontIcon FontSize="11" Glyph="&#xE774;" />
                                                                    <TextBlock x:Uid="Localserver_OpenUrlText" FontSize="12" />
                                                                </StackPanel>
                                                            </HyperlinkButton>

                                                            <!-- Row 2: Expanded Configuration Panel -->
                                                            <Border
                                                                Grid.Row="2"
                                                                Grid.Column="0"
                                                                Grid.ColumnSpan="8"
                                                                Margin="0,12,0,4"
                                                                Padding="16,14"
                                                                Style="{StaticResource KitRecessedSurfaceStyle}"
                                                                Visibility="{x:Bind ConfigVisibility, Mode=OneWay}">
                                                                <StackPanel Spacing="12">
                                                                    <Grid ColumnDefinitions="110,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                                                                        <!-- NAME -->
                                                                        <TextBlock x:Uid="Localserver_ConfigName" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                                        <TextBox Grid.Column="1" CornerRadius="4" IsEnabled="{x:Bind IsEditable, Mode=OneWay}" Text="{x:Bind Name, Mode=TwoWay}" />

                                                                        <!-- COMMAND -->
                                                                        <TextBlock x:Uid="Localserver_ConfigCommand" Grid.Row="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                                        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                            <TextBox CornerRadius="4" FontFamily="{StaticResource KitMonoFontFamily}" IsEnabled="{x:Bind IsEditable, Mode=OneWay}" Text="{x:Bind Executable, Mode=TwoWay}" />
                                                                            <Button x:Uid="Localserver_BrowseFileButton" Grid.Column="1" AutomationProperties.AutomationId="Localserver_BrowseFileButton" Click="BrowseExecutable_Click" DataContext="{x:Bind}" IsEnabled="{x:Bind IsEditable, Mode=OneWay}" Style="{StaticResource KitActionButtonStyle}">
                                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                    <FontIcon FontSize="12" Glyph="&#xE8B7;" />
                                                                                    <TextBlock x:Uid="Localserver_BrowseFileButtonText" VerticalAlignment="Center" FontSize="12" Text="Browse..." />
                                                                                </StackPanel>
                                                                            </Button>
                                                                        </Grid>

                                                                        <!-- ARGUMENTS -->
                                                                        <TextBlock x:Uid="Localserver_ConfigArguments" Grid.Row="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                                        <TextBox Grid.Row="2" Grid.Column="1" CornerRadius="4" FontFamily="{StaticResource KitMonoFontFamily}" IsEnabled="{x:Bind IsEditable, Mode=OneWay}" Text="{x:Bind BaseArgsText, Mode=TwoWay}" />

                                                                        <!-- WORKING DIR -->
                                                                        <TextBlock x:Uid="Localserver_ConfigWorkingDir" Grid.Row="3" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                                        <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                            <TextBox CornerRadius="4" FontFamily="{StaticResource KitMonoFontFamily}" IsEnabled="{x:Bind IsEditable, Mode=OneWay}" Text="{x:Bind Cwd, Mode=TwoWay}" />
                                                                            <Button x:Uid="Localserver_BrowseFolderButton" Grid.Column="1" AutomationProperties.AutomationId="Localserver_BrowseFolderButton" Click="BrowseCwd_Click" DataContext="{x:Bind}" IsEnabled="{x:Bind IsEditable, Mode=OneWay}" Style="{StaticResource KitActionButtonStyle}">
                                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                    <FontIcon FontSize="12" Glyph="&#xE838;" />
                                                                                    <TextBlock x:Uid="Localserver_BrowseFolderButtonText" VerticalAlignment="Center" FontSize="12" Text="Browse..." />
                                                                                </StackPanel>
                                                                            </Button>
                                                                        </Grid>

                                                                        <!-- PORT -->
                                                                        <TextBlock x:Uid="Localserver_ConfigPort" Grid.Row="4" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                                                            <NumberBox Width="130" CornerRadius="4" IsEnabled="{x:Bind IsEditable, Mode=OneWay}" Maximum="65535" Minimum="0" SpinButtonPlacementMode="Compact" Value="{x:Bind PortValue, Mode=TwoWay}" />
                                                                            <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind PortHintText, Mode=OneWay}" />
                                                                        </StackPanel>

                                                                        <!-- RESOLVED COMMAND -->
                                                                        <TextBlock x:Uid="Localserver_ConfigResolvedCommand" Grid.Row="5" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                                        <TextBox Grid.Row="5" Grid.Column="1" CornerRadius="4" FontFamily="{StaticResource KitMonoFontFamily}" IsReadOnly="True" Text="{x:Bind ResolvedCommandText, Mode=OneWay}" TextWrapping="Wrap" />
                                                                    </Grid>

                                                                    <Rectangle Height="1" Margin="0,4" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                                                    <Grid Margin="0,4,0,0">
                                                                        <Button
                                                                            x:Uid="Localserver_DeleteLineButton"
                                                                            HorizontalAlignment="Left"
                                                                            AutomationProperties.AutomationId="Localserver_DeleteLineButton"
                                                                            IsEnabled="{x:Bind IsEditable, Mode=OneWay}"
                                                                            Style="{StaticResource KitDangerActionButtonStyle}">
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <FontIcon FontSize="13" Glyph="&#xE74D;" />
                                                                                <TextBlock x:Uid="Localserver_DeleteLineButtonText" />
                                                                            </StackPanel>
                                                                            <Button.Flyout>
                                                                                <Flyout>
                                                                                    <StackPanel MaxWidth="300" Spacing="10">
                                                                                        <TextBlock x:Uid="Localserver_ConfirmDeleteTitle" FontWeight="SemiBold" />
                                                                                        <TextBlock x:Uid="Localserver_ConfirmDeleteDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                                                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                                                                            <Button x:Uid="Localserver_ConfirmDeleteCancelButton" Click="CancelDeleteLine_Click" Style="{StaticResource KitActionButtonStyle}" />
                                                                                            <Button x:Uid="Localserver_ConfirmDeleteConfirmButton" Click="DeleteLine_Click" DataContext="{x:Bind}" Style="{StaticResource KitDangerActionButtonStyle}" />
                                                                                        </StackPanel>
                                                                                    </StackPanel>
                                                                                </Flyout>
                                                                            </Button.Flyout>
                                                                        </Button>

                                                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                                                            <Button
                                                                                x:Uid="Localserver_CollapseLineButton"
                                                                                AutomationProperties.AutomationId="Localserver_CollapseLineButton"
                                                                                Click="ToggleConfigExpanded_Click"
                                                                                DataContext="{x:Bind}"
                                                                                Style="{StaticResource KitActionButtonStyle}">
                                                                                <TextBlock x:Uid="Localserver_CollapseLineButtonText" />
                                                                            </Button>
                                                                            <Button
                                                                                x:Uid="Localserver_SaveLineButton"
                                                                                AutomationProperties.AutomationId="Localserver_SaveLineButton"
                                                                                Click="SaveCatalog_Click"
                                                                                IsEnabled="{x:Bind IsEditable, Mode=OneWay}"
                                                                                Style="{StaticResource KitPrimaryActionButtonStyle}">
                                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                    <FontIcon FontSize="13" Glyph="&#xE74E;" />
                                                                                    <TextBlock x:Uid="Localserver_SaveLineButtonText" />
                                                                                </StackPanel>
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- ============================================================== -->
                            <!-- 3. ENVIRONMENT DIAGNOSTICS (Full-Width Horizontal Deck)        -->
                            <!-- ============================================================== -->
                            <Border
                                x:Name="EnvironmentCard"
                                Margin="0,4,0,0"
                                Padding="18,16"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource KitCardSurfaceStyle}">
                                <StackPanel Spacing="12">
                                    <!-- Top Header & Service Selector Bar -->
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                                            <Border Style="{StaticResource KitIconBadgeStyle}">
                                                <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE9D9;" />
                                            </Border>
                                            <TextBlock x:Uid="Localserver_SectionEnvironment" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource KitCardTitleTextStyle}" />
                                        </StackPanel>
                                        <Border
                                            Grid.Column="1"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource KitStatusPillStyle}">
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{x:Bind ViewModel.EnvSummaryBrush, Mode=OneWay}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{x:Bind ViewModel.EnvSummaryBrush, Mode=OneWay}"
                                                    Text="{x:Bind ViewModel.EnvSummaryText, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                        <ComboBox
                                            x:Uid="Localserver_SelectedLineComboBox"
                                            Grid.Column="2"
                                            Width="200"
                                            Height="32"
                                            MinWidth="0"
                                            Padding="10,0"
                                            CornerRadius="4"
                                            DisplayMemberPath="Name"
                                            FontSize="12"
                                            ItemsSource="{x:Bind ViewModel.Lines, Mode=OneWay}"
                                            SelectedItem="{x:Bind ViewModel.SelectedLine, Mode=TwoWay}" />
                                    </Grid>

                                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                    <!-- Horizontal Tiled Body: Health Ring | Metrics + Paths + Checks | Unified Resource Bars -->
                                    <Grid ColumnDefinitions="104,Auto,*,Auto,248" ColumnSpacing="16" RowDefinitions="Auto,Auto">
                                        <!-- Left: Health Ring -->
                                        <StackPanel Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                            <Grid Width="88" Height="88">
                                                <Ellipse Width="68" Height="68" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                <Ellipse Width="84" Height="84" Stroke="{ThemeResource CardStrokeColorDefaultBrush}" StrokeThickness="6" />
                                                <Ellipse Width="84" Height="84" Stroke="{x:Bind ViewModel.HealthRingBrush, Mode=OneWay}" StrokeThickness="6" />
                                                <TextBlock Width="72" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.HealthStateText, Mode=OneWay}" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </StackPanel>

                                        <Border Grid.Column="1" Grid.RowSpan="2" Width="1" Margin="0,2" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                        <!-- Center: Metrics + Command/WorkingDir + Checks Chips -->
                                        <StackPanel x:Name="EnvDetailsStack" Grid.Column="2" Spacing="10">
                                            <!-- 4 Unified Borderless Subtle Metadata Tiles: PORT, PID, STATE, RUNTIMES -->
                                            <Grid ColumnDefinitions="1*,1*,1.2*,1.6*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="8">
                                                <Border x:Name="EnvTilePort" Padding="10,7" Style="{StaticResource KitSubtleSurfaceStyle}">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock x:Uid="Localserver_ColPort" Style="{StaticResource KitMicroLabelTextStyle}" />
                                                        <TextBlock Style="{StaticResource KitMetricCompactTextStyle}" Text="{x:Bind ViewModel.EnvPortText, Mode=OneWay}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="EnvTilePid" Grid.Column="1" Padding="10,7" Style="{StaticResource KitSubtleSurfaceStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.EnvPidTooltip, Mode=OneWay}">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock x:Uid="Localserver_ColPid" Style="{StaticResource KitMicroLabelTextStyle}" />
                                                        <TextBlock Style="{StaticResource KitMetricCompactTextStyle}" Text="{x:Bind ViewModel.EnvPidText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="EnvTileState" Grid.Column="2" Padding="10,7" Style="{StaticResource KitSubtleSurfaceStyle}">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock x:Uid="Localserver_ColState" Style="{StaticResource KitMicroLabelTextStyle}" />
                                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{x:Bind ViewModel.EnvStateBrush, Mode=OneWay}" />
                                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{x:Bind ViewModel.EnvStateBrush, Mode=OneWay}" Text="{x:Bind ViewModel.EnvStateText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="EnvTileRuntimes" Grid.Column="3" Padding="10,7" Style="{StaticResource KitSubtleSurfaceStyle}">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock x:Uid="Localserver_RuntimesLabel" Style="{StaticResource KitMicroLabelTextStyle}" />
                                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="{x:Bind ViewModel.EnvRuntimesText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Secondary details: COMMAND & ARGS and WORKING DIR -->
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="8">
                                                <StackPanel x:Name="EnvCommandPanel" Spacing="4">
                                                    <TextBlock x:Uid="Localserver_CommandAndArgsLabel" Style="{StaticResource KitMicroLabelTextStyle}" />
                                                    <Border Padding="10,6" Style="{StaticResource KitSubtleSurfaceStyle}">
                                                        <TextBlock FontFamily="{StaticResource KitMonoFontFamily}" IsTextSelectionEnabled="True" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.EnvCommandText, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{x:Bind ViewModel.EnvCommandText, Mode=OneWay}" />
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel x:Name="EnvCwdPanel" Grid.Column="1" Spacing="4">
                                                    <TextBlock x:Uid="Localserver_WorkingDirLabel" Style="{StaticResource KitMicroLabelTextStyle}" />
                                                    <Border Padding="10,6" Style="{StaticResource KitSubtleSurfaceStyle}">
                                                        <TextBlock FontFamily="{StaticResource KitMonoFontFamily}" IsTextSelectionEnabled="True" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.EnvCwdText, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{x:Bind ViewModel.EnvCwdText, Mode=OneWay}" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <!-- CHECKS Chips -->
                                            <StackPanel Spacing="6">
                                                <TextBlock x:Uid="Localserver_ChecksLabel" Style="{StaticResource KitMicroLabelTextStyle}" />
                                                <ItemsControl ItemsSource="{x:Bind ViewModel.EnvironmentCheckChips, Mode=OneWay}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <tkcontrols:WrapPanel HorizontalSpacing="8" Orientation="Horizontal" VerticalSpacing="6" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="viewModels:EnvironmentCheckChipModel">
                                                            <Border Padding="10,5" Background="{x:Bind BackgroundBrush}" CornerRadius="6" ToolTipService.ToolTip="{x:Bind Tooltip}">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <FontIcon VerticalAlignment="Center" FontSize="11" Foreground="{x:Bind ForegroundBrush}" Glyph="{x:Bind StatusGlyph}" />
                                                                    <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind ForegroundBrush}" Text="{x:Bind Label}" />
                                                                    <Button x:Uid="Localserver_FixButton" AutomationProperties.AutomationId="Localserver_FixButton" Style="{StaticResource KitCompactIconButtonStyle}" Visibility="{x:Bind FixVisibility}">
                                                                        <FontIcon FontSize="12" Glyph="&#xE90F;" />
                                                                        <Button.Flyout>
                                                                            <MenuFlyout>
                                                                                <MenuFlyoutItem x:Uid="Localserver_CopyFixCommandMenu" Click="CopyFixCommand_Click" DataContext="{x:Bind}" Visibility="{x:Bind FixCommandVisibility}" />
                                                                                <MenuFlyoutItem x:Uid="Localserver_ReleasePortMenu" Click="ReleasePort_Click" DataContext="{x:Bind}" Visibility="{x:Bind ReleasePortVisibility}" />
                                                                            </MenuFlyout>
                                                                        </Button.Flyout>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border x:Name="EnvTrendDivider" Grid.Column="3" Width="1" Margin="0,2" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                        <!-- Right: Unified Process Resource Telemetry (CPU Trend Curve & Memory Bar) -->
                                        <Border x:Name="EnvTrendPanel" Grid.Column="4" Padding="14,12" VerticalAlignment="Stretch" Style="{StaticResource KitSubtleSurfaceStyle}">
                                            <StackPanel VerticalAlignment="Center" Spacing="10">
                                                <!-- CPU Usage & Trend Curve -->
                                                <StackPanel Spacing="5">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                                            <FontIcon VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE950;" />
                                                            <TextBlock x:Uid="Localserver_CpuTrendLabel" VerticalAlignment="Center" Style="{StaticResource KitMicroLabelTextStyle}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="{StaticResource KitMonoFontFamily}" FontSize="12.5" FontWeight="SemiBold" Text="{x:Bind ViewModel.EnvCpuText, Mode=OneWay}" Typography.NumeralAlignment="Tabular" />
                                                    </Grid>
                                                    <!-- CPU Trend Wave Sparkline -->
                                                    <Border Height="38" Margin="0,1,0,0" Padding="0" SizeChanged="OnStatusChartSizeChanged" Style="{StaticResource KitRecessedSurfaceStyle}">
                                                        <Grid>
                                                            <Path
                                                                Data="{x:Bind ViewModel.StatusCurveFillGeometry, Mode=OneWay}"
                                                                Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                                Opacity="0.14" />
                                                            <Path
                                                                Data="{x:Bind ViewModel.StatusCurveGeometry, Mode=OneWay}"
                                                                Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                                                StrokeEndLineCap="Round"
                                                                StrokeLineJoin="Round"
                                                                StrokeStartLineCap="Round"
                                                                StrokeThickness="1.75" />
                                                            <TextBlock
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                FontFamily="{StaticResource KitMonoFontFamily}"
                                                                FontSize="11"
                                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                Text="—"
                                                                Visibility="{x:Bind ViewModel.StatusChartEmptyVisibility, Mode=OneWay}" />
                                                        </Grid>
                                                    </Border>
                                                    <local:UsageProgressBar
                                                        x:Uid="Localserver_CpuUsageBar"
                                                        Height="4"
                                                        local:UsageProgressBar.UsageCategory="Cpu"
                                                        AutomationProperties.HelpText="{x:Bind ViewModel.EnvCpuText, Mode=OneWay}"
                                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                        CornerRadius="2"
                                                        Maximum="100"
                                                        TargetValue="{x:Bind ViewModel.EnvCpuPercent, Mode=OneWay}" />
                                                </StackPanel>

                                                <!-- Memory Usage Bar -->
                                                <StackPanel Spacing="5">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                                            <FontIcon VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE964;" />
                                                            <TextBlock x:Uid="Localserver_ColMem" VerticalAlignment="Center" Style="{StaticResource KitMicroLabelTextStyle}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="{StaticResource KitMonoFontFamily}" FontSize="12.5" FontWeight="SemiBold" Text="{x:Bind ViewModel.EnvMemoryText, Mode=OneWay}" Typography.NumeralAlignment="Tabular" />
                                                    </Grid>
                                                    <local:UsageProgressBar
                                                        x:Uid="Localserver_MemoryUsageBar"
                                                        Height="6"
                                                        local:UsageProgressBar.UsageCategory="Memory"
                                                        AutomationProperties.HelpText="{x:Bind ViewModel.EnvMemoryText, Mode=OneWay}"
                                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                        CornerRadius="3"
                                                        Maximum="100"
                                                        TargetValue="{x:Bind ViewModel.EnvMemoryPercent, Mode=OneWay}" />
                                                </StackPanel>

                                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                                <!-- Peak CPU & Uptime Footer -->
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource KitMonoFontFamily}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.StatusChartRangeText, Mode=OneWay}" Typography.NumeralAlignment="Tabular" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                                                        <FontIcon VerticalAlignment="Center" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE823;" />
                                                        <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource KitMonoFontFamily}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.EnvUptimeText, Mode=OneWay}" Typography.NumeralAlignment="Tabular" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ============================================================== -->
                            <!-- 4. BOTTOM OUTPUT DRAWER (Native Expander + Virtualized ListView) -->
                            <!-- ============================================================== -->
                            <Expander
                                x:Name="OutputDrawerExpander"
                                Margin="0,4,0,0"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                CornerRadius="{StaticResource OverlayCornerRadius}"
                                IsExpanded="{x:Bind ViewModel.IsLogPanelOpen, Mode=TwoWay}">
                                <Expander.Header>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE756;" />
                                            <TextBlock x:Uid="Localserver_OutputHeader" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ViewModel.LogSubtitleText, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel
                                            Grid.Column="2"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            Visibility="{x:Bind ViewModel.LogActionsVisibility, Mode=OneWay}">
                                            <ToggleButton
                                                x:Uid="Localserver_LogFollowToggle"
                                                AutomationProperties.AutomationId="Localserver_LogAutoScrollToggle"
                                                IsChecked="{x:Bind ViewModel.IsLogFollowEnabled, Mode=TwoWay}"
                                                Style="{StaticResource KitCompactToggleButtonStyle}" />
                                            <Button
                                                x:Uid="Localserver_OpenLogFolderButton"
                                                Click="OpenLogFolder_Click"
                                                Style="{StaticResource KitCompactIconButtonStyle}">
                                                <FontIcon FontSize="13" Glyph="&#xE8B7;" />
                                            </Button>
                                            <Button
                                                x:Uid="Localserver_ClearLogsButton"
                                                Click="ClearLogs_Click"
                                                Style="{StaticResource KitCompactIconButtonStyle}">
                                                <FontIcon FontSize="13" Glyph="&#xE74D;" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Expander.Header>

                                <StackPanel Spacing="0">
                                    <Grid
                                        x:Name="LogConsoleContainer"
                                        Height="220"
                                        MinHeight="120"
                                        MaxHeight="520"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <ListView
                                            x:Name="LogListView"
                                            Padding="10,8"
                                            HorizontalContentAlignment="Stretch"
                                            ItemsSource="{x:Bind ViewModel.LogLines, Mode=OneWay}"
                                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                            ScrollViewer.HorizontalScrollMode="Auto"
                                            SelectionMode="None">
                                            <ListView.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" />
                                                </ItemsPanelTemplate>
                                            </ListView.ItemsPanel>
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="MinHeight" Value="20" />
                                                    <Setter Property="Padding" Value="4,1" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="IsTabStop" Value="False" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="viewModels:LogLineViewModel">
                                                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                                                        <TextBlock FontFamily="{StaticResource KitMonoFontFamily}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Timestamp}" Typography.NumeralAlignment="Tabular" />
                                                        <TextBlock Grid.Column="1" Width="24" FontFamily="{StaticResource KitMonoFontFamily}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind StreamLabel}" />
                                                        <TextBlock Grid.Column="2" FontFamily="{StaticResource KitMonoFontFamily}" FontWeight="{x:Bind FontWeight}" Foreground="{x:Bind Brush}" IsTextSelectionEnabled="True" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Text}" TextWrapping="NoWrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <TextBlock
                                            x:Uid="Localserver_LogEmptyText"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Visibility="{x:Bind ViewModel.LogEmptyVisibility, Mode=OneWay}" />
                                    </Grid>
                                    <tkcontrols:ContentSizer
                                        HorizontalAlignment="Stretch"
                                        Orientation="Horizontal"
                                        TargetControl="{x:Bind LogConsoleContainer}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ContentControl>

                </StackPanel>
            </controls:SettingsPageControl.ModuleContent>
        </controls:SettingsPageControl>
    </Grid>
</local:NavigablePage>
