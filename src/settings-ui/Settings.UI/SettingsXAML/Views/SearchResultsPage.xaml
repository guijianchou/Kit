<local:NavigablePage
    x:Class="Kit.Settings.UI.Views.SearchResultsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Kit.Settings.UI.Services"
    xmlns:controls="using:Kit.Settings.UI.Controls"
    xmlns:converters="using:Kit.Settings.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Kit.Settings.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Kit.Settings.UI.Library"
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:tkconverters="using:CommunityToolkit.WinUI.Converters"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:Kit.Settings.UI.ViewModels"
    x:Name="RootPage"
    AutomationProperties.LandmarkType="Main"
    mc:Ignorable="d"
    FontFamily="{ThemeResource KitUiFontFamily}"
    FontSize="{ThemeResource KitFontSize14}" services:TypographyResources.BaseFontSize="14">

    <local:NavigablePage.Resources>
        <converters:IconConverter x:Key="IconConverter" />
        <tkconverters:CollectionVisibilityConverter x:Key="CollectionVisibilityConverter" />
    </local:NavigablePage.Resources>

    <controls:SettingsPageControl x:Name="PageControl" x:Uid="SearchResults_Title" services:RuntimeLocalization.Uid="SearchResults_Title" CompactHeader="True">
        <controls:SettingsPageControl.ModuleContent>
            <StackPanel
                AutomationProperties.LiveSetting="Polite"
                ChildrenTransitions="{StaticResource SettingsCardsAnimations}"
                Orientation="Vertical"
                Spacing="8">
                <SelectorBar
                    x:Name="ResultsFilterBar"
                    SelectionChanged="ResultsFilterBar_SelectionChanged"
                    Visibility="{x:Bind ViewModel.ShowFilterBar, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <SelectorBarItem x:Name="FilterAllItem" IsSelected="True" Tag="0" />
                    <SelectorBarItem x:Name="FilterModulesItem" Tag="1" />
                    <SelectorBarItem x:Name="FilterSettingsItem" Tag="2" />
                </SelectorBar>

                <controls:SettingsGroup
                    x:Name="ModulesGroup"
                    x:Uid="SearchResults_ModulesTitle" services:RuntimeLocalization.Uid="SearchResults_ModulesTitle"
                    Padding="0,12,0,0"
                    ItemsSource="{x:Bind ViewModel.ModuleResults, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.ShowModulesSection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <controls:SettingsGroup.ItemTemplate>
                        <DataTemplate x:DataType="models:SettingEntry">
                            <tkcontrols:SettingsCard
                                Click="ModuleButton_Click"
                                Description="{x:Bind Description}"
                                Header="{x:Bind Header}"
                                HeaderIcon="{x:Bind Icon, Converter={StaticResource IconConverter}, ConverterParameter=&#xE8B7;}"
                                IsClickEnabled="True" />
                        </DataTemplate>
                    </controls:SettingsGroup.ItemTemplate>
                </controls:SettingsGroup>

                <!--  Settings Groups  -->
                <ItemsRepeater
                    x:Name="SettingsGroupsItemsControl"
                    ItemsSource="{x:Bind ViewModel.GroupedSettingsResults, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.ShowSettingsSection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="0" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:SettingsGroup">
                            <controls:SettingsGroup Header="{x:Bind GroupName}" ItemsSource="{x:Bind Settings}">
                                <controls:SettingsGroup.ItemTemplate>
                                    <DataTemplate x:DataType="models:SettingEntry">
                                        <tkcontrols:SettingsCard
                                            Click="SettingButton_Click"
                                            Description="{x:Bind Description}"
                                            Header="{x:Bind Header}"
                                            HeaderIcon="{x:Bind Icon, Converter={StaticResource IconConverter}, ConverterParameter=&#xE713;}"
                                            IsClickEnabled="True" />
                                    </DataTemplate>
                                </controls:SettingsGroup.ItemTemplate>
                            </controls:SettingsGroup>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!--  No Results Message  -->
                <StackPanel
                    x:Name="NoResultsPanel"
                    Margin="0,48,0,0"
                    HorizontalAlignment="Center"
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.HasNoResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="40"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE721;" />
                    <TextBlock
                        x:Uid="SearchResults_NoResultsHeader" services:RuntimeLocalization.Uid="SearchResults_NoResultsHeader"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextAlignment="Center" />
                    <TextBlock
                        x:Uid="SearchResults_NoResultsDescription" services:RuntimeLocalization.Uid="SearchResults_NoResultsDescription"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        TextAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </controls:SettingsPageControl.ModuleContent>
    </controls:SettingsPageControl>
</local:NavigablePage>
