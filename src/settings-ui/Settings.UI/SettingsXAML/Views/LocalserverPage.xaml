<?xml version="1.0" encoding="utf-8" ?>
<local:NavigablePage
    x:Class="Kit.Settings.UI.Views.LocalserverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kit.Settings.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Kit.Settings.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:viewModels="using:Kit.Settings.UI.ViewModels"
    xmlns:views="using:Kit.Settings.UI.Views"
    d:DataContext="{d:DesignInstance Type=viewModels:LocalserverViewModel}"
    AutomationProperties.LandmarkType="Main"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger TargetElement="{Binding ElementName=EnvironmentCard}" MinWidth="760" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger TargetElement="{Binding ElementName=EnvironmentCard}" MaxWidth="760" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="EnvDetailsStack.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="EnvTrendDivider.Visibility" Value="Collapsed" />
                        <Setter Target="EnvTrendPanel.(Grid.Row)" Value="1" />
                        <Setter Target="EnvTrendPanel.(Grid.Column)" Value="2" />
                        <Setter Target="EnvTrendPanel.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="EnvTrendPanel.Margin" Value="0,12,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <controls:SettingsPageControl
            x:Uid="Localserver"
            ModuleTitle="Local Server"
            ModuleImageSource="ms-appx:///Assets/Settings/Modules/Localserver.png"
            IsTabStop="False">
            <controls:SettingsPageControl.ModuleContent>
                <StackPanel Spacing="16">
                    <!-- ============================================================== -->
                    <!-- 1. HERO MASTER GLASS CARD: Server Toggle & Live Telemetry Bar  -->
                    <!-- ============================================================== -->
                    <Border Style="{StaticResource KitHeroSurfaceStyle}">
                        <StackPanel Spacing="0">
                            <!-- Master Enable Toggle with GPO -->
                            <controls:GPOInfoControl ShowWarning="{x:Bind ViewModel.IsEnabledGpoConfigured, Mode=OneWay}">
                                <tkcontrols:SettingsCard
                                    x:Uid="Localserver_EnableSettingsCard"
                                    HeaderIcon="{ui:BitmapIcon Source=/Assets/Settings/Icons/Localserver.png}"
                                    IsEnabled="{x:Bind ViewModel.IsEnabledGpoConfigured, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                    BorderThickness="0" Background="Transparent">
                                    <ToggleSwitch
                                        AutomationProperties.AutomationId="Toggle_Localserver"
                                        IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}" />
                                </tkcontrols:SettingsCard>
                            </controls:GPOInfoControl>

                            <!-- Live Session Telemetry Glass Sub-Bar -->
                            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Padding="16,10" CornerRadius="0,0,8,8">
                                <Grid ColumnSpacing="14" ColumnDefinitions="Auto,*,Auto">
                                    <!-- Live Status Dot & Quick Session Summary -->
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Width="26" Height="26" CornerRadius="13" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="{x:Bind ViewModel.EnvStateBrush, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Border CornerRadius="4" Padding="6,2" Background="{ThemeResource BadgeSuccessBackgroundBrush}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE768;" FontSize="10" Foreground="{ThemeResource BadgeSuccessForegroundBrush}" />
                                                    <TextBlock Text="{x:Bind ViewModel.SessionRunningText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource BadgeSuccessForegroundBrush}" />
                                                    <TextBlock x:Uid="Localserver_RunningBadge" Text="Running" FontSize="11" Foreground="{ThemeResource BadgeSuccessForegroundBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <Border CornerRadius="4" Padding="6,2" Background="{ThemeResource BadgeWarningBackgroundBrush}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE783;" FontSize="10" Foreground="{ThemeResource BadgeWarningForegroundBrush}" />
                                                    <TextBlock Text="{x:Bind ViewModel.SessionFaultedText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource BadgeWarningForegroundBrush}" />
                                                    <TextBlock x:Uid="Localserver_FaultedBadge" Text="Faulted" FontSize="11" Foreground="{ThemeResource BadgeWarningForegroundBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <Border CornerRadius="4" Padding="6,2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{x:Bind ViewModel.SessionRegisteredText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                                                    <TextBlock x:Uid="Localserver_TotalBadge" Text="Total" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Session Uptime in Center -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE823;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Uid="Localserver_TelemetryUptimeLabel" Text="Uptime:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.SessionUptimeText, Mode=OneWay}" FontFamily="{StaticResource KitMonoFontFamily}" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>

                                    <!-- Quick Refresh Action on Right -->
                                    <Button Grid.Column="2" x:Uid="Localserver_RefreshButton"
                                            Click="RefreshTelemetry_Click" IsEnabled="{x:Bind ViewModel.CanRefreshTelemetry, Mode=OneWay}"
                                            Style="{StaticResource KitCompactToolbarButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="11" Glyph="&#xE72C;" />
                                            <TextBlock x:Uid="Localserver_RefreshButtonText" Text="Refresh" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- System Status InfoBar -->
                    <InfoBar
                        IsClosable="True"
                        IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}"
                        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Severity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}" />

                    <!-- All module settings disabled when master switch is OFF -->
                    <ContentControl IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}"
                                    Opacity="{x:Bind ViewModel.IsEnabled, Mode=OneWay, Converter={StaticResource BoolToDisabledOpacityConverter}}"
                                    IsTabStop="False"
                                    HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="16" ChildrenTransitions="{StaticResource SettingsCardsAnimations}">

                            <!-- ============================================================== -->
                            <!-- 2. SERVICES MANAGEMENT SECTION (Main Action Workspace)         -->
                            <!-- ============================================================== -->
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock x:Uid="Localserver_LinesHeader" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" Text="Services" />
                                    <Border CornerRadius="4" Padding="6,2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{x:Bind ViewModel.Lines.Count, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                                            <TextBlock x:Uid="Localserver_ConfiguredBadge" Text="configured" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Uid="Localserver_AddServiceButton" Click="AddLine_Click" IsEnabled="{x:Bind ViewModel.CanAddLine, Mode=OneWay}" Style="{StaticResource KitPrimaryActionButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                                            <TextBlock x:Uid="Localserver_AddLineButtonText" FontSize="13" Text="Add service" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Uid="Localserver_StartAllServicesButton" Click="StartAll_Click" IsEnabled="{x:Bind ViewModel.CanStartAll, Mode=OneWay}" Style="{StaticResource KitActionButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                            <TextBlock x:Uid="Localserver_StartAllButtonText" FontSize="13" Text="Start all" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Uid="Localserver_StopAllServicesButton" Click="StopAll_Click" IsEnabled="{x:Bind ViewModel.CanStopAll, Mode=OneWay}" Style="{StaticResource KitActionButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE71A;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            <TextBlock x:Uid="Localserver_StopAllButtonText" FontSize="13" Text="Stop all" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Border Width="1" Height="20" Margin="2,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Button x:Uid="Localserver_RefreshStatusButton" Click="RefreshTelemetry_Click" IsEnabled="{x:Bind ViewModel.CanRefreshTelemetry, Mode=OneWay}" Style="{StaticResource KitIconButtonStyle}">
                                        <FontIcon FontSize="13" Glyph="&#xE72C;" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Empty State Card -->
                            <Border
                                Style="{StaticResource KitCardSurfaceStyle}"
                                Padding="24"
                                Visibility="{x:Bind views:LocalserverPage.GetEmptyVisibility(ViewModel.Lines.Count), Mode=OneWay}">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Uid="Localserver_EmptyLinesTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Uid="Localserver_EmptyLinesDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Services Table Container -->
                            <Border Style="{StaticResource KitCardSurfaceStyle}" Padding="0">
                                <StackPanel Spacing="0">
                                    <!-- Table Header -->
                                    <Grid Padding="16,11,16,7" ColumnSpacing="10" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*" MinWidth="96" />
                                            <ColumnDefinition Width="0.5*" MinWidth="48" />
                                            <ColumnDefinition Width="0.8*" MinWidth="80" />
                                            <ColumnDefinition Width="0.7*" MinWidth="70" />
                                            <ColumnDefinition Width="0.5*" MinWidth="48" />
                                            <ColumnDefinition Width="0.6*" MinWidth="56" />
                                            <ColumnDefinition Width="0.7*" MinWidth="60" />
                                            <ColumnDefinition Width="128" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="Localserver_ColName" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" x:Uid="Localserver_ColPort" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="2" x:Uid="Localserver_ColState" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="3" x:Uid="Localserver_ColUptime" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="4" x:Uid="Localserver_ColCpu" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="5" x:Uid="Localserver_ColMem" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="6" x:Uid="Localserver_ColPid" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>

                                    <!-- Service Rows ItemsControl -->
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.Lines, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="0" ChildrenTransitions="{StaticResource DynamicListTransitions}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:LineRowViewModel">
                                                <Border
                                                    Padding="16,10"
                                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                    BorderThickness="0,0,0,1">
                                                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.1*" MinWidth="96" />
                                                            <ColumnDefinition Width="0.5*" MinWidth="48" />
                                                            <ColumnDefinition Width="0.8*" MinWidth="80" />
                                                            <ColumnDefinition Width="0.7*" MinWidth="70" />
                                                            <ColumnDefinition Width="0.5*" MinWidth="48" />
                                                            <ColumnDefinition Width="0.6*" MinWidth="56" />
                                                            <ColumnDefinition Width="0.7*" MinWidth="60" />
                                                            <ColumnDefinition Width="128" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Row 0: NAME + Tag + Lock -->
                                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Center" />
                                                            <Border Padding="6,2" CornerRadius="4" Background="{x:Bind TagBackgroundBrush, Mode=OneWay}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="{x:Bind TagVisibility, Mode=OneWay}" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind TagLabel, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="{x:Bind TagBrush, Mode=OneWay}" />
                                                            </Border>
                                                            <Border Padding="6,2" CornerRadius="4" Background="{ThemeResource BadgeWarningBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="{x:Bind AdoptedVisibility, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind AdoptedTooltip, Mode=OneWay}" VerticalAlignment="Center">
                                                                <TextBlock x:Uid="Localserver_AdoptedBadge" Text="ADOPTED" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource BadgeWarningForegroundBrush}" />
                                                            </Border>
                                                            <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind LockVisibility, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind LockTooltip, Mode=OneWay}" VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <!-- Row 0: PORT -->
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind PortText, Mode=OneWay}" VerticalAlignment="Center" FontFamily="{StaticResource KitMonoFontFamily}" />

                                                        <!-- Row 0: STATE -->
                                                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Ellipse Width="7" Height="7" Fill="{x:Bind StateBrush, Mode=OneWay}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{x:Bind StateLabel, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <!-- Row 0: UPTIME -->
                                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{x:Bind UptimeText, Mode=OneWay}" Foreground="{x:Bind UptimeBrush, Mode=OneWay}" FontFamily="{StaticResource KitMonoFontFamily}" VerticalAlignment="Center" />

                                                        <!-- Row 0: CPU -->
                                                        <TextBlock Grid.Row="0" Grid.Column="4" Text="{x:Bind CpuText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="{StaticResource KitMonoFontFamily}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />

                                                        <!-- Row 0: MEM -->
                                                        <TextBlock Grid.Row="0" Grid.Column="5" Text="{x:Bind MemoryText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="{StaticResource KitMonoFontFamily}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />

                                                        <!-- Row 0: PID -->
                                                        <TextBlock Grid.Row="0" Grid.Column="6" Text="{x:Bind PidText, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind PidTooltip, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource KitMonoFontFamily}" />

                                                        <!-- Row 0: Actions Column -->
                                                        <StackPanel Grid.Row="0" Grid.Column="7" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <ToggleSwitch
                                                                Style="{StaticResource RightAlignedCompactToggleSwitchStyle}"
                                                                Width="40"
                                                                Margin="0,0,4,0"
                                                                VerticalAlignment="Center"
                                                                OnContent=""
                                                                OffContent=""
                                                                IsOn="{x:Bind IsOn, Mode=TwoWay}"
                                                                IsEnabled="{x:Bind CanToggle, Mode=OneWay}"
                                                                AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" />
                                                            <Button
                                                                x:Uid="Localserver_ConfigureButton"
                                                                Style="{StaticResource KitSubtleIconButtonStyle}"
                                                                Click="ToggleConfigExpanded_Click"
                                                                DataContext="{x:Bind}">
                                                                <FontIcon FontSize="12" Glyph="{x:Bind ExpandGlyph, Mode=OneWay}" />
                                                            </Button>
                                                            <Button
                                                                x:Uid="Localserver_MoreOptionsButton"
                                                                Style="{StaticResource KitSubtleIconButtonStyle}">
                                                                <FontIcon FontSize="14" Glyph="&#xE712;" />
                                                                <Button.Flyout>
                                                                    <MenuFlyout>
                                                                        <MenuFlyoutItem x:Uid="Localserver_RestartLineMenu" Click="RestartLine_Click" DataContext="{x:Bind}" IsEnabled="{x:Bind CanRestart, Mode=OneWay}">
                                                                            <MenuFlyoutItem.Icon>
                                                                                <FontIcon Glyph="&#xE72C;" />
                                                                            </MenuFlyoutItem.Icon>
                                                                        </MenuFlyoutItem>
                                                                        <MenuFlyoutItem x:Uid="Localserver_ForceKillLineMenu" Click="ForceKillLine_Click" DataContext="{x:Bind}" IsEnabled="{x:Bind CanForceKill, Mode=OneWay}">
                                                                            <MenuFlyoutItem.Icon>
                                                                                <FontIcon Glyph="&#xE711;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                                            </MenuFlyoutItem.Icon>
                                                                        </MenuFlyoutItem>
                                                                    </MenuFlyout>
                                                                </Button.Flyout>
                                                            </Button>
                                                        </StackPanel>

                                                        <!-- Row 1: Status Sub-Row -->
                                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Visibility="{x:Bind StatusVisibility, Mode=OneWay}">
                                                            <TextBlock x:Uid="Localserver_StatusLabel" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                            <Ellipse Width="6" Height="6" Fill="{x:Bind StateBrush, Mode=OneWay}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{x:Bind StateLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <!-- RecentBars status bar -->
                                                        <ItemsControl
                                                            Grid.Row="1"
                                                            Grid.Column="1"
                                                            Grid.ColumnSpan="6"
                                                            Margin="0,8,23,0"
                                                            Height="20"
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Center"
                                                            ItemsSource="{x:Bind RecentBars, Mode=OneWay}"
                                                            Visibility="{x:Bind StatusVisibility, Mode=OneWay}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <controls:StatusBarsPanel BarWidth="5" Spacing="2" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="viewModels:StatusBarViewModel">
                                                                    <Border Height="{x:Bind BarHeight}" Width="5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="{x:Bind Brush}" CornerRadius="2" ToolTipService.ToolTip="{x:Bind Description}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- Open hyperlink button directly under Actions -->
                                                        <HyperlinkButton
                                                            Grid.Row="1"
                                                            Grid.Column="7"
                                                            Margin="0,8,0,0"
                                                            HorizontalAlignment="Right"
                                                            Padding="8,3"
                                                            CornerRadius="4"
                                                            Click="OpenServiceUrl_Click"
                                                            DataContext="{x:Bind}"
                                                            Visibility="{x:Bind OpenUrlVisibility, Mode=OneWay}"
                                                            ToolTipService.ToolTip="{x:Bind OpenUrl, Mode=OneWay}">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <FontIcon Glyph="&#xE774;" FontSize="11" />
                                                                <TextBlock x:Uid="Localserver_OpenUrlText" FontSize="12" />
                                                            </StackPanel>
                                                        </HyperlinkButton>

                                                        <!-- Row 2: Expanded Targets-style Configuration Panel -->
                                                        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="8" Margin="0,12,0,4"
                                                                Padding="16,14"
                                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Visibility="{x:Bind ConfigVisibility, Mode=OneWay}">
                                                            <StackPanel Spacing="12">
                                                                <Grid ColumnDefinitions="110,*" ColumnSpacing="12" RowSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                                                                    <!-- NAME -->
                                                                    <TextBlock x:Uid="Localserver_ConfigName" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                                    <TextBox Grid.Column="1" Text="{x:Bind Name, Mode=TwoWay}" CornerRadius="4" IsEnabled="{x:Bind IsEditable, Mode=OneWay}" />

                                                                    <!-- COMMAND -->
                                                                    <TextBlock Grid.Row="1" x:Uid="Localserver_ConfigCommand" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                        <TextBox Text="{x:Bind Executable, Mode=TwoWay}" FontFamily="{StaticResource KitMonoFontFamily}" CornerRadius="4" IsEnabled="{x:Bind IsEditable, Mode=OneWay}" />
                                                                        <Button Grid.Column="1" Click="BrowseExecutable_Click" DataContext="{x:Bind}" Style="{StaticResource KitActionButtonStyle}" IsEnabled="{x:Bind IsEditable, Mode=OneWay}">
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                                                                                <TextBlock x:Uid="Localserver_BrowseFileButtonText" FontSize="12" Text="Browse..." VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Button>
                                                                    </Grid>

                                                                    <!-- ARGUMENTS -->
                                                                    <TextBlock Grid.Row="2" x:Uid="Localserver_ConfigArguments" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{x:Bind BaseArgsText, Mode=TwoWay}" FontFamily="{StaticResource KitMonoFontFamily}" CornerRadius="4" IsEnabled="{x:Bind IsEditable, Mode=OneWay}" />

                                                                    <!-- WORKING DIR -->
                                                                    <TextBlock Grid.Row="3" x:Uid="Localserver_ConfigWorkingDir" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                                    <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                        <TextBox Text="{x:Bind Cwd, Mode=TwoWay}" FontFamily="{StaticResource KitMonoFontFamily}" CornerRadius="4" IsEnabled="{x:Bind IsEditable, Mode=OneWay}" />
                                                                        <Button Grid.Column="1" Click="BrowseCwd_Click" DataContext="{x:Bind}" Style="{StaticResource KitActionButtonStyle}" IsEnabled="{x:Bind IsEditable, Mode=OneWay}">
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <FontIcon Glyph="&#xE838;" FontSize="12" />
                                                                                <TextBlock x:Uid="Localserver_BrowseFolderButtonText" FontSize="12" Text="Browse..." VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Button>
                                                                    </Grid>

                                                                    <!-- PORT -->
                                                                    <TextBlock Grid.Row="4" x:Uid="Localserver_ConfigPort" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                                                        <NumberBox Value="{x:Bind PortValue, Mode=TwoWay}" Width="130" Minimum="0" Maximum="65535" SpinButtonPlacementMode="Compact" CornerRadius="4" IsEnabled="{x:Bind IsEditable, Mode=OneWay}" />
                                                                        <TextBlock Text="{x:Bind PortHintText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                                    </StackPanel>

                                                                    <!-- RESOLVED COMMAND -->
                                                                    <TextBlock Grid.Row="5" x:Uid="Localserver_ConfigResolvedCommand" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{x:Bind ResolvedCommandText, Mode=OneWay}" FontFamily="{StaticResource KitMonoFontFamily}" CornerRadius="4" IsReadOnly="True" TextWrapping="Wrap" />
                                                                </Grid>

                                                                <!-- Bottom of Expanded Panel: Action buttons (Delete on left, Save on right) -->
                                                                <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,4" />

                                                                <Grid Margin="0,4,0,0">
                                                                    <Button
                                                                        HorizontalAlignment="Left"
                                                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                        Style="{StaticResource KitActionButtonStyle}"
                                                                        IsEnabled="{x:Bind IsEditable, Mode=OneWay}">
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                                                            <TextBlock x:Uid="Localserver_DeleteLineButtonText" />
                                                                        </StackPanel>
                                                                        <Button.Flyout>
                                                                            <Flyout>
                                                                                <StackPanel MaxWidth="300" Spacing="10">
                                                                                    <TextBlock x:Uid="Localserver_ConfirmDeleteTitle" FontWeight="SemiBold" />
                                                                                    <TextBlock x:Uid="Localserver_ConfirmDeleteDescription" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                                                    <Button x:Uid="Localserver_ConfirmDeleteConfirmButton" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Style="{StaticResource KitActionButtonStyle}" Click="DeleteLine_Click" DataContext="{x:Bind}" />
                                                                                </StackPanel>
                                                                            </Flyout>
                                                                        </Button.Flyout>
                                                                    </Button>

                                                                    <Button
                                                                        HorizontalAlignment="Right"
                                                                        Style="{StaticResource KitPrimaryActionButtonStyle}"
                                                                        Click="SaveCatalog_Click"
                                                                        IsEnabled="{x:Bind IsEditable, Mode=OneWay}">
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <FontIcon Glyph="&#xE74E;" FontSize="13" />
                                                                            <TextBlock x:Uid="Localserver_SaveLineButtonText" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- ============================================================== -->
                            <!-- 3. ENVIRONMENT DIAGNOSTICS (Full-Width Horizontal Deck)        -->
                            <!-- ============================================================== -->
                            <Border
                                x:Name="EnvironmentCard"
                                Margin="0,4,0,0"
                                Padding="18,16"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource KitCardSurfaceStyle}">
                                <StackPanel Spacing="12">
                                    <!-- Top Header & Service Selector Bar -->
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <Border Style="{StaticResource KitIconBadgeStyle}">
                                                <FontIcon Glyph="&#xE9D9;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock x:Uid="Localserver_SectionEnvironment" Style="{StaticResource KitCardTitleTextStyle}" AutomationProperties.HeadingLevel="Level2" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border
                                            Grid.Column="1"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource KitStatusPillStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7" Fill="{x:Bind ViewModel.EnvSummaryBrush, Mode=OneWay}" VerticalAlignment="Center" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Foreground="{x:Bind ViewModel.EnvSummaryBrush, Mode=OneWay}"
                                                    Text="{x:Bind ViewModel.EnvSummaryText, Mode=OneWay}"
                                                    FontWeight="SemiBold"
                                                    FontSize="12"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                        <ComboBox
                                            x:Uid="Localserver_SelectedLineComboBox"
                                            Grid.Column="2"
                                            MinWidth="0"
                                            Width="200"
                                            Height="32"
                                            Padding="10,0"
                                            CornerRadius="4"
                                            DisplayMemberPath="Name"
                                            FontSize="12"
                                            ItemsSource="{x:Bind ViewModel.Lines, Mode=OneWay}"
                                            SelectedItem="{x:Bind ViewModel.SelectedLine, Mode=TwoWay}" />
                                    </Grid>

                                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                    <!-- Horizontal Tiled Body: Health Ring | Metrics + Paths + Checks | Unified Resource Bars -->
                                    <Grid ColumnDefinitions="104,Auto,*,Auto,248" RowDefinitions="Auto,Auto" ColumnSpacing="16">
                                        <!-- Left: Health Ring -->
                                        <StackPanel Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                            <Grid Width="88" Height="88">
                                                <Ellipse Width="68" Height="68" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                <Ellipse Width="84" Height="84" Stroke="{ThemeResource CardStrokeColorDefaultBrush}" StrokeThickness="6" />
                                                <Ellipse Width="84" Height="84" Stroke="{x:Bind ViewModel.HealthRingBrush, Mode=OneWay}" StrokeThickness="6" />
                                                <TextBlock Width="72" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind ViewModel.HealthStateText, Mode=OneWay}" />
                                            </Grid>
                                        </StackPanel>

                                        <Border Grid.Column="1" Grid.RowSpan="2" Width="1" Margin="0,2" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                        <!-- Center: Metrics + Command/WorkingDir + Checks Chips -->
                                        <StackPanel x:Name="EnvDetailsStack" Grid.Column="2" Spacing="10">
                                            <!-- 4 Unified Metadata Tag Tiles: PORT, PID, STATE, RUNTIMES -->
                                            <Grid ColumnDefinitions="1*,1*,1.2*,1.6*" ColumnSpacing="10">
                                                <Border Padding="10,7" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock x:Uid="Localserver_ColPort" Style="{StaticResource KitMicroLabelTextStyle}" />
                                                        <TextBlock Text="{x:Bind ViewModel.EnvPortText, Mode=OneWay}" Style="{StaticResource KitMetricCompactTextStyle}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="1" Padding="10,7" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" ToolTipService.ToolTip="{x:Bind ViewModel.EnvPidTooltip, Mode=OneWay}">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock x:Uid="Localserver_ColPid" Style="{StaticResource KitMicroLabelTextStyle}" />
                                                        <TextBlock Text="{x:Bind ViewModel.EnvPidText, Mode=OneWay}" Style="{StaticResource KitMetricCompactTextStyle}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="2" Padding="10,7" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock x:Uid="Localserver_ColState" Style="{StaticResource KitMicroLabelTextStyle}" />
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Ellipse Width="7" Height="7" Fill="{x:Bind ViewModel.EnvStateBrush, Mode=OneWay}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{x:Bind ViewModel.EnvStateText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{x:Bind ViewModel.EnvStateBrush, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="3" Padding="10,7" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock x:Uid="Localserver_RuntimesLabel" Style="{StaticResource KitMicroLabelTextStyle}" />
                                                        <TextBlock Text="{x:Bind ViewModel.EnvRuntimesText, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Secondary details: COMMAND & ARGS and WORKING DIR -->
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                <StackPanel Spacing="4">
                                                    <TextBlock x:Uid="Localserver_CommandAndArgsLabel" Style="{StaticResource KitMicroLabelTextStyle}" />
                                                    <Border Padding="10,6" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                        <TextBlock Text="{x:Bind ViewModel.EnvCommandText, Mode=OneWay}" FontFamily="{StaticResource KitMonoFontFamily}" Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{x:Bind ViewModel.EnvCommandText, Mode=OneWay}" />
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock x:Uid="Localserver_WorkingDirLabel" Style="{StaticResource KitMicroLabelTextStyle}" />
                                                    <Border Padding="10,6" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                        <TextBlock Text="{x:Bind ViewModel.EnvCwdText, Mode=OneWay}" FontFamily="{StaticResource KitMonoFontFamily}" Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{x:Bind ViewModel.EnvCwdText, Mode=OneWay}" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <!-- CHECKS Chips (Horizontally Tiled WrapPanel with Unified Semantic Badges) -->
                                            <StackPanel Spacing="6">
                                                <TextBlock x:Uid="Localserver_ChecksLabel" Style="{StaticResource KitMicroLabelTextStyle}" />
                                                <ItemsControl ItemsSource="{x:Bind ViewModel.EnvironmentCheckChips, Mode=OneWay}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <tkcontrols:WrapPanel Orientation="Horizontal" HorizontalSpacing="8" VerticalSpacing="6" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="viewModels:EnvironmentCheckChipModel">
                                                            <Border Padding="10,5" Background="{x:Bind BackgroundBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" ToolTipService.ToolTip="{x:Bind Tooltip}">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <FontIcon Glyph="{x:Bind StatusGlyph}" FontSize="11" Foreground="{x:Bind ForegroundBrush}" VerticalAlignment="Center" />
                                                                    <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind ForegroundBrush}" Text="{x:Bind Label}" />
                                                                    <Button x:Uid="Localserver_FixButton" Width="28" Height="28" CornerRadius="4" Padding="0" Style="{ThemeResource SubtleButtonStyle}" Visibility="{x:Bind FixVisibility}">
                                                                        <FontIcon FontSize="10" Glyph="&#xE712;" />
                                                                        <Button.Flyout>
                                                                            <MenuFlyout>
                                                                                <MenuFlyoutItem x:Uid="Localserver_CopyFixCommandMenu" Click="CopyFixCommand_Click" DataContext="{x:Bind}" Visibility="{x:Bind FixCommandVisibility}" />
                                                                                <MenuFlyoutItem x:Uid="Localserver_ReleasePortMenu" Click="ReleasePort_Click" DataContext="{x:Bind}" Visibility="{x:Bind ReleasePortVisibility}" />
                                                                            </MenuFlyout>
                                                                        </Button.Flyout>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border x:Name="EnvTrendDivider" Grid.Column="3" Width="1" Margin="0,2" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                        <!-- Right: Unified Process Resource Telemetry (CPU Trend Curve & Memory Bar) -->
                                        <Border x:Name="EnvTrendPanel" Grid.Column="4" Padding="14,12" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" VerticalAlignment="Stretch">
                                            <StackPanel Spacing="10" VerticalAlignment="Center">
                                                <!-- CPU Usage & Trend Curve -->
                                                <StackPanel Spacing="5">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <FontIcon Glyph="&#xE950;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                            <TextBlock x:Uid="Localserver_CpuTrendLabel" Style="{StaticResource KitMicroLabelTextStyle}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.EnvCpuText, Mode=OneWay}" FontFamily="{StaticResource KitMonoFontFamily}" FontWeight="SemiBold" FontSize="12.5" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <!-- CPU Trend Wave Sparkline -->
                                                    <Border Height="36" Margin="0,1,0,0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" SizeChanged="OnStatusChartSizeChanged">
                                                        <Grid>
                                                            <Path Data="{x:Bind ViewModel.StatusCurveFillGeometry, Mode=OneWay}"
                                                                  Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                                  Opacity="0.14" />
                                                            <Path Data="{x:Bind ViewModel.StatusCurveGeometry, Mode=OneWay}"
                                                                  Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                                                  StrokeThickness="1.75"
                                                                  StrokeLineJoin="Round"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round" />
                                                        </Grid>
                                                    </Border>
                                                    <local:UsageProgressBar
                                                        x:Uid="Localserver_CpuUsageBar"
                                                        Height="4"
                                                        CornerRadius="2"
                                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                        Maximum="100"
                                                        TargetValue="{x:Bind ViewModel.EnvCpuPercent, Mode=OneWay}"
                                                        local:UsageProgressBar.UsageCategory="Cpu"
                                                        AutomationProperties.HelpText="{x:Bind ViewModel.EnvCpuText, Mode=OneWay}" />
                                                </StackPanel>

                                                <!-- Memory Usage Bar -->
                                                <StackPanel Spacing="5">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <FontIcon Glyph="&#xE964;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                            <TextBlock x:Uid="Localserver_ColMem" Style="{StaticResource KitMicroLabelTextStyle}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.EnvMemoryText, Mode=OneWay}" FontFamily="{StaticResource KitMonoFontFamily}" FontWeight="SemiBold" FontSize="12.5" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <local:UsageProgressBar
                                                        x:Uid="Localserver_MemoryUsageBar"
                                                        Height="6"
                                                        CornerRadius="3"
                                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                        Maximum="100"
                                                        TargetValue="{x:Bind ViewModel.EnvMemoryPercent, Mode=OneWay}"
                                                        local:UsageProgressBar.UsageCategory="Memory"
                                                        AutomationProperties.HelpText="{x:Bind ViewModel.EnvMemoryText, Mode=OneWay}" />
                                                </StackPanel>

                                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                                <!-- Peak CPU & Uptime Footer -->
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{x:Bind ViewModel.StatusChartRangeText, Mode=OneWay}" FontFamily="{StaticResource KitMonoFontFamily}" Style="{StaticResource CaptionTextBlockStyle}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE823;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{x:Bind ViewModel.EnvUptimeText, Mode=OneWay}" FontFamily="{StaticResource KitMonoFontFamily}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ============================================================== -->
                            <!-- 4. BOTTOM OUTPUT DRAWER (Diagnostic Console)                  -->
                            <!-- ============================================================== -->
                            <Border
                                Margin="0,4,0,0"
                                Style="{StaticResource KitCardSurfaceStyle}"
                                Padding="0">
                                <Grid RowDefinitions="Auto,Auto">
                                    <!-- Header -->
                                    <Grid Height="44" Padding="14,0" ColumnDefinitions="Auto,Auto,*,Auto">
                                        <Button
                                            x:Uid="Localserver_LogToggleButton"
                                            Style="{StaticResource KitCompactIconButtonStyle}"
                                            Click="ToggleLogPanel_Click">
                                            <FontIcon Glyph="{x:Bind ViewModel.LogToggleGlyph, Mode=OneWay}" FontSize="12" />
                                        </Button>
                                        <TextBlock Grid.Column="1" x:Uid="Localserver_OutputHeader" Margin="8,0,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.LogSubtitleText, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.LogActionsVisibility, Mode=OneWay}">
                                            <ToggleButton
                                                Height="28"
                                                CornerRadius="4"
                                                Padding="10,0"
                                                FontSize="12"
                                                x:Uid="Localserver_LogFollowToggle"
                                                IsChecked="{x:Bind ViewModel.IsLogFollowEnabled, Mode=TwoWay}" />
                                            <Button
                                                x:Uid="Localserver_OpenLogFolderButton"
                                                Style="{StaticResource KitCompactIconButtonStyle}"
                                                Click="OpenLogFolder_Click">
                                                <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                                            </Button>
                                            <Button
                                                x:Uid="Localserver_ClearLogsButton"
                                                Style="{StaticResource KitCompactIconButtonStyle}"
                                                Click="ClearLogs_Click">
                                                <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Body -->
                                    <Border
                                        Grid.Row="1"
                                        Height="220"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="0,1,0,0"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="0,0,8,8"
                                        Visibility="{x:Bind ViewModel.LogPanelVisibility, Mode=OneWay}">
                                        <Grid>
                                            <ScrollViewer
                                                x:Name="LogScroller"
                                                Padding="14,10"
                                                HorizontalScrollMode="Auto"
                                                HorizontalScrollBarVisibility="Auto"
                                                VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{x:Bind ViewModel.LogLines, Mode=OneWay}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="viewModels:LogLineViewModel">
                                                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                                                                <TextBlock Text="{x:Bind Timestamp}" FontFamily="{StaticResource KitMonoFontFamily}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                                <TextBlock Grid.Column="1" Width="24" Text="{x:Bind StreamLabel}" FontFamily="{StaticResource KitMonoFontFamily}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                                <TextBlock Grid.Column="2" Text="{x:Bind Text}" FontFamily="{StaticResource KitMonoFontFamily}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{x:Bind Brush}" FontWeight="{x:Bind FontWeight}" TextWrapping="NoWrap" IsTextSelectionEnabled="True" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <TextBlock
                                                x:Uid="Localserver_LogEmptyText"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Visibility="{x:Bind ViewModel.LogEmptyVisibility, Mode=OneWay}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ContentControl>

                </StackPanel>
            </controls:SettingsPageControl.ModuleContent>
        </controls:SettingsPageControl>
    </Grid>
</local:NavigablePage>
