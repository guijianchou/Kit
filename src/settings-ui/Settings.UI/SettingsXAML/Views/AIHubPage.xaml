                                 Visibility="{x:Bind ViewModel.IsStatusOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                 Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" AutomationProperties.LiveSetting="Assertive" />

                        <!-- TAB 0: SECURITY AUDIT -->
                        <StackPanel x:Name="AuditPanel" Spacing="16">
                            <Border x:Name="AuditWorkflowCard"
                                    Style="{StaticResource AiHubSectionSurfaceStyle}" Padding="14,12"
                                    Visibility="{x:Bind AuditResultStatusVisibility(ViewModel.SidebarWorkflowVisible, ViewModel.IsAuditing, ViewModel.IsAiAnalyzing), Mode=OneWay}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind ViewModel.SidebarWorkflowGlyph, Mode=OneWay}" FontSize="16"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SidebarWorkflowTitle, Mode=OneWay}"
                                                   FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.SidebarWorkflowPercentText, Mode=OneWay}"
                                                   FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource KitMonoFontFamily}"
                                                   Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                                    </Grid>
                                <TextBlock x:Name="AuditElapsedText" Text="{x:Bind ViewModel.AuditElapsedText, Mode=OneWay}"
                                           FontSize="12" FontFamily="{StaticResource KitMonoFontFamily}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{x:Bind ViewModel.AuditElapsedText, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}" />
                                <ProgressBar x:Name="AuditWorkflowProgress" Value="{x:Bind ViewModel.SidebarWorkflowPercent, Mode=OneWay}" Minimum="0" Maximum="100"
                                             IsIndeterminate="{x:Bind ViewModel.IsAuditProgressIndeterminate, Mode=OneWay}"
                                             Style="{StaticResource KitProgressBarStyle}" Margin="0"
                                             AutomationProperties.Name="{x:Bind ViewModel.SidebarWorkflowTooltip, Mode=OneWay}" />
                                <!-- Both messages can contain a complete native failure.
                                     An Auto column would take the available width away
                                     from the wrapping status and create a very tall card. -->
                                <ScrollViewer x:Name="AuditWorkflowDetailsScroll" MaxHeight="144"
                                              HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                                              HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentStageText, Mode=OneWay}" FontSize="12"
                                                   FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                                   Visibility="{x:Bind ViewModel.CurrentStageText, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}" />
                                        <TextBlock x:Name="AuditWorkflowStatus" Text="{x:Bind ViewModel.AuditResultDetailText, Mode=OneWay}"
                                                   FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Visibility="{x:Bind ViewModel.AuditResultDetailText, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}" />
                                        <TextBlock x:Name="AuditWorkflowAiResult" Text="{x:Bind ViewModel.AuditResultSupplementText, Mode=OneWay}"
                                                   Visibility="{x:Bind ViewModel.AuditResultSupplementText, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}"
                                                   FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                            <!-- The NavigationView already supplies the reading layer over Mica. -->
                            <Border x:Name="AuditDashboard" Style="{StaticResource AiHubSectionSurfaceStyle}"
                                    Background="Transparent" BorderThickness="0" Padding="0">
                                <StackPanel Spacing="20">
                                    <Grid x:Name="AuditCommandHeader" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                                        <tkcontrols:WrapPanel x:Name="AuditPrimaryCommands" HorizontalSpacing="10" VerticalSpacing="10" VerticalAlignment="Center">
                                            <SplitButton x:Name="AuditScanButton" Click="OnSelectedScanClick" IsEnabledChanged="OnScanButtonIsEnabledChanged" IsEnabled="{x:Bind ViewModel.CanConfigureAudit, Mode=OneWay}"
                                                Background="{ThemeResource SplitButtonBackground}"
                                                Foreground="{ThemeResource SplitButtonForeground}"
                                                AutomationProperties.AutomationId="AIHub_ScanButton">
                                                <!-- SplitButton paints its inner buttons from state resources. Separate
                                                    theme dictionaries prevent cached brush aliases during theme changes. -->
                                                <SplitButton.Resources>
                                                    <ResourceDictionary>
                                                        <ResourceDictionary.ThemeDictionaries>
                                                            <ResourceDictionary x:Key="Default">
                                                                <SolidColorBrush x:Key="SplitButtonBackground" Color="{ThemeResource SystemAccentColorLight2}" />
                                                                <SolidColorBrush x:Key="SplitButtonBackgroundPointerOver" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.9" />
                                                                <SolidColorBrush x:Key="SplitButtonBackgroundPressed" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.8" />
                                                                <SolidColorBrush x:Key="SplitButtonBackgroundDisabled" Color="{ThemeResource ControlFillColorDisabled}" />
                                                                <SolidColorBrush x:Key="SplitButtonForeground" Color="{ThemeResource TextOnAccentFillColorPrimary}" />
                                                                <SolidColorBrush x:Key="SplitButtonForegroundPointerOver" Color="{ThemeResource TextOnAccentFillColorPrimary}" />
                                                                <SolidColorBrush x:Key="SplitButtonForegroundPressed" Color="{ThemeResource TextOnAccentFillColorPrimary}" />
                                                                <SolidColorBrush x:Key="SplitButtonForegroundDisabled" Color="{ThemeResource TextFillColorSecondary}" />
                                                                <SolidColorBrush x:Key="SplitButtonForegroundSecondary" Color="{ThemeResource TextOnAccentFillColorPrimary}" />
                                                                <SolidColorBrush x:Key="SplitButtonForegroundSecondaryPressed" Color="{ThemeResource TextOnAccentFillColorPrimary}" />
                                                                <SolidColorBrush x:Key="SplitButtonBorderBrush" Color="{ThemeResource ControlStrokeColorOnAccentDefault}" />
                                                                <SolidColorBrush x:Key="SplitButtonBorderBrushPointerOver" Color="{ThemeResource ControlStrokeColorOnAccentDefault}" />
                                                                <SolidColorBrush x:Key="SplitButtonBorderBrushPressed" Color="{ThemeResource ControlStrokeColorOnAccentDefault}" />
                                                                <SolidColorBrush x:Key="SplitButtonBorderBrushDisabled" Color="{ThemeResource ControlStrokeColorOnAccentDefault}" />
                                                                <SolidColorBrush x:Key="SplitButtonBorderBrushDivider" Color="{ThemeResource ControlStrokeColorOnAccentTertiary}" />
                                                            </ResourceDictionary>
                                                            <ResourceDictionary x:Key="Light">
                                                                <SolidColorBrush x:Key="SplitButtonBackground" Color="{ThemeResource SystemAccentColorDark1}" />
                                                                <SolidColorBrush x:Key="SplitButtonBackgroundPointerOver" Color="{ThemeResource SystemAccentColorDark1}" Opacity="0.9" />
                                                                <SolidColorBrush x:Key="SplitButtonBackgroundPressed" Color="{ThemeResource SystemAccentColorDark2}" />
                                                                <SolidColorBrush x:Key="SplitButtonBackgroundDisabled" Color="{ThemeResource ControlFillColorDisabled}" />
                                                                <SolidColorBrush x:Key="SplitButtonForeground" Color="{ThemeResource TextOnAccentFillColorPrimary}" />
                                                                <SolidColorBrush x:Key="SplitButtonForegroundPointerOver" Color="{ThemeResource TextOnAccentFillColorPrimary}" />
                                                                <SolidColorBrush x:Key="SplitButtonForegroundPressed" Color="{ThemeResource TextOnAccentFillColorPrimary}" />
                                                                <SolidColorBrush x:Key="SplitButtonForegroundDisabled" Color="{ThemeResource TextFillColorSecondary}" />
                                                                <SolidColorBrush x:Key="SplitButtonForegroundSecondary" Color="{ThemeResource TextOnAccentFillColorPrimary}" />
                                                                <SolidColorBrush x:Key="SplitButtonForegroundSecondaryPressed" Color="{ThemeResource TextOnAccentFillColorPrimary}" />
                                                                <SolidColorBrush x:Key="SplitButtonBorderBrush" Color="{ThemeResource ControlStrokeColorOnAccentDefault}" />
                                                                <SolidColorBrush x:Key="SplitButtonBorderBrushPointerOver" Color="{ThemeResource ControlStrokeColorOnAccentDefault}" />
                                                                <SolidColorBrush x:Key="SplitButtonBorderBrushPressed" Color="{ThemeResource ControlStrokeColorOnAccentDefault}" />
                                                                <SolidColorBrush x:Key="SplitButtonBorderBrushDisabled" Color="{ThemeResource ControlStrokeColorOnAccentDefault}" />
                                                                <SolidColorBrush x:Key="SplitButtonBorderBrushDivider" Color="{ThemeResource ControlStrokeColorOnAccentTertiary}" />
                                                            </ResourceDictionary>
                                                            <ResourceDictionary x:Key="HighContrast">
                                                                <SolidColorBrush x:Key="SplitButtonBackground" Color="{ThemeResource SystemColorHighlightColor}" />
                                                                <SolidColorBrush x:Key="SplitButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                                                                <SolidColorBrush x:Key="SplitButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                                                                <SolidColorBrush x:Key="SplitButtonBackgroundDisabled" Color="{ThemeResource SystemColorButtonFaceColor}" />
                                                                <SolidColorBrush x:Key="SplitButtonForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                                                <SolidColorBrush x:Key="SplitButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                                                <SolidColorBrush x:Key="SplitButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                                                <SolidColorBrush x:Key="SplitButtonForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
                                                                <SolidColorBrush x:Key="SplitButtonForegroundSecondary" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                                                <SolidColorBrush x:Key="SplitButtonForegroundSecondaryPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                                                <SolidColorBrush x:Key="SplitButtonBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                                                                <SolidColorBrush x:Key="SplitButtonBorderBrushPointerOver" Color="{ThemeResource SystemColorButtonTextColor}" />
                                                                <SolidColorBrush x:Key="SplitButtonBorderBrushPressed" Color="{ThemeResource SystemColorButtonTextColor}" />
                                                                <SolidColorBrush x:Key="SplitButtonBorderBrushDisabled" Color="{ThemeResource SystemColorButtonTextColor}" />
                                                                <SolidColorBrush x:Key="SplitButtonBorderBrushDivider" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                                            </ResourceDictionary>
                                                        </ResourceDictionary.ThemeDictionaries>
                                                    </ResourceDictionary>
                                                </SplitButton.Resources>
                                                <SplitButton.Content>
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <FontIcon Glyph="&#xE721;" FontSize="13" />
                                                        <TextBlock Text="{x:Bind ViewModel.SelectedScanLabel, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </SplitButton.Content>
                                                <SplitButton.Flyout>
                                                    <Flyout>
                                                        <StackPanel Spacing="14" Width="270">
                                                            <TextBlock Text="{x:Bind ViewModel.ScanOptionsLabel}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                            <ComboBox x:Uid="AIHub_Fluent_ScanMode" SelectedIndex="{x:Bind ViewModel.SelectedScanModeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                                                <ComboBoxItem Content="{x:Bind ViewModel.FastScanLabel}" />
                                                                <ComboBoxItem Content="{x:Bind ViewModel.FullScanLabel}" />
                                                            </ComboBox>
                                                            <ComboBox x:Uid="AIHub_Fluent_ScanRange" SelectedIndex="{x:Bind ViewModel.FullScanRangeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.IsFullScanSelected, Mode=OneWay}">
                                                                <ComboBoxItem Content="{x:Bind ViewModel.RangeOption1DayLabel}" />
                                                                <ComboBoxItem Content="{x:Bind ViewModel.RangeOption2DaysLabel}" />
                                                                <ComboBoxItem Content="{x:Bind ViewModel.RangeOption1WeekLabel}" />
                                                            </ComboBox>
                                                            <CheckBox x:Uid="AIHub_Fluent_FullChannels" IsChecked="{x:Bind ViewModel.IsFullAuditMode, Mode=OneWay}" Click="OnFullAuditCheckClick" IsEnabled="{x:Bind ViewModel.CanUseFullAuditMode}" />
                                                            <TextBlock Text="{x:Bind ViewModel.ScopeHint, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Flyout>
                                                </SplitButton.Flyout>
                                            </SplitButton>
                                            <Border CornerRadius="4" Padding="8,5" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE787;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                                    <TextBlock Text="{x:Bind ViewModel.SelectedScanRangeText, Mode=OneWay}" FontSize="12" FontWeight="Medium"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <Button Command="{x:Bind ViewModel.DeepAnalyzeCommand}" AutomationProperties.AutomationId="AIHub_DeepAnalyzeButton"
                                                ToolTipService.ToolTip="{x:Bind ViewModel.DeepAnalyzeHint, Mode=OneWay}" Style="{StaticResource KitActionButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <FontIcon Glyph="&#xE9D9;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{x:Bind ViewModel.DeepAnalyzeLabel}" FontWeight="Medium" />
                                                </StackPanel>
                                            </Button>
                                        </tkcontrols:WrapPanel>
                                        <DropDownButton x:Name="AuditHistoryDropDown" Grid.Column="1"
                                            IsEnabled="{x:Bind ViewModel.CanConfigureAudit, Mode=OneWay}"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Bind ViewModel.AuditHistoryLabel, Mode=OneWay}"
                                            AutomationProperties.AutomationId="AIHub_AuditHistoryButton">
                                            <DropDownButton.Content>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE81C;" FontSize="13" />
                                                    <TextBlock Text="{x:Bind ViewModel.AuditHistoryLabel, Mode=OneWay}" FontSize="13" />
                                                </StackPanel>
                                            </DropDownButton.Content>
                                            <DropDownButton.Flyout>
                                                <Flyout>
                                                    <StackPanel Spacing="12">
                                                        <CalendarDatePicker x:Uid="AIHub_AuditDatePicker" Date="{x:Bind ViewModel.SelectedAuditDate, Mode=OneWay}" MaxDate="{x:Bind ViewModel.LatestSelectableAuditDate}" DateChanged="OnAuditDateChanged" />
                                                        <Button Content="{x:Bind ViewModel.LatestAuditLabel}" Command="{x:Bind ViewModel.SelectLatestCommand}" AutomationProperties.AutomationId="AIHub_SelectLatestButton" />
                                                        <Button x:Uid="AIHub_WeeklyReport" Click="OnWeeklyReportClick" AutomationProperties.AutomationId="AIHub_WeeklyReportButton" />
                                                    </StackPanel>
                                                </Flyout>
                                            </DropDownButton.Flyout>
                                        </DropDownButton>
                                    </Grid>
                                    <Border x:Name="AuditHealthSummary"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="8">
                                        <Grid>
                                            <Border CornerRadius="8" Background="{ThemeResource KitHeroGradientBrush}" IsHitTestVisible="False" />
                                            <Grid x:Name="AuditOverviewGrid" Padding="18,16" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="14">
                                                <Grid x:Name="AuditScoreCard" Width="96" Height="96" VerticalAlignment="Center">
                                                    <Ellipse Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" StrokeThickness="6" />
                                                    <ProgressRing IsIndeterminate="False" Value="{x:Bind HealthScoreToDouble(ViewModel.HealthScore), Mode=OneWay}" Maximum="100"
                                                        Width="96" Height="96" Style="{x:Bind HealthScoreRingStyle(ViewModel.HealthScore), Mode=OneWay}"
                                                        Visibility="{x:Bind ViewModel.HasAuditData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                                                        <TextBlock x:Name="AuditScoreText" Text="{x:Bind ViewModel.HealthScoreText, Mode=OneWay}" FontSize="30" FontWeight="SemiBold"
                                                                   FontFamily="{StaticResource KitMonoFontFamily}" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" />
                                                        <TextBlock Text="{x:Bind ViewModel.HealthScoreLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel x:Name="AuditScoreSummary" Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                                    <tkcontrols:WrapPanel HorizontalSpacing="8" VerticalSpacing="4" VerticalAlignment="Center">
                                                        <Grid VerticalAlignment="Center">
                                                            <Border CornerRadius="4" Padding="7,2" Background="{ThemeResource BadgeSuccessBackgroundBrush}"
                                                                    Visibility="{x:Bind ViewModel.IsHealthGood, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="{x:Bind ViewModel.HealthScoreGrade, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource BadgeSuccessForegroundBrush}" />
                                                            </Border>
                                                            <Border CornerRadius="4" Padding="7,2" Background="{ThemeResource BadgeWarningBackgroundBrush}"
                                                                    Visibility="{x:Bind ViewModel.IsHealthWarning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="{x:Bind ViewModel.HealthScoreGrade, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource BadgeWarningForegroundBrush}" />
                                                            </Border>
                                                            <Border CornerRadius="4" Padding="7,2" Background="{ThemeResource BadgeCriticalBackgroundBrush}"
                                                                    Visibility="{x:Bind ViewModel.IsHealthCritical, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="{x:Bind ViewModel.HealthScoreGrade, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource BadgeCriticalForegroundBrush}" />
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Text="{x:Bind ViewModel.OverviewAuditTimestampText, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                    </tkcontrols:WrapPanel>
                                                    <TextBlock Text="{x:Bind ViewModel.OverviewHeadline, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="20" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind ViewModel.OverviewDescription, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                    <tkcontrols:WrapPanel HorizontalSpacing="10" VerticalSpacing="6" Margin="0,2,0,0">
                                                        <HyperlinkButton x:Uid="AIHub_Fluent_PriorityButton" Click="OnPriorityFindingClick" Padding="0" FontSize="12"
                                                            AutomationProperties.Name="{x:Bind ViewModel.AuditPriorityTitle, Mode=OneWay}"
                                                            Visibility="{x:Bind ViewModel.HasAuditPriority, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </tkcontrols:WrapPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <tkcontrols:Segmented x:Name="AuditResultViews" HorizontalAlignment="Left"
                                        SelectedIndex="{x:Bind ViewModel.AuditResultViewIndex, Mode=TwoWay}"
