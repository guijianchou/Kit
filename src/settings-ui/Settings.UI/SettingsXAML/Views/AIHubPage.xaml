<?xml version="1.0" encoding="utf-8" ?>
<local:NavigablePage
    x:Class="Kit.Settings.UI.Views.AIHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kit.Settings.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Kit.Settings.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Kit.AIHubLib.Models"
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:viewModels="using:Kit.Settings.UI.ViewModels"
    xmlns:views="using:Kit.Settings.UI.Views"
    d:DataContext="{d:DesignInstance Type=viewModels:AIHubPageViewModel}"
    AutomationProperties.LandmarkType="Main"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <local:NavigablePage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AiHubRiskHighSurfaceBrush" Color="#1EFF5263" />
                    <SolidColorBrush x:Key="AiHubRiskHighBorderBrush" Color="#42FF5263" />
                    <SolidColorBrush x:Key="AiHubRiskHighAccentBrush" Color="#FFFF6B7A" />
                    <SolidColorBrush x:Key="AiHubRiskHighIconBgBrush" Color="#24FF6B7A" />
                    <SolidColorBrush x:Key="AiHubRiskHighForegroundBrush" Color="#FFFF99A4" />

                    <SolidColorBrush x:Key="AiHubRiskMediumSurfaceBrush" Color="#1EF2C94C" />
                    <SolidColorBrush x:Key="AiHubRiskMediumBorderBrush" Color="#42F2C94C" />
                    <SolidColorBrush x:Key="AiHubRiskMediumAccentBrush" Color="#FFF2C94C" />
                    <SolidColorBrush x:Key="AiHubRiskMediumIconBgBrush" Color="#22F2C94C" />
                    <SolidColorBrush x:Key="AiHubRiskMediumForegroundBrush" Color="#FFFCE100" />

                    <SolidColorBrush x:Key="AiHubRiskLowSurfaceBrush" Color="#1E60CDFF" />
                    <SolidColorBrush x:Key="AiHubRiskLowBorderBrush" Color="#4260CDFF" />
                    <SolidColorBrush x:Key="AiHubRiskLowAccentBrush" Color="#FF60CDFF" />
                    <SolidColorBrush x:Key="AiHubRiskLowIconBgBrush" Color="#2260CDFF" />
                    <SolidColorBrush x:Key="AiHubRiskLowForegroundBrush" Color="#FF7CCBFF" />

                    <SolidColorBrush x:Key="AiHubAiCalloutSurfaceBrush" Color="#1660CDFF" />
                    <SolidColorBrush x:Key="AiHubAiCalloutBorderBrush" Color="#3460CDFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AiHubRiskHighSurfaceBrush" Color="#12C42B1C" />
                    <SolidColorBrush x:Key="AiHubRiskHighBorderBrush" Color="#36C42B1C" />
                    <SolidColorBrush x:Key="AiHubRiskHighAccentBrush" Color="#FFC42B1C" />
                    <SolidColorBrush x:Key="AiHubRiskHighIconBgBrush" Color="#18C42B1C" />
                    <SolidColorBrush x:Key="AiHubRiskHighForegroundBrush" Color="#FFA41E15" />

                    <SolidColorBrush x:Key="AiHubRiskMediumSurfaceBrush" Color="#14C17A00" />
                    <SolidColorBrush x:Key="AiHubRiskMediumBorderBrush" Color="#3BC17A00" />
                    <SolidColorBrush x:Key="AiHubRiskMediumAccentBrush" Color="#FFC17A00" />
                    <SolidColorBrush x:Key="AiHubRiskMediumIconBgBrush" Color="#1AC17A00" />
                    <SolidColorBrush x:Key="AiHubRiskMediumForegroundBrush" Color="#FF834A00" />

                    <SolidColorBrush x:Key="AiHubRiskLowSurfaceBrush" Color="#120067C0" />
                    <SolidColorBrush x:Key="AiHubRiskLowBorderBrush" Color="#360067C0" />
                    <SolidColorBrush x:Key="AiHubRiskLowAccentBrush" Color="#FF0067C0" />
                    <SolidColorBrush x:Key="AiHubRiskLowIconBgBrush" Color="#160067C0" />
                    <SolidColorBrush x:Key="AiHubRiskLowForegroundBrush" Color="#FF005396" />

                    <SolidColorBrush x:Key="AiHubAiCalloutSurfaceBrush" Color="#100067C0" />
                    <SolidColorBrush x:Key="AiHubAiCalloutBorderBrush" Color="#2E0067C0" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="AiHubRiskHighSurfaceBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="AiHubRiskHighBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="AiHubRiskHighAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AiHubRiskHighIconBgBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AiHubRiskHighForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

                    <SolidColorBrush x:Key="AiHubRiskMediumSurfaceBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="AiHubRiskMediumBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="AiHubRiskMediumAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AiHubRiskMediumIconBgBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AiHubRiskMediumForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

                    <SolidColorBrush x:Key="AiHubRiskLowSurfaceBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="AiHubRiskLowBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="AiHubRiskLowAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AiHubRiskLowIconBgBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AiHubRiskLowForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

                    <SolidColorBrush x:Key="AiHubAiCalloutSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AiHubAiCalloutBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="AiHubSectionSurfaceStyle" TargetType="Border" BasedOn="{StaticResource KitCardSurfaceStyle}">
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="AiHubSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
            </Style>

            <!-- Readiness / health styles per level: bound via AiReadinessStyle and HealthScore*Style, locked by AiHubSettingsTests + ModulePageSmoke contrast assertions -->
            <Style x:Key="ReadinessReadyStyle" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
            </Style>
            <Style x:Key="ReadinessDegradedStyle" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <Style x:Key="ReadinessUnverifiedStyle" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorAttentionBrush}" />
            </Style>
            <Style x:Key="ReadinessNotConfiguredStyle" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
            <Style x:Key="ReadinessDisabledStyle" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="HealthRingGoodStyle" TargetType="ProgressRing">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
            </Style>
            <Style x:Key="HealthRingWarningStyle" TargetType="ProgressRing">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <Style x:Key="HealthRingCriticalStyle" TargetType="ProgressRing">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>

            <Style x:Key="AiHubRiskMetricButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="OutlineOverlay.BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                                                <Setter Target="StateOverlay.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="OutlineOverlay.BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                                <Setter Target="StateOverlay.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Opacity" Value="0.6" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter
                                    x:Name="ContentPresenter"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTransitions="{TemplateBinding ContentTransitions}"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <Border
                                    x:Name="StateOverlay"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Background="Transparent"
                                    IsHitTestVisible="False" />
                                <Border
                                    x:Name="OutlineOverlay"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    IsHitTestVisible="False" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="OptimizationItemContainerStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="IsTabStop" Value="False" />
            </Style>
            <Style x:Key="OptimizationPresenterStyle" TargetType="ContentPresenter">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>

            <DataTemplate x:Key="AuditCategoryCardTemplate" x:DataType="viewModels:AuditCategoryRow">
                <Button Style="{StaticResource AiHubRiskMetricButtonStyle}"
                        Tag="{x:Bind Category}" Click="OnAuditCategoryClick"
                        AutomationProperties.AutomationId="AIHub_AuditCategoryCard" AutomationProperties.Name="{x:Bind AccessibleSummary}"
                        ToolTipService.ToolTip="{x:Bind ActionLabel}">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                        <Grid ColumnDefinitions="3,*">
                            <Grid>
                                <Border CornerRadius="8,0,0,8" Background="{ThemeResource AiHubRiskHighAccentBrush}"
                                        Visibility="{x:Bind IsHigh, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Border CornerRadius="8,0,0,8" Background="{ThemeResource AiHubRiskMediumAccentBrush}"
                                        Visibility="{x:Bind IsMedium, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Border CornerRadius="8,0,0,8" Background="{ThemeResource AiHubRiskLowAccentBrush}"
                                        Visibility="{x:Bind IsLow, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                            <Grid Grid.Column="1" Padding="14,12,14,12" RowDefinitions="Auto,*,Auto" RowSpacing="8" MinHeight="94">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <FontIcon Glyph="{x:Bind CategoryGlyph}" FontSize="14" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" CornerRadius="4" Padding="7,2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Counts}" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{x:Bind Priority}" FontSize="13" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           ToolTipService.ToolTip="{x:Bind Priority}" VerticalAlignment="Top" />
                                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Grid>
                                        <Border Style="{StaticResource KitSeverityHighBadgeStyle}"
                                                Visibility="{x:Bind IsHigh, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{x:Bind Severity}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource BadgeCriticalForegroundBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource KitSeverityMediumBadgeStyle}"
                                                Visibility="{x:Bind IsMedium, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{x:Bind Severity}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource BadgeWarningForegroundBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource KitSeverityLowBadgeStyle}"
                                                Visibility="{x:Bind IsLow, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{x:Bind Severity}" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource BadgeInfoForegroundBrush}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Occurrences}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Button>
            </DataTemplate>

        <DataTemplate x:Key="OptimizationInventoryScopeTemplate" x:DataType="viewModels:OptimizationInventoryScopeViewModel">
            <Border Margin="0,0,0,8" CornerRadius="{StaticResource OverlayCornerRadius}"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                          IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" HorizontalAlignment="Stretch" Padding="0,4">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" VerticalAlignment="Top" Margin="0,3,0,0"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}"
                                           FontFamily="{StaticResource KitMonoFontFamily}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <tkcontrols:WrapPanel HorizontalSpacing="10" VerticalSpacing="4">
                                    <TextBlock Text="{x:Bind SizeText}" FontWeight="SemiBold" FontFamily="{StaticResource KitMonoFontFamily}" />
                                    <TextBlock Text="{x:Bind FileSummary}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </tkcontrols:WrapPanel>
                                <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind SharePercent}" Height="4"
                                             AutomationProperties.Name="{x:Bind Name}" IsHitTestVisible="False"
                                             Visibility="{x:Bind HasMeasuredSize, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <tkcontrols:WrapPanel HorizontalSpacing="6" VerticalSpacing="4">
                                    <Border Style="{StaticResource KitStatusPillStyle}">
                                        <TextBlock Text="{x:Bind StateLabel}" FontSize="11" TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock Text="{x:Bind DispositionLabel}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </tkcontrols:WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel x:Name="InventoryScopeDetails" x:Load="{x:Bind HasBeenExpanded, Mode=OneWay}" Spacing="10" Padding="8,6">
                        <TextBlock Text="{x:Bind ChangeText}" TextWrapping="Wrap" Visibility="{x:Bind HasComparison, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="{x:Bind Reason}" TextWrapping="Wrap" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                        <TextBlock Text="{x:Bind Guidance}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind AgeSummary}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind HasMeasuredSize, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="{x:Bind ScanNotes}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind HasScanNotes, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <StackPanel Spacing="6" Visibility="{x:Bind HasTopFiles, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock x:Uid="AIHub_Inventory_LargestFilesTitle" FontWeight="SemiBold" FontSize="12" />
                            <ItemsControl ItemsSource="{x:Bind TopFiles}" HorizontalContentAlignment="Stretch">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:OptimizationInventoryFileViewModel">
                                        <Border Padding="10,8" Margin="0,0,0,4" CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Path}" FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                           FontFamily="{StaticResource KitMonoFontFamily}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <tkcontrols:WrapPanel HorizontalSpacing="12" VerticalSpacing="3">
                                                    <TextBlock Text="{x:Bind SizeText}" FontSize="12" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind ModifiedText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </tkcontrols:WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </Border>
        </DataTemplate>

        <!-- Leaf category item template inside groups -->
        <DataTemplate x:Key="OptimizationCategoryTemplate" x:DataType="viewModels:OptimizationCategoryViewModel">
            <Border Margin="0,0,0,6" CornerRadius="{StaticResource OverlayCornerRadius}" HorizontalAlignment="Stretch"
                    Visibility="{x:Bind HasVisibleItems, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                          Background="Transparent" BorderThickness="0">
                    <Expander.Header>
                        <Grid ColumnSpacing="12" RowSpacing="10" RowDefinitions="Auto,Auto" HorizontalAlignment="Stretch" MinHeight="48" Padding="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.ColumnSpan="2" Spacing="3" VerticalAlignment="Center">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13"
                                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                                    <Border Grid.Column="1" Style="{StaticResource KitStatusPillStyle}" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ReviewStatus}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{x:Bind LocationLabel}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind Destination}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Summary, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" FontFamily="{StaticResource KitMonoFontFamily}" />
                                <TextBlock Text="{x:Bind SelectionSummary, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Row="1" Grid.Column="1" Content="{x:Bind ActionLabel}" Command="{x:Bind ExecuteCommand}"
                                    IsEnabled="{x:Bind IsEnabled, Mode=OneWay}" VerticalAlignment="Center"
                                    Style="{StaticResource KitActionButtonStyle}" />
                        </Grid>
                    </Expander.Header>
                    <StackPanel x:Name="OptimizationLeafDetails" x:Load="{x:Bind HasBeenExpanded, Mode=OneWay}" Spacing="10" Padding="4,8">
                        <Border CornerRadius="4" Padding="8,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock Text="{x:Bind Destination}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="{StaticResource KitMonoFontFamily}" />
                        </Border>
                        <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind Progress, Mode=OneWay}"
                                     Visibility="{x:Bind HasProgress, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                     Style="{StaticResource KitProgressBarStyle}" />
                        <ListView ItemsSource="{x:Bind VisibleItems, Mode=OneWay}" SelectionMode="None" MaxHeight="320" HorizontalContentAlignment="Stretch"
                                  ItemContainerStyle="{StaticResource OptimizationItemContainerStyle}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:TempFileInfo">
                                    <Grid Padding="0,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                  IsEnabled="{x:Bind IsActionable, Mode=OneWay}"
                                                  AutomationProperties.Name="{x:Bind FileName}"
                                                  VerticalAlignment="Center" MinWidth="32" />
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind FilePath}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{x:Bind FilePath}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="{StaticResource KitMonoFontFamily}" />
                                            <TextBlock Text="{x:Bind DisplayReason}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind SizeFormatted}" FontWeight="Medium" FontSize="12" HorizontalAlignment="Right" FontFamily="{StaticResource KitMonoFontFamily}" />
                                            <Border Style="{StaticResource KitStatusPillStyle}" HorizontalAlignment="Right">
                                                <TextBlock Text="{x:Bind ReviewLabel}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Expander>
            </Border>
        </DataTemplate>

        <!-- Project item template -->
        <DataTemplate x:Key="OptimizationProjectTemplate" x:DataType="viewModels:OptimizationGroupViewModel">
            <Border Margin="0,0,0,6" CornerRadius="{StaticResource OverlayCornerRadius}" HorizontalAlignment="Stretch"
                    Visibility="{x:Bind HasVisibleItems, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                          Background="Transparent" BorderThickness="0">
                    <Expander.Header>
                        <Grid ColumnSpacing="12" RowSpacing="10" RowDefinitions="Auto,Auto" MinHeight="48" Padding="0,2" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.ColumnSpan="2" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Location}" />
                                <TextBlock Text="{x:Bind Summary}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="{x:Bind Size}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" FontFamily="{StaticResource KitMonoFontFamily}" />
                            <Button Grid.Row="1" Grid.Column="1" Content="{x:Bind CleanLabel}" Command="{x:Bind ExecuteCommand}"
                                    IsEnabled="{x:Bind IsEnabled, Mode=OneWay}" VerticalAlignment="Center"
                                    Style="{StaticResource KitActionButtonStyle}" />
                        </Grid>
                    </Expander.Header>
                    <StackPanel x:Name="OptimizationProjectDetails" x:Load="{x:Bind HasBeenExpanded, Mode=OneWay}" Spacing="8" Padding="4,8">
                        <Border CornerRadius="4" Padding="8,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock Text="{x:Bind Location}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="{StaticResource KitMonoFontFamily}" />
                        </Border>
