<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ -->
    <!-- Kit 共享表面样式（批次 0 新增）                                -->
    <!-- 用途：统一全项目手写 Border 卡面 / 状态胶囊 / 指标瓦片 / 进度条  -->
    <!-- ============================================================ -->

    <Style x:Key="KitCardSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="16,14" />
    </Style>

    <!-- 工作流进度卡（审计 / 优化共用；Accent 描边） -->
    <Style x:Key="KitWorkflowCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="18,14" />
    </Style>

    <!-- 状态胶囊（dot + 文本 / 单一文本，28 高） -->
    <Style x:Key="KitStatusPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <!-- 指标瓦片（label + 数值） -->
    <Style x:Key="KitMetricTileBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style x:Key="KitMetricTileValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource KitMonoFontFamily}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="KitMetricTileLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 标准进度条（高 4 / 圆角 2 / Accent 前景） -->
    <Style x:Key="KitProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
    </Style>

    <!-- 卡片标题图标徽章（32 方形 / 强调色微染底 / 强调色图标） -->
    <Style x:Key="KitIconBadgeStyle" TargetType="Border">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{ThemeResource KitAccentTintBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 卡片内分节小徽章（24 方形 / 中性底 + 描边） -->
    <Style x:Key="KitIconBadgeSmallStyle" TargetType="Border">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 卡片标题文本（16 / SemiBold / 二级标题） -->
    <Style x:Key="KitCardTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 主页 Hero 表面（卡片底 + 强调色渐变洗色叠层由页面内 Border 提供） -->
    <Style x:Key="KitHeroSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
    </Style>

    <!-- Hero 共享表面：卡片底 + 渐变叠层 + 内容槽（Dashboard / General 共用，消除双份拷贝） -->
    <Style x:Key="KitHeroPanelStyle" TargetType="ContentControl">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Style="{StaticResource KitHeroSurfaceStyle}">
                        <Grid>
                            <Border
                                CornerRadius="{StaticResource OverlayCornerRadius}"
                                Background="{ThemeResource KitHeroGradientBrush}"
                                IsHitTestVisible="False" />
                            <ContentPresenter
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 出口状态着色（Unknown / Good / Error；Dashboard 经 EgressTextStyle 类型化映射取用；NetMap 页内自持 NetMapHealthStyles 字典） -->
    <ResourceDictionary x:Key="KitEgressStatusStyles">
        <Style x:Key="UnknownText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="GoodText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
        </Style>
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
    </ResourceDictionary>
</ResourceDictionary>
