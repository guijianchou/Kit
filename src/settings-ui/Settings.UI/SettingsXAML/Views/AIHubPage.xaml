                           ToolTipService.ToolTip="{x:Bind ModuleDescription}" />
                <TextBlock x:Name="AiHubDescription" Grid.Row="1" Text="{x:Bind ModuleDescription}"
                           FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis"
