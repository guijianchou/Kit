<ContentDialog
    x:Class="Kit.Settings.UI.Views.FindingDetailsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Kit.AIHubLib.Models"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d"
    Title="Finding Details"
    PrimaryButtonText="Close"
    SecondaryButtonText="Copy Summary"
    DefaultButton="Primary"
    SecondaryButtonClick="OnCopySummaryClick">

    <Grid MinWidth="480" MaxWidth="600" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header metadata -->
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock x:Name="FindingTitleTextBlock"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border x:Name="SeverityBadge"
                        CornerRadius="4" Padding="6,2"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <TextBlock x:Name="SeverityTextBlock"
                               Foreground="White"
                               FontSize="11" FontWeight="SemiBold" />
                </Border>

                <Border CornerRadius="4" Padding="6,2"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <TextBlock x:Name="CategoryTextBlock"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="11" />
                </Border>

                <Border CornerRadius="4" Padding="6,2"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <TextBlock x:Name="EventIdTextBlock"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="11" />
                </Border>

                <Border x:Name="OccurrencesBadge"
                        CornerRadius="4" Padding="6,2"
                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                    <TextBlock x:Name="OccurrencesTextBlock"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                               FontSize="11" FontWeight="SemiBold" />
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Details ScrollViewer -->
        <ScrollViewer Grid.Row="1" MaxHeight="420" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <!-- Section 1: Analysis & Recommended Action -->
                <StackPanel Spacing="4">
                    <TextBlock x:Name="FactsHeaderTextBlock" Text="Detection Facts"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="DescriptionTextBlock"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock x:Name="RootCauseHeaderTextBlock" Text="Root Cause"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="RootCauseTextBlock"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock x:Name="RecommendationHeaderTextBlock" Text="Recommended Action"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Border CornerRadius="6" Padding="12,8"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <TextBlock x:Name="RecommendationTextBlock"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   FontWeight="Medium"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </Border>
                </StackPanel>

                <!-- Section 2: Event Evidence -->
                <StackPanel Spacing="6">
                    <TextBlock x:Name="EvidenceHeaderTextBlock" Text="Event Evidence"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid RowSpacing="4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" x:Name="TimestampHeaderTextBlock" Text="Timestamp:"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TimestampTextBlock"
                                   FontSize="12" IsTextSelectionEnabled="True" />

                        <TextBlock Grid.Row="1" Grid.Column="0" x:Name="AffectedHeaderTextBlock" Text="Affected:"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AffectedTextBlock"
                                   FontSize="12" IsTextSelectionEnabled="True" />

                        <TextBlock Grid.Row="2" Grid.Column="0" x:Name="KeyHeaderTextBlock" Text="Issue Key:"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="KeyTextBlock"
                                   FontSize="12" IsTextSelectionEnabled="True" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
