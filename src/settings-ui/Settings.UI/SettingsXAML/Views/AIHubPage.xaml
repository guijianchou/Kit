                            <Setter Target="InventoryOldTile.(Grid.Row)" Value="2" />
                            <Setter Target="InventoryOldTile.(Grid.Column)" Value="0" />
                            <Setter Target="InventoryOldTile.(Grid.ColumnSpan)" Value="3" />
