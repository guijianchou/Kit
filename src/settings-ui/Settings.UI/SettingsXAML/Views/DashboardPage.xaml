<local:NavigablePage
    x:Class="Kit.Settings.UI.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controlConverters="using:Kit.Settings.UI.Controls.Converters"
    xmlns:controls="using:Kit.Settings.UI.Controls"
    xmlns:converters="using:Kit.Settings.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Kit.Settings.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ptcontrols="using:Kit.Common.UI.Controls"
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewmodels="using:Kit.Settings.UI.ViewModels"
    AutomationProperties.LandmarkType="Main"
    mc:Ignorable="d">
    <local:NavigablePage.Resources>
        <controlConverters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <converters:EnumToModuleListSortOptionConverter x:Key="EnumToModuleListSortOptionConverter" />
        <Style x:Key="OverviewSurfaceStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource KitSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <ResourceDictionary x:Key="DashboardEgressStyles">
            <Style x:Key="UnknownText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="GoodText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
            </Style>
            <Style x:Key="ErrorText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
        </ResourceDictionary>
        <viewmodels:NetMapHealthStyleConverter x:Key="DashboardEgressStyleConverter" Styles="{StaticResource DashboardEgressStyles}" />
        <DataTemplate x:Key="DashboardDetailTemplate" x:DataType="viewmodels:DashboardDetail">
            <Grid Margin="0,1" ColumnSpacing="12" MinHeight="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DetailLabel" Text="{x:Bind Label, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="13" />
                <TextBlock Grid.Column="1" Text="{x:Bind Value, Mode=OneWay}" FontWeight="SemiBold" FontSize="13"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind HasUsage, Converter={StaticResource ReverseBoolToVisibilityConverter}, Mode=OneWay}" />
                <Grid x:Name="UsageRow" Grid.Column="1" ColumnSpacing="12" VerticalAlignment="Center"
                    Visibility="{x:Bind HasUsage, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Value, Mode=OneWay}" FontWeight="SemiBold" FontSize="13"
                        TextWrapping="Wrap" Typography.NumeralAlignment="Tabular"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" IsTextSelectionEnabled="True"
                        VerticalAlignment="Center" />
                    <local:UsageProgressBar Grid.Column="1" Height="4" CornerRadius="2" VerticalAlignment="Center" Maximum="100" TargetValue="{x:Bind UsageValue, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind Label, Mode=OneWay}" AutomationProperties.HelpText="{x:Bind Value, Mode=OneWay}"
                        Visibility="{x:Bind HasUsage, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                </Grid>
            </Grid>
        </DataTemplate>
    </local:NavigablePage.Resources>

    <Grid MaxWidth="{StaticResource PageMaxWidth}" Margin="24,0,0,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Uid="DashboardTitle"
            Margin="0,0,24,0"
            VerticalAlignment="Center"
            AutomationProperties.HeadingLevel="1"
            Style="{StaticResource TitleTextBlockStyle}" />

        <TextBlock
            Grid.Row="1"
            x:Uid="DashboardIntro"
            Margin="0,0,24,12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="WrapWholeWords"
            Style="{StaticResource BodyTextBlockStyle}" />

        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="2">
            <Grid>
                <Grid
                    Padding="0,0,24,24"
                    ColumnSpacing="16"
                    RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="DashboardSecondaryWidth" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Vertical" Spacing="16">
                        <StackPanel.ChildrenTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromVerticalOffset="20" IsStaggeringEnabled="True" />
                                <RepositionThemeTransition IsStaggeringEnabled="False" />
                            </TransitionCollection>
                        </StackPanel.ChildrenTransitions>
                        <controls:Card x:Name="QuickAccessCard" x:Uid="QuickAccessTitle" VerticalAlignment="Top">
                            <Grid>
                                <controls:QuickAccessList
                                    x:Name="QuickAccessItemsControl"
                                    Margin="8,0,12,12"
                                    ItemsSource="{x:Bind ViewModel.QuickAccessItems, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.VisibleQuickAccessItemsCount, Mode=OneWay, Converter={StaticResource DoubleToVisibilityConverter}}" />
                                <TextBlock
                                    x:Uid="NoActionsToShow"
                                    Margin="12"
                                    HorizontalAlignment="Left"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Visibility="{x:Bind ViewModel.VisibleQuickAccessItemsCount, Mode=OneWay, Converter={StaticResource DoubleToInvertedVisibilityConverter}}" />
                            </Grid>
                        </controls:Card>
                        <Border x:Name="SystemOverviewCard" Style="{StaticResource OverviewSurfaceStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock x:Uid="Dashboard_SystemCard" FontSize="16" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
                                </StackPanel>
                                <ItemsControl x:Name="SystemDetailsList" ItemsSource="{x:Bind ViewModel.SystemDetails, Mode=OneWay}"
                                    ItemTemplate="{StaticResource DashboardDetailTemplate}" />

                                <!-- Storage Section -->
                                <Border Padding="0,10,0,0"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xEDA2;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock x:Uid="Dashboard_StorageHeading" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ItemsControl x:Name="StorageDetailsList" ItemsSource="{x:Bind ViewModel.StorageDetails, Mode=OneWay}"
                                            ItemTemplate="{StaticResource DashboardDetailTemplate}" />
                                    </StackPanel>
                                </Border>

                                <!-- Graphics Cards Section -->
                                <ItemsControl x:Name="GraphicsCardsList" ItemsSource="{x:Bind ViewModel.GraphicsCards, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodels:DashboardGpuCard">
                                            <Border Margin="0,0,0,8" Padding="0,10,0,0"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="&#xE7F8;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{x:Bind Details, Mode=OneWay}" ItemTemplate="{StaticResource DashboardDetailTemplate}" />
                                                    <TextBlock Text="{x:Bind Status, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                                        Visibility="{x:Bind Status, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="SecondaryColumn" Grid.Column="1" Spacing="16">
                        <StackPanel.ChildrenTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromVerticalOffset="20" IsStaggeringEnabled="True" />
                                <RepositionThemeTransition IsStaggeringEnabled="False" />
                            </TransitionCollection>
                        </StackPanel.ChildrenTransitions>
                        <controls:Card
                            x:Name="UtilitiesCard"
                            x:Uid="UtilitiesHeader"
                            Padding="0"
                            VerticalAlignment="Top"
                            DividerVisibility="Collapsed">
                            <controls:Card.TitleContent>
                                <Button
                                    x:Uid="Dashboard_SortBy"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    CornerRadius="6"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SubtleButtonStyle}">
                                    <ToolTipService.ToolTip>
                                        <TextBlock x:Uid="Dashboard_SortBy_ToolTip" />
                                    </ToolTipService.ToolTip>
                                    <Button.Content>
                                        <FontIcon FontSize="15" Glyph="&#xE8CB;" />
                                    </Button.Content>
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <ToggleMenuFlyoutItem
                                                x:Uid="Dashboard_SortAlphabetical"
                                                Click="SortAlphabetical_Click"
                                                IsChecked="{x:Bind ViewModel.DashboardSortOrder, Mode=OneWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Alphabetical}" />
                                            <ToggleMenuFlyoutItem
                                                x:Uid="Dashboard_SortByStatus"
                                                Click="SortByStatus_Click"
                                                IsChecked="{x:Bind ViewModel.DashboardSortOrder, Mode=OneWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=ByStatus}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </controls:Card.TitleContent>
                            <controls:ModuleList
                                x:Name="ModulesCard"
                                ItemsSource="{x:Bind ViewModel.AllModules, Mode=OneWay}"
                                SortOption="{x:Bind ViewModel.DashboardSortOrder, Mode=TwoWay, Converter={StaticResource EnumToModuleListSortOptionConverter}}" />
                        </controls:Card>
                        <Border x:Name="NetworkOverviewCard" Style="{StaticResource OverviewSurfaceStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE774;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock x:Uid="Dashboard_NetworkCard" FontSize="16" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
                                </StackPanel>
                                <TextBlock x:Uid="Dashboard_NetworkNote" Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="DirectRouteTitle" Margin="0,0,0,8" x:Uid="Dashboard_DirectRouteTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="DirectIpLabel" Margin="0,0,0,8" x:Uid="Dashboard_PublicIpLabel" Grid.Row="1" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="DirectIpText" Margin="0,0,0,8" Grid.Row="2"
                                        Text="{x:Bind viewmodels:DashboardViewModel.EgressIp(ViewModel.DirectEgress), Mode=OneWay}"
                                        Style="{x:Bind ViewModel.DirectEgress.Health, Mode=OneWay, Converter={StaticResource DashboardEgressStyleConverter}, ConverterParameter=Text}"
                                        FontSize="20" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                    <TextBlock x:Name="DirectLocationText" Margin="0,0,0,8" Grid.Row="3" TextWrapping="Wrap" FontSize="13">
                                        <Run x:Uid="Dashboard_LocationLabel" /><Run Text="{x:Bind ViewModel.DirectEgress.Location, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock x:Name="DirectEgressStatusText" Margin="0,0,0,8" Grid.Row="5" Text="{x:Bind viewmodels:DashboardViewModel.EgressStatus(ViewModel.DirectEgress), Mode=OneWay}"
                                        Visibility="{Binding Text, ElementName=DirectEgressStatusText, Converter={StaticResource StringVisibilityConverter}}"
                                        Style="{x:Bind ViewModel.DirectEgress.Health, Mode=OneWay, Converter={StaticResource DashboardEgressStyleConverter}, ConverterParameter=Text}"
                                        TextWrapping="Wrap" FontSize="12" />
                                    <Rectangle x:Name="EgressDivider" Grid.Column="1" Grid.RowSpan="6" Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <TextBlock x:Name="ProxyRouteTitle" Margin="0,0,0,8" x:Uid="Dashboard_ProxyRouteTitle" Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="ProxyIpLabel" Margin="0,0,0,8" x:Uid="Dashboard_PublicIpLabel" Grid.Row="1" Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="ProxyIpText" Margin="0,0,0,8" Grid.Row="2" Grid.Column="2"
                                        Text="{x:Bind viewmodels:DashboardViewModel.EgressIp(ViewModel.ProxyEgress), Mode=OneWay}"
                                        Style="{x:Bind ViewModel.ProxyEgress.Health, Mode=OneWay, Converter={StaticResource DashboardEgressStyleConverter}, ConverterParameter=Text}"
                                        FontSize="20" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ProxyLocationText" Margin="0,0,0,8" Grid.Row="3" Grid.Column="2" TextWrapping="Wrap" FontSize="13">
                                        <Run x:Uid="Dashboard_LocationLabel" /><Run Text="{x:Bind ViewModel.ProxyEgress.Location, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock x:Name="ProxyEgressStatusText" Margin="0,0,0,8" Grid.Row="5" Grid.Column="2" Text="{x:Bind viewmodels:DashboardViewModel.EgressStatus(ViewModel.ProxyEgress), Mode=OneWay}"
                                        Visibility="{Binding Text, ElementName=ProxyEgressStatusText, Converter={StaticResource StringVisibilityConverter}}"
                                        Style="{x:Bind ViewModel.ProxyEgress.Health, Mode=OneWay, Converter={StaticResource DashboardEgressStyleConverter}, ConverterParameter=Text}"
                                        TextWrapping="Wrap" FontSize="12" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="600" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DirectRouteTitle.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="DirectIpLabel.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="DirectIpText.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="DirectLocationText.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="DirectEgressStatusText.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="EgressDivider.(Grid.Column)" Value="0" />
                        <Setter Target="EgressDivider.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="EgressDivider.(Grid.Row)" Value="6" />
                        <Setter Target="EgressDivider.(Grid.RowSpan)" Value="1" />
                        <Setter Target="EgressDivider.Width" Value="Auto" />
                        <Setter Target="EgressDivider.Height" Value="1" />
                        <Setter Target="EgressDivider.Margin" Value="0,8,0,16" />
                        <Setter Target="ProxyRouteTitle.(Grid.Column)" Value="0" />
                        <Setter Target="ProxyRouteTitle.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="ProxyRouteTitle.(Grid.Row)" Value="7" />
                        <Setter Target="ProxyIpLabel.(Grid.Column)" Value="0" />
                        <Setter Target="ProxyIpLabel.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="ProxyIpLabel.(Grid.Row)" Value="8" />
                        <Setter Target="ProxyIpText.(Grid.Column)" Value="0" />
                        <Setter Target="ProxyIpText.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="ProxyIpText.(Grid.Row)" Value="9" />
                        <Setter Target="ProxyLocationText.(Grid.Column)" Value="0" />
                        <Setter Target="ProxyLocationText.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="ProxyLocationText.(Grid.Row)" Value="10" />
                        <Setter Target="ProxyEgressStatusText.(Grid.Column)" Value="0" />
                        <Setter Target="ProxyEgressStatusText.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="ProxyEgressStatusText.(Grid.Row)" Value="12" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1200" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SecondaryColumn.(Grid.Column)" Value="0" />
                        <Setter Target="SecondaryColumn.(Grid.Row)" Value="1" />
                        <Setter Target="DashboardSecondaryWidth.Width" Value="Auto" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</local:NavigablePage>
