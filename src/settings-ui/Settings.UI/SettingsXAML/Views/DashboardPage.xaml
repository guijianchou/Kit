<local:NavigablePage
    x:Class="Kit.Settings.UI.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controlConverters="using:Kit.Settings.UI.Controls.Converters"
    xmlns:controls="using:Kit.Settings.UI.Controls"
    xmlns:converters="using:Kit.Settings.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Kit.Settings.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ptcontrols="using:Kit.Common.UI.Controls"
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewmodels="using:Kit.Settings.UI.ViewModels"
    AutomationProperties.LandmarkType="Main"
    NavigationCacheMode="Required"
    mc:Ignorable="d">
    <local:NavigablePage.Resources>
        <controlConverters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <converters:EnumToModuleListSortOptionConverter x:Key="EnumToModuleListSortOptionConverter" />
        <DataTemplate x:Key="DashboardDetailTemplate" x:DataType="viewmodels:DashboardDetail">
            <Grid Margin="44,2,0,2" ColumnSpacing="12" MinHeight="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DetailLabel" Margin="0,3,0,3" Text="{x:Bind Label, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    VerticalAlignment="Top" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="13" />
                <TextBlock Grid.Column="1" Margin="0,3,0,3" Text="{x:Bind Value, Mode=OneWay}" FontWeight="Normal" FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                    Typography.NumeralAlignment="Tabular" VerticalAlignment="Top"
                    Visibility="{x:Bind HasUsage, Converter={StaticResource ReverseBoolToVisibilityConverter}, Mode=OneWay}" />
                <Grid x:Name="UsageRow" Grid.Column="1" Margin="0,3,0,3" ColumnSpacing="12" VerticalAlignment="Center"
                    Visibility="{x:Bind HasUsage, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Value, Mode=OneWay}" FontWeight="Normal" FontSize="13"
                        TextWrapping="Wrap" Typography.NumeralAlignment="Tabular"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True"
                        VerticalAlignment="Center" />
                    <local:UsageProgressBar Grid.Column="1" Height="6" CornerRadius="3"
                        Background="{ThemeResource ControlStrongStrokeColorDisabledBrush}"
                        VerticalAlignment="Center" Maximum="100" TargetValue="{x:Bind UsageValue, Mode=OneWay}"
                        local:UsageProgressBar.UsageCategory="{x:Bind UsageCategory, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind Label, Mode=OneWay}" AutomationProperties.HelpText="{x:Bind Value, Mode=OneWay}"
                        Visibility="{x:Bind HasUsage, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                </Grid>
            </Grid>
        </DataTemplate>
    </local:NavigablePage.Resources>

    <Grid Padding="24,0,0,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Uid="DashboardTitle"
            MaxWidth="{StaticResource PageMaxWidth}"
            Margin="0,0,24,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            AutomationProperties.HeadingLevel="1"
            Style="{StaticResource TitleTextBlockStyle}" />

        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1">
            <Grid Padding="0,0,24,32">
                <Grid
                    x:Name="DashboardGrid"
                    MaxWidth="{StaticResource PageMaxWidth}"
                    ColumnSpacing="16"
                    RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="DashboardSecondaryWidth" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Mica Hero Overview Banner（共享 KitHeroPanelStyle） -->
                    <ContentControl x:Name="DashboardHero" Grid.ColumnSpan="2" Style="{StaticResource KitHeroPanelStyle}">
                        <Grid Padding="16,12" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource KitIconBadgeStyle}" Width="36" Height="36" CornerRadius="{StaticResource OverlayCornerRadius}">
                                <FontIcon
                                    AutomationProperties.AccessibilityView="Raw"
                                    Glyph="&#xE80F;"
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                x:Uid="DashboardIntro"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="WrapWholeWords"
                                Style="{StaticResource BodyTextBlockStyle}" />
                        </Grid>
                    </ContentControl>

                    <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="16" ChildrenTransitions="{StaticResource SettingsCardsAnimations}">
                        <controls:Card
                            x:Name="QuickAccessCard"
                            x:Uid="QuickAccessTitle"
                            Padding="16,14,16,16"
                            HeaderGlyph="&#xE91C;"
                            VerticalAlignment="Top"
                            DividerVisibility="Visible">
                            <Grid>
                                <controls:QuickAccessList
                                    x:Name="QuickAccessItemsControl"
                                    Margin="0"
                                    ItemsSource="{x:Bind ViewModel.QuickAccessItems, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.VisibleQuickAccessItemsCount, Mode=OneWay, Converter={StaticResource DoubleToVisibilityConverter}}" />
                                <StackPanel
                                    Padding="8,12"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.VisibleQuickAccessItemsCount, Mode=OneWay, Converter={StaticResource DoubleToInvertedVisibilityConverter}}">
                                    <FontIcon
                                        AutomationProperties.AccessibilityView="Raw"
                                        FontSize="16"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xE74C;" />
                                    <TextBlock
                                        x:Uid="NoActionsToShow"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource BodyTextBlockStyle}" />
                                </StackPanel>
                            </Grid>
                        </controls:Card>
                        <Border x:Name="SystemOverviewCard" Style="{StaticResource KitCardSurfaceStyle}" Padding="0">
                            <Grid RowDefinitions="Auto,Auto,*">
                                <Grid MinHeight="52" Padding="16,10,16,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource KitIconBadgeStyle}">
                                        <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xE7F4;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" x:Uid="Dashboard_SystemCard" Style="{StaticResource KitCardTitleTextStyle}" AutomationProperties.HeadingLevel="Level2" />
                                </Grid>
                                <Rectangle Grid.Row="1" Height="1" HorizontalAlignment="Stretch" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <StackPanel Grid.Row="2" Spacing="0">
                                    <ItemsControl x:Name="SystemDetailsList" Margin="16,10,16,12" ItemsSource="{x:Bind ViewModel.SystemDetails, Mode=OneWay}"
                                        ItemTemplate="{StaticResource DashboardDetailTemplate}" />

                                    <!-- Storage Section -->
                                    <Border Padding="16,10,16,12"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="32,*" ColumnSpacing="12" MinHeight="24">
                                                <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xEDA2;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" x:Uid="Dashboard_StorageHeading" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                            <ItemsControl x:Name="StorageDetailsList" ItemsSource="{x:Bind ViewModel.StorageDetails, Mode=OneWay}"
                                                ItemTemplate="{StaticResource DashboardDetailTemplate}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Graphics Cards Section -->
                                    <ItemsControl x:Name="GraphicsCardsList" ItemsSource="{x:Bind ViewModel.GraphicsCards, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="0" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="viewmodels:DashboardGpuCard">
                                                <Border Padding="16,10,16,14"
                                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                                    <StackPanel Spacing="6">
                                                        <Grid ColumnDefinitions="32,*" ColumnSpacing="12" MinHeight="24">
                                                            <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xE7F8;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                        </Grid>
                                                        <ItemsControl ItemsSource="{x:Bind Details, Mode=OneWay}" ItemTemplate="{StaticResource DashboardDetailTemplate}" />
                                                        <TextBlock Margin="44,2,0,0" Text="{x:Bind Status, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                                            Visibility="{x:Bind Status, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="SecondaryColumn" Grid.Row="1" Grid.Column="1" Spacing="16" ChildrenTransitions="{StaticResource SettingsCardsAnimations}">
                        <controls:Card
                            x:Name="UtilitiesCard"
                            x:Uid="UtilitiesHeader"
                            HeaderGlyph="&#xE71D;"
                            Padding="0,6"
                            VerticalAlignment="Top"
                            DividerVisibility="Visible">
                            <controls:Card.TitleContent>
                                <Button
                                    x:Uid="Dashboard_SortBy"
                                    AutomationProperties.AutomationId="DashboardSortByButton"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource KitSubtleIconButtonStyle}">
                                    <ToolTipService.ToolTip>
                                        <TextBlock x:Uid="Dashboard_SortBy_ToolTip" />
                                    </ToolTipService.ToolTip>
                                    <Button.Content>
                                        <FontIcon FontSize="15" Glyph="&#xE8CB;" />
                                    </Button.Content>
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <RadioMenuFlyoutItem
                                                x:Uid="Dashboard_SortAlphabetical"
                                                Click="SortAlphabetical_Click"
                                                GroupName="DashboardSortGroup"
                                                IsChecked="{x:Bind ViewModel.DashboardSortOrder, Mode=OneWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Alphabetical}" />
                                            <RadioMenuFlyoutItem
                                                x:Uid="Dashboard_SortByStatus"
                                                Click="SortByStatus_Click"
                                                GroupName="DashboardSortGroup"
                                                IsChecked="{x:Bind ViewModel.DashboardSortOrder, Mode=OneWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=ByStatus}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </controls:Card.TitleContent>
                            <controls:ModuleList
                                x:Name="ModulesCard"
                                ItemsSource="{x:Bind ViewModel.AllModules, Mode=OneWay}"
                                SortOption="{x:Bind ViewModel.DashboardSortOrder, Mode=TwoWay, Converter={StaticResource EnumToModuleListSortOptionConverter}}" />
                        </controls:Card>
                        <Border x:Name="NetworkOverviewCard" Style="{StaticResource KitCardSurfaceStyle}" Padding="0">
                            <Grid RowDefinitions="Auto,Auto,*">
                                <Grid MinHeight="52" Padding="16,10,16,10" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource KitIconBadgeStyle}">
                                        <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xE774;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" x:Uid="Dashboard_NetworkCard" Style="{StaticResource KitCardTitleTextStyle}" AutomationProperties.HeadingLevel="Level2" />
                                </Grid>
                                <Rectangle Grid.Row="1" Height="1" HorizontalAlignment="Stretch" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <StackPanel Grid.Row="2" Padding="16,12,16,14" Spacing="12">
                                    <TextBlock x:Uid="Dashboard_NetworkNote" Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="DirectRouteTitle" Margin="0,0,0,4" x:Uid="Dashboard_DirectRouteTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Name="DirectIpLabel" Margin="0,0,0,2" x:Uid="Dashboard_PublicIpLabel" Grid.Row="1" Style="{StaticResource KitMicroLabelTextStyle}" />
                                        <TextBlock x:Name="DirectIpText" Margin="0,0,0,6" Grid.Row="2"
                                            Text="{x:Bind viewmodels:DashboardViewModel.EgressIp(ViewModel.DirectEgress), Mode=OneWay}"
                                            Style="{x:Bind EgressTextStyle(ViewModel.DirectEgress.Health), Mode=OneWay}"
                                            FontFamily="{StaticResource KitMonoFontFamily}" FontSize="20" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                        <TextBlock x:Name="DirectLocationText" Margin="0,0,0,4" Grid.Row="3" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Run x:Uid="Dashboard_LocationLabel" /><Run Text="{x:Bind ViewModel.DirectEgress.Location, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </TextBlock>
                                        <TextBlock x:Name="DirectEgressStatusText" Margin="0,2,0,0" Grid.Row="4" Text="{x:Bind viewmodels:DashboardViewModel.EgressStatus(ViewModel.DirectEgress), Mode=OneWay}"
                                            Visibility="{x:Bind EgressStatusVisibility(ViewModel.DirectEgress), Mode=OneWay}"
                                            Style="{x:Bind EgressTextStyle(ViewModel.DirectEgress.Health), Mode=OneWay}"
                                            TextWrapping="Wrap" FontSize="12" />
                                        <Rectangle x:Name="EgressDivider" Grid.Column="1" Grid.RowSpan="5" Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                        <TextBlock x:Name="ProxyRouteTitle" Margin="0,0,0,4" x:Uid="Dashboard_ProxyRouteTitle" Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Name="ProxyIpLabel" Margin="0,0,0,2" x:Uid="Dashboard_PublicIpLabel" Grid.Row="1" Grid.Column="2" Style="{StaticResource KitMicroLabelTextStyle}" />
                                        <TextBlock x:Name="ProxyIpText" Margin="0,0,0,6" Grid.Row="2" Grid.Column="2"
                                            Text="{x:Bind viewmodels:DashboardViewModel.EgressIp(ViewModel.ProxyEgress), Mode=OneWay}"
                                            Style="{x:Bind EgressTextStyle(ViewModel.ProxyEgress.Health), Mode=OneWay}"
                                            FontFamily="{StaticResource KitMonoFontFamily}" FontSize="20" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                        <TextBlock x:Name="ProxyLocationText" Margin="0,0,0,4" Grid.Row="3" Grid.Column="2" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Run x:Uid="Dashboard_LocationLabel" /><Run Text="{x:Bind ViewModel.ProxyEgress.Location, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </TextBlock>
                                        <TextBlock x:Name="ProxyEgressStatusText" Margin="0,2,0,0" Grid.Row="4" Grid.Column="2" Text="{x:Bind viewmodels:DashboardViewModel.EgressStatus(ViewModel.ProxyEgress), Mode=OneWay}"
                                            Visibility="{x:Bind EgressStatusVisibility(ViewModel.ProxyEgress), Mode=OneWay}"
                                            Style="{x:Bind EgressTextStyle(ViewModel.ProxyEgress.Health), Mode=OneWay}"
                                            TextWrapping="Wrap" FontSize="12" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="600" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DirectRouteTitle.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="DirectIpLabel.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="DirectIpText.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="DirectLocationText.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="DirectEgressStatusText.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="EgressDivider.(Grid.Column)" Value="0" />
                        <Setter Target="EgressDivider.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="EgressDivider.(Grid.Row)" Value="5" />
                        <Setter Target="EgressDivider.(Grid.RowSpan)" Value="1" />
                        <Setter Target="EgressDivider.Width" Value="Auto" />
                        <Setter Target="EgressDivider.Height" Value="1" />
                        <Setter Target="EgressDivider.Margin" Value="0,8,0,12" />
                        <Setter Target="ProxyRouteTitle.(Grid.Column)" Value="0" />
                        <Setter Target="ProxyRouteTitle.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="ProxyRouteTitle.(Grid.Row)" Value="6" />
                        <Setter Target="ProxyIpLabel.(Grid.Column)" Value="0" />
                        <Setter Target="ProxyIpLabel.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="ProxyIpLabel.(Grid.Row)" Value="7" />
                        <Setter Target="ProxyIpText.(Grid.Column)" Value="0" />
                        <Setter Target="ProxyIpText.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="ProxyIpText.(Grid.Row)" Value="8" />
                        <Setter Target="ProxyLocationText.(Grid.Column)" Value="0" />
                        <Setter Target="ProxyLocationText.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="ProxyLocationText.(Grid.Row)" Value="9" />
                        <Setter Target="ProxyEgressStatusText.(Grid.Column)" Value="0" />
                        <Setter Target="ProxyEgressStatusText.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="ProxyEgressStatusText.(Grid.Row)" Value="10" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1200" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DashboardGrid.ColumnSpacing" Value="0" />
                        <Setter Target="DashboardHero.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="SecondaryColumn.(Grid.Column)" Value="0" />
                        <Setter Target="SecondaryColumn.(Grid.Row)" Value="2" />
                        <Setter Target="DashboardSecondaryWidth.Width" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</local:NavigablePage>
