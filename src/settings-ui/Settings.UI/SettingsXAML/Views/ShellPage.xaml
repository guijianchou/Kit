<UserControl
    x:Class="Kit.Settings.UI.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedVisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:controls="using:Kit.Settings.UI.Controls"
    xmlns:converters="using:Kit.Settings.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Kit.Settings.UI.Helpers"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:ic="using:Microsoft.Xaml.Interactions.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Kit.Settings.UI.ViewModels"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:views="using:Kit.Settings.UI.Views"
    HighContrastAdjustment="None"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:IconConverter x:Key="IconConverter" />
        <converters:SearchSuggestionTemplateSelector
            x:Key="SearchSuggestionTemplateSelector"
            DefaultSuggestionTemplate="{StaticResource DefaultSearchResultTemplate}"
            NoResultsSuggestionTemplate="{StaticResource NoResultSearchResultTemplate}"
            ShowAllSuggestionTemplate="{StaticResource ShowAllSearchResultTemplate}" />
        <DataTemplate x:Key="DefaultSearchResultTemplate" x:DataType="models:SuggestionItem">
            <Grid Padding="16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Viewbox
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Stretch="Uniform">
                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="{x:Bind Icon, Converter={StaticResource IconConverter}, ConverterParameter=&#xE713;}" />
                </Viewbox>
                <StackPanel
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Header}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Subtitle}"
                        Visibility="{x:Bind Subtitle, Converter={StaticResource StringVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="NoResultSearchResultTemplate" x:DataType="models:SuggestionItem">
            <Grid>
                <TextBlock
                    Margin="8"
                    HorizontalAlignment="Center"
                    Text="{x:Bind Header}"
                    TextAlignment="Center" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ShowAllSearchResultTemplate" x:DataType="models:SuggestionItem">
            <Grid>
                <Rectangle
                    Height="1"
                    Margin="0,-12,0,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <TextBlock
                    x:Uid="Shell_Search_ShowAll"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    TextAlignment="Center" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <i:Interaction.Behaviors>
        <ic:EventTriggerBehavior EventName="Loaded">
            <ic:InvokeCommandAction Command="{x:Bind ViewModel.LoadedCommand}" />
        </ic:EventTriggerBehavior>
    </i:Interaction.Behaviors>
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:TitleBar
            x:Name="AppTitleBar"
            AutoConfigureCustomTitleBar="True"
            CompactStateBreakpoint="900"
            IsPaneButtonVisible="True"
            IsTabStop="False"
            Background="Transparent"
            PaneButtonClick="PaneToggleBtn_Click">
            <controls:TitleBar.Resources>
                <x:Double x:Key="TitleBarContentMinWidth">516</x:Double>
            </controls:TitleBar.Resources>
            <controls:TitleBar.Icon>
                <BitmapIcon ShowAsMonochrome="False" UriSource="/Assets/Settings/icon.ico" />
            </controls:TitleBar.Icon>
            <controls:TitleBar.Content>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    x:Uid="Shell_SearchBox"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    GotFocus="SearchBox_GotFocus"
                    ItemTemplateSelector="{StaticResource SearchSuggestionTemplateSelector}"
                    QueryIcon="Find"
                    QuerySubmitted="SearchBox_QuerySubmitted"
                    SuggestionChosen="SearchBox_SuggestionChosen"
                    TextChanged="SearchBox_TextChanged"
                    TextMemberPath="Header"
                    UpdateTextOnSelect="False">
                    <AutoSuggestBox.KeyboardAccelerators>
                        <KeyboardAccelerator
                            Key="F"
                            Invoked="CtrlF_Invoked"
                            Modifiers="Control" />
                    </AutoSuggestBox.KeyboardAccelerators>
                </AutoSuggestBox>
            </controls:TitleBar.Content>
        </controls:TitleBar>
        <NavigationView
            x:Name="navigationView"
            Grid.Row="1"
            Canvas.ZIndex="0"
            DisplayModeChanged="NavigationView_DisplayModeChanged"
            IsBackButtonVisible="Collapsed"
            IsBackEnabled="{x:Bind ViewModel.IsBackEnabled, Mode=OneWay}"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="176"
            CompactPaneLength="48"
            PaneClosed="NavigationView_PaneClosed"
            PaneDisplayMode="Left"
            PaneOpened="NavigationView_PaneOpened"
            SelectedItem="{x:Bind ViewModel.Selected, Mode=OneWay}">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />

                <!-- Compact progress bar matching the original app sidebar treatment. -->
                <Style x:Key="SidebarProgressBarStyle" TargetType="ProgressBar">
                    <Setter Property="Height" Value="4" />
                    <Setter Property="MinHeight" Value="4" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                </Style>
            </NavigationView.Resources>

            <!-- Audit progress lives in the pane footer so it stays visible on every page,
                 replacing the pipeline strip that used to sit above the AI Hub tabs. -->
            <NavigationView.PaneFooter>
                <StackPanel Margin="8,4,8,8" Spacing="4"
                            Visibility="{x:Bind ViewModel.AuditProgress.IsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="8" Height="20">
                        <FontIcon Glyph="{x:Bind ViewModel.AuditProgress.Glyph, Mode=OneWay}" FontSize="14" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AuditProgress.Title, Mode=OneWay}"
                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind ViewModel.AuditProgress.Tooltip, Mode=OneWay}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.AuditProgress.PercentText, Mode=OneWay}"
                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                    <ProgressBar Value="{x:Bind ViewModel.AuditProgress.Percent, Mode=OneWay}" Minimum="0" Maximum="100"
                                 Style="{StaticResource SidebarProgressBarStyle}"
                                 AutomationProperties.Name="{x:Bind ViewModel.AuditProgress.Tooltip, Mode=OneWay}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{x:Bind ViewModel.AuditProgress.Title, Mode=OneWay}" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AuditProgress.CountText, Mode=OneWay}" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </StackPanel>
            </NavigationView.PaneFooter>
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="DashboardNavigationItem"
                    x:Uid="Shell_Dashboard"
                    AutomationProperties.AutomationId="DashboardNavItem"
                    Icon="{ui:FontIcon Glyph=&#xE80F;}" />

                <NavigationViewItemSeparator />

                <NavigationViewItem
                    x:Name="AwakeNavigationItem"
                    x:Uid="Shell_Awake"
                    AutomationProperties.AutomationId="AwakeNavItem"
                    Icon="{ui:BitmapIcon Source=/Assets/Settings/Icons/Awake.png}" />

                <NavigationViewItem
                    x:Name="LightSwitchNavigationItem"
                    x:Uid="Shell_LightSwitch"
                    AutomationProperties.AutomationId="LightSwitchNavItem"
                    Icon="{ui:BitmapIcon Source=/Assets/Settings/Icons/LightSwitch.png}" />

                <NavigationViewItem
                    x:Name="LocalserverNavigationItem"
                    x:Uid="Shell_Localserver"
                    AutomationProperties.AutomationId="LocalserverNavItem"
                    Icon="{ui:BitmapIcon Source=/Assets/Settings/Icons/Localserver.png}" />

                <NavigationViewItem
                    x:Name="UDPtestNavigationItem"
                    x:Uid="Shell_UDPtest"
                    AutomationProperties.AutomationId="UDPtestNavItem"
                    Icon="{ui:BitmapIcon Source=/Assets/Settings/Icons/UDPtest.png}" />

                <NavigationViewItem
                    x:Name="AIHubNavigationItem"
                    x:Uid="Shell_AIHub"
                    AutomationProperties.AutomationId="AIHubNavItem"
                    Icon="{ui:BitmapIcon Source=/Assets/Settings/Icons/AiHub.png}" />

            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="GeneralNavigationItem"
                    x:Uid="Shell_Settings"
                    AutomationProperties.AutomationId="GeneralNavItem">
                    <NavigationViewItem.Icon>
                        <AnimatedIcon>
                            <AnimatedIcon.Source>
                                <animatedVisuals:AnimatedSettingsVisualSource />
                            </AnimatedIcon.Source>
                            <AnimatedIcon.FallbackIconSource>
                                <SymbolIconSource Symbol="Setting" />
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <i:Interaction.Behaviors>
                <ic:EventTriggerBehavior EventName="ItemInvoked">
                    <ic:InvokeCommandAction Command="{x:Bind ViewModel.ItemInvokedCommand}" />
                </ic:EventTriggerBehavior>
            </i:Interaction.Behaviors>
            <Frame x:Name="shellFrame" />
        </NavigationView>
    </Grid>
</UserControl>
