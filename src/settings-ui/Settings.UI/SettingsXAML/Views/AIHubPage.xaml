                                            </Button>
                                        </StackPanel>
                                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <TextBlock Text="{x:Bind ViewModel.OverviewFindingsSummary, Mode=OneWay}" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <HyperlinkButton Grid.Column="1" Command="{x:Bind ViewModel.ToggleOverviewFindingsCommand}" Padding="0" FontSize="12"
                                                                 HorizontalAlignment="Right"
                                                                 Visibility="{x:Bind ViewModel.CanToggleOverviewFindings, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="{x:Bind ViewModel.OverviewFindingsToggleLabel, Mode=OneWay}" FontSize="12" />
                                                        <FontIcon Glyph="{x:Bind ViewModel.OverviewFindingsToggleChevron, Mode=OneWay}" FontSize="10" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </HyperlinkButton>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="AuditSummaryCard" Grid.Column="1" Style="{StaticResource KitCardSurfaceStyle}" Padding="20,18" VerticalAlignment="Top"
                                        Background="{ThemeResource SectionAiTintBrush}">
                                    <StackPanel Spacing="14">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE9D9;" FontSize="15" Foreground="{ThemeResource SectionAiForegroundBrush}" />
                                                <TextBlock x:Uid="AIHub_Fluent_AiSummary" Foreground="{ThemeResource SectionAiForegroundBrush}" FontWeight="SemiBold" FontSize="15" />
                                            </StackPanel>
                                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                                <Border CornerRadius="4" Padding="8,2" Background="{ThemeResource BadgeSuccessBackgroundBrush}"
                                                        Visibility="{x:Bind ViewModel.IsAiSummaryCompleted, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{x:Bind ViewModel.AiSummaryStatusText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                </Border>
                                                <Border CornerRadius="4" Padding="8,2" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                        Visibility="{x:Bind ViewModel.IsAiSummaryCaution, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{x:Bind ViewModel.AiSummaryStatusText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                </Border>
                                                <Border CornerRadius="4" Padding="8,2" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        Visibility="{x:Bind ViewModel.IsAiSummaryNeutral, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{x:Bind ViewModel.AiSummaryStatusText, Mode=OneWay}" FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                            </Grid>
                                        </Grid>

                                        <Border BorderBrush="{ThemeResource SectionAiForegroundBrush}" BorderThickness="2,0,0,0" Padding="12,2,0,2">
                                            <TextBlock Text="{x:Bind ViewModel.AiSummaryText, Mode=OneWay}" TextWrapping="Wrap" FontSize="13" MaxLines="8" TextTrimming="CharacterEllipsis" />
                                        </Border>

                                        <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasAiSummaryPoint1, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{x:Bind ViewModel.AiSummaryPoint1, Mode=OneWay}" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind ViewModel.AiSummaryPoint2, Mode=OneWay}" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                                                       Visibility="{x:Bind ViewModel.HasAiSummaryPoint2, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>

                                        <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasRelatedEvidence, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock x:Uid="AIHub_Fluent_RelatedEvidence" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.RelatedEvidenceFindings, Mode=OneWay}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <tkcontrols:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:AuditIssueEnhanced">
                                                        <Button Tag="{x:Bind}" Click="OnFindingClick" Padding="8,4" CornerRadius="4"
                                                                Style="{StaticResource SubtleButtonStyle}"
                                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                                AutomationProperties.Name="{x:Bind DisplayTitle}">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <TextBlock Text="{x:Bind EvidenceChipText}" FontSize="11" FontFamily="{StaticResource KitMonoFontFamily}" />
                                                                <FontIcon Glyph="&#xE8A7;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <Button Content="{x:Bind ViewModel.DeepAnalyzeLabel}" Command="{x:Bind ViewModel.DeepAnalyzeCommand}"
                                                Style="{StaticResource KitActionButtonStyle}" HorizontalAlignment="Left"
                                                Visibility="{x:Bind ViewModel.ShowAiSummaryAction, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <HyperlinkButton x:Uid="AIHub_Fluent_FullReport" Click="OnJumpToAiReportClick" Padding="0"
                                                                 HorizontalAlignment="Left" FontSize="12"
                                                                 Visibility="{x:Bind ViewModel.HasAiReport, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AiSummaryFooterMetaText, Mode=OneWay}"
                                                           TextWrapping="Wrap" FontSize="11" FontFamily="{StaticResource KitMonoFontFamily}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border x:Name="AuditAiReport"
                                    Visibility="{x:Bind ViewModel.HasAiReport, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
