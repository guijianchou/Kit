<ContentDialog
    x:Class="Kit.Settings.UI.Views.WingetOptionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Kit.Settings.UI.Services"
    DefaultButton="Close">

    <ScrollViewer
        MaxHeight="500"
        MaxWidth="480"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">
            <CheckBox x:Name="SilentCheckBox" />
            <ComboBox x:Name="ScopeComboBox" HorizontalAlignment="Stretch" />
            <StackPanel x:Name="InstallOnlyOptionsPanel" Spacing="12">
                <ComboBox x:Name="ArchitectureComboBox" HorizontalAlignment="Stretch" />
                <StackPanel Spacing="4">
                    <TextBox
                        x:Name="InstallLocationBox"
                        MaxLength="1024"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="Winget_InstallLocation"
                        TextChanged="OnInstallLocationTextChanged" />
                    <TextBlock
                        x:Name="InvalidLocationText"
                        FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </StackPanel>
                <TextBlock
                    x:Name="InstallLocationHintText"
                    FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
