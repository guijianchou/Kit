<local:NavigablePage
    x:Class="Kit.Settings.UI.Views.GeneralPage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Kit.Settings.UI.Services"
    xmlns:controls="using:Kit.Settings.UI.Controls"
    xmlns:converters="using:Kit.Settings.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Kit.Settings.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Kit.AiHub.Models"
    xmlns:ptcontrols="using:Kit.Common.UI.Controls"
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:viewModels="using:Kit.Settings.UI.ViewModels"
    AutomationProperties.LandmarkType="Main"
    FontFamily="{ThemeResource KitUiFontFamily}"
    FontSize="{ThemeResource KitFontSize14}" services:TypographyResources.BaseFontSize="14"
    mc:Ignorable="d">

    <local:NavigablePage.Resources>
        <ResourceDictionary>
            <converters:StringToInfoBarSeverityConverter x:Key="StringToInfoBarSeverityConverter" />
            <!-- Keep the native PowerToys heading and separate setting cards. A
                 long expander must not animate every surrounding section. -->
            <Style BasedOn="{StaticResource DefaultSettingsGroupStyle}" TargetType="controls:SettingsGroup">
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="{StaticResource SettingsCardSpacing}" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </local:NavigablePage.Resources>

    <Grid>
        <controls:SettingsPageControl x:Name="GeneralSettingsSurface" x:Uid="General" services:RuntimeLocalization.Uid="General" CompactHeader="True">
            <controls:SettingsPageControl.HeaderSubContent>
                <Border
                    x:Name="SettingsSectionBar"
                    Background="{ThemeResource KitSettingsSectionBarBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    Padding="0">
                    <Grid
                        x:Name="SettingsSectionNavigation"
                        ColumnSpacing="0"
                        RowSpacing="0"
                        AutomationProperties.AutomationId="GeneralSectionNavigation">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="SectionCol0" Width="*" />
                            <ColumnDefinition x:Name="SectionCol1" Width="*" />
                            <ColumnDefinition x:Name="SectionCol2" Width="*" />
                            <ColumnDefinition x:Name="SectionCol3" Width="*" />
                            <ColumnDefinition x:Name="SectionCol4" Width="*" />
                            <ColumnDefinition x:Name="SectionCol5" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button
                            x:Name="SectionNavAppearanceButton"
                            Grid.Row="0"
                            Grid.Column="0"
                            AutomationProperties.AutomationId="GeneralSection_Appearance"
                            AutomationProperties.Name="{Binding ElementName=AppearanceAndBehaviorGroup, Path=Header}"
                            Click="SettingsSection_Click"
                            Style="{StaticResource KitSectionChipButtonStyle}"
                            Tag="AppearanceAndBehaviorGroup"
                            ToolTipService.ToolTip="{Binding ElementName=AppearanceAndBehaviorGroup, Path=Header}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="22" Height="22" CornerRadius="5" Background="{ThemeResource SectionAppearanceTintBrush}" VerticalAlignment="Center">
                                    <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="12" Glyph="&#xE790;" Foreground="{ThemeResource SectionAppearanceForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock
                                    x:Uid="General_SectionAppearance"
                                    services:RuntimeLocalization.Uid="General_SectionAppearance"
                                    FontSize="{ThemeResource KitFontSize13}"
                                    services:TypographyResources.BaseFontSize="13"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="SectionNavStartupButton"
                            Grid.Row="0"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="GeneralSection_Startup"
                            AutomationProperties.Name="{Binding ElementName=StartupAndPermissionsGroup, Path=Header}"
                            Click="SettingsSection_Click"
                            Style="{StaticResource KitSectionChipButtonStyle}"
                            Tag="StartupAndPermissionsGroup"
                            ToolTipService.ToolTip="{Binding ElementName=StartupAndPermissionsGroup, Path=Header}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="22" Height="22" CornerRadius="5" Background="{ThemeResource SectionStartupTintBrush}" VerticalAlignment="Center">
                                    <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="12" Glyph="&#xF71C;" Foreground="{ThemeResource SectionStartupForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock
                                    x:Uid="General_SectionStartup"
                                    services:RuntimeLocalization.Uid="General_SectionStartup"
                                    FontSize="{ThemeResource KitFontSize13}"
                                    services:TypographyResources.BaseFontSize="13"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="SectionNavAiButton"
                            Grid.Row="0"
                            Grid.Column="2"
                            AutomationProperties.AutomationId="GeneralSection_Ai"
                            AutomationProperties.Name="{Binding ElementName=AiServicesGroup, Path=Header}"
                            Click="SettingsSection_Click"
                            Style="{StaticResource KitSectionChipButtonStyle}"
                            Tag="AiServicesGroup"
                            ToolTipService.ToolTip="{Binding ElementName=AiServicesGroup, Path=Header}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="22" Height="22" CornerRadius="5" Background="{ThemeResource SectionAiTintBrush}" VerticalAlignment="Center">
                                    <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="12" Glyph="&#xEA80;" Foreground="{ThemeResource SectionAiForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock
                                    x:Uid="General_SectionAi"
                                    services:RuntimeLocalization.Uid="General_SectionAi"
                                    FontSize="{ThemeResource KitFontSize13}"
                                    services:TypographyResources.BaseFontSize="13"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="SectionNavDiagnosticsButton"
                            Grid.Row="0"
                            Grid.Column="3"
                            AutomationProperties.AutomationId="GeneralSection_Diagnostics"
                            AutomationProperties.Name="{Binding ElementName=DiagnosticsGroup, Path=Header}"
                            Click="SettingsSection_Click"
                            Style="{StaticResource KitSectionChipButtonStyle}"
                            Tag="DiagnosticsGroup"
                            ToolTipService.ToolTip="{Binding ElementName=DiagnosticsGroup, Path=Header}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="22" Height="22" CornerRadius="5" Background="{ThemeResource SectionDiagnosticsTintBrush}" VerticalAlignment="Center">
                                    <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="12" Glyph="&#xEC19;" Foreground="{ThemeResource SectionDiagnosticsForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock
                                    x:Uid="General_SectionDiagnostics"
                                    services:RuntimeLocalization.Uid="General_SectionDiagnostics"
                                    FontSize="{ThemeResource KitFontSize13}"
                                    services:TypographyResources.BaseFontSize="13"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="SectionNavBackupButton"
                            Grid.Row="0"
                            Grid.Column="4"
                            AutomationProperties.AutomationId="GeneralSection_Backup"
                            AutomationProperties.Name="{Binding ElementName=BackupAndRestoreGroup, Path=Header}"
                            Click="SettingsSection_Click"
                            Style="{StaticResource KitSectionChipButtonStyle}"
                            Tag="BackupAndRestoreGroup"
                            ToolTipService.ToolTip="{Binding ElementName=BackupAndRestoreGroup, Path=Header}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="22" Height="22" CornerRadius="5" Background="{ThemeResource SectionBackupTintBrush}" VerticalAlignment="Center">
                                    <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="12" Glyph="&#xE777;" Foreground="{ThemeResource SectionBackupForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock
                                    x:Uid="General_SectionBackup"
                                    services:RuntimeLocalization.Uid="General_SectionBackup"
                                    FontSize="{ThemeResource KitFontSize13}"
                                    services:TypographyResources.BaseFontSize="13"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="SectionNavUpdatesButton"
                            Grid.Row="0"
                            Grid.Column="5"
                            AutomationProperties.AutomationId="GeneralSection_Updates"
                            AutomationProperties.Name="{Binding ElementName=VersionAndUpdateGroup, Path=Header}"
                            Click="SettingsSection_Click"
                            Style="{StaticResource KitSectionChipButtonStyle}"
                            Tag="VersionAndUpdateGroup"
                            ToolTipService.ToolTip="{Binding ElementName=VersionAndUpdateGroup, Path=Header}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="22" Height="22" CornerRadius="5" Background="{ThemeResource SectionUpdatesTintBrush}" VerticalAlignment="Center">
                                    <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="12" Glyph="&#xE895;" Foreground="{ThemeResource SectionUpdatesForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock
                                    x:Uid="General_SectionUpdates"
                                    services:RuntimeLocalization.Uid="General_SectionUpdates"
                                    FontSize="{ThemeResource KitFontSize13}"
                                    services:TypographyResources.BaseFontSize="13"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </controls:SettingsPageControl.HeaderSubContent>
            <controls:SettingsPageControl.ModuleContent>
                <StackPanel Orientation="Vertical" Spacing="8">
                    <controls:SettingsGroup x:Name="AppearanceAndBehaviorGroup" x:Uid="Appearance_Behavior" services:RuntimeLocalization.Uid="Appearance_Behavior" Padding="0,0,0,0" IsEnabled="True">
                    <tkcontrols:SettingsCard
                        x:Name="ColorModeHeader"
                        x:Uid="ColorModeHeader" services:RuntimeLocalization.Uid="ColorModeHeader"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE790;}">
                        <tkcontrols:SettingsCard.Description>
                            <HyperlinkButton x:Uid="Windows_Color_Settings" services:RuntimeLocalization.Uid="Windows_Color_Settings" Click="OpenColorsSettings_Click" />
                        </tkcontrols:SettingsCard.Description>
                        <ComboBox
                            x:Name="ThemeSelector"
                            MinWidth="{StaticResource SettingActionControlMinWidth}"
                            AutomationProperties.Name="{Binding ElementName=ColorModeHeader, Path=Header}"
                            SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="Radio_Theme_Dark" services:RuntimeLocalization.Uid="Radio_Theme_Dark" />
                            <ComboBoxItem x:Uid="Radio_Theme_Light" services:RuntimeLocalization.Uid="Radio_Theme_Light" />
                            <ComboBoxItem x:Uid="Radio_Theme_Default" services:RuntimeLocalization.Uid="Radio_Theme_Default" />
                        </ComboBox>
                    </tkcontrols:SettingsCard>

                    <tkcontrols:SettingsCard
                        x:Name="LanguageHeader"
                        x:Uid="LanguageHeader" services:RuntimeLocalization.Uid="LanguageHeader"
                        HeaderIcon="{ui:FontIcon Glyph=&#xF2B7;}">
                        <ComboBox
                            x:Name="Languages_ComboBox"
                            MinWidth="{StaticResource SettingActionControlMinWidth}"
                            AutomationProperties.Name="{Binding ElementName=LanguageHeader, Path=Header}"
                            DisplayMemberPath="Language"
                            ItemsSource="{Binding Languages, Mode=TwoWay}"
                            SelectedIndex="{Binding LanguagesIndex, Mode=TwoWay}" />
                    </tkcontrols:SettingsCard>

                    <tkcontrols:SettingsCard
                        x:Name="FontFamilyCard"
                        x:Uid="General_FontFamily" services:RuntimeLocalization.Uid="General_FontFamily"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE8D2;}">
                        <ComboBox
                            x:Name="FontFamilySelector"
                            MinWidth="{StaticResource SettingActionControlMinWidth}"
                            AutomationProperties.AutomationId="GeneralFontFamily"
                            AutomationProperties.Name="{Binding ElementName=FontFamilyCard, Path=Header}"
                            SelectedIndex="{x:Bind ViewModel.FontFamilyIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="System UI" />
                            <ComboBoxItem Content="Noto Sans SC" />
                        </ComboBox>
                    </tkcontrols:SettingsCard>

                    <tkcontrols:SettingsCard
                        x:Name="FontSizeCard"
                        x:Uid="General_FontSize" services:RuntimeLocalization.Uid="General_FontSize"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE8E9;}">
                        <NumberBox
                            x:Name="FontSizeSelector"
                            Width="{StaticResource SettingActionControlMinWidth}"
                            Minimum="12"
                            Maximum="20"
                            SmallChange="1"
                            LargeChange="2"
                            SpinButtonPlacementMode="Inline"
                            ValueChanged="FontSizeSelector_ValueChanged"
                            Value="{x:Bind ViewModel.UiFontSize, Mode=TwoWay}"
                            AutomationProperties.AutomationId="GeneralFontSize"
                            AutomationProperties.Name="{Binding ElementName=FontSizeCard, Path=Header}" />
                    </tkcontrols:SettingsCard>

                    <tkcontrols:SettingsExpander
                        x:Name="ShowSystemTrayIconCard"
                        x:Uid="ShowSystemTrayIcon" services:RuntimeLocalization.Uid="ShowSystemTrayIcon"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE75B;}">
                        <ToggleSwitch
                            x:Uid="ToggleSwitch" services:RuntimeLocalization.Uid="ToggleSwitch"
                            AutomationProperties.Name="{Binding ElementName=ShowSystemTrayIconCard, Path=Header}"
                            IsOn="{x:Bind ViewModel.ShowSysTrayIcon, Mode=TwoWay}" />
                        <tkcontrols:SettingsExpander.Items>
                            <tkcontrols:SettingsCard
                                x:Name="ShowThemeAdaptiveTrayIconCard"
                                ContentAlignment="Left"
                                IsEnabled="{x:Bind ViewModel.ShowSysTrayIcon, Mode=OneWay}">
                                <CheckBox x:Uid="ShowThemeAdaptiveTrayIcon" services:RuntimeLocalization.Uid="ShowThemeAdaptiveTrayIcon" IsChecked="{x:Bind ViewModel.ShowThemeAdaptiveTrayIcon, Mode=TwoWay}" />
                            </tkcontrols:SettingsCard>
                        </tkcontrols:SettingsExpander.Items>
                    </tkcontrols:SettingsExpander>

                    <tkcontrols:SettingsCard
                        x:Name="GeneralPageEnableQuickAccess"
                        x:Uid="GeneralPage_EnableQuickAccess" services:RuntimeLocalization.Uid="GeneralPage_EnableQuickAccess"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE91C;}">
                        <ToggleSwitch
                            x:Uid="ToggleSwitch" services:RuntimeLocalization.Uid="ToggleSwitch"
                            AutomationProperties.Name="{Binding ElementName=GeneralPageEnableQuickAccess, Path=Header}"
                            IsOn="{x:Bind ViewModel.EnableQuickAccess, Mode=TwoWay}" />
                    </tkcontrols:SettingsCard>
                </controls:SettingsGroup>

                <controls:SettingsGroup x:Name="StartupAndPermissionsGroup" x:Uid="StartupAndPermissions" services:RuntimeLocalization.Uid="StartupAndPermissions">
                    <controls:GPOInfoControl ShowWarning="{x:Bind ViewModel.IsRunAtStartupGPOManaged, Mode=OneWay}">
                        <tkcontrols:SettingsCard
                            x:Name="GeneralPageRunAtStartUp"
                            x:Uid="GeneralPage_RunAtStartUp" services:RuntimeLocalization.Uid="GeneralPage_RunAtStartUp"
                            HeaderIcon="{ui:FontIcon Glyph=&#xF71C;}"
                            IsEnabled="{x:Bind ViewModel.IsRunAtStartupGPOManaged, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                            <ToggleSwitch
                                x:Name="StartupToggle"
                                x:Uid="ToggleSwitch" services:RuntimeLocalization.Uid="ToggleSwitch"
                                AutomationProperties.Name="{Binding ElementName=GeneralPageRunAtStartUp, Path=Header}"
                                IsOn="{x:Bind ViewModel.Startup, Mode=TwoWay}" />
                        </tkcontrols:SettingsCard>
                    </controls:GPOInfoControl>
                    <tkcontrols:SettingsExpander
                        x:Name="AdminModeRunningAs"
                        Header="{x:Bind ViewModel.RunningAsText, Mode=OneWay}"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE7EF;}"
                        IsExpanded="False">
                        <tkcontrols:SettingsExpander.Description>
                            <TextBlock x:Uid="General_AdminModeDescription" services:RuntimeLocalization.Uid="General_AdminModeDescription" TextWrapping="Wrap" />
                        </tkcontrols:SettingsExpander.Description>
                        <Button
                            x:Uid="GeneralPage_RestartAsAdmin_Button" services:RuntimeLocalization.Uid="GeneralPage_RestartAsAdmin_Button"
                            Style="{StaticResource KitActionButtonStyle}"
                            Command="{Binding RestartElevatedButtonEventHandler}"
                            IsEnabled="{Binding IsAdminButtonEnabled}" />
                        <tkcontrols:SettingsExpander.Items>
                            <tkcontrols:SettingsCard ContentAlignment="Left" IsEnabled="{x:Bind ViewModel.IsElevated, Mode=OneWay}">
                                <ptcontrols:CheckBoxWithDescriptionControl x:Uid="GeneralSettings_AlwaysRunAsAdminText" services:RuntimeLocalization.Uid="GeneralSettings_AlwaysRunAsAdminText" IsChecked="{x:Bind ViewModel.RunElevated, Mode=TwoWay}" />
                            </tkcontrols:SettingsCard>
                            <tkcontrols:SettingsCard ContentAlignment="Left">
                                <CheckBox x:Uid="GeneralPage_WarningsElevatedApps" services:RuntimeLocalization.Uid="GeneralPage_WarningsElevatedApps" IsChecked="{Binding Mode=TwoWay, Path=EnableWarningsElevatedApps}" />
                            </tkcontrols:SettingsCard>
                        </tkcontrols:SettingsExpander.Items>
                    </tkcontrols:SettingsExpander>
                </controls:SettingsGroup>

                <controls:SettingsGroup x:Name="AiServicesGroup" x:Uid="General_AiServicesGroup" services:RuntimeLocalization.Uid="General_AiServicesGroup">
                    <Grid>
                        <ContentControl x:Name="AiServiceSettingsSurface" HorizontalContentAlignment="Stretch" IsTabStop="False"
                                        Opacity="0" IsEnabled="False" IsHitTestVisible="False">
                            <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                                <tkcontrols:SettingsCard
                                    x:Name="GeneralPageAiHubMasterCard"
                                    x:Uid="General_AiHubSettings" services:RuntimeLocalization.Uid="General_AiHubSettings"
                                    AutomationProperties.AutomationId="AiHubSettingsCard"
                                    HeaderIcon="{ui:FontIcon Glyph=&#xEA80;}">
                                    <ToggleSwitch
                                        x:Name="AiServiceToggle"
                                        x:Uid="AiHub_EnableToggle" services:RuntimeLocalization.Uid="AiHub_EnableToggle"
                                        AutomationProperties.AutomationId="Toggle_AiHub"
                                        IsEnabled="{x:Bind ViewModel.AiServices.CanToggle, Mode=OneWay}"
                                        IsOn="{x:Bind ViewModel.AiServices.IsEnabled, Mode=TwoWay}" />
                                </tkcontrols:SettingsCard>

                                <InfoBar
                                    IsClosable="{x:Bind ViewModel.AiServices.IsStatusClosable, Mode=OneWay}"
                                    IsOpen="{x:Bind ViewModel.AiServices.IsStatusOpen, Mode=TwoWay}"
                                    Message="{x:Bind ViewModel.AiServices.StatusMessage, Mode=OneWay}"
                                    Severity="{x:Bind ViewModel.AiServices.StatusSeverity, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.AiServices.IsStatusOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <InfoBar.ActionButton>
                                        <Button
                                            x:Uid="AiHub_RetryConfigurationButton" services:RuntimeLocalization.Uid="AiHub_RetryConfigurationButton"
                                            AutomationProperties.AutomationId="AiHub_RetryConfigurationButton"
                                            Style="{StaticResource KitActionButtonStyle}"
                                            Command="{x:Bind ViewModel.AiServices.RetryConfigurationCommand}"
                                            Visibility="{x:Bind ViewModel.AiServices.CanRetryConfiguration, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </InfoBar.ActionButton>
                                </InfoBar>

                                <!-- The service configuration is only shown while the service is on. -->
                                <StackPanel
                                    Spacing="{StaticResource SettingsCardSpacing}"
                                    Visibility="{x:Bind ViewModel.AiServices.HubContentVisibility, Mode=OneWay}">
                                    <!-- Cached service readiness; each endpoint has its own connection test. -->
                                    <tkcontrols:SettingsCard
                                        x:Name="AiServiceStatusCard"
                                        x:Uid="AiHub_ServiceStatusCard" services:RuntimeLocalization.Uid="AiHub_ServiceStatusCard"
                                        Description="{x:Bind ViewModel.AiServices.ServiceStatusText, Mode=OneWay}">
                                        <tkcontrols:SettingsCard.HeaderIcon>
                                            <FontIcon Glyph="{x:Bind ViewModel.AiServices.ServiceStatusGlyph, Mode=OneWay}" />
                                        </tkcontrols:SettingsCard.HeaderIcon>
                                        <ProgressRing
                                            Width="16"
                                            Height="16"
                                            IsActive="{x:Bind ViewModel.AiServices.IsBusy, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.AiServices.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </tkcontrols:SettingsCard>

                                    <!-- AI execution kernel -->
                                    <tkcontrols:SettingsExpander
                                        x:Name="AiKernelSettingsExpander"
                                        x:Uid="AiHub_KernelCard" services:RuntimeLocalization.Uid="AiHub_KernelCard"
                                        Description="{x:Bind ViewModel.AiServices.KernelStatusText, Mode=OneWay}"
                                        HeaderIcon="{ui:FontIcon Glyph=&#xEDA3;}"
                                        IsExpanded="False">
                                        <tkcontrols:WrapPanel Orientation="Horizontal" VerticalSpacing="8" HorizontalSpacing="8">
                                            <ComboBox
                                                x:Uid="AiHub_KernelComboBox" services:RuntimeLocalization.Uid="AiHub_KernelComboBox"
                                                AutomationProperties.AutomationId="AiHub_KernelComboBox"
                                                MinWidth="160"
                                                IsEnabled="{x:Bind ViewModel.AiServices.CanEdit, Mode=OneWay}"
                                                SelectedIndex="{x:Bind ViewModel.AiServices.PendingKernelIndex, Mode=TwoWay}">
                                                <ComboBoxItem x:Uid="AIHub_KernelCodexItem" services:RuntimeLocalization.Uid="AIHub_KernelCodexItem" Content="Codex CLI" />
                                                <ComboBoxItem x:Uid="AIHub_KernelPiItem" services:RuntimeLocalization.Uid="AIHub_KernelPiItem" Content="Pi CLI" />
                                            </ComboBox>
                                            <Button
                                                x:Uid="AiHub_ApplyKernelButton" services:RuntimeLocalization.Uid="AiHub_ApplyKernelButton"
                                                AutomationProperties.AutomationId="AiHub_ApplyKernelButton"
                                                MinWidth="80"
                                                Command="{x:Bind ViewModel.AiServices.ApplyKernelSwitchCommand}"
                                                Content="Apply"
                                                Style="{StaticResource KitPrimaryActionButtonStyle}"
                                                Visibility="{x:Bind ViewModel.AiServices.IsKernelSwitchPending, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </tkcontrols:WrapPanel>
                                        <tkcontrols:SettingsExpander.Items>
                                            <tkcontrols:SettingsCard
                                                x:Uid="AiHub_KernelUpdatesCard" services:RuntimeLocalization.Uid="AiHub_KernelUpdatesCard"
                                                Description="{x:Bind ViewModel.AiServices.KernelLatestText, Mode=OneWay}"
                                                Header="Kernel updates">
                                                <tkcontrols:WrapPanel Orientation="Horizontal" VerticalSpacing="8" HorizontalSpacing="8">
                                                    <Button
                                                        x:Uid="AiHub_CheckUpdatesButton" services:RuntimeLocalization.Uid="AiHub_CheckUpdatesButton"
                                                        AutomationProperties.AutomationId="AiHub_CheckUpdatesButton"
                                                        Style="{StaticResource KitActionButtonStyle}"
                                                        Command="{x:Bind ViewModel.AiServices.CheckKernelUpdatesCommand}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon FontSize="13" Glyph="&#xE72C;" />
                                                            <TextBlock x:Uid="AiHub_CheckUpdatesText" services:RuntimeLocalization.Uid="AiHub_CheckUpdatesText" Text="Check for updates" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button
                                                        x:Uid="AiHub_DownloadKernelButton" services:RuntimeLocalization.Uid="AiHub_DownloadKernelButton"
                                                        AutomationProperties.AutomationId="AiHub_DownloadKernelButton"
                                                        Style="{StaticResource KitActionButtonStyle}"
                                                        Command="{x:Bind ViewModel.AiServices.DownloadKernelCommand}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon FontSize="13" Glyph="&#xE896;" />
                                                            <TextBlock x:Uid="AiHub_DownloadKernelText" services:RuntimeLocalization.Uid="AiHub_DownloadKernelText" Text="Download or update" />
                                                        </StackPanel>
                                                    </Button>
                                                </tkcontrols:WrapPanel>
                                            </tkcontrols:SettingsCard>
                                            <tkcontrols:SettingsCard Visibility="{x:Bind ViewModel.AiServices.ShowDownloadProgress, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <ProgressBar
                                                    HorizontalAlignment="Stretch"
                                                    Maximum="1"
                                                    Minimum="0"
                                                    Value="{x:Bind ViewModel.AiServices.DownloadProgress, Mode=OneWay}" />
                                            </tkcontrols:SettingsCard>
                                            <tkcontrols:SettingsCard x:Uid="AiHub_KernelLocationCard" services:RuntimeLocalization.Uid="AiHub_KernelLocationCard" Header="Installation path">
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    IsTextSelectionEnabled="True"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind ViewModel.AiServices.KernelPathText, Mode=OneWay}"
                                                    TextWrapping="Wrap" />
                                            </tkcontrols:SettingsCard>
                                        </tkcontrols:SettingsExpander.Items>
                                    </tkcontrols:SettingsExpander>

                                    <!-- Main endpoint. Edits stay in memory until saved from the bar below. -->
                                    <tkcontrols:SettingsExpander
                                        x:Name="AiMainEndpointExpander"
                                        x:Uid="AiHub_MainEndpointExpander" services:RuntimeLocalization.Uid="AiHub_MainEndpointExpander"
                                        Description="{x:Bind ViewModel.AiServices.MainEndpoint.EndpointSummary, Mode=OneWay}"
                                        Header="Main endpoint"
                                        HeaderIcon="{ui:FontIcon Glyph=&#xE774;}"
                                        IsExpanded="False">
                                        <tkcontrols:WrapPanel
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal" VerticalSpacing="8"
                                            HorizontalSpacing="12">
                                            <TextBlock
                                                MaxWidth="180"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind ViewModel.AiServices.MainEndpoint.ModelSummary, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind ViewModel.AiServices.MainEndpoint.ModelSummary, Mode=OneWay}" />
                                            <Button
                                                x:Uid="AiHub_TestConnectionButton" services:RuntimeLocalization.Uid="AiHub_TestConnectionButton"
                                                AutomationProperties.AutomationId="AiHub_MainEndpoint_TestConnectionButton"
                                                Style="{StaticResource KitActionButtonStyle}"
                                                    Command="{x:Bind ViewModel.AiServices.MainEndpoint.TestCommand, Mode=OneWay}"
                                                Content="Test connection" />
                                        </tkcontrols:WrapPanel>
                                        <tkcontrols:SettingsExpander.Items>
                                            <tkcontrols:SettingsCard x:Uid="AiHub_MainEndpoint_UrlCard" services:RuntimeLocalization.Uid="AiHub_MainEndpoint_UrlCard" Header="Endpoint URL" SizeChanged="SettingEditorCard_SizeChanged">
                                                <TextBox
                                                    x:Uid="AiHub_EndpointUrlBox" services:RuntimeLocalization.Uid="AiHub_EndpointUrlBox"
                                                    AutomationProperties.AutomationId="AiHub_MainEndpoint_UrlBox"
                                                    Width="280"
                                                    PlaceholderText="https://api.example.com"
                                                    Text="{x:Bind ViewModel.AiServices.MainEndpoint.BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </tkcontrols:SettingsCard>
                                            <tkcontrols:SettingsCard x:Uid="AiHub_MainEndpoint_ApiKeyCard" services:RuntimeLocalization.Uid="AiHub_MainEndpoint_ApiKeyCard" Header="API key" SizeChanged="SettingEditorCard_SizeChanged">
                                                <PasswordBox
                                                    x:Name="AiMainApiKeyBox"
                                                    x:Uid="AiHub_MainEndpoint_ApiKeyBox" services:RuntimeLocalization.Uid="AiHub_MainEndpoint_ApiKeyBox"
