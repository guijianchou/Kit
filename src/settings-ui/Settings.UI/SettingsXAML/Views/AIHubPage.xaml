                                                              IsChecked="{x:Bind ViewModel.IsSourceAll, Mode=OneWay}" Click="OnSourceFilterClick" />
                                                <ToggleButton Tag="Application" Style="{StaticResource KitFilterPillToggleStyle}"
                                                              AutomationProperties.Name="{x:Bind ViewModel.ApplicationLabel, Mode=OneWay}"
                                                              Content="{x:Bind ViewModel.ApplicationLabel, Mode=OneWay}"
                                                              IsChecked="{x:Bind ViewModel.IsSourceApplication, Mode=OneWay}" Click="OnSourceFilterClick" />
                                                <ToggleButton Tag="Security" Style="{StaticResource KitFilterPillToggleStyle}"
                                                              AutomationProperties.Name="{x:Bind ViewModel.SecurityLabel, Mode=OneWay}"
                                                              Content="{x:Bind ViewModel.SecurityLabel, Mode=OneWay}"
                                                              IsChecked="{x:Bind ViewModel.IsSourceSecurity, Mode=OneWay}" Click="OnSourceFilterClick" />
                                                <ToggleButton Tag="System" Style="{StaticResource KitFilterPillToggleStyle}"
                                                              AutomationProperties.Name="{x:Bind ViewModel.SystemLabel, Mode=OneWay}"
                                                              Content="{x:Bind ViewModel.SystemLabel, Mode=OneWay}"
                                                              IsChecked="{x:Bind ViewModel.IsSourceSystem, Mode=OneWay}" Click="OnSourceFilterClick" />
                                                <ToggleButton Tag="Setup" Style="{StaticResource KitFilterPillToggleStyle}"
                                                              AutomationProperties.Name="{x:Bind ViewModel.SetupLabel, Mode=OneWay}"
                                                              Content="{x:Bind ViewModel.SetupLabel, Mode=OneWay}"
                                                              IsChecked="{x:Bind ViewModel.IsSourceSetup, Mode=OneWay}" Click="OnSourceFilterClick" />
                                                <ToggleButton Tag="ForwardedEvents" Style="{StaticResource KitFilterPillToggleStyle}"
                                                              AutomationProperties.Name="{x:Bind ViewModel.ForwardedLabel, Mode=OneWay}"
                                                              Content="{x:Bind ViewModel.ForwardedLabel, Mode=OneWay}"
                                                              IsChecked="{x:Bind ViewModel.IsSourceForwarded, Mode=OneWay}" Click="OnSourceFilterClick" />
                                            </tkcontrols:WrapPanel>
                                            <HyperlinkButton Content="{x:Bind ViewModel.ResetFindingFiltersLabel}" Command="{x:Bind ViewModel.ResetFindingFiltersCommand}" HorizontalAlignment="Left" Padding="0" />
                                        </StackPanel>
                                        <ItemsControl x:Name="OverviewFindingsList" ItemsSource="{x:Bind ViewModel.OverviewFindings, Mode=OneWay}" ItemTemplate="{StaticResource FindingPreviewTemplate}" />
