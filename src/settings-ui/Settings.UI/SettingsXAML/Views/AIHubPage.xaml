                                                 AutomationProperties.Name="{x:Bind ViewModel.OptimizationWorkflowTitle}"
                                                 AutomationProperties.HelpText="{x:Bind ViewModel.OptimizationWorkflowStatus, Mode=OneWay}" />
                                    <TextBlock x:Name="OptimizationWorkflowStatus" Text="{x:Bind ViewModel.OptimizationWorkflowStatus, Mode=OneWay}"
                                               FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource KitCardSurfaceStyle}" Padding="18,18" Background="{ThemeResource SectionBackupTintBrush}">
                                <StackPanel Spacing="16">
                                    <Grid x:Name="OptimizationCommandHeader" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="14">
                                        <StackPanel x:Name="OptimizationCommandTitle" Spacing="6">
                                            <TextBlock Text="{x:Bind ViewModel.CleanableCapacityLabel}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="OptimizationCleanableCapacityText" Text="{x:Bind ViewModel.CleanableCapacityText, Mode=OneWay}" FontSize="32" FontWeight="SemiBold" Foreground="{ThemeResource SectionBackupForegroundBrush}" />
                                            <TextBlock x:Uid="AIHub_Fluent_StorageCapacityHint" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <tkcontrols:WrapPanel HorizontalSpacing="16" VerticalSpacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{x:Bind ViewModel.ScannedCandidatesLabel}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock x:Name="OptimizationScannedCandidatesText" Text="{x:Bind ViewModel.ScannedCandidatesText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{x:Bind ViewModel.ApprovedCandidatesLabel}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock x:Name="OptimizationApprovedCandidatesText" Text="{x:Bind ViewModel.ApprovedCandidatesText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </tkcontrols:WrapPanel>
                                        </StackPanel>
                                        <tkcontrols:WrapPanel x:Name="OptimizationCommandActions" Grid.Column="1" HorizontalSpacing="8" VerticalSpacing="8" VerticalAlignment="Center">
                                            <Button Command="{x:Bind ViewModel.ScanAllCommand}" Style="{StaticResource KitPrimaryActionButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <FontIcon Glyph="&#xE9F5;" FontSize="13" />
                                                    <TextBlock Text="{x:Bind ViewModel.ScanAllLabel}" />
                                                </StackPanel>
                                            </Button>
                                            <HyperlinkButton x:Uid="AIHub_Fluent_ExecutionHistory" Click="OnShowOptimizationHistoryClick" FontSize="12" />
                                        </tkcontrols:WrapPanel>
                                    </Grid>

                                    <StackPanel Spacing="10">
                                        <Border Height="6" CornerRadius="3" Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                            <Grid ColumnSpacing="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{x:Bind ViewModel.ActionableBarWidth, Mode=OneWay}" />
                                                    <ColumnDefinition Width="{x:Bind ViewModel.ReviewBarWidth, Mode=OneWay}" />
                                                    <ColumnDefinition Width="{x:Bind ViewModel.RetainedBarWidth, Mode=OneWay}" />
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="3,0,0,3" Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <Border Grid.Column="1" Background="{ThemeResource SystemFillColorCautionBrush}" />
                                                <Border Grid.Column="2" CornerRadius="0,3,3,0" Background="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.45" />
                                            </Grid>
                                        </Border>
                                        <tkcontrols:WrapPanel HorizontalSpacing="18" VerticalSpacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Width="8" Height="8" CornerRadius="2" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind ViewModel.ActionableLegendText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Width="8" Height="8" CornerRadius="2" Background="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind ViewModel.ReviewLegendText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Width="8" Height="8" CornerRadius="2" Background="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.6" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind ViewModel.RetainedLegendText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </tkcontrols:WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="8" Padding="2,0">
                                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Uid="AIHub_Fluent_OptimizationSteps" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>

                            <Border Style="{StaticResource KitCardSurfaceStyle}" Padding="20,18"
                                    Visibility="{x:Bind ViewModel.HasOptimizationResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Spacing="14">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <TextBlock Text="{x:Bind ViewModel.CandidatesLabel}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <tkcontrols:WrapPanel Grid.Column="1" HorizontalSpacing="6" VerticalSpacing="6" VerticalAlignment="Center">
                                            <Button x:Uid="AIHub_SelectVisibleButton" Command="{x:Bind ViewModel.SelectAllCandidatesCommand}" Style="{StaticResource SubtleButtonStyle}" FontSize="12" Padding="8,4" />
                                            <Button x:Uid="AIHub_DeselectVisibleButton" Command="{x:Bind ViewModel.DeselectAllCandidatesCommand}" Style="{StaticResource SubtleButtonStyle}" FontSize="12" Padding="8,4" />
                                        </tkcontrols:WrapPanel>
                                    </Grid>

                                    <tkcontrols:WrapPanel HorizontalSpacing="6" VerticalSpacing="6">
                                        <ToggleButton Tag="0" Style="{StaticResource KitFilterPillToggleStyle}"
                                                      IsChecked="{x:Bind ViewModel.IsOptFilterAll, Mode=OneWay}" Click="OnOptFilterPillClick">
                                            <TextBlock FontSize="12"><Run Text="{x:Bind ViewModel.FilterAllLabel, Mode=OneWay}" /><Run Text=" " /><Run Text="{x:Bind ViewModel.OptFilterAllCount, Mode=OneWay}" /></TextBlock>
                                        </ToggleButton>
                                        <ToggleButton Tag="1" Style="{StaticResource KitFilterPillToggleStyle}"
                                                      IsChecked="{x:Bind ViewModel.IsOptFilterApproved, Mode=OneWay}" Click="OnOptFilterPillClick">
                                            <TextBlock FontSize="12"><Run Text="{x:Bind ViewModel.ApprovedCandidatesLabel, Mode=OneWay}" /><Run Text=" " /><Run Text="{x:Bind ViewModel.OptFilterApprovedCount, Mode=OneWay}" /></TextBlock>
                                        </ToggleButton>
                                        <ToggleButton Tag="2" Style="{StaticResource KitFilterPillToggleStyle}"
                                                      IsChecked="{x:Bind ViewModel.IsOptFilterSkipped, Mode=OneWay}" Click="OnOptFilterPillClick">
                                            <TextBlock FontSize="12"><Run Text="{x:Bind ViewModel.OptFilterSkippedLabel, Mode=OneWay}" /><Run Text=" " /><Run Text="{x:Bind ViewModel.OptFilterSkippedCount, Mode=OneWay}" /></TextBlock>
                                        </ToggleButton>
                                        <ToggleButton Tag="3" Style="{StaticResource KitFilterPillToggleStyle}"
                                                      IsChecked="{x:Bind ViewModel.IsOptFilterFailed, Mode=OneWay}" Click="OnOptFilterPillClick">
                                            <TextBlock FontSize="12"><Run Text="{x:Bind ViewModel.OptFilterFailedLabel, Mode=OneWay}" /><Run Text=" " /><Run Text="{x:Bind ViewModel.OptFilterFailedCount, Mode=OneWay}" /></TextBlock>
                                        </ToggleButton>
                                        <ToggleButton Tag="4" Style="{StaticResource KitFilterPillToggleStyle}"
                                                      IsChecked="{x:Bind ViewModel.IsOptFilterSelected, Mode=OneWay}" Click="OnOptFilterPillClick">
                                            <TextBlock FontSize="12"><Run Text="{x:Bind ViewModel.OptFilterSelectedLabel, Mode=OneWay}" /><Run Text=" " /><Run Text="{x:Bind ViewModel.OptFilterSelectedCount, Mode=OneWay}" /></TextBlock>
                                        </ToggleButton>
                                    </tkcontrols:WrapPanel>

                                    <Grid x:Name="OptimizationReviewFilters" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="12">
                                        <TextBox x:Name="OptimizationSearchBox" x:Uid="AIHub_OptimizationSearchBox"
                                                 Text="{x:Bind ViewModel.OptimizationSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <ComboBox x:Name="OptimizationReviewFilter" x:Uid="AIHub_OptimizationReviewFilter" Grid.Column="1"
                                                  ItemsSource="{x:Bind ViewModel.OptimizationFilterOptions}"
                                                  SelectedIndex="{x:Bind ViewModel.OptimizationFilterIndex, Mode=TwoWay}" MinWidth="150" />
                                    </Grid>

                                    <TextBlock Text="{x:Bind ViewModel.FilteredCandidatesSummary, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                                    <Border CornerRadius="8" Padding="16,12" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid x:Name="OptimizationSelectionBar" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                            <StackPanel x:Name="OptimizationSelectionInfo" Spacing="4" VerticalAlignment="Center">
                                                <tkcontrols:WrapPanel HorizontalSpacing="14" VerticalSpacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock x:Uid="AIHub_SelectedCandidatesLabel" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock x:Name="OptimizationSelectionSummary" Text="{x:Bind ViewModel.SelectedCandidatesSummary, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ViewModel.HasSelectedDeletes, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock x:Uid="AIHub_Fluent_SelectedDeletes" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{x:Bind ViewModel.SelectedDeleteSizeText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ViewModel.HasSelectedMoves, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock x:Uid="AIHub_Fluent_SelectedMoves" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{x:Bind ViewModel.SelectedMoveSizeText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </tkcontrols:WrapPanel>
                                                <TextBlock x:Uid="AIHub_Fluent_SelectionFooterHint" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button x:Name="OptimizationExecuteButton" Grid.Column="1" x:Uid="AIHub_ExecuteSelectedButton" Command="{x:Bind ViewModel.ExecuteOptimizationCommand}"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.AutomationId="AIHub_ExecuteSelected" Style="{StaticResource KitPrimaryActionButtonStyle}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border x:Name="OptimizationNoResults" Style="{StaticResource KitCardSurfaceStyle}" Padding="20"
                                    Visibility="{x:Bind ViewModel.HasOptimizationResults, Mode=OneWay, Converter={StaticResource ReverseBoolToVisibilityConverter}}">
                                <StackPanel Spacing="6">
                                    <TextBlock x:Uid="AIHub_OptimizationNoResultsTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Uid="AIHub_OptimizationNoResultsDescription" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="OptimizationNoFilterMatches" Style="{StaticResource KitCardSurfaceStyle}" Padding="20"
                                    Visibility="{x:Bind ShowOptimizationNoMatches(ViewModel.HasOptimizationResults, ViewModel.HasFilteredOptimizationResults), Mode=OneWay}">
                                <StackPanel Spacing="6">
                                    <TextBlock x:Uid="AIHub_OptimizationNoFilterMatchesTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Uid="AIHub_OptimizationNoFilterMatchesDescription" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Downloads Management Section Card -->
                            <Border Style="{StaticResource KitCardSurfaceStyle}" Padding="20,18">
                                <StackPanel Spacing="14">
                                    <Grid x:Name="DownloadsCommandHeader" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel x:Name="DownloadsCommandTitle" Spacing="4">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                <Border Style="{StaticResource KitIconBadgeStyle}">
                                                    <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind ViewModel.DownloadsLabel, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Grid>
                                            <Border CornerRadius="4" Padding="6,2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" HorizontalAlignment="Left" Margin="0,4,0,0">
                                                <TextBlock Text="{x:Bind ViewModel.DownloadsPath}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="{StaticResource KitMonoFontFamily}" />
                                            </Border>
                                            <TextBlock Text="{x:Bind ViewModel.DownloadsResultSummary, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" FontWeight="Medium" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <tkcontrols:WrapPanel x:Name="DownloadsCommandActions" Grid.Column="1" HorizontalSpacing="8" VerticalSpacing="8" VerticalAlignment="Center">
                                            <Button Command="{x:Bind ViewModel.ScanDownloadsCommand}"
                                                    Style="{StaticResource KitActionButtonStyle}"
                                                    AutomationProperties.AutomationId="AIHub_ScanDownloads">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE721;" FontSize="11" />
                                                    <TextBlock Text="{x:Bind ViewModel.ScanButtonLabel}" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{x:Bind ViewModel.OrganizeDownloadsCommand}"
                                                    Style="{StaticResource KitActionButtonStyle}"
                                                    AutomationProperties.AutomationId="AIHub_OrganizeDownloads">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE8B7;" FontSize="11" />
                                                    <TextBlock Text="{x:Bind ViewModel.OrganizeDownloadsLabel}" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                        </tkcontrols:WrapPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.DownloadCategories}" ItemTemplate="{StaticResource OptimizationCategoryTemplate}" HorizontalContentAlignment="Stretch"
                                                  ItemContainerStyle="{StaticResource OptimizationPresenterStyle}"
                                                  IsEnabled="{x:Bind ViewModel.CanSelectOptimizationItems, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="0" ChildrenTransitions="{StaticResource SettingsCardsAnimations}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Caches & Temporary Files Section Card -->
                            <Border Style="{StaticResource KitCardSurfaceStyle}" Padding="20,18">
                                <StackPanel Spacing="14">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                <Border Style="{StaticResource KitIconBadgeStyle}">
                                                    <FontIcon Glyph="&#xEDA2;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind ViewModel.TemporaryFilesLabel, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind ViewModel.CacheResultSummary, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                        <Button Grid.Column="1" Command="{x:Bind ViewModel.ScanTemporaryFilesCommand}"
                                                Style="{StaticResource KitActionButtonStyle}"
                                                VerticalAlignment="Center" AutomationProperties.AutomationId="AIHub_ScanCaches">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE721;" FontSize="11" />
                                                <TextBlock Text="{x:Bind ViewModel.ScanButtonLabel}" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Border CornerRadius="{StaticResource OverlayCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            Visibility="{x:Bind ViewModel.HasUserDirectorySummaries, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Expander Header="{x:Bind ViewModel.UserDirectoryLabel}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                  Background="Transparent" BorderThickness="0">
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.UserDirectorySummaries}" HorizontalContentAlignment="Stretch" Padding="6,8">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Spacing="0" ChildrenTransitions="{StaticResource SettingsCardsAnimations}" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <TextBlock Text="{x:Bind}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="{StaticResource KitMonoFontFamily}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </Border>

                                    <ItemsControl x:Name="OptimizationCacheGroups" ItemsSource="{x:Bind ViewModel.CacheGroups}" HorizontalContentAlignment="Stretch"
                                                  ItemContainerStyle="{StaticResource OptimizationPresenterStyle}"
                                                  IsEnabled="{x:Bind ViewModel.CanSelectOptimizationItems, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:OptimizationGroupViewModel">
                                                <Border Margin="0,0,0,8" CornerRadius="{StaticResource OverlayCornerRadius}" HorizontalAlignment="Stretch"
                                                        Visibility="{x:Bind HasVisibleItems, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                              IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                                              Background="Transparent" BorderThickness="0">
                                                        <Expander.Header>
                                                            <Grid x:Name="OptimizationFamilyHeader" ColumnSpacing="8" MinHeight="52" Padding="0,2" HorizontalAlignment="Stretch">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Style="{StaticResource KitIconBadgeStyle}">
                                                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                    <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                                                                    <TextBlock Text="{x:Bind Summary}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Summary}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2" Text="{x:Bind Size}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" FontFamily="{StaticResource KitMonoFontFamily}" />
                                                                <Button Grid.Column="3" Content="{x:Bind CleanLabel}" Command="{x:Bind ExecuteCommand}"
                                                                        Style="{StaticResource KitActionButtonStyle}" Padding="10,5"
                                                                        IsEnabled="{x:Bind IsEnabled, Mode=OneWay}" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Expander.Header>
                                                        <Border x:Name="OptimizationGroupDetails" x:Load="{x:Bind HasBeenExpanded, Mode=OneWay}"
                                                                Padding="8,10,0,8">
                                                            <Grid>
                                                                <ListView x:Name="OptimizationProjectList" x:Load="{x:Bind HasProjects}" ItemsSource="{x:Bind Projects}"
                                                                          ItemContainerStyle="{StaticResource OptimizationItemContainerStyle}"
                                                                          ItemTemplate="{StaticResource OptimizationProjectTemplate}" SelectionMode="None" MaxHeight="520" HorizontalContentAlignment="Stretch" />
                                                                <ListView x:Name="OptimizationDirectCategoryList" x:Load="{x:Bind HasDirectCategories}" ItemsSource="{x:Bind Categories}"
                                                                          ItemContainerStyle="{StaticResource OptimizationItemContainerStyle}"
                                                                          ItemTemplate="{StaticResource OptimizationCategoryTemplate}" SelectionMode="None" MaxHeight="440" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                                            </Grid>
                                                        </Border>
                                                    </Expander>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Expander x:Name="OptimizationHistoryExpander" x:Uid="AIHub_Fluent_HistoryExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Border Style="{StaticResource KitCardSurfaceStyle}" Padding="20,18">
                                    <StackPanel Spacing="12">
                                        <tkcontrols:WrapPanel HorizontalSpacing="12" VerticalSpacing="8">
                                            <TextBlock x:Uid="AIHub_OptimizationHistoryTitle" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="16"
                                                       VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                                            <Button x:Uid="AIHub_RefreshHistoryButton" Command="{x:Bind ViewModel.RefreshOptimizationHistoryCommand}" Style="{StaticResource KitActionButtonStyle}" />
                                        </tkcontrols:WrapPanel>
                                        <TextBlock x:Uid="AIHub_OptimizationHistoryEmpty" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Visibility="{x:Bind ViewModel.HasOptimizationHistory, Mode=OneWay, Converter={StaticResource ReverseBoolToVisibilityConverter}}" />
                                        <ListView x:Name="OptimizationHistoryList" ItemsSource="{x:Bind ViewModel.OptimizationHistory}"
                                                  SelectedItem="{x:Bind ViewModel.SelectedOptimizationRun, Mode=TwoWay}"
                                                  SelectionMode="Single" MaxHeight="240" HorizontalContentAlignment="Stretch"
                                                  Visibility="{x:Bind ViewModel.HasOptimizationHistory, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="viewModels:OptimizationRunViewModel">
                                                    <StackPanel Spacing="4" Padding="4,8">
                                                        <TextBlock Text="{x:Bind CompletedText}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <StackPanel Spacing="12" Visibility="{x:Bind HasSelectedRun(ViewModel.SelectedOptimizationRun), Mode=OneWay}">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedOptimizationRun.DetailsSummary, Mode=OneWay}"
                                                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <ListView ItemsSource="{x:Bind ViewModel.SelectedOptimizationRun.Details, Mode=OneWay}" MaxHeight="300"
                                                      SelectionMode="None" HorizontalContentAlignment="Stretch">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="models:OptimizationExecutionItemRecord">
                                                        <StackPanel Spacing="4" Padding="4,8">
                                                            <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            <TextBlock Text="{x:Bind views:AIHubPage.ExecutionItemSummary(Action, State)}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Text="{x:Bind SourcePath}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind SourcePath}" FontSize="11" />
                                                            <TextBlock Text="{x:Bind DestinationPath}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind DestinationPath}" FontSize="11"
                                                                       Visibility="{x:Bind DestinationPath, Converter={StaticResource StringVisibilityConverter}}" />
                                                            <TextBlock Text="{x:Bind Reason}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                       Visibility="{x:Bind Reason, Converter={StaticResource StringVisibilityConverter}}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                            <Button x:Uid="AIHub_CopyOptimizationReportButton" Click="OnCopyOptimizationReportClick"
                                                    Style="{StaticResource KitActionButtonStyle}" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Expander>

                            <Expander x:Name="InventoryExpander" x:Uid="AIHub_Fluent_InventoryExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Border x:Name="InventoryPanel" AutomationProperties.AutomationId="InventoryPanel"
                                        Style="{StaticResource KitCardSurfaceStyle}" Padding="20,18">
                                    <StackPanel Spacing="14">
                                        <Grid x:Name="InventoryHeader" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                                            <StackPanel x:Name="InventoryTitle" Spacing="5">
                                                <TextBlock x:Uid="AIHub_Inventory_Title" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18"
                                                           AutomationProperties.HeadingLevel="Level2" />
                                                <TextBlock x:Uid="AIHub_Inventory_Description" FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <tkcontrols:WrapPanel x:Name="InventoryActions" Grid.Column="1" HorizontalAlignment="Right" HorizontalSpacing="8" VerticalSpacing="6">
                                                <Button x:Uid="AIHub_Inventory_AnalyzeButton" Command="{x:Bind ViewModel.AnalyzeStorageCommand}"
                                                        IsEnabled="{x:Bind ViewModel.CanAnalyzeStorage, Mode=OneWay}"
                                                        AutomationProperties.AutomationId="AIHub_AnalyzeStorage" Style="{StaticResource KitActionButtonStyle}" />
                                                <Button x:Uid="AIHub_Inventory_StopButton" Command="{x:Bind ViewModel.CancelInventoryCommand}"
                                                        IsEnabled="{x:Bind ViewModel.CanCancelInventory, Mode=OneWay}"
                                                        Visibility="{x:Bind ViewModel.IsInventoryScanning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        AutomationProperties.AutomationId="AIHub_CancelInventory" Style="{StaticResource KitActionButtonStyle}" />
                                            </tkcontrols:WrapPanel>
                                        </Grid>
                                        <ProgressBar IsIndeterminate="True" Style="{StaticResource KitProgressBarStyle}"
                                                     Visibility="{x:Bind ViewModel.IsInventoryScanning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                     AutomationProperties.Name="{x:Bind ViewModel.InventoryStatusText, Mode=OneWay}" />
                                        <TextBlock x:Name="InventoryStatusText" Text="{x:Bind ViewModel.InventoryStatusText, Mode=OneWay}" TextWrapping="Wrap"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasInventory, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid x:Name="InventoryMetricsGrid" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                                                <Border x:Name="InventoryObservedTile" Style="{StaticResource KitMetricTileBorderStyle}">
                                                    <StackPanel Spacing="5">
                                                        <TextBlock x:Uid="AIHub_Inventory_ObservedLabel" Style="{StaticResource KitMetricTileLabelStyle}" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="InventoryObservedSizeText" Text="{x:Bind ViewModel.Inventory.ObservedSizeText, Mode=OneWay}"
                                                                   Style="{StaticResource KitMetricTileValueStyle}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="InventoryRecentTile" Grid.Column="1" Style="{StaticResource KitMetricTileBorderStyle}">
                                                    <StackPanel Spacing="5">
                                                        <TextBlock x:Uid="AIHub_Inventory_RecentLabel" Style="{StaticResource KitMetricTileLabelStyle}" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="InventoryRecentSizeText" Text="{x:Bind ViewModel.Inventory.RecentSizeText, Mode=OneWay}"
                                                                   Style="{StaticResource KitMetricTileValueStyle}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="InventoryOldTile" Grid.Column="2" Style="{StaticResource KitMetricTileBorderStyle}">
                                                    <StackPanel Spacing="5">
                                                        <TextBlock x:Uid="AIHub_Inventory_OldLabel" Style="{StaticResource KitMetricTileLabelStyle}" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="InventoryOldSizeText" Text="{x:Bind ViewModel.Inventory.OldSizeText, Mode=OneWay}"
                                                                   Style="{StaticResource KitMetricTileValueStyle}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Uid="AIHub_Inventory_SizeCaveat" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="InventoryCoverageText" Text="{x:Bind ViewModel.Inventory.CoverageSummary, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" />
                                            <TextBlock x:Uid="AIHub_Inventory_PartialHint" TextWrapping="Wrap" FontSize="12"
                                                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                       Visibility="{x:Bind ViewModel.Inventory.IsPartial, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBlock Text="{x:Bind ViewModel.Inventory.SnapshotText, Mode=OneWay}" TextWrapping="Wrap" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Grid x:Name="InventoryFilters" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                                <TextBox x:Name="InventorySearchBox" x:Uid="AIHub_Inventory_SearchBox" AutomationProperties.AutomationId="InventorySearchBox"
                                                         Text="{x:Bind ViewModel.Inventory.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <ComboBox x:Name="InventoryFilterComboBox" x:Uid="AIHub_Inventory_FilterComboBox" Grid.Column="1" MinWidth="160"
                                                          AutomationProperties.AutomationId="InventoryFilterComboBox" HorizontalAlignment="Right"
                                                          ItemsSource="{x:Bind ViewModel.Inventory.FilterOptions}"
                                                          SelectedIndex="{x:Bind ViewModel.Inventory.FilterIndex, Mode=TwoWay}" />
                                            </Grid>
                                            <TextBlock Text="{x:Bind ViewModel.Inventory.FilterSummary, Mode=OneWay}" TextWrapping="Wrap" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <ListView x:Name="InventoryScopeList" AutomationProperties.AutomationId="InventoryScopeList"
                                                      ItemsSource="{x:Bind ViewModel.Inventory.FilteredRows, Mode=OneWay}"
                                                      ItemTemplate="{StaticResource OptimizationInventoryScopeTemplate}"
                                                      ItemContainerStyle="{StaticResource OptimizationItemContainerStyle}"
                                                      SelectionMode="None" HorizontalContentAlignment="Stretch" MaxHeight="600"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                            <TextBlock x:Name="InventoryNoMatches" x:Uid="AIHub_Inventory_NoMatches" TextWrapping="Wrap" FontSize="12"
                                                       Visibility="{x:Bind ViewModel.Inventory.HasFilteredRows, Mode=OneWay, Converter={StaticResource ReverseBoolToVisibilityConverter}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Expander>

                            <StackPanel Orientation="Horizontal" Spacing="6" Padding="2,0">
                                <FontIcon Glyph="&#xE8B7;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Uid="AIHub_Fluent_OptimizationBoundaryFooter" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <!-- TAB 2: TASK POLICIES -->
                        <StackPanel x:Name="TaskPolicyPanel" x:Load="False" Spacing="16" Visibility="Collapsed">
                            <InfoBar x:Name="AiTaskPolicyStatus"
                                     AutomationProperties.LiveSetting="Assertive"
                                     IsClosable="True"
                                     IsOpen="{x:Bind ViewModel.AiHub.IsStatusOpen, Mode=TwoWay}"
                                     Visibility="{x:Bind ViewModel.AiHub.IsStatusOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                     Message="{x:Bind ViewModel.AiHub.StatusMessage, Mode=OneWay}"
                                     Severity="{x:Bind ViewModel.AiHub.StatusSeverity, Mode=OneWay}" />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind ViewModel.TaskPolicyTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="20" AutomationProperties.HeadingLevel="Level2" />
                                    <TextBlock Text="{x:Bind ViewModel.TaskPolicyDescription, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Grid Grid.Column="1" VerticalAlignment="Top">
                                    <Border CornerRadius="4" Padding="8,3" Background="{ThemeResource BadgeSuccessBackgroundBrush}"
                                            Visibility="{x:Bind ViewModel.IsTaskPolicyClean, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{x:Bind ViewModel.AiHub.CurrentPolicyStatusText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}" AutomationProperties.LiveSetting="Polite" />
                                    </Border>
                                    <Border CornerRadius="4" Padding="8,3" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                            Visibility="{x:Bind ViewModel.AiHub.IsCurrentPolicyDirty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{x:Bind ViewModel.AiHub.CurrentPolicyStatusText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" AutomationProperties.LiveSetting="Polite" />
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- Each chain keeps its own draft until explicitly saved. -->
                            <tkcontrols:Segmented
                                x:Name="AiTaskPolicySegmented"
                                SelectedIndex="{x:Bind ViewModel.AiHub.TaskPolicyIndex, Mode=TwoWay}"
                                HorizontalAlignment="Left">
                                <tkcontrols:SegmentedItem x:Uid="AIHub_Segment_SecurityAudit" Content="Security audit" Icon="{ui:FontIcon Glyph=&#xE72E;}" />
                                <tkcontrols:SegmentedItem x:Uid="AIHub_Segment_Optimization" Content="Optimization" Icon="{ui:FontIcon Glyph=&#xE9F5;}" />
                            </tkcontrols:Segmented>

                            <Grid x:Name="TaskPolicyColumnsGrid" ColumnDefinitions="*,260" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16" SizeChanged="OnTaskPolicyColumnsSizeChanged">
                                <Border x:Name="TaskPolicyEditorCard" Style="{StaticResource KitCardSurfaceStyle}" Padding="20,18" VerticalAlignment="Top">
                                    <StackPanel Spacing="14">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock Text="{x:Bind ViewModel.TaskPolicyEditorHeading, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TaskPolicyCharCountText, Mode=OneWay}" FontSize="12"
                                                       FontFamily="{StaticResource KitMonoFontFamily}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </Grid>

                                        <TextBlock x:Uid="AIHub_TaskPolicyDraftHint" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Visibility="{x:Bind ViewModel.AiHub.IsCurrentPolicyDirty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <TextBox
                                            x:Name="AiTaskPolicyContentBox"
                                            x:Uid="AIHub_TaskPolicyContentBox"
                                            Loaded="OnTaskPolicyContentLoaded"
                                            Text="{x:Bind ViewModel.AiHub.CurrentPolicyContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            IsReadOnly="{x:Bind ViewModel.AiHub.CanEditPolicies, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                            AcceptsReturn="True"
                                            TextWrapping="Wrap"
                                            MinHeight="300"
                                            MaxHeight="520"
                                            MaxLength="64000"
                                            FontFamily="{StaticResource KitMonoFontFamily}"
                                            FontSize="12"
                                            CornerRadius="{StaticResource ControlCornerRadius}"
                                            ScrollViewer.VerticalScrollBarVisibility="Auto" />

                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <Button x:Uid="AiHub_ResetPolicyButton"
                                                    AutomationProperties.AutomationId="AIHub_ResetTaskPolicyButton"
                                                    Command="{x:Bind ViewModel.AiHub.ResetActivePolicyCommand}"
                                                    Style="{StaticResource SubtleButtonStyle}" Padding="8,5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE777;" FontSize="12" />
                                                    <TextBlock x:Uid="AiHub_ResetPolicyButtonText" Text="Reset to default" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                            <tkcontrols:WrapPanel Grid.Column="1" HorizontalSpacing="8" VerticalSpacing="8" HorizontalAlignment="Right">
                                                <Button x:Uid="AIHub_DiscardTaskPolicyButton"
                                                        Command="{x:Bind ViewModel.AiHub.DiscardActivePolicyCommand}"
                                                        Style="{StaticResource KitActionButtonStyle}" />
                                                <Button x:Uid="AiHub_SavePolicyButton"
                                                        AutomationProperties.AutomationId="AIHub_SaveTaskPolicyButton"
                                                        Style="{StaticResource KitPrimaryActionButtonStyle}"
                                                        Command="{x:Bind ViewModel.AiHub.SaveActivePolicyCommand}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE73E;" FontSize="12" />
                                                        <TextBlock x:Uid="AiHub_SavePolicyButtonText" Text="Save" FontSize="12" />
                                                    </StackPanel>
                                                </Button>
                                            </tkcontrols:WrapPanel>
                                        </Grid>

                                        <TextBlock x:Uid="AIHub_Fluent_PolicyFooterHint" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                                        <Expander x:Uid="AIHub_Fluent_PolicyLocation" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                  Background="Transparent" BorderThickness="0">
                                            <Border CornerRadius="{StaticResource ControlCornerRadius}" Padding="8,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                                <TextBlock Text="{x:Bind ViewModel.AiHub.CurrentPolicyFilePath, Mode=OneWay}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           FontFamily="{StaticResource KitMonoFontFamily}"
                                                           ToolTipService.ToolTip="{x:Bind ViewModel.AiHub.CurrentPolicyFilePath, Mode=OneWay}"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            </Border>
                                        </Expander>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="TaskPolicyScopeCard" Grid.Column="1" Style="{StaticResource KitCardSurfaceStyle}" Padding="18,16" VerticalAlignment="Top"
                                        Background="{ThemeResource SectionAppearanceTintBrush}">
                                    <StackPanel Spacing="12">
                                        <TextBlock x:Uid="AIHub_Fluent_PolicyScopeTitle" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind ViewModel.TaskPolicyScopePrimaryText, Mode=OneWay}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                            <TextBlock x:Uid="AIHub_Fluent_PolicyScopeBoundary" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Dimming scrim over page content when right-side FindingDetailsPane is open -->
            <Border x:Name="DetailsBackdropScrim" Grid.RowSpan="3" Margin="-24,0,0,0"
                    Background="{ThemeResource SmokeFillColorDefaultBrush}"
                    Visibility="Collapsed" IsHitTestVisible="True" Tapped="OnDetailsBackdropTapped" Canvas.ZIndex="10" />
            </Grid>
        </SplitView>
    </Grid>
</local:NavigablePage>
