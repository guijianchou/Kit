                                                        Click="OnCopyAiReportClick"
                                                        AutomationProperties.AutomationId="AIHub_CopyAiReportButton"
                                                        AutomationProperties.Name="{x:Bind ViewModel.CopyReportLabel}"
                                                        ToolTipService.ToolTip="{x:Bind ViewModel.CopyAiReportHint}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                                        <TextBlock Text="{x:Bind ViewModel.CopyReportLabel}" FontSize="12" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.AiReportFindings, Mode=OneWay}">
