<UserControl
    x:Class="Kit.Settings.UI.Views.FindingDetailsPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Kit.Settings.UI.Services"
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
    AutomationProperties.AutomationId="AIHub_FindingDetailsPane"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    IsTabStop="False"
    FontFamily="{ThemeResource KitUiFontFamily}"
    FontSize="{ThemeResource KitFontSize14}" services:TypographyResources.BaseFontSize="14">
    <UserControl.Resources>
        <Style x:Key="SeverityHighTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource KitUiFontFamily}" />
            <Setter Property="Foreground" Value="{ThemeResource BadgeCriticalForegroundBrush}" />
            <Setter Property="FontSize" Value="{ThemeResource KitFontSize12}" />
        <Setter Property="services:TypographyResources.BaseFontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SeverityMediumTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource KitUiFontFamily}" />
            <Setter Property="Foreground" Value="{ThemeResource BadgeWarningForegroundBrush}" />
            <Setter Property="FontSize" Value="{ThemeResource KitFontSize12}" />
        <Setter Property="services:TypographyResources.BaseFontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SeverityLowTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource KitUiFontFamily}" />
            <Setter Property="Foreground" Value="{ThemeResource BadgeInfoForegroundBrush}" />
            <Setter Property="FontSize" Value="{ThemeResource KitFontSize12}" />
        <Setter Property="services:TypographyResources.BaseFontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Border Background="Transparent"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
        <Grid Padding="20" RowSpacing="16" RowDefinitions="Auto,*,Auto" TabFocusNavigation="Cycle">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:Uid="AIHub_PageTitle" services:RuntimeLocalization.Uid="AIHub_PageTitle" FontSize="{ThemeResource KitFontSize11}" services:TypographyResources.BaseFontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="PaneTitleText" Style="{StaticResource BodyStrongTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2" TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="CloseDetailsButton" Grid.Column="1" VerticalAlignment="Center"
                        Style="{StaticResource KitIconButtonStyle}" Click="OnCloseClick"
                        AutomationProperties.AutomationId="AIHub_CloseFindingDetails">
                    <FontIcon Glyph="&#xE711;" FontSize="14" AutomationProperties.AccessibilityView="Raw" />
                </Button>
            </Grid>

            <ScrollViewer x:Name="DetailsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="18" Padding="0,0,4,4">
                    <tkcontrols:WrapPanel HorizontalSpacing="8" VerticalSpacing="6">
                        <Border x:Name="SeverityBadge" Style="{StaticResource KitSeverityLowBadgeStyle}">
                            <TextBlock x:Name="SeverityText" Style="{StaticResource SeverityLowTextStyle}" />
                        </Border>
                        <Border CornerRadius="{StaticResource ControlCornerRadius}" Padding="8,3" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock x:Name="CategoryText" FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <Border x:Name="OccurrencesBadge" CornerRadius="{StaticResource ControlCornerRadius}" Padding="8,3" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock x:Name="OccurrencesText" FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontFamily="{StaticResource KitMonoFontFamily}" Typography.NumeralAlignment="Tabular" />
                        </Border>
                    </tkcontrols:WrapPanel>

                    <StackPanel Spacing="8">
                        <TextBlock x:Name="FindingTitleText" Style="{StaticResource SubtitleTextBlockStyle}"
                                   AutomationProperties.HeadingLevel="Level3" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Border Style="{StaticResource KitSubtleSurfaceStyle}" Padding="12">
                        <Grid RowSpacing="8" ColumnSpacing="12" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                            <TextBlock x:Name="EventIdLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12" />
                            <TextBlock x:Name="EventIdText" Grid.Column="1" FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12" FontFamily="{StaticResource KitMonoFontFamily}"
                                       Typography.NumeralAlignment="Tabular" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock x:Name="SourceLabel" Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12" />
                            <TextBlock x:Name="SourceText" Grid.Row="1" Grid.Column="1" FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock x:Name="TimestampLabel" Grid.Row="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12" />
                            <TextBlock x:Name="TimestampText" Grid.Row="2" Grid.Column="1" FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12" FontFamily="{StaticResource KitMonoFontFamily}"
                                       Typography.NumeralAlignment="Tabular" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock x:Name="RangeLabel" Grid.Row="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12" />
                            <TextBlock x:Name="RangeText" Grid.Row="3" Grid.Column="1" FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </Grid>
                    </Border>

                    <StackPanel x:Name="ReasonSection" Spacing="6">
                        <TextBlock x:Name="ReasonLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="ReasonText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Border CornerRadius="8" Background="{ThemeResource KitAccentTintBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="3,*">
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="8,0,0,8" />
                            <StackPanel Grid.Column="1" Spacing="12" Padding="12,10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock x:Uid="FindingDetails_Recommendation" services:RuntimeLocalization.Uid="FindingDetails_Recommendation" Style="{StaticResource BodyStrongTextBlockStyle}"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock x:Name="PlanSourceText" TextWrapping="Wrap" FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Spacing="6">
                                    <TextBlock x:Name="CheckPlanLabel" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="RecommendationText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock x:Name="ConditionalActionLabel" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ConditionalActionText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock x:Name="VerificationLabel" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="VerificationText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <Border Style="{StaticResource KitSubtleSurfaceStyle}" Padding="10">
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Name="RecoveryLabel" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="RecoveryText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </Border>
                                <Expander x:Name="PreviousAdviceExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <TextBlock x:Name="PreviousAdviceText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </Expander>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Expander x:Name="EvidenceExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <Button x:Name="CopyEvidenceButton" HorizontalAlignment="Right" Click="OnCopyEvidenceClick"
                                    Style="{StaticResource SubtleButtonStyle}" Padding="8,4"
                                    AutomationProperties.AutomationId="AIHub_CopyFindingEvidence">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="12" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock x:Name="CopyEvidenceLabel" FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12" />
                                </StackPanel>
                            </Button>
                            <Border Style="{StaticResource KitRecessedSurfaceStyle}" Padding="10,8">
                                <TextBlock x:Name="EvidenceText" FontFamily="{StaticResource KitMonoFontFamily}" FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </Border>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Spacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock x:Name="PositionText" FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button x:Name="PreviousButton" Style="{StaticResource KitIconButtonStyle}" Click="OnPreviousClick"
                                AutomationProperties.AutomationId="AIHub_PreviousFinding">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Menu" Key="Up" />
                            </Button.KeyboardAccelerators>
                            <FontIcon Glyph="&#xE76B;" FontSize="14" AutomationProperties.AccessibilityView="Raw" />
                        </Button>
                        <Button x:Name="NextButton" Style="{StaticResource KitIconButtonStyle}" Click="OnNextClick"
                                AutomationProperties.AutomationId="AIHub_NextFinding">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Menu" Key="Down" />
                            </Button.KeyboardAccelerators>
                            <FontIcon Glyph="&#xE76C;" FontSize="14" AutomationProperties.AccessibilityView="Raw" />
                        </Button>
                    </StackPanel>
                </Grid>
                <tkcontrols:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                    <Button x:Name="CopyButton" Click="OnCopyClick" Style="{StaticResource KitActionButtonStyle}"
                            AutomationProperties.AutomationId="AIHub_CopyFindingSummary">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE8C8;" FontSize="13" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock x:Name="CopyLabel" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AnalyzeButton" Click="OnAnalyzeClick" Style="{StaticResource KitPrimaryActionButtonStyle}"
                            AutomationProperties.AutomationId="AIHub_AnalyzeFindingRange">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE9D9;" FontSize="13" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock x:Name="AnalyzeLabel" />
                        </StackPanel>
                    </Button>
                </tkcontrols:WrapPanel>
                <TextBlock x:Name="ActionHintText" FontSize="{ThemeResource KitFontSize11}" services:TypographyResources.BaseFontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="CopyFeedbackText" Visibility="Collapsed" FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
