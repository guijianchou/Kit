<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <OutputPath>$(RepoRoot)$(Platform)\$(Configuration)\tests\Updater\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);SA0001;SA1200;SA1201;SA1202;SA1309;SA1402;SA1516;SA1600;SA1633;SA1649;CA1303;CA1305;CA2007;CA1861</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest" />
    <Compile Include="..\Kit.Updater\*.cs" Exclude="..\Kit.Updater\Program.cs" Link="Production\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
