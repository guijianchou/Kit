                                             Style="{StaticResource KitProgressBarStyle}"
                                             AutomationProperties.Name="{x:Bind ViewModel.SidebarWorkflowTooltip, Mode=OneWay}" />
                                <!-- Both messages can contain a complete native failure.
                                     An Auto column would take the available width away
                                     from the wrapping status and create a very tall card. -->
                                <ScrollViewer x:Name="AuditWorkflowDetailsScroll" MaxHeight="144"
                                              HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                                              HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentStageText, Mode=OneWay}" FontSize="12"
                                                   FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="AuditWorkflowStatus" Text="{x:Bind ViewModel.AuditStatusText, Mode=OneWay}"
                                                   FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="AuditWorkflowAiResult" Text="{x:Bind ViewModel.AiAnalysisRanText, Mode=OneWay}"
                                                   Visibility="{x:Bind ViewModel.AiAnalysisRanText, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}"
                                                   FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                            <Border Style="{StaticResource KitCardSurfaceStyle}" Padding="24,22"
                                    Background="{ThemeResource KitHeroGradientBrush}">
                                <Grid x:Name="AuditOverviewGrid" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="14">
                                    <Grid x:Name="AuditScoreCard" Width="96" Height="96" VerticalAlignment="Center">
                                        <Ellipse Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" StrokeThickness="6" />
                                        <ProgressRing IsIndeterminate="False" Value="{x:Bind HealthScoreToDouble(ViewModel.HealthScore), Mode=OneWay}" Maximum="100"
                                                      Width="96" Height="96" Style="{x:Bind HealthScoreRingStyle(ViewModel.HealthScore), Mode=OneWay}"
                                                      Visibility="{x:Bind ViewModel.HasAuditData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                                            <TextBlock x:Name="AuditScoreText" Text="{x:Bind ViewModel.HealthScoreText, Mode=OneWay}" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind ViewModel.HealthScoreLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel x:Name="AuditScoreSummary" Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.OverviewAuditTimestampText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind ViewModel.OverviewHeadline, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind ViewModel.OverviewDescription, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                        <tkcontrols:WrapPanel HorizontalSpacing="10" VerticalSpacing="6" Margin="0,2,0,0">
                                            <HyperlinkButton x:Uid="AIHub_Fluent_PriorityButton" Click="OnPriorityFindingClick" Padding="0" FontSize="12"
                                                             AutomationProperties.Name="{x:Bind ViewModel.AuditPriorityTitle, Mode=OneWay}"
                                                             Visibility="{x:Bind ViewModel.HasAuditPriority, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBlock Text="{x:Bind ViewModel.WindowText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="·" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                                                       Visibility="{x:Bind ViewModel.HasAuditData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBlock Text="{x:Bind ViewModel.EventCountText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </tkcontrols:WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid x:Name="AuditCommandHeader" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10">
