                                            <ResourceDictionary>
                                                <ResourceDictionary.ThemeDictionaries>
                                                    <ResourceDictionary x:Key="Default">
                                                        <SolidColorBrush x:Key="SplitButtonBackground" Color="{ThemeResource SystemAccentColorLight2}" />
                                                        <SolidColorBrush x:Key="SplitButtonBackgroundPointerOver" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.9" />
                                                        <SolidColorBrush x:Key="SplitButtonBackgroundPressed" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.8" />
                                                        <SolidColorBrush x:Key="SplitButtonBackgroundDisabled" Color="{ThemeResource ControlFillColorDisabled}" />
                                                        <SolidColorBrush x:Key="SplitButtonForeground" Color="{ThemeResource TextOnAccentFillColorPrimary}" />
                                                        <SolidColorBrush x:Key="SplitButtonForegroundPointerOver" Color="{ThemeResource TextOnAccentFillColorPrimary}" />
                                                        <SolidColorBrush x:Key="SplitButtonForegroundPressed" Color="{ThemeResource TextOnAccentFillColorPrimary}" />
                                                        <SolidColorBrush x:Key="SplitButtonForegroundDisabled" Color="{ThemeResource TextFillColorSecondary}" />
                                                        <SolidColorBrush x:Key="SplitButtonForegroundSecondary" Color="{ThemeResource TextOnAccentFillColorPrimary}" />
                                                        <SolidColorBrush x:Key="SplitButtonForegroundSecondaryPressed" Color="{ThemeResource TextOnAccentFillColorPrimary}" />
                                                        <SolidColorBrush x:Key="SplitButtonBorderBrush" Color="{ThemeResource ControlStrokeColorOnAccentDefault}" />
                                                        <SolidColorBrush x:Key="SplitButtonBorderBrushPointerOver" Color="{ThemeResource ControlStrokeColorOnAccentDefault}" />
                                                        <SolidColorBrush x:Key="SplitButtonBorderBrushPressed" Color="{ThemeResource ControlStrokeColorOnAccentDefault}" />
                                                        <SolidColorBrush x:Key="SplitButtonBorderBrushDisabled" Color="{ThemeResource ControlStrokeColorOnAccentDefault}" />
                                                        <SolidColorBrush x:Key="SplitButtonBorderBrushDivider" Color="{ThemeResource ControlStrokeColorOnAccentTertiary}" />
                                                    </ResourceDictionary>
                                                    <ResourceDictionary x:Key="Light">
                                                        <SolidColorBrush x:Key="SplitButtonBackground" Color="{ThemeResource SystemAccentColorDark1}" />
                                                        <SolidColorBrush x:Key="SplitButtonBackgroundPointerOver" Color="{ThemeResource SystemAccentColorDark1}" Opacity="0.9" />
                                                        <SolidColorBrush x:Key="SplitButtonBackgroundPressed" Color="{ThemeResource SystemAccentColorDark2}" />
                                                        <SolidColorBrush x:Key="SplitButtonBackgroundDisabled" Color="{ThemeResource ControlFillColorDisabled}" />
                                                        <SolidColorBrush x:Key="SplitButtonForeground" Color="{ThemeResource TextOnAccentFillColorPrimary}" />
                                                        <SolidColorBrush x:Key="SplitButtonForegroundPointerOver" Color="{ThemeResource TextOnAccentFillColorPrimary}" />
                                                        <SolidColorBrush x:Key="SplitButtonForegroundPressed" Color="{ThemeResource TextOnAccentFillColorPrimary}" />
                                                        <SolidColorBrush x:Key="SplitButtonForegroundDisabled" Color="{ThemeResource TextFillColorSecondary}" />
                                                        <SolidColorBrush x:Key="SplitButtonForegroundSecondary" Color="{ThemeResource TextOnAccentFillColorPrimary}" />
                                                        <SolidColorBrush x:Key="SplitButtonForegroundSecondaryPressed" Color="{ThemeResource TextOnAccentFillColorPrimary}" />
                                                        <SolidColorBrush x:Key="SplitButtonBorderBrush" Color="{ThemeResource ControlStrokeColorOnAccentDefault}" />
                                                        <SolidColorBrush x:Key="SplitButtonBorderBrushPointerOver" Color="{ThemeResource ControlStrokeColorOnAccentDefault}" />
                                                        <SolidColorBrush x:Key="SplitButtonBorderBrushPressed" Color="{ThemeResource ControlStrokeColorOnAccentDefault}" />
                                                        <SolidColorBrush x:Key="SplitButtonBorderBrushDisabled" Color="{ThemeResource ControlStrokeColorOnAccentDefault}" />
                                                        <SolidColorBrush x:Key="SplitButtonBorderBrushDivider" Color="{ThemeResource ControlStrokeColorOnAccentTertiary}" />
                                                    </ResourceDictionary>
                                                    <ResourceDictionary x:Key="HighContrast">
                                                        <SolidColorBrush x:Key="SplitButtonBackground" Color="{ThemeResource SystemColorHighlightColor}" />
                                                        <SolidColorBrush x:Key="SplitButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                                                        <SolidColorBrush x:Key="SplitButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                                                        <SolidColorBrush x:Key="SplitButtonBackgroundDisabled" Color="{ThemeResource SystemColorButtonFaceColor}" />
                                                        <SolidColorBrush x:Key="SplitButtonForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                                        <SolidColorBrush x:Key="SplitButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                                        <SolidColorBrush x:Key="SplitButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                                        <SolidColorBrush x:Key="SplitButtonForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
                                                        <SolidColorBrush x:Key="SplitButtonForegroundSecondary" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                                        <SolidColorBrush x:Key="SplitButtonForegroundSecondaryPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                                        <SolidColorBrush x:Key="SplitButtonBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                                                        <SolidColorBrush x:Key="SplitButtonBorderBrushPointerOver" Color="{ThemeResource SystemColorButtonTextColor}" />
                                                        <SolidColorBrush x:Key="SplitButtonBorderBrushPressed" Color="{ThemeResource SystemColorButtonTextColor}" />
                                                        <SolidColorBrush x:Key="SplitButtonBorderBrushDisabled" Color="{ThemeResource SystemColorButtonTextColor}" />
                                                        <SolidColorBrush x:Key="SplitButtonBorderBrushDivider" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                                    </ResourceDictionary>
                                                </ResourceDictionary.ThemeDictionaries>
                                            </ResourceDictionary>
                                        </SplitButton.Resources>
                                        <SplitButton.Content>
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <FontIcon Glyph="&#xE721;" FontSize="13" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedScanLabel, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </SplitButton.Content>
                                        <SplitButton.Flyout>
                                            <Flyout>
                                                <StackPanel Spacing="14" Width="270">
                                                    <TextBlock Text="{x:Bind ViewModel.ScanOptionsLabel}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                    <ComboBox x:Uid="AIHub_Fluent_ScanMode" SelectedIndex="{x:Bind ViewModel.SelectedScanModeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                                        <ComboBoxItem Content="{x:Bind ViewModel.FastScanLabel}" />
                                                        <ComboBoxItem Content="{x:Bind ViewModel.FullScanLabel}" />
                                                    </ComboBox>
                                                    <ComboBox x:Uid="AIHub_Fluent_ScanRange" SelectedIndex="{x:Bind ViewModel.FullScanRangeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.IsFullScanSelected, Mode=OneWay}">
                                                        <ComboBoxItem Content="{x:Bind ViewModel.RangeOption1DayLabel}" />
                                                        <ComboBoxItem Content="{x:Bind ViewModel.RangeOption2DaysLabel}" />
                                                        <ComboBoxItem Content="{x:Bind ViewModel.RangeOption1WeekLabel}" />
                                                    </ComboBox>
                                                    <CheckBox x:Uid="AIHub_Fluent_FullChannels" IsChecked="{x:Bind ViewModel.IsFullAuditMode, Mode=OneWay}" Click="OnFullAuditCheckClick" IsEnabled="{x:Bind ViewModel.CanUseFullAuditMode}" />
                                                    <TextBlock Text="{x:Bind ViewModel.ScopeHint, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock x:Uid="AIHub_Fluent_NextScanHint" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Flyout>
                                        </SplitButton.Flyout>
                                    </SplitButton>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedScanRangeText, Mode=OneWay}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,2,0" />
                                    <Button Command="{x:Bind ViewModel.DeepAnalyzeCommand}" AutomationProperties.AutomationId="AIHub_DeepAnalyzeButton"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.DeepAnalyzeHint}" Style="{StaticResource KitActionButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE9D9;" FontSize="13" />
                                            <TextBlock Text="{x:Bind ViewModel.DeepAnalyzeLabel}" />
                                        </StackPanel>
                                    </Button>
                                </tkcontrols:WrapPanel>
                                <DropDownButton x:Name="AuditHistoryDropDown" Grid.Column="1"
                                                IsEnabled="{x:Bind ViewModel.CanConfigureAudit, Mode=OneWay}"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="{x:Bind ViewModel.AuditHistoryLabel, Mode=OneWay}"
                                                AutomationProperties.AutomationId="AIHub_AuditHistoryButton">
                                    <DropDownButton.Content>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE81C;" FontSize="13" />
                                            <TextBlock Text="{x:Bind ViewModel.AuditHistoryLabel, Mode=OneWay}" FontSize="13" />
