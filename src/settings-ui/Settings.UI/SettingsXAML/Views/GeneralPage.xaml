                                                    PlaceholderText="Enter API key" />
                                            </tkcontrols:SettingsCard>
                                            <tkcontrols:SettingsCard x:Uid="AiHub_MainEndpoint_ApiModeCard" services:RuntimeLocalization.Uid="AiHub_MainEndpoint_ApiModeCard" Header="API mode" Description="Select a preset or enter a custom API mode identifier." SizeChanged="SettingEditorCard_SizeChanged">
                                                <controls:EditableValueComboBox
                                                    x:Uid="AiHub_MainEndpoint_ApiModeComboBox" services:RuntimeLocalization.Uid="AiHub_MainEndpoint_ApiModeComboBox"
                                                    AutomationProperties.AutomationId="AiHub_MainEndpoint_ApiModeComboBox"
                                                    Width="280"
                                                    IsEditable="True"
                                                    ItemsSource="{x:Bind ViewModel.AiServices.MainEndpoint.ModeSuggestions, Mode=OneWay}"
                                                    Value="{x:Bind ViewModel.AiServices.MainEndpoint.Mode, Mode=TwoWay}" />
                                            </tkcontrols:SettingsCard>
                                            <tkcontrols:SettingsCard x:Uid="AiHub_MainEndpoint_ModelCard" services:RuntimeLocalization.Uid="AiHub_MainEndpoint_ModelCard" Header="Model" SizeChanged="SettingEditorCard_SizeChanged">
                                                <TextBox
                                                    x:Uid="AiHub_ModelBox" services:RuntimeLocalization.Uid="AiHub_ModelBox"
                                                    AutomationProperties.AutomationId="AiHub_MainEndpoint_ModelBox"
                                                    Width="280"
                                                    PlaceholderText="gpt-6-luna"
                                                    Text="{x:Bind ViewModel.AiServices.MainEndpoint.Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </tkcontrols:SettingsCard>
                                            <tkcontrols:SettingsCard x:Uid="AiHub_MainEndpoint_ReasoningCard" services:RuntimeLocalization.Uid="AiHub_MainEndpoint_ReasoningCard" Header="Reasoning effort" Description="Reasoning level passed to supported models." SizeChanged="SettingEditorCard_SizeChanged">
                                                <controls:EditableValueComboBox
                                                    x:Uid="AiHub_MainEndpoint_EffortComboBox" services:RuntimeLocalization.Uid="AiHub_MainEndpoint_EffortComboBox"
                                                    AutomationProperties.AutomationId="AiHub_MainEndpoint_EffortComboBox"
                                                    Width="280"
                                                    IsEditable="True"
                                                    ItemsSource="{x:Bind ViewModel.AiServices.MainEndpoint.EffortSuggestions, Mode=OneWay}"
                                                    Value="{x:Bind ViewModel.AiServices.MainEndpoint.Effort, Mode=TwoWay}" />
                                            </tkcontrols:SettingsCard>
                                            <tkcontrols:SettingsCard x:Uid="AiHub_ContextWindowCard" services:RuntimeLocalization.Uid="AiHub_ContextWindowCard" Header="Context window" Description="Maximum context size in tokens (default: 256,000)." SizeChanged="SettingEditorCard_SizeChanged">
                                                <StackPanel Width="280" Spacing="6">
                                                    <NumberBox
                                                        x:Uid="AiHub_ContextWindowBox" services:RuntimeLocalization.Uid="AiHub_ContextWindowBox"
                                                        AutomationProperties.AutomationId="AiHub_MainEndpoint_ContextWindowBox"
                                                        Minimum="1024"
                                                        Maximum="2147483647"
                                                        SmallChange="1024"
                                                        LargeChange="8192"
                                                        SpinButtonPlacementMode="Compact"
                                                        Value="{x:Bind ViewModel.AiServices.MainEndpoint.ContextWindowTokens, Mode=TwoWay}" />
                                                    <TextBlock
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                        TextWrapping="Wrap"
                                                        Text="{x:Bind ViewModel.AiServices.MainEndpoint.ContextWindowError, Mode=OneWay}"
                                                        Visibility="{x:Bind ViewModel.AiServices.MainEndpoint.ContextWindowErrorVisibility, Mode=OneWay}" />
                                                </StackPanel>
                                            </tkcontrols:SettingsCard>
                                        </tkcontrols:SettingsExpander.Items>
                                    </tkcontrols:SettingsExpander>

                                    <!-- Fallback endpoint. Filling in its URL turns the fallback on when saved. -->
                                    <tkcontrols:SettingsExpander
                                        x:Name="AiFallbackEndpointExpander"
                                        x:Uid="AiHub_FallbackEndpointExpander" services:RuntimeLocalization.Uid="AiHub_FallbackEndpointExpander"
                                        Description="{x:Bind ViewModel.AiServices.FallbackEndpoint.EndpointSummary, Mode=OneWay}"
                                        Header="Fallback endpoint"
                                        HeaderIcon="{ui:FontIcon Glyph=&#xE8AB;}"
                                        IsExpanded="False">
                                        <tkcontrols:WrapPanel
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal" VerticalSpacing="8"
                                            HorizontalSpacing="12">
                                            <TextBlock
                                                MaxWidth="180"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind ViewModel.AiServices.FallbackEndpoint.ModelSummary, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind ViewModel.AiServices.FallbackEndpoint.ModelSummary, Mode=OneWay}" />
                                            <Button
                                                x:Uid="AiHub_TestConnectionButton" services:RuntimeLocalization.Uid="AiHub_TestConnectionButton"
                                                AutomationProperties.AutomationId="AiHub_FallbackEndpoint_TestConnectionButton"
                                                Style="{StaticResource KitActionButtonStyle}"
                                                    Command="{x:Bind ViewModel.AiServices.FallbackEndpoint.TestCommand, Mode=OneWay}"
                                                Content="Test connection" />
                                        </tkcontrols:WrapPanel>
                                        <tkcontrols:SettingsExpander.Items>
                                            <tkcontrols:SettingsCard x:Uid="AiHub_FallbackEndpoint_UrlCard" services:RuntimeLocalization.Uid="AiHub_FallbackEndpoint_UrlCard" Header="Endpoint URL" SizeChanged="SettingEditorCard_SizeChanged">
                                                <TextBox
                                                    x:Uid="AiHub_EndpointUrlBox" services:RuntimeLocalization.Uid="AiHub_EndpointUrlBox"
                                                    AutomationProperties.AutomationId="AiHub_FallbackEndpoint_UrlBox"
                                                    Width="280"
                                                    PlaceholderText="https://api.example.com"
                                                    Text="{x:Bind ViewModel.AiServices.FallbackEndpoint.BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </tkcontrols:SettingsCard>
                                            <tkcontrols:SettingsCard x:Uid="AiHub_FallbackEndpoint_ApiKeyCard" services:RuntimeLocalization.Uid="AiHub_FallbackEndpoint_ApiKeyCard" Header="API key" SizeChanged="SettingEditorCard_SizeChanged">
                                                <PasswordBox
                                                    x:Name="AiFallbackApiKeyBox"
                                                    x:Uid="AiHub_FallbackEndpoint_ApiKeyBox" services:RuntimeLocalization.Uid="AiHub_FallbackEndpoint_ApiKeyBox"
                                                    AutomationProperties.AutomationId="AiHub_FallbackEndpoint_ApiKeyBox"
                                                    Width="280"
                                                    Password="{x:Bind ViewModel.AiServices.FallbackEndpoint.ApiKey, Mode=OneWay}"
                                                    PasswordChanged="AiFallbackApiKeyBox_PasswordChanged"
                                                    PlaceholderText="Enter API key" />
                                            </tkcontrols:SettingsCard>
                                            <tkcontrols:SettingsCard x:Uid="AiHub_FallbackEndpoint_ApiModeCard" services:RuntimeLocalization.Uid="AiHub_FallbackEndpoint_ApiModeCard" Header="API mode" Description="Select a preset or enter a custom API mode identifier." SizeChanged="SettingEditorCard_SizeChanged">
                                                <controls:EditableValueComboBox
                                                    x:Uid="AiHub_FallbackEndpoint_ApiModeComboBox" services:RuntimeLocalization.Uid="AiHub_FallbackEndpoint_ApiModeComboBox"
                                                    AutomationProperties.AutomationId="AiHub_FallbackEndpoint_ApiModeComboBox"
                                                    Width="280"
                                                    IsEditable="True"
                                                    ItemsSource="{x:Bind ViewModel.AiServices.FallbackEndpoint.ModeSuggestions, Mode=OneWay}"
                                                    Value="{x:Bind ViewModel.AiServices.FallbackEndpoint.Mode, Mode=TwoWay}" />
                                            </tkcontrols:SettingsCard>
                                            <tkcontrols:SettingsCard x:Uid="AiHub_FallbackEndpoint_ModelCard" services:RuntimeLocalization.Uid="AiHub_FallbackEndpoint_ModelCard" Header="Model" SizeChanged="SettingEditorCard_SizeChanged">
                                                <TextBox
                                                    x:Uid="AiHub_ModelBox" services:RuntimeLocalization.Uid="AiHub_ModelBox"
                                                    AutomationProperties.AutomationId="AiHub_FallbackEndpoint_ModelBox"
                                                    Width="280"
                                                    PlaceholderText="gpt-6-luna"
                                                    Text="{x:Bind ViewModel.AiServices.FallbackEndpoint.Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </tkcontrols:SettingsCard>
                                            <tkcontrols:SettingsCard x:Uid="AiHub_FallbackEndpoint_ReasoningCard" services:RuntimeLocalization.Uid="AiHub_FallbackEndpoint_ReasoningCard" Header="Reasoning effort" Description="Reasoning level passed to supported models." SizeChanged="SettingEditorCard_SizeChanged">
                                                <controls:EditableValueComboBox
                                                    x:Uid="AiHub_FallbackEndpoint_EffortComboBox" services:RuntimeLocalization.Uid="AiHub_FallbackEndpoint_EffortComboBox"
                                                    AutomationProperties.AutomationId="AiHub_FallbackEndpoint_EffortComboBox"
                                                    Width="280"
                                                    IsEditable="True"
                                                    ItemsSource="{x:Bind ViewModel.AiServices.FallbackEndpoint.EffortSuggestions, Mode=OneWay}"
                                                    Value="{x:Bind ViewModel.AiServices.FallbackEndpoint.Effort, Mode=TwoWay}" />
                                            </tkcontrols:SettingsCard>
                                            <tkcontrols:SettingsCard x:Uid="AiHub_ContextWindowCard" services:RuntimeLocalization.Uid="AiHub_ContextWindowCard" Header="Context window" Description="Maximum context size in tokens (default: 256,000)." SizeChanged="SettingEditorCard_SizeChanged">
                                                <StackPanel Width="280" Spacing="6">
                                                    <NumberBox
                                                        x:Uid="AiHub_ContextWindowBox" services:RuntimeLocalization.Uid="AiHub_ContextWindowBox"
                                                        AutomationProperties.AutomationId="AiHub_FallbackEndpoint_ContextWindowBox"
                                                        Minimum="1024"
                                                        Maximum="2147483647"
                                                        SmallChange="1024"
                                                        LargeChange="8192"
                                                        SpinButtonPlacementMode="Compact"
                                                        Value="{x:Bind ViewModel.AiServices.FallbackEndpoint.ContextWindowTokens, Mode=TwoWay}" />
                                                    <TextBlock
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                        TextWrapping="Wrap"
                                                        Text="{x:Bind ViewModel.AiServices.FallbackEndpoint.ContextWindowError, Mode=OneWay}"
                                                        Visibility="{x:Bind ViewModel.AiServices.FallbackEndpoint.ContextWindowErrorVisibility, Mode=OneWay}" />
                                                </StackPanel>
                                            </tkcontrols:SettingsCard>
                                            <tkcontrols:SettingsCard x:Uid="AiHub_ClearFallbackCard" services:RuntimeLocalization.Uid="AiHub_ClearFallbackCard" Header="Clear fallback endpoint">
                                                <Button
                                                    x:Uid="AiHub_ClearFallbackButton" services:RuntimeLocalization.Uid="AiHub_ClearFallbackButton"
                                                    AutomationProperties.AutomationId="AiHub_ClearFallbackButton"
                                                    Style="{StaticResource KitActionButtonStyle}"
                                                    Command="{x:Bind ViewModel.AiServices.ClearFallbackCommand}"
                                                    Content="Clear" />
                                            </tkcontrols:SettingsCard>
                                        </tkcontrols:SettingsExpander.Items>
                                    </tkcontrols:SettingsExpander>

                                    <!-- Unsaved endpoint edits. The engine and other plugins only read the saved
                                         configuration, so pending edits are called out instead of silently dropped. -->
                                    <InfoBar
                                        x:Name="AiUnsavedEndpointsCard"
                                        Title="{x:Bind UnsavedEndpointsTitle}"
                                        Message="{x:Bind UnsavedEndpointsMessage}"
                                        IsClosable="False"
                                        IsOpen="{x:Bind ViewModel.AiServices.HasUnsavedEndpointChanges, Mode=OneWay}"
                                        Severity="Warning"
                                        Visibility="{x:Bind ViewModel.AiServices.HasUnsavedEndpointChanges, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <tkcontrols:WrapPanel Margin="0,0,0,12" Orientation="Horizontal" VerticalSpacing="8" HorizontalSpacing="8">
                                            <Button
                                                x:Uid="AiHub_DiscardEndpointsButton" services:RuntimeLocalization.Uid="AiHub_DiscardEndpointsButton"
                                                AutomationProperties.AutomationId="AiHub_DiscardEndpointsButton"
                                                Style="{StaticResource KitActionButtonStyle}"
                                                Command="{x:Bind ViewModel.AiServices.DiscardEndpointChangesCommand}" />
                                            <Button
                                                x:Uid="AiHub_SaveEndpointsButton" services:RuntimeLocalization.Uid="AiHub_SaveEndpointsButton"
                                                AutomationProperties.AutomationId="AiHub_SaveEndpointsButton"
                                                Command="{x:Bind ViewModel.AiServices.SaveEndpointsCommand}"
                                                Style="{StaticResource KitPrimaryActionButtonStyle}" />
                                        </tkcontrols:WrapPanel>
                                    </InfoBar>

                                </StackPanel>

                                <tkcontrols:SettingsExpander
                                    x:Uid="AiHub_SubagentsExpander" services:RuntimeLocalization.Uid="AiHub_SubagentsExpander"
                                    AutomationProperties.AutomationId="AiHub_SubagentsExpander"
                                    Header="Parallel analysis"
                                    HeaderIcon="{ui:FontIcon Glyph=&#xE8FD;}"
                                    Description="{x:Bind ViewModel.AiServices.SubagentSettingsSummary, Mode=OneWay}">
                                    <tkcontrols:SettingsExpander.Items>
                                        <tkcontrols:SettingsCard x:Uid="AiHub_SubagentsCard" services:RuntimeLocalization.Uid="AiHub_SubagentsCard" Header="Analysis subagents"
                                            Description="Process independent evidence groups in parallel with Codex or Pi.">
                                            <ToggleSwitch x:Uid="AiHub_SubagentsToggle" services:RuntimeLocalization.Uid="AiHub_SubagentsToggle"
                                                AutomationProperties.AutomationId="AiHub_SubagentsToggle"
                                                IsEnabled="{x:Bind ViewModel.AiServices.CanEdit, Mode=OneWay}"
                                                IsOn="{x:Bind ViewModel.AiServices.EnableSubagents, Mode=TwoWay}" />
                                        </tkcontrols:SettingsCard>
                                        <tkcontrols:SettingsCard x:Uid="AiHub_ServiceConcurrencyCard" services:RuntimeLocalization.Uid="AiHub_ServiceConcurrencyCard" Header="Service concurrency"
                                            Description="Maximum concurrent analyses across all active tasks.">
                                            <NumberBox x:Uid="AiHub_ServiceConcurrencyBox" services:RuntimeLocalization.Uid="AiHub_ServiceConcurrencyBox"
                                                AutomationProperties.AutomationId="AiHub_ServiceConcurrencyBox"
                                                Width="140" Minimum="1" Maximum="4" SmallChange="1" SpinButtonPlacementMode="Compact"
                                                IsEnabled="{x:Bind ViewModel.AiServices.CanEdit, Mode=OneWay}"
                                                Value="{x:Bind ViewModel.AiServices.MaxConcurrentAnalysis, Mode=TwoWay}" />
                                        </tkcontrols:SettingsCard>
                                        <tkcontrols:SettingsCard x:Uid="AiHub_TaskAgentsCard" services:RuntimeLocalization.Uid="AiHub_TaskAgentsCard" Header="Subagents per task"
                                            Description="Maximum parallel workers assigned to a single task.">
                                            <NumberBox x:Uid="AiHub_TaskAgentsBox" services:RuntimeLocalization.Uid="AiHub_TaskAgentsBox"
                                                AutomationProperties.AutomationId="AiHub_TaskAgentsBox"
                                                Width="140" Minimum="1" Maximum="4" SmallChange="1" SpinButtonPlacementMode="Compact"
                                                IsEnabled="{x:Bind ViewModel.AiServices.CanEditSubagentLimit, Mode=OneWay}"
                                                Value="{x:Bind ViewModel.AiServices.MaxAgentsPerTask, Mode=TwoWay}" />
                                        </tkcontrols:SettingsCard>
                                    </tkcontrols:SettingsExpander.Items>
                                </tkcontrols:SettingsExpander>

                                <!-- Global policy remains editable while AI is off. Task chains live on the AI Hub page. -->
                                <tkcontrols:SettingsExpander
                                    x:Name="AiPolicyRulesExpander"
                                    x:Uid="AiHub_PolicyRulesExpander" services:RuntimeLocalization.Uid="AiHub_PolicyRulesExpander"
                                    HeaderIcon="{ui:FontIcon Glyph=&#xE72E;}"
                                    IsExpanded="False">
                                    <tkcontrols:SettingsExpander.Items>
                                        <tkcontrols:SettingsCard HorizontalContentAlignment="Stretch" ContentAlignment="Vertical">
                                            <StackPanel Margin="0,4,0,4" Spacing="12">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    AutomationProperties.LiveSetting="Polite"
                                                    Text="{x:Bind ViewModel.AiServices.SecurityPolicyStatusText, Mode=OneWay}" />
                                                <TextBox
                                                    x:Name="AiPolicyContentBox"
                                                    x:Uid="AiHub_PolicyContentBox" services:RuntimeLocalization.Uid="AiHub_PolicyContentBox"
                                                    AutomationProperties.AutomationId="AiHub_PolicyContentBox"
                                                    MinHeight="160"
                                                    MaxHeight="320"
                                                    AcceptsReturn="True"
                                                    FontFamily="{StaticResource KitMonoFontFamily}"
                                                    FontSize="{ThemeResource KitFontSize12}" services:TypographyResources.BaseFontSize="12"
                                                    IsReadOnly="{x:Bind ViewModel.AiServices.CanEditPolicies, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                                    MaxLength="64000"
                                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                    Text="{x:Bind ViewModel.AiServices.SecurityPolicyContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    TextWrapping="Wrap" />
                                                <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        IsTextSelectionEnabled="True"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind ViewModel.AiServices.SecurityPolicyPath, Mode=OneWay}"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTipService.ToolTip="{x:Bind ViewModel.AiServices.SecurityPolicyPath, Mode=OneWay}" />
                                                    <tkcontrols:WrapPanel
                                                        Grid.Row="1"
                                                        HorizontalAlignment="Right"
                                                        HorizontalSpacing="8"
                                                        VerticalSpacing="8">
                                                        <Button
                                                            x:Uid="AIHub_DiscardTaskPolicyButton" services:RuntimeLocalization.Uid="AIHub_DiscardTaskPolicyButton"
                                                            AutomationProperties.AutomationId="AiHub_DiscardPolicyButton"
                                                            Style="{StaticResource KitActionButtonStyle}"
                                                            Command="{x:Bind ViewModel.AiServices.DiscardPolicyCommand}" />
                                                        <Button
                                                            x:Uid="AiHub_ResetPolicyButton" services:RuntimeLocalization.Uid="AiHub_ResetPolicyButton"
                                                            AutomationProperties.AutomationId="AiHub_ResetPolicyButton"
                                                            Style="{StaticResource KitActionButtonStyle}"
                                                            Command="{x:Bind ViewModel.AiServices.ResetPolicyCommand}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <FontIcon Glyph="&#xE777;" FontSize="13" />
                                                                <TextBlock x:Uid="AiHub_ResetPolicyButtonText" services:RuntimeLocalization.Uid="AiHub_ResetPolicyButtonText" Text="Reset to default" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button
                                                            x:Uid="AiHub_SavePolicyButton" services:RuntimeLocalization.Uid="AiHub_SavePolicyButton"
                                                            AutomationProperties.AutomationId="AiHub_SavePolicyButton"
                                                            Command="{x:Bind ViewModel.AiServices.SavePolicyCommand}"
                                                            Style="{StaticResource KitPrimaryActionButtonStyle}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <FontIcon Glyph="&#xE74E;" FontSize="13" />
                                                                <TextBlock x:Uid="AiHub_SavePolicyButtonText" services:RuntimeLocalization.Uid="AiHub_SavePolicyButtonText" Text="Save" />
                                                            </StackPanel>
                                                        </Button>
                                                    </tkcontrols:WrapPanel>
                                                </Grid>
                                            </StackPanel>
                                        </tkcontrols:SettingsCard>
                                    </tkcontrols:SettingsExpander.Items>
                                </tkcontrols:SettingsExpander>
                            </StackPanel>
                        </ContentControl>
                        <Grid x:Name="AiServiceSettingsLoading" Background="Transparent">
                            <ProgressRing x:Name="AiServiceSettingsLoadingRing" x:Uid="General_SettingsLoadingRing" services:RuntimeLocalization.Uid="General_SettingsLoadingRing"
                                          Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16"
                                          IsActive="True" />
                        </Grid>
                    </Grid>
                </controls:SettingsGroup>

                <controls:SettingsGroup x:Name="DiagnosticsGroup" x:Uid="General_DiagnosticsGroup" services:RuntimeLocalization.Uid="General_DiagnosticsGroup">
                    <tkcontrols:SettingsExpander
                        x:Name="GeneralDiagnosticsExpander"
                        x:Uid="General_DiagnosticsExpander" services:RuntimeLocalization.Uid="General_DiagnosticsExpander"
                        HeaderIcon="{ui:FontIcon Glyph=&#xEC19;}"
                        IsExpanded="False">
                        <ToggleSwitch
                            x:Name="DiagnosticsToggle"
                            x:Uid="ToggleSwitch" services:RuntimeLocalization.Uid="ToggleSwitch"
                            AutomationProperties.Name="{Binding ElementName=GeneralDiagnosticsExpander, Path=Header}"
                            IsOn="{x:Bind ViewModel.EnableLogging, Mode=TwoWay}" />
                        <tkcontrols:SettingsExpander.Items>
                            <tkcontrols:SettingsCard
                                x:Uid="General_LogLevelCard" services:RuntimeLocalization.Uid="General_LogLevelCard"
                                IsEnabled="{x:Bind ViewModel.EnableLogging, Mode=OneWay}">
                                <ComboBox
                                    x:Uid="General_LogLevelComboBox" services:RuntimeLocalization.Uid="General_LogLevelComboBox"
                                    AutomationProperties.AutomationId="General_LogLevelComboBox"
                                    MinWidth="{StaticResource SettingActionControlMinWidth}"
                                    SelectedIndex="{x:Bind ViewModel.LogLevelIndex, Mode=TwoWay}">
                                    <ComboBoxItem x:Uid="General_LogLevelTrace" services:RuntimeLocalization.Uid="General_LogLevelTrace" Content="Trace (Verbose)" Tag="trace" />
                                    <ComboBoxItem x:Uid="General_LogLevelDebug" services:RuntimeLocalization.Uid="General_LogLevelDebug" Content="Debug" Tag="debug" />
                                    <ComboBoxItem x:Uid="General_LogLevelInfo" services:RuntimeLocalization.Uid="General_LogLevelInfo" Content="Info" Tag="info" />
                                    <ComboBoxItem x:Uid="General_LogLevelWarning" services:RuntimeLocalization.Uid="General_LogLevelWarning" Content="Warning" Tag="warn" />
                                    <ComboBoxItem x:Uid="General_LogLevelError" services:RuntimeLocalization.Uid="General_LogLevelError" Content="Error" Tag="err" />
                                </ComboBox>
                            </tkcontrols:SettingsCard>
                            <tkcontrols:SettingsCard
                                x:Uid="General_OpenLogsFolderCard" services:RuntimeLocalization.Uid="General_OpenLogsFolderCard"
                                Description="{x:Bind ViewModel.LogsFolderPath, Mode=OneWay}">
                                <Button
                                    x:Uid="General_OpenLogsFolderButton" services:RuntimeLocalization.Uid="General_OpenLogsFolderButton"
                                    AutomationProperties.AutomationId="General_OpenLogsFolderButton"
                                    Style="{StaticResource KitActionButtonStyle}"
                                    Command="{x:Bind ViewModel.OpenLogsFolderCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xEC50;" FontSize="13" />
                                        <TextBlock x:Uid="General_OpenLogsFolderText" services:RuntimeLocalization.Uid="General_OpenLogsFolderText" Text="Open folder" />
                                    </StackPanel>
                                </Button>
                            </tkcontrols:SettingsCard>
                        </tkcontrols:SettingsExpander.Items>
                    </tkcontrols:SettingsExpander>
                </controls:SettingsGroup>

                <controls:SettingsGroup x:Name="BackupAndRestoreGroup" x:Uid="General_SettingsBackupAndRestoreTitle" services:RuntimeLocalization.Uid="General_SettingsBackupAndRestoreTitle" Visibility="Visible">
                    <tkcontrols:SettingsExpander
                        x:Name="GeneralSettingsBackupAndRestore"
                        x:Uid="General_SettingsBackupAndRestore" services:RuntimeLocalization.Uid="General_SettingsBackupAndRestore"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE777;}">
                        <tkcontrols:WrapPanel Orientation="Horizontal" VerticalSpacing="8" HorizontalSpacing="8">
                            <Button
                                x:Name="BackupButton"
                                x:Uid="General_SettingsBackupAndRestore_ButtonBackup" services:RuntimeLocalization.Uid="General_SettingsBackupAndRestore_ButtonBackup"
                                AutomationProperties.AutomationId="General_BackupConfigsButton"
                                Style="{StaticResource KitActionButtonStyle}"
                                Command="{Binding BackupConfigsEventHandler}" />
                            <Button
                                x:Uid="General_SettingsBackupAndRestore_ButtonRestore" services:RuntimeLocalization.Uid="General_SettingsBackupAndRestore_ButtonRestore"
                                AutomationProperties.AutomationId="General_RestoreConfigsButton"
                                Style="{StaticResource KitActionButtonStyle}"
                                Command="{Binding RestoreConfigsEventHandler}" />
                        </tkcontrols:WrapPanel>
                        <tkcontrols:SettingsExpander.Items>
                            <tkcontrols:SettingsCard x:Name="GeneralSettingsBackupAndRestoreLocationText" x:Uid="General_SettingsBackupAndRestoreLocationText" services:RuntimeLocalization.Uid="General_SettingsBackupAndRestoreLocationText" HorizontalContentAlignment="Stretch" ContentAlignment="Vertical">
                                <Grid MaxWidth="320" HorizontalAlignment="Left" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="pathTextBlock"
                                        MaxWidth="280"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        IsTextSelectionEnabled="True"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ViewModel.SettingsBackupAndRestoreDir, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.SettingsBackupAndRestoreDir, Mode=OneWay}" />
                                    <Button
                                        x:Uid="General_SettingsBackupAndRestore_ButtonSelectFolder" services:RuntimeLocalization.Uid="General_SettingsBackupAndRestore_ButtonSelectFolder"
                                        AutomationProperties.AutomationId="General_SelectBackupFolderButton"
                                        Style="{StaticResource KitIconButtonStyle}"
                                        Grid.Column="1"
                                        Command="{Binding SelectSettingBackupDirEventHandler}">
                                        <FontIcon Glyph="&#xE8DA;" FontSize="14" />
                                        <ToolTipService.ToolTip>
                                            <ToolTip>
                                                <TextBlock x:Uid="General_SettingsBackupAndRestore_ButtonSelectLocation" services:RuntimeLocalization.Uid="General_SettingsBackupAndRestore_ButtonSelectLocation" />
                                            </ToolTip>
                                        </ToolTipService.ToolTip>
                                    </Button>
                                </Grid>
                            </tkcontrols:SettingsCard>
                            <tkcontrols:SettingsCard
                                x:Name="GeneralSettingsBackupAndRestoreStatusInfo"
                                x:Uid="General_SettingsBackupAndRestoreStatusInfo" services:RuntimeLocalization.Uid="General_SettingsBackupAndRestoreStatusInfo"
                                HorizontalContentAlignment="Left"
                                ContentAlignment="Vertical">
                                <Grid
                                    Margin="0,2,0,4"
                                    ColumnSpacing="24"
                                    RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        x:Uid="General_SettingsBackupInfo_StatusHeader" services:RuntimeLocalization.Uid="General_SettingsBackupInfo_StatusHeader"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SecondaryTextStyle}" />
                                    <tkcontrols:WrapPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal" VerticalSpacing="8"
                                        HorizontalSpacing="8"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                            Text="{x:Bind ViewModel.CurrentSettingMatchText, Mode=OneWay}"
                                            TextWrapping="WrapWholeWords" />
                                        <Button
                                            x:Uid="General_RefreshBackupStatusButton" services:RuntimeLocalization.Uid="General_RefreshBackupStatusButton"
                                            AutomationProperties.AutomationId="General_RefreshBackupStatusButton"
                                            Click="UpdateBackupAndRestoreStatusText"
                                            Style="{StaticResource KitCompactToolbarButtonStyle}"
                                            VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="&#xE72C;" FontSize="11" />
                                                <TextBlock x:Uid="General_SettingsBackupAndRestore_LinkRefresh" services:RuntimeLocalization.Uid="General_SettingsBackupAndRestore_LinkRefresh" Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                        </Button>
                                    </tkcontrols:WrapPanel>

                                    <TextBlock
                                        x:Uid="General_SettingsBackupInfo_FileNameHeader" services:RuntimeLocalization.Uid="General_SettingsBackupInfo_FileNameHeader"
                                        Grid.Row="1"
                                        Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        Text="{x:Bind ViewModel.LastSettingsBackupFileName, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords" />

                                    <TextBlock
                                        x:Uid="General_SettingsBackupInfo_SourceHeader" services:RuntimeLocalization.Uid="General_SettingsBackupInfo_SourceHeader"
                                        Grid.Row="2"
                                        Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        Text="{x:Bind ViewModel.LastSettingsBackupSource, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords" />
                                    <TextBlock
                                        x:Uid="General_SettingsBackupInfo_DateHeader" services:RuntimeLocalization.Uid="General_SettingsBackupInfo_DateHeader"
                                        Grid.Row="3"
                                        Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        Text="{x:Bind ViewModel.LastSettingsBackupDate, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords" />
                                </Grid>
                            </tkcontrols:SettingsCard>
                        </tkcontrols:SettingsExpander.Items>
                    </tkcontrols:SettingsExpander>
                    <InfoBar
                        Title="{x:Bind ViewModel.SettingsBackupMessage, Mode=OneWay}"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.SettingsBackupRestoreMessageVisible, Mode=OneWay}"
                        IsTabStop="{x:Bind ViewModel.SettingsBackupRestoreMessageVisible, Mode=OneWay}"
                        Severity="{x:Bind ViewModel.BackupRestoreMessageSeverity, Converter={StaticResource StringToInfoBarSeverityConverter}}"
                        Visibility="{x:Bind ViewModel.SettingsBackupRestoreMessageVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </controls:SettingsGroup>

                <controls:SettingsGroup x:Name="VersionAndUpdateGroup" x:Uid="General_VersionAndUpdate" services:RuntimeLocalization.Uid="General_VersionAndUpdate">
                    <tkcontrols:SettingsCard Header="{x:Bind ViewModel.PowerToysVersion, Mode=OneWay}" HeaderIcon="{ui:FontIcon Glyph=&#xE895;}">
                        <tkcontrols:SettingsCard.Description>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Style="{StaticResource SecondaryTextStyle}">
                                    <Run x:Uid="General_VersionLastChecked" services:RuntimeLocalization.Uid="General_VersionLastChecked" />
                                    <Run Text="{x:Bind ViewModel.UpdateCheckedDate, Mode=OneWay}" />
                                </TextBlock>
                                <HyperlinkButton
                                    x:Uid="ReleaseNotes" services:RuntimeLocalization.Uid="ReleaseNotes"
                                    Margin="0,2,0,0"
                                    FontWeight="SemiBold"
                                    NavigateUri="https://github.com/guijianchou/Kit/releases/" />
                            </StackPanel>
                        </tkcontrols:SettingsCard.Description>
                        <Grid Visibility="{x:Bind ViewModel.IsUpdatePanelVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="12"
                                Visibility="{x:Bind ViewModel.IsCheckingForUpdates, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsCheckingForUpdates, Mode=OneWay}" />
                                <TextBlock
                                    x:Uid="General_CheckingForUpdates" services:RuntimeLocalization.Uid="General_CheckingForUpdates"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button
                                x:Name="CheckForUpdatesButton"
                                x:Uid="GeneralPage_CheckForUpdates" services:RuntimeLocalization.Uid="GeneralPage_CheckForUpdates"
                                HorizontalAlignment="Right"
                                Command="{Binding CheckForUpdatesEventHandler}"
                                IsEnabled="{x:Bind ViewModel.IsCheckForUpdatesButtonEnabled, Mode=OneWay}"
                                Style="{StaticResource KitPrimaryActionButtonStyle}"
                                Visibility="{x:Bind ViewModel.IsCheckingForUpdates, Mode=OneWay, Converter={StaticResource ReverseBoolToVisibilityConverter}}" />
                        </Grid>
                    </tkcontrols:SettingsCard>

                    <InfoBar
                        Title="{x:Bind ViewModel.UpdateCheckMessage, Mode=OneWay}"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.UpdateCheckMessageVisible, Mode=OneWay}"
                        IsTabStop="{x:Bind ViewModel.UpdateCheckMessageVisible, Mode=OneWay}"
                        Severity="{x:Bind ViewModel.UpdateCheckMessageSeverity, Converter={StaticResource StringToInfoBarSeverityConverter}, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.UpdateCheckMessageVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="12" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsPortableUpdateBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ViewModel.UpdateDownloadPercent, Mode=OneWay}"
                                             IsIndeterminate="{x:Bind ViewModel.IsUpdateProgressIndeterminate, Mode=OneWay}"
                                             Style="{StaticResource KitProgressBarStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.UpdateDownloadSummary, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                            <tkcontrols:WrapPanel Orientation="Horizontal" VerticalSpacing="8" HorizontalSpacing="8">
                                <Button x:Uid="General_UpdateDownload" services:RuntimeLocalization.Uid="General_UpdateDownload" AutomationProperties.AutomationId="GeneralPage_DownloadUpdate"
                                        Command="{x:Bind ViewModel.DownloadUpdateCommand}" Style="{StaticResource KitPrimaryActionButtonStyle}"
                                        Visibility="{x:Bind ViewModel.CanDownloadPortableUpdate, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button Content="{x:Bind ViewModel.RestartUpdateLabel, Mode=OneWay}" AutomationProperties.AutomationId="GeneralPage_RestartUpdate"
                                        Command="{x:Bind ViewModel.RestartToUpdateCommand}" Style="{StaticResource KitPrimaryActionButtonStyle}"
                                        Visibility="{x:Bind ViewModel.CanRestartToUpdate, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button x:Uid="General_UpdateCancel" services:RuntimeLocalization.Uid="General_UpdateCancel" AutomationProperties.AutomationId="GeneralPage_CancelUpdate"
                                        Style="{StaticResource KitActionButtonStyle}"
                                        Command="{x:Bind ViewModel.CancelUpdateDownloadCommand}"
                                        Visibility="{x:Bind ViewModel.CanCancelUpdateDownload, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <HyperlinkButton x:Uid="GeneralPage_ViewRelease" services:RuntimeLocalization.Uid="GeneralPage_ViewRelease" AutomationProperties.AutomationId="GeneralPage_ViewReleaseButton"
                                                 NavigateUri="{x:Bind ViewModel.PowerToysNewAvailableVersionUri, Mode=OneWay}"
                                                 Visibility="{x:Bind ViewModel.IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                            </tkcontrols:WrapPanel>
                        </StackPanel>
                    </InfoBar>
                </controls:SettingsGroup>
            </StackPanel>
        </controls:SettingsPageControl.ModuleContent>
        </controls:SettingsPageControl>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SettingsSectionBarStates">
                <VisualState x:Name="SettingsSectionBarSingleRow">
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger TargetElement="{Binding ElementName=SettingsSectionBar}" MinWidth="640" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="SettingsSectionBarTwoRows">
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger TargetElement="{Binding ElementName=SettingsSectionBar}" MaxWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SectionCol3.Width" Value="0" />
                        <Setter Target="SectionCol4.Width" Value="0" />
                        <Setter Target="SectionCol5.Width" Value="0" />
                        <Setter Target="SectionNavDiagnosticsButton.(Grid.Row)" Value="1" />
                        <Setter Target="SectionNavDiagnosticsButton.(Grid.Column)" Value="0" />
                        <Setter Target="SectionNavBackupButton.(Grid.Row)" Value="1" />
                        <Setter Target="SectionNavBackupButton.(Grid.Column)" Value="1" />
                        <Setter Target="SectionNavUpdatesButton.(Grid.Row)" Value="1" />
                        <Setter Target="SectionNavUpdatesButton.(Grid.Column)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</local:NavigablePage>
